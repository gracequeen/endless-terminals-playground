[45.468236, "i", "cat > check_yaml.py << 'EOF'\n#!/usr/bin/env python3\nimport sys\nimport yaml\nfrom yaml.constructor import ConstructorError\n\nclass DuplicateKeysLoader(yaml.SafeLoader):\n    def construct_mapping(self, node, deep=False):\n        if not isinstance(node, yaml.MappingNode):\n            raise ConstructorError(None, None,\n                \"expected a mapping node, but found %s\" % node.id,\n                node.start_mark)\n        mapping = {}\n        for key_node, value_node in node.value:\n            key = self.construct_object(key_node, deep=deep)\n            # Check for unhashable keys\n            try:\n                hash(key)\n            except TypeError as exc:\n                raise ConstructorError(\"while constructing a mapping\", node.start_mark,\n                    \"found unhashable key\", key_node.start_mark) from exc\n            # Check for duplicate keys\n            if key in mapping:\n                raise ConstructorError(\"while constructing a mapping\", node.start_mark,\n                    f\"found duplicate k"]
[45.468368, "i", "ey: {key}\", key_node.start_mark)\n            value = self.construct_object(value_node, deep=deep)\n            mapping[key] = value\n        return mapping\n\nfor path in sys.argv[1:]:\n    try:\n        with open(path) as f:\n            yaml.load(f, Loader=DuplicateKeysLoader)\n        print(f\"OK: {path}\")\n    except yaml.YAMLError as e:\n        print(f\"ERROR: {path}: {e}\")\n    except Exception as e:\n        print(f\"ERROR: {path}: {e}\")\nEOF\n"]
