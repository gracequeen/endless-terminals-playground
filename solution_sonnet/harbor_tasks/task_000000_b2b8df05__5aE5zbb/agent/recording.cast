[106.562521, "o", "root@04d4f8bd267e:/home/user/data# "]
[106.663182, "i", "cat clean.sql\n"]
[106.663301, "o", "cat clean.sql\r\n\u001b[?2004l\r"]
[106.664143, "o", "DROP TABLE IF EXISTS responses_clean;\r\nCREATE TABLE responses_clean AS\r\n-- Keep earliest submission for each non-NULL email\r\nSELECT r.*\r\nFROM responses r\r\nINNER JOIN (\r\n    SELECT email, MIN(submitted_at) as first_sub\r\n    FROM responses\r\n    WHERE email IS NOT NULL AND email != ''\r\n    GROUP BY email\r\n) earliest ON r.email = earliest.email AND r.submitted_at = earliest.first_sub\r\nUNION ALL\r\n-- Keep all rows with NULL/empty email (can't deduplicate these)\r\nSELECT *\r\nFROM responses\r\nWHERE email IS NULL OR email = '';\r\n"]
[106.664308, "o", "\u001b[?2004h"]
[106.664366, "o", "root@04d4f8bd267e:/home/user/data# "]
[106.763958, "i", "sqlite3 survey.db < clean.sql\n"]
[106.764092, "o", "sqlite3 survey.db < clean.sql\r\n"]
[106.764146, "o", "\u001b[?2004l\r"]
[106.776526, "o", "\u001b[?2004h"]
[106.776585, "o", "root@04d4f8bd267e:/home/user/data# "]
[107.264767, "i", "sqlite3 survey.db \"SELECT COUNT(*) FROM responses_clean;\"\n"]
[107.264985, "o", "sqlite3 survey.db \"SELECT COUNT(*) FROM responses_clean;\"\r\n\u001b[?2004l\r"]
[107.266594, "o", "312\r\n"]
[107.26691, "o", "\u001b[?2004h"]
[107.266981, "o", "root@04d4f8bd267e:/home/user/data# "]
