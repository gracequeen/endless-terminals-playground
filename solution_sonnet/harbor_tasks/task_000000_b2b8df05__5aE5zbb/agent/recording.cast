[106.559211, "i", "cat > clean.sql << 'EOF'\nDROP TABLE IF EXISTS responses_clean;\nCREATE TABLE responses_clean AS\n-- Keep earliest submission for each non-NULL email\nSELECT r.*\nFROM responses r\nINNER JOIN (\n    SELECT email, MIN(submitted_at) as first_sub\n    FROM responses\n    WHERE email IS NOT NULL AND email != ''\n    GROUP BY email\n) earliest ON r.email = earliest.email AND r.submitted_at = earliest.first_sub\nUNION ALL\n-- Keep all rows with NULL/empty email (can't deduplicate these)\nSELECT *\nFROM responses\nWHERE email IS NULL OR email = '';\nEOF\n"]
[106.559334, "o", "cat > clean.sql << 'EOF'\r\n\u001b[?2004l\r"]
[106.559397, "o", "\u001b[?2004h"]
[106.559426, "o", "> "]
[106.559534, "o", "DROP TABLE IF EXISTS responses_clean;\r\n\u001b[?2004l\r"]
[106.559569, "o", "\u001b[?2004h> "]
[106.559657, "o", "CREATE TABLE responses_clean AS\r\n\u001b[?2004l\r"]
[106.559691, "o", "\u001b[?2004h> "]
[106.559839, "o", "-- Keep earliest submission for each non-NULL email\r\n\u001b[?2004l\r"]
[106.559876, "o", "\u001b[?2004h> "]
[106.559912, "o", "SELECT r.*\r\n\u001b[?2004l\r"]
[106.559944, "o", "\u001b[?2004h> "]
[106.559972, "o", "FROM responses r\r\n\u001b[?2004l\r"]
[106.560002, "o", "\u001b[?2004h> "]
[106.560039, "o", "INNER JOIN (\r\n\u001b[?2004l\r"]
[106.56007, "o", "\u001b[?2004h> "]
[106.560207, "o", "    SELECT email, MIN(submitted_at) as first_sub\r\n\u001b[?2004l\r"]
[106.560246, "o", "\u001b[?2004h"]
[106.560273, "o", "> "]
[106.5603, "o", "    FROM responses\r\n\u001b[?2004l\r"]
[106.560329, "o", "\u001b[?2004h> "]
[106.560456, "o", "    WHERE email IS NOT NULL AND email != ''\r\n\u001b[?2004l\r"]
[106.560491, "o", "\u001b[?2004h> "]
[106.56054, "o", "    GROUP BY email\r\n\u001b[?2004l\r"]
[106.56057, "o", "\u001b[?2004h"]
[106.5606, "o", "> "]
[106.560791, "o", ") earliest ON r.email = earliest.email AND r.submitted_at = earliest.first_sub\r\n\u001b[?2004l\r"]
[106.560822, "o", "\u001b[?2004h"]
[106.560848, "o", "> "]
[106.560875, "o", "UNION ALL\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.560901, "o", "> "]
[106.561071, "o", "-- Keep all rows with NULL/empty email (can't deduplicate these)\r\n\u001b[?2004l\r"]
[106.561104, "o", "\u001b[?2004h> "]
[106.561132, "o", "SELECT *\r\n\u001b[?2004l\r"]
[106.561163, "o", "\u001b[?2004h> "]
[106.561206, "o", "FROM responses\r\n\u001b[?2004l\r"]
[106.561237, "o", "\u001b[?2004h> "]
[106.561335, "o", "WHERE email IS NULL OR email = '';\r\n\u001b[?2004l\r"]
[106.561366, "o", "\u001b[?2004h> "]
[106.561393, "o", "EOF\r\n\u001b[?2004l\r"]
