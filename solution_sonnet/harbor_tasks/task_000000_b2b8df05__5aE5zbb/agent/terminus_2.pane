[?2004l[?2004h> DROP TABLE IF EXISTS responses_clean;
[?2004l[?2004h> CREATE TABLE responses_clean AS
[?2004l[?2004h> -- Keep earliest submission for each non-NULL email
[?2004l[?2004h> SELECT r.*
[?2004l[?2004h> FROM responses r
[?2004l[?2004h> INNER JOIN (
[?2004l[?2004h>     SELECT email, MIN(submitted_at) as first_sub
[?2004l[?2004h>     FROM responses
[?2004l[?2004h>     WHERE email IS NOT NULL AND email != ''
[?2004l[?2004h>     GROUP BY email
[?2004l[?2004h> ) earliest ON r.email = earliest.email AND r.submitted_at = earliest.first_sub
[?2004l[?2004h> UNION ALL
[?2004l[?2004h> -- Keep all rows with NULL/empty email (can't deduplicate these)
[?2004l[?2004h> SELECT *
[?2004l[?2004h> FROM responses
