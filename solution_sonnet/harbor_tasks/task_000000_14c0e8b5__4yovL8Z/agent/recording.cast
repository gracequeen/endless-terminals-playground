[37.683816, "i", "']})\"\n    \n    # IP matched rules but port didn't match any\n    return False, f\"port not allowed from {matching_rules[0]['source_cidr']}\"\n\ndef main():\n    # Load firewall rules\n    with open('/home/user/audit/firewall_rules.json', 'r') as f:\n        config = json.load(f)\n        rules = config['rules']\n    \n    # Load connections\n    with open('/home/user/audit/connections.csv', 'r') as f:\n        reader = csv.DictReader(f)\n        connections = list(reader)\n    \n    # Check each connection\n    for conn in connections:\n        src_ip = conn['src_ip']\n        dest_port = conn['dest_port']\n        \n        allowed, reason = check_connection(src_ip, dest_port, rules)\n        \n        if not allowed:\n            # Find the most specific CIDR that matched (if any)\n            matching = find_matching_rules(src_ip, rules)\n            if matching:\n                cidr = matching[0]['source_cidr']\n            else:\n                cidr = \"any\"\n            print(f\"BLOCKED: {src_ip}:{dest_port} not allowed from {cidr}\""]
