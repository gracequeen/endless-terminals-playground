[37.683571, "i", "cat > check.py << 'EOF'\n#!/usr/bin/env python3\nimport json\nimport csv\nimport ipaddress\nimport sys\n\ndef parse_port_spec(port_spec):\n    \"\"\"Parse port specification into a list of allowed ports or a range.\"\"\"\n    port_spec = str(port_spec)\n    if '-' in port_spec:\n        start, end = port_spec.split('-')\n        return ('range', int(start), int(end))\n    else:\n        return ('single', int(port_spec))\n\ndef port_matches(port, port_spec):\n    \"\"\"Check if a port matches the port specification.\"\"\"\n    spec_type, *spec_values = parse_port_spec(port_spec)\n    port = int(port)\n    \n    if spec_type == 'single':\n        return port == spec_values[0]\n    elif spec_type == 'range':\n        start, end = spec_values\n        return start <= port <= end\n    return False\n\ndef find_matching_rules(src_ip, rules):\n    \"\"\"Find all rules that match the source IP, sorted by specificity (most specific first).\"\"\"\n    matching = []\n    src_ip_obj = ipaddress.ip_address(src_ip)\n    \n    for rule in rules:\n        network = ipaddress.i"]
[37.683707, "i", "p_network(rule['source_cidr'])\n        if src_ip_obj in network:\n            matching.append(rule)\n    \n    # Sort by prefix length (descending) - more specific networks have higher prefix length\n    matching.sort(key=lambda r: ipaddress.ip_network(r['source_cidr']).prefixlen, reverse=True)\n    return matching\n\ndef check_connection(src_ip, dest_port, rules):\n    \"\"\"Check if a connection is allowed. Returns (allowed, reason).\"\"\"\n    matching_rules = find_matching_rules(src_ip, rules)\n    \n    if not matching_rules:\n        # No matching rules, default deny\n        return False, \"no matching rule (default deny)\"\n    \n    # Check rules in order of specificity\n    for rule in matching_rules:\n        if port_matches(dest_port, rule['dest_port']):\n            if rule['action'] == 'allow':\n                return True, f\"allowed by rule {rule['id']} ({rule['source_cidr']}:{rule['dest_port']})\"\n            else:  # deny\n                return False, f\"denied by rule {rule['id']} ({rule['source_cidr']}:{rule['dest_port"]
