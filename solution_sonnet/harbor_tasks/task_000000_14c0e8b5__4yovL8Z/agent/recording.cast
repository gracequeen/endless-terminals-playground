[37.694679, "o", "\u001b[?2004h> "]
[37.694739, "o", "        if not allowed:\r\n\u001b[?2004l\r"]
[37.69477, "o", "\u001b[?2004h> "]
[37.694974, "o", "            # Find the most specific CIDR that matched (if any)\r\n\u001b[?2004l\r"]
[37.695008, "o", "\u001b[?2004h> "]
[37.695168, "o", "            matching = find_matching_rules(src_ip, rules)\r\n\u001b[?2004l\r"]
