[38.287257, "i", "cat > process_memory.sh << 'EOF'\n#!/bin/bash\n\n# Output file\nOUTPUT=\"/home/user/low_memory_report.txt\"\n\n# Temporary file for collecting data\nTEMP_FILE=$(mktemp)\n\n# Process each host file\nfor hostfile in /home/user/memstats/host*.txt; do\n    hostname=$(basename \"$hostfile\" .txt)\n    \n    # Extract MemTotal and MemAvailable, handle missing values gracefully\n    memtotal=$(grep -E '^MemTotal:' \"$hostfile\" 2>/dev/null | awk '{print $2}')\n    memavail=$(grep -E '^MemAvailable:' \"$hostfile\" 2>/dev/null | awk '{print $2}')\n    \n    # Check if both values exist and are numeric, then calculate and filter\n    if [[ -n \"$memtotal\" && -n \"$memavail\" ]]; then\n        # Use awk to calculate percentage and check if < 20%\n        awk -v mt=\"$memtotal\" -v ma=\"$memavail\" -v host=\"$hostname\" '\n        BEGIN {\n            if (mt > 0) {\n                percent = (ma / mt) * 100\n                if (percent < 20) {\n                    printf \"%s\\t%.2f\\n\", host, percent\n                }\n            }\n        }' >> \"$TEMP_FILE\"\n    f"]
[38.287387, "i", "i\ndone\n\n# Sort by percentage (ascending - worst first) and write to output\nsort -t$'\\t' -k2 -n \"$TEMP_FILE\" > \"$OUTPUT\"\n\n# Clean up\nrm -f \"$TEMP_FILE\"\nEOF\n"]
