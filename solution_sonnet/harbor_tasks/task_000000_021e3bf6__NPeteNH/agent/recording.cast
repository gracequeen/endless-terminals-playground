[26.23815, "i", "cat > process_memory.sh << 'EOF'\n#!/bin/bash\n\n# Output file\nOUTPUT=\"/home/user/low_memory_report.txt\"\n\n# Temporary file for collecting data\nTEMP_FILE=$(mktemp)\n\n# Process each host file\nfor hostfile in /home/user/memstats/host*.txt; do\n    hostname=$(basename \"$hostfile\" .txt)\n    \n    # Extract MemTotal and MemAvailable, handle missing values gracefully\n    memtotal=$(grep -E '^MemTotal:' \"$hostfile\" 2>/dev/null | awk '{print $2}')\n    memavail=$(grep -E '^MemAvailable:' \"$hostfile\" 2>/dev/null | awk '{print $2}')\n    \n    # Check if both values exist and are numeric\n    if [[ -n \"$memtotal\" && -n \"$memavail\" && \"$memtotal\" -gt 0 ]]; then\n        # Calculate percentage available (using bc for floating point)\n        percent=$(echo \"scale=2; ($memavail / $memtotal) * 100\" | bc)\n        \n        # Check if less than 20%\n        is_low=$(echo \"$percent < 20\" | bc)\n        if [[ \"$is_low\" -eq 1 ]]; then\n            echo -e \"${hostname}\\t${percent}\" >> \"$TEMP_FILE\"\n        fi\n    fi\ndone\n\n# Sort by percentage (as"]
[26.238292, "i", "cending - worst first) and write to output\nsort -t$'\\t' -k2 -n \"$TEMP_FILE\" > \"$OUTPUT\"\n\n# Clean up\nrm -f \"$TEMP_FILE\"\nEOF\n"]
