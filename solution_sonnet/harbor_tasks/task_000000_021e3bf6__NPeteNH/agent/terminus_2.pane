[?2004l[?2004h> #!/bin/bash
[?2004l[?2004h> 
[?2004l[?2004h> # Output file
[?2004l[?2004h> OUTPUT="/home/user/low_memory_report.txt"
[?2004l[?2004h> 
[?2004l[?2004h> # Temporary file for collecting data
[?2004l[?2004h> TEMP_FILE=$(mktemp)
[?2004l[?2004h> 
[?2004l[?2004h> # Process each host file
[?2004l[?2004h> for hostfile in /home/user/memstats/host*.txt; do
[?2004l[?2004h>     hostname=$(basename "$hostfile" .txt)
[?2004l[?2004h>     
[?2004l[?2004h>     # Extract MemTotal and MemAvailable, handle missing values gracefully
[?2004l[?2004h>     memtotal=$(grep -E '^MemTotal:' "$hostfile" 2>/dev/null | awk '{print $2}')
[?2004l[?2004h>     memavail=$(grep -E '^MemAvailable:' "$hostfile" 2>/dev/null | awk '{print $2}')
[?2004l[?2004h>     
[?2004l[?2004h>     # Check if both values exist and are numeric, then calculate and filter
[?2004l[?2004h>     if [[ -n "$memtotal" && -n "$memavail" ]]; then
[?2004l[?2004h>         # Use awk to calculate percentage and check if < 20%
[?2004l[?2004h>         awk -v mt="$memtotal" -v ma="$memavail" -v host="$hostname" '
[?2004l[?2004h>         BEGIN {
[?2004l[?2004h>             if (mt > 0) {
[?2004l[?2004h>                 percent = (ma / mt) * 100
[?2004l[?2004h>                 if (percent < 20) {
[?2004l[?2004h>                     printf "%s\t%.2f\n", host, percent
[?2004l[?2004h>                 }
[?2004l[?2004h>             }
[?2004l[?2004h>         }' >> "$TEMP_FILE"
[?2004l[?2004h>     fi
[?2004l[?2004h> done
[?2004l[?2004h> 
[?2004l[?2004h> # Sort by percentage (ascending - worst first) and write to output
