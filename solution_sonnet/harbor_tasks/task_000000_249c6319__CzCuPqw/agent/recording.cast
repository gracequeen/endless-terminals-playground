[76.609773, "i", "python3 << 'EOF'\nimport json\nimport csv\n\n# Calculate total from JSON\nwith open('input/transactions.json') as f:\n    json_data = json.load(f)\n    json_total = 0\n    for txn in json_data:\n        amount_str = txn['amount'].replace('$', '').replace('€', '').replace('£', '').replace('¥', '').replace(',', '')\n        json_total += float(amount_str)\n\n# Calculate total from CSV\nwith open('output/transactions.csv') as f:\n    reader = csv.DictReader(f)\n    csv_total = sum(float(row['amount']) for row in reader)\n\nprint(f\"JSON total: ${json_total:,.2f}\")\nprint(f\"CSV total:  ${csv_total:,.2f}\")\nprint(f\"Match: {abs(json_total - csv_total) < 0.01}\")\nEOF\n"]
