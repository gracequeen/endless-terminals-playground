[86.461707, "i", "python3 << 'EOF'\nimport json\n\n# Count transactions by currency in the JSON\nwith open('input/transactions.json') as f:\n    data = json.load(f)\n    currencies = {}\n    for txn in data:\n        symbol = txn['amount'][0]\n        currencies[symbol] = currencies.get(symbol, 0) + 1\n\nprint(\"Transaction counts by currency symbol:\")\nfor symbol, count in sorted(currencies.items()):\n    currency_name = {'$': 'USD', '€': 'EUR', '£': 'GBP', '¥': 'JPY'}.get(symbol, 'Unknown')\n    print(f\"  {symbol} ({currency_name}): {count}\")\nprint(f\"\\nTotal transactions: {len(data)}\")\nEOF\n"]
