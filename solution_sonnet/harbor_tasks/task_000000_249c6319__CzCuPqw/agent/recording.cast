[59.311881, "i", "cat lib/parsers.py\n"]
[59.311998, "o", "cat lib/parsers.py\r\n\u001b[?2004l\r"]
[59.312898, "o", "\"\"\"\r\nHelper functions for parsing transaction data.\r\n\"\"\"\r\nimport re\r\n\r\n\r\ndef parse_amount(s):\r\n    \"\"\"\r\n    Parse an amount string like \"$1,234.56\" or \"€1,234.56\" and return a float.\r\n    Strips currency symbols and thousand separators.\r\n    \"\"\"\r\n    # Remove currency symbols (dollar, euro, etc.) and commas\r\n    cleaned = re.sub(r'[\\$€£¥,]', '', s)\r\n    return float(cleaned)\r\n"]
[59.313065, "o", "\u001b[?2004h"]
[59.313113, "o", "root@3955e54a7bf9:/home/user/etl# "]
