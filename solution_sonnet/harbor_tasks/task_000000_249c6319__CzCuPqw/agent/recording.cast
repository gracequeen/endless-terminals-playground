[52.736841, "o", "def parse_amount(s):\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.736874, "o", ">     \"\"\"\r\n\u001b[?2004l\r"]
[52.73691, "o", "\u001b[?2004h> "]
[52.737134, "o", "    Parse an amount string like \"$1,234.56\" or \"€1,234.56\" and return a float.\r\n\u001b[?2004l\r"]
[52.737182, "o", "\u001b[?2004h> "]
[52.737319, "o", "    Strips currency symbols and thousand separators.\r\n\u001b[?2004l\r"]
[52.737357, "o", "\u001b[?2004h> "]
[52.737391, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.737427, "o", "> "]
[52.737588, "o", "    # Remove currency symbols (dollar, euro, etc.) and commas\r\n\u001b[?2004l\r"]
[52.737629, "o", "\u001b[?2004h> "]
[52.737755, "o", "    cleaned = re.sub(r'[\\$€£¥,]', '', s)\r\n\u001b[?2004l\r"]
[52.737792, "o", "\u001b[?2004h> "]
[52.737849, "o", "    return float(cleaned)\r\n\u001b[?2004l\r"]
[52.737884, "o", "\u001b[?2004h> "]
