[81.365262, "o", "\u001b[?2004h> "]
[81.365481, "o", "   - Came BEFORE the general ACCEPT rule, so matched first and dropped packets\r\n\u001b[?2004l\r"]
[81.365517, "o", "\u001b[?2004h> "]
[81.365743, "o", "   - Comment said \"Block known bad actors\" but blocked entire legitimate subnet\r\n\u001b[?2004l\r"]
[81.365758, "o", "\u001b[?2004h"]
[81.365791, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[81.365817, "o", "> "]
[81.365853, "o", "3. RULE ORDERING:\r\n\u001b[?2004l\r"]
[81.365878, "o", "\u001b[?2004h"]
[81.365908, "o", "> "]
[81.366055, "o", "   - DROP rule on line 24 came before ACCEPT rule on line 27\r\n\u001b[?2004l\r"]
[81.366082, "o", "\u001b[?2004h> "]
[81.366265, "o", "   - iptables processes rules top-to-bottom, stops at first match\r\n\u001b[?2004l\r"]
[81.366297, "o", "\u001b[?2004h> "]
[81.366466, "o", "   - Traffic was dropped before reaching the ACCEPT rule\r\n\u001b[?2004l\r"]
[81.36648, "o", "\u001b[?2004h"]
[81.366513, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[81.36654, "o", "> "]
[81.366573, "o", "FIXES APPLIED:\r\n\u001b[?2004l\r"]
[81.366604, "o", "\u001b[?2004h> \r\n"]
[81.366635, "o", "\u001b[?2004l\r\u001b[?2004h"]
[81.366677, "o", "> "]
[81.366799, "o", "1. Moved port 5000 rule to FORWARD chain (line 19):\r\n\u001b[?2004l\r"]
[81.36683, "o", "\u001b[?2004h> "]
[81.367063, "o", "   iptables -A FORWARD -s 10.200.0.0/16 -d 10.100.0.42 -p tcp --dport 5000 -j ACCEPT\r\n\u001b[?2004l\r"]
[81.367094, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[81.367126, "o", "\u001b[?2004h> "]
[81.367259, "o", "2. Removed the problematic DROP rules entirely\r\n\u001b[?2004l\r"]
[81.367289, "o", "\u001b[?2004h> "]
[81.367319, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.36735, "o", "> "]
[81.367495, "o", "3. Added bidirectional forwarding rules for return traffic:\r\n\u001b[?2004l\r"]
[81.367528, "o", "\u001b[?2004h> "]
[81.367674, "o", "   iptables -A FORWARD -i eth1 -o eth2 -j ACCEPT\r\n\u001b[?2004l\r"]
[81.367701, "o", "\u001b[?2004h"]
[81.367731, "o", "> "]
[81.367845, "o", "   iptables -A FORWARD -i eth2 -o eth1 -j ACCEPT\r\n\u001b[?2004l\r"]
[81.367877, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[81.367907, "o", "\u001b[?2004h> "]
[81.368116, "o", "4. Made destination more specific (10.100.0.42 instead of 10.100.0.0/16)\r\n\u001b[?2004l\r"]
[81.368145, "o", "\u001b[?2004h> "]
[81.368172, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.368203, "o", "> RESULT:\r\n\u001b[?2004l\r"]
[81.368234, "o", "\u001b[?2004h> "]
[81.368505, "o", "Traffic from ML inference service (10.200.0.0/16) can now reach model registry (10.100.0.42:5000)\r\n\u001b[?2004l\r"]
[81.368533, "o", "\u001b[?2004h> "]
[81.368561, "o", "EOF\r\n\u001b[?2004l\r"]
