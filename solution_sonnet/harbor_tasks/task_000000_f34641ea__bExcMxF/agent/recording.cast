[77.169953, "o", "\r\n+log_syslog=false\r\n+[auth]\r\n+auth_enabled=true\r\n+auth_provider=local\r\n+auth_session_ttl=3600\r\n+auth_timeout=30\r\n+auth_max_attempts=5\r\n+auth_lockout_duration=300\r\n+auth_password_min_length=8\r\n+auth_require_uppercase=true\r\n+auth_require_numbers=true\r\n+auth_require_special=false\r\n+auth_mfa_enabled=false\r\n+auth_jwt_secret=supersecretkey\r\n"]
[77.169994, "o", "+auth_jwt_expiry=86400\r\n+auth_refresh_token=true\r\n+auth_cookie_secure=true\r\n+[features]\r\n+feature_signup=true\r\n+feature_oauth=true\r\n+feature_api=true\r\n+feature_webhooks=false\r\n+feature_notifications=true\r\n+feature_analytics=true\r\n+feature_reports=false\r\n+feature_import=true\r\n+feature_bulk_ops=false\r\n+feature_audit_log=true\r\n+feature_rate_limit=true\r\n+feature_maintenance=false\r\n+feature_beta=false\r\n+feature_experimental=false\r\n"]
[77.170033, "o", "+feature_legacy_api=true\r\n+feature_dark_mode=true\r\n+feature_export=csv,json\r\n"]
