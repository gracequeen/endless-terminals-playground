[76.394133, "i", "cat > .git/hooks/pre-commit << 'EOF'\n#!/bin/bash\n# Pre-commit hook to block world-readable private keys\n# WARNING: This hook can be bypassed with 'git commit --no-verify'\n# For production repositories, ensure server-side hooks (pre-receive/update) are also in place\n\necho \"[pre-commit] Checking for world-readable private keys...\"\n\n# Get list of staged files\nstaged_files=$(git diff --cached --name-only --diff-filter=ACM)\n\nexit_code=0\n\nfor file in $staged_files; do\n    # Check if file matches *.pem or *.key\n    if [[ \"$file\" == *.pem ]] || [[ \"$file\" == *.key ]]; then\n        # Check if file exists in working tree\n        if [ -f \"$file\" ]; then\n            # Get file permissions\n            perms=$(stat -c \"%a\" \"$file\")\n            \n            # Check if permissions are too permissive (anything other than 600 or 400)\n            # Private keys should be 600 (rw-------) or 400 (r--------)\n            if [ \"$perms\" != \"600\" ] && [ \"$perms\" != \"400\" ]; then\n                echo \"ERROR: $file has insecure permissi"]
[76.39425, "i", "ons ($perms).\"\n                echo \"       Private keys must have permissions 0600 or 0400 (owner-only access).\"\n                echo \"       Current permissions allow group/world access.\"\n                echo \"       Fix with: chmod 600 $file\"\n                exit_code=1\n            fi\n        fi\n    fi\ndone\n\nif [ $exit_code -ne 0 ]; then\n    echo \"\"\n    echo \"COMMIT BLOCKED: Fix the permissions above before committing.\"\n    echo \"WARNING: Do NOT use --no-verify to bypass this check!\"\n    echo \"         Using --no-verify bypasses security checks and may expose private keys.\"\nfi\n\nexit $exit_code\nEOF\n"]
