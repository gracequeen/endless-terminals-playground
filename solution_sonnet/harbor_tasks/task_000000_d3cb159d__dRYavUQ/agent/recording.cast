[143.967613, "o", "> "]
[143.967811, "o", "- Blocks commits where private keys have permissions other than 0600 or 0400\r\n\u001b[?2004l\r"]
[143.96786, "o", "\u001b[?2004h> "]
[143.968066, "o", "- **WARNING**: Can be bypassed with `git commit --no-verify` (DO NOT USE)\r\n\u001b[?2004l\r"]
[143.968095, "o", "\u001b[?2004h> "]
[143.968121, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[143.968148, "o", "> "]
[143.968196, "o", "### 2. Pre-push Hook  \r\n\u001b[?2004l\r"]
[143.96823, "o", "\u001b[?2004h> "]
[143.96842, "o", "- Scans all commits being pushed for insecure private key permissions\r\n\u001b[?2004l\r"]
[143.968452, "o", "\u001b[?2004h"]
[143.968484, "o", "> "]
[143.9687, "o", "- Checks the actual file mode stored in git (not just filesystem permissions)\r\n\u001b[?2004l\r"]
[143.968731, "o", "\u001b[?2004h> "]
[143.968925, "o", "- Provides a second line of defense if pre-commit was bypassed\r\n\u001b[?2004l\r"]
[143.968955, "o", "\u001b[?2004h> "]
[143.969083, "o", "- Cannot be bypassed as easily as pre-commit\r\n\u001b[?2004l\r"]
[143.969111, "o", "\u001b[?2004h> "]
[143.969142, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.969214, "o", "### 3. Pre-receive Hook\r\n\u001b[?2004l\r"]
