[143.967247, "o", "\u001b[?2004h> "]
[143.967307, "o", "### 1. Pre-commit Hook\r\n\u001b[?2004l\r"]
[143.967334, "o", "\u001b[?2004h"]
[143.967362, "o", "> "]
[143.967555, "o", "- Checks staged files matching `*.pem` or `*.key` for insecure permissions\r\n\u001b[?2004l\r"]
