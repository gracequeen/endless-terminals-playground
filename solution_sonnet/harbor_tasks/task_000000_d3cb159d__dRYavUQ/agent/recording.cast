[54.482432, "i", "cat > .git/hooks/pre-receive << 'EOF'\n#!/bin/bash\n# Pre-receive hook to block world-readable private keys\n# This runs server-side and cannot be bypassed with --no-verify\n\nwhile read oldrev newrev refname; do\n    # Get list of all commits being pushed\n    if [ \"$oldrev\" = \"0000000000000000000000000000000000000000\" ]; then\n        # New branch, check all commits\n        commit_range=\"$newrev\"\n    else\n        # Existing branch, check new commits\n        commit_range=\"$oldrev..$newrev\"\n    fi\n\n    # Check each commit in the range\n    for commit in $(git rev-list $commit_range); do\n        # Get files added or modified in this commit\n        files=$(git diff-tree --no-commit-id --name-only --diff-filter=AM -r $commit)\n        \n        for file in $files; do\n            # Check if file matches *.pem or *.key\n            if [[ \"$file\" == *.pem ]] || [[ \"$file\" == *.key ]]; then\n                # Get file content from the commit\n                if git cat-file -e $commit:\"$file\" 2>/dev/null; then\n                   "]
[54.482577, "i", " # Check file mode from git (not filesystem)\n                    mode=$(git ls-tree $commit \"$file\" | awk '{print $1}')\n                    # Convert octal mode to decimal for comparison\n                    # Git stores mode as 100644, 100755, etc.\n                    # Extract last 3 digits\n                    perms=${mode: -3}\n                    \n                    # Check if world-readable (other has read permission)\n                    other_perms=$((perms % 10))\n                    group_perms=$(((perms / 10) % 10))\n                    \n                    # Check if other or group has read permission (bit 4)\n                    if [ $((other_perms & 4)) -ne 0 ]; then\n                        echo \"ERROR: Commit $commit contains world-readable key file: $file (mode $mode)\"\n                        echo \"Private keys must have permissions 0600 or 0400.\"\n                        echo \"Fix: chmod 600 $file && git add $file && git commit --amend\"\n                        exit 1\n                    fi\n         "]
[54.482617, "o", "cat > .git/hooks/pre-receive << 'EOF'\r\n\u001b[?2004l\r"]
[54.482659, "i", "           \n                    if [ $((group_perms & 4)) -ne 0 ]; then\n                        echo \"ERROR: Commit $commit contains group-readable key file: $file (mode $mode)\"\n                        echo \"Private keys must have permissions 0600 or 0400.\"\n                        echo \"Fix: chmod 600 $file && git add $file && git commit --amend\"\n                        exit 1\n                    fi\n                fi\n            fi\n        done\n    done\ndone\n\nexit 0\nEOF\n"]
