[232.305001, "o", "echo \"ROOT CAUSE: jenkins-bot bypassed pre-commit hook using --no-verify flag\"\r\n\u001b[?2004l\r"]
[232.305056, "o", "ROOT CAUSE: jenkins-bot bypassed pre-commit hook using --no-verify flag\r\n"]
