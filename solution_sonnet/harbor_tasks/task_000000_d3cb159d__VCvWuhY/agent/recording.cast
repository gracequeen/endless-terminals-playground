[110.370445, "o", "git add test.key\r\n"]
[110.370493, "o", "\u001b[?2004l\r"]
[110.372481, "o", "\u001b[?2004h"]
[110.372528, "o", "user@b7869e42860b:~/infra-configs$ "]
[110.472858, "i", "git commit --no-verify -m \"test bypass with post-commit hook\"\n"]
[110.473155, "o", "git commit --no-verify -m \"test bypass with post-commit hook\"\r\n\u001b[?2004l\r"]
[110.478599, "o", "[Security Check] Validating committed files...\r\n"]
[110.484698, "o", "\r\n"]
[110.484769, "o", "========================================\r\nSECURITY ERROR DETECTED!\r\n========================================\r\nFile: test.key\r\nPermissions: 644 (world-readable)\r\nCommit: e4308c4a4c3f8d3bfae7550fbd53c7a3af1de142\r\n\r\n"]
[110.484829, "o", "Private keys must NOT be world-readable!\r\nThis commit contains a security violation.\r\n\r\nTo fix this issue:\r\n  1. Reset the commit: git reset --soft HEAD~1\r\n"]
[110.484865, "o", "  2. Fix permissions: chmod 600 test.key\r\n  3. Re-stage: git add test.key\r\n  4. Commit again: git commit\r\n========================================\r\n"]
[110.484905, "o", "\r\n"]
[110.484937, "o", "WARNING: Commit completed but contains security violations!\r\nPlease fix immediately before pushing.\r\n"]
[110.485242, "o", "[master e4308c4] test bypass with post-commit hook\r\n"]
[110.485313, "o", " 1 file changed, 1 insertion(+)\r\n create mode 100644 test.key\r\n"]
