[103.678734, "o", "\u001b[?2004h"]
[103.678762, "o", "> "]
[103.67884, "o", "# Get the commit that was just made\r\n\u001b[?2004l\r"]
[103.678869, "o", "\u001b[?2004h"]
[103.678905, "o", "> "]
[103.678984, "o", "commit_hash=$(git rev-parse HEAD)\r\n\u001b[?2004l\r"]
[103.679015, "o", "\u001b[?2004h"]
[103.679049, "o", "> \r\n\u001b[?2004l\r"]
[103.679079, "o", "\u001b[?2004h> "]
[103.679174, "o", "# Get list of files in the commit\r\n\u001b[?2004l\r"]
[103.679207, "o", "\u001b[?2004h> "]
[103.679413, "o", "files=$(git diff-tree --no-commit-id --name-only -r \"$commit_hash\")\r\n\u001b[?2004l\r"]
[103.679447, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[103.679481, "o", "\u001b[?2004h> "]
[103.679514, "o", "exit_code=0\r\n\u001b[?2004l\r"]
[103.679544, "o", "\u001b[?2004h> "]
[103.679576, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.679644, "o", "for file in $files; do\r\n\u001b[?2004l\r"]
[103.679676, "o", "\u001b[?2004h> "]
[103.679809, "o", "    # Check if file matches *.pem or *.key\r\n\u001b[?2004l\r"]
[103.679842, "o", "\u001b[?2004h> "]
[103.680017, "o", "    if [[ \"$file\" == *.pem ]] || [[ \"$file\" == *.key ]]; then\r\n\u001b[?2004l\r"]
[103.680048, "o", "\u001b[?2004h"]
[103.68008, "o", "> "]
[103.680167, "o", "        # Get file mode from git object\r\n\u001b[?2004l\r"]
[103.680204, "o", "\u001b[?2004h> "]
[103.680408, "o", "        mode=$(git ls-tree \"$commit_hash\" \"$file\" | awk '{print $1}')\r\n\u001b[?2004l\r"]
[103.680442, "o", "\u001b[?2004h> "]
[103.680578, "o", "        # Extract permission bits (last 3 digits)\r\n\u001b[?2004l\r"]
[103.68061, "o", "\u001b[?2004h> "]
[103.680681, "o", "        perms=${mode: -3}\r\n\u001b[?2004l\r"]
[103.680711, "o", "\u001b[?2004h> "]
[103.680739, "o", "        \r\n"]
[103.680767, "o", "\u001b[?2004l\r\u001b[?2004h"]
[103.680798, "o", "> "]
[103.680911, "o", "        # Check if world-readable (644 or looser)\r\n\u001b[?2004l\r"]
[103.680943, "o", "\u001b[?2004h> "]
[103.681046, "o", "        if [ \"$perms\" -ge 644 ]; then\r\n\u001b[?2004l\r"]
[103.681077, "o", "\u001b[?2004h> "]
[103.681195, "o", "            other_read=$((perms % 10))\r\n\u001b[?2004l\r"]
[103.681226, "o", "\u001b[?2004h> "]
[103.681266, "o", "            \r\n\u001b[?2004l\r"]
[103.681313, "o", "\u001b[?2004h> "]
[103.681453, "o", "            if [ $((other_read & 4)) -ne 0 ]; then\r\n\u001b[?2004l\r"]
[103.681484, "o", "\u001b[?2004h> "]
[103.681564, "o", "                echo \"\" >&2\r\n\u001b[?2004l\r"]
[103.681595, "o", "\u001b[?2004h> "]
[103.681788, "o", "                echo \"========================================\" >&2\r\n\u001b[?2004l\r"]
[103.68182, "o", "\u001b[?2004h> "]
[103.681966, "o", "                echo \"SECURITY ERROR DETECTED!\" >&2\r\n\u001b[?2004l\r"]
[103.681998, "o", "\u001b[?2004h> "]
[103.682191, "o", "                echo \"========================================\" >&2\r\n\u001b[?2004l\r"]
[103.682223, "o", "\u001b[?2004h> "]
[103.682348, "o", "                echo \"File: $file\" >&2\r\n\u001b[?2004l\r"]
[103.682376, "o", "\u001b[?2004h"]
[103.682412, "o", "> "]
[103.682559, "o", "                echo \"Permissions: $perms (world-readable)\" >&2\r\n\u001b[?2004l\r"]
[103.682593, "o", "\u001b[?2004h> "]
[103.682721, "o", "                echo \"Commit: $commit_hash\" >&2\r\n\u001b[?2004l\r"]
[103.682752, "o", "\u001b[?2004h> "]
[103.682829, "o", "                echo \"\" >&2\r\n\u001b[?2004l\r"]
[103.682858, "o", "\u001b[?2004h> "]
[103.683054, "o", "                echo \"Private keys must NOT be world-readable!\" >&2\r\n\u001b[?2004l\r"]
[103.683089, "o", "\u001b[?2004h> "]
[103.683297, "o", "                echo \"This commit contains a security violation.\" >&2\r\n\u001b[?2004l\r"]
[103.683329, "o", "\u001b[?2004h> "]
[103.683411, "o", "                echo \"\" >&2\r\n\u001b[?2004l\r"]
[103.683442, "o", "\u001b[?2004h> "]
[103.683569, "o", "                echo \"To fix this issue:\" >&2\r\n\u001b[?2004l\r"]
[103.683597, "o", "\u001b[?2004h"]
[103.683633, "o", "> "]
[103.683805, "o", "                echo \"  1. Reset the commit: git reset --soft HEAD~1\" >&2\r\n\u001b[?2004l\r"]
[103.683837, "o", "\u001b[?2004h> "]
[103.684016, "o", "                echo \"  2. Fix permissions: chmod 600 $file\" >&2\r\n\u001b[?2004l\r"]
[103.684048, "o", "\u001b[?2004h> "]
[103.684203, "o", "                echo \"  3. Re-stage: git add $file\" >&2\r\n\u001b[?2004l\r"]
[103.684235, "o", "\u001b[?2004h> "]
[103.684411, "o", "                echo \"  4. Commit again: git commit\" >&2\r\n\u001b[?2004l\r"]
[103.684451, "o", "\u001b[?2004h> "]
[103.684629, "o", "                echo \"========================================\" >&2\r\n\u001b[?2004l\r"]
[103.684662, "o", "\u001b[?2004h> "]
[103.684737, "o", "                exit_code=1\r\n\u001b[?2004l\r"]
[103.684767, "o", "\u001b[?2004h> "]
[103.68481, "o", "            fi\r\n\u001b[?2004l\r"]
[103.684843, "o", "\u001b[?2004h> "]
[103.684871, "o", "        fi\r\n\u001b[?2004l\r"]
[103.684903, "o", "\u001b[?2004h> "]
[103.684935, "o", "    fi\r\n\u001b[?2004l\r"]
[103.684965, "o", "\u001b[?2004h> done\r\n"]
[103.684997, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[103.685028, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.685117, "o", "if [ $exit_code -ne 0 ]; then\r\n\u001b[?2004l\r"]
[103.685149, "o", "\u001b[?2004h> "]
[103.685193, "o", "    echo \"\" >&2\r\n\u001b[?2004l\r"]
[103.685225, "o", "\u001b[?2004h> "]
[103.685453, "o", "    echo \"WARNING: Commit completed but contains security violations!\" >&2\r\n\u001b[?2004l\r"]
[103.685486, "o", "\u001b[?2004h> "]
[103.685637, "o", "    echo \"Please fix immediately before pushing.\" >&2\r\n\u001b[?2004l\r"]
[103.685668, "o", "\u001b[?2004h> "]
[103.6857, "o", "    exit 1\r\n\u001b[?2004l\r"]
[103.685731, "o", "\u001b[?2004h> "]
[103.685763, "o", "fi\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.685794, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[103.685827, "o", "> exit 0\r\n\u001b[?2004l\r"]
[103.685855, "o", "\u001b[?2004h> "]
[103.685887, "o", "EOF\r\n\u001b[?2004l\r"]
[103.686965, "o", "\u001b[?2004h"]
[103.687002, "o", "user@b7869e42860b:~/infra-configs$ "]
[110.055809, "i", "chmod +x .git/hooks/post-commit\n"]
[110.055962, "o", "chmod +x .git/hooks/post-commit\r\n"]
