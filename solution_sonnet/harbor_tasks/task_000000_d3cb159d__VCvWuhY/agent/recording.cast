[103.677629, "i", "cat > .git/hooks/post-commit << 'EOF'\n#!/bin/bash\n# Post-commit hook to validate no world-readable private keys were committed\n# This runs after commit and cannot be bypassed with --no-verify\n\necho \"[Security Check] Validating committed files...\"\n\n# Get the commit that was just made\ncommit_hash=$(git rev-parse HEAD)\n\n# Get list of files in the commit\nfiles=$(git diff-tree --no-commit-id --name-only -r \"$commit_hash\")\n\nexit_code=0\n\nfor file in $files; do\n    # Check if file matches *.pem or *.key\n    if [[ \"$file\" == *.pem ]] || [[ \"$file\" == *.key ]]; then\n        # Get file mode from git object\n        mode=$(git ls-tree \"$commit_hash\" \"$file\" | awk '{print $1}')\n        # Extract permission bits (last 3 digits)\n        perms=${mode: -3}\n        \n        # Check if world-readable (644 or looser)\n        if [ \"$perms\" -ge 644 ]; then\n            other_read=$((perms % 10))\n            \n            if [ $((other_read & 4)) -ne 0 ]; then\n                echo \"\" >&2\n                echo \"========================="]
[103.677731, "i", "===============\" >&2\n                echo \"SECURITY ERROR DETECTED!\" >&2\n                echo \"========================================\" >&2\n                echo \"File: $file\" >&2\n                echo \"Permissions: $perms (world-readable)\" >&2\n                echo \"Commit: $commit_hash\" >&2\n                echo \"\" >&2\n                echo \"Private keys must NOT be world-readable!\" >&2\n                echo \"This commit contains a security violation.\" >&2\n                echo \"\" >&2\n                echo \"To fix this issue:\" >&2\n                echo \"  1. Reset the commit: git reset --soft HEAD~1\" >&2\n                echo \"  2. Fix permissions: chmod 600 $file\" >&2\n                echo \"  3. Re-stage: git add $file\" >&2\n                echo \"  4. Commit again: git commit\" >&2\n                echo \"========================================\" >&2\n                exit_code=1\n            fi\n        fi\n    fi\ndone\n\nif [ $exit_code -ne 0 ]; then\n    echo \"\" >&2\n    echo \"WARNING: Commit completed but contains security v"]
[103.677764, "i", "iolations!\" >&2\n    echo \"Please fix immediately before pushing.\" >&2\n    exit 1\nfi\n\nexit 0\nEOF\n"]
[103.677794, "o", "cat > .git/hooks/post-commit << 'EOF'\r\n"]
[103.677825, "o", "\u001b[?2004l\r"]
