[144.832195, "i", "cat > .git/hooks/pre-push << 'EOF'\n#!/bin/bash\n# Pre-push hook to validate no world-readable private keys\n# Additional safety layer before pushing to remote\n\necho \"[Security Check] Scanning repository for insecure key files before push...\"\n\nremote=\"$1\"\nurl=\"$2\"\n\nexit_code=0\n\n# Check all .key and .pem files in the current working tree\nwhile IFS= read -r -d '' file; do\n    if [ -f \"$file\" ]; then\n        perms=$(stat -c \"%a\" \"$file\")\n        if [ \"$perms\" -ge 644 ]; then\n            other_read=$((perms % 10))\n            if [ $((other_read & 4)) -ne 0 ]; then\n                echo \"ERROR: $file has world-readable permissions ($perms)\" >&2\n                echo \"       Private keys must be 600 or 400\" >&2\n                exit_code=1\n            fi\n        fi\n    fi\ndone < <(find . -type f \\( -name \"*.key\" -o -name \"*.pem\" \\) -print0 2>/dev/null)\n\nif [ $exit_code -ne 0 ]; then\n    echo \"\" >&2\n    echo \"Push rejected: Fix file permissions before pushing\" >&2\n    echo \"Use: chmod 600 <filename>\" >&2\n    exit 1\nfi\n\nec"]
[144.832339, "i", "ho \"[Security Check] All key files have secure permissions\"\nexit 0\nEOF\n"]
