[89.093717, "i", "cat > .git/hooks/pre-receive << 'EOF'\n#!/bin/bash\n# Pre-receive hook to block world-readable private keys\n# This cannot be bypassed with --no-verify\n\nwhile read oldrev newrev refname; do\n    # Get list of all files in the new commit(s)\n    if [ \"$oldrev\" = \"0000000000000000000000000000000000000000\" ]; then\n        # New branch, check all files\n        files=$(git ls-tree -r --name-only \"$newrev\")\n    else\n        # Existing branch, check changed files\n        files=$(git diff --name-only \"$oldrev\" \"$newrev\")\n    fi\n\n    for file in $files; do\n        # Check if file matches *.pem or *.key\n        if [[ \"$file\" == *.pem ]] || [[ \"$file\" == *.key ]]; then\n            # Get file mode from git object\n            mode=$(git ls-tree \"$newrev\" \"$file\" | awk '{print $1}')\n            # Extract permission bits (last 3 digits)\n            perms=${mode: -3}\n            \n            # Check if world-readable or group-readable (anything >= 640)\n            if [ \"$perms\" -ge 640 ]; then\n                other_read=$((perms "]
[89.09386, "i", "% 10))\n                group_read=$(((perms / 10) % 10))\n                \n                if [ $((other_read & 4)) -ne 0 ]; then\n                    echo \"ERROR: $file has world-readable permissions ($perms) in commit $newrev\"\n                    echo \"Private keys must not be world-readable. Fix permissions and try again.\"\n                    exit 1\n                fi\n                if [ $((group_read & 4)) -ne 0 ] && [ \"$perms\" -ge 644 ]; then\n                    echo \"ERROR: $file has group-readable permissions ($perms) in commit $newrev\"\n                    echo \"Private keys should be 600 or 400. Fix permissions and try again.\"\n                    exit 1\n                fi\n            fi\n        fi\n    done\ndone\n\nexit 0\nEOF\n"]
