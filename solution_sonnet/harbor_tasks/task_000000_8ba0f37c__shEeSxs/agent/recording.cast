[7.303998, "o", "total 12\r\n"]
[7.304024, "o", "drwxrwxrwx 1 user user 4096 May  5 17:40 .\r\ndrwxrwxrwx 1 user user 4096 May  5 17:41 ..\r\n-rw-r--r-- 1 user user  468 May  5 17:40 target_iptables.txt\r\n"]
