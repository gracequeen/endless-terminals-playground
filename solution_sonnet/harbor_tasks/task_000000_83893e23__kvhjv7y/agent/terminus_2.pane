[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> """
[?2004l[?2004h> Capacity Forecasting Pipeline
[?2004l[?2004h> 
[?2004l[?2004h> Loads host metrics and reservation data, rolls up to weekly totals,
[?2004l[?2004h> fits a growth curve, and projects forward.
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> 
[?2004l[?2004h> # Paths
[?2004l[?2004h> BASE_DIR = Path(__file__).parent
[?2004l[?2004h> DATA_DIR = BASE_DIR / "data"
[?2004l[?2004h> OUTPUT_DIR = BASE_DIR / "output"
[?2004l[?2004h> 
[?2004l[?2004h> HOSTS_CSV = DATA_DIR / "hosts.csv"
[?2004l[?2004h> RESERVATIONS_CSV = DATA_DIR / "reservations.csv"
[?2004l[?2004h> OUTPUT_CSV = OUTPUT_DIR / "forecast.csv"
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def exponential_growth(x, a, b, c):
[?2004l[?2004h>     """Exponential growth model: y = a * exp(b * x) + c"""
[?2004l[?2004h>     return a * np.exp(b * x) + c
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def load_data():
[?2004l[?2004h>     """Load host metrics and reservation data."""
[?2004l[?2004h>     print("Loading hosts.csv...")
[?2004l[?2004h>     hosts = pd.read_csv(HOSTS_CSV)
[?2004l[?2004h>     hosts['timestamp'] = pd.to_datetime(hosts['timestamp'])
[?2004l[?2004h> 
[?2004l[?2004h>     print("Loading reservations.csv...")
[?2004l[?2004h>     reservations = pd.read_csv(RESERVATIONS_CSV)
[?2004l[?2004h>     reservations['start_time'] = pd.to_datetime(reservations['start_time'])
[?2004l[?2004h>     reservations['end_time'] = pd.to_datetime(reservations['end_time'])
[?2004l[?2004h> 
[?2004l[?2004h>     return hosts, reservations
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def enrich_metrics_with_reservations(hosts, reservations):
[?2004l[?2004h>     """Merge host metrics with reservation context for enriched analysis."""
[?2004l[?2004h>     # FIX: The original merge was creating duplicates by joining each metric
[?2004l[?2004h>     # with ALL reservations for that host. For capacity forecasting, we need
[?2004l[?2004h>     # to count each metric's cpu_hours exactly once, regardless of reservations.
[?2004l[?2004h>     # 
[?2004l[?2004h>     # The reservation data is metadata that shouldn't affect the cpu_hours totals.
[?2004l[?2004h>     # Simply return the hosts data - no merge needed to avoid duplication.
[?2004l[?2004h>     return hosts
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def compute_weekly_totals(data):
[?2004l[?2004h>     """Aggregate metrics to weekly totals."""
[?2004l[?2004h>     # Extract ISO week number
[?2004l[?2004h>     data = data.copy()
[?2004l[?2004h>     data['week'] = data['timestamp'].dt.isocalendar().week
[?2004l[?2004h> 
[?2004l[?2004h>     # Sum cpu_hours by week
[?2004l[?2004h>     weekly = data.groupby('week')['cpu_hours'].sum().reset_index()
[?2004l[?2004h>     weekly.columns = ['week', 'cpu_hours']
[?2004l[?2004h> 
[?2004l[?2004h>     return weekly
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def fit_growth_curve(weekly):
[?2004l[?2004h>     """Fit exponential growth curve to weekly data."""
[?2004l[?2004h>     x = weekly['week'].values
[?2004l[?2004h>     y = weekly['cpu_hours'].values
[?2004l[?2004h> 
[?2004l[?2004h>     # Initial guess for parameters
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt, _ = curve_fit(
[?2004l[?2004h>             exponential_growth,
[?2004l[?2004h>             x, y,
[?2004l[?2004h>             p0=[1, 0.01, y.mean()],
[?2004l[?2004h>             maxfev=10000,
[?2004l[?2004h>             bounds=([0, -0.1, 0], [np.inf, 0.5, np.inf])
[?2004l[?2004h>         )
[?2004l[?2004h>     except RuntimeError:
[?2004l[?2004h>         # Fallback to linear if exponential doesn't converge
[?2004l[?2004h>         popt = [0, 0, y.mean()]
[?2004l[?2004h> 
[?2004l[?2004h>     return popt
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def generate_forecast(weekly, params, weeks_ahead=8):
[?2004l[?2004h>     """Generate forecast for future weeks."""
[?2004l[?2004h>     last_week = weekly['week'].max()
[?2004l[?2004h> 
[?2004l[?2004h>     # Historical data
[?2004l[?2004h>     historical = weekly.copy()
[?2004l[?2004h>     historical['type'] = 'historical'
[?2004l[?2004h> 
[?2004l[?2004h>     # Forecast data
[?2004l[?2004h>     forecast_weeks = list(range(last_week + 1, last_week + weeks_ahead + 1))
[?2004l[?2004h>     forecast_values = [exponential_growth(w, *params) for w in forecast_weeks]
[?2004l[?2004h> 
[?2004l[?2004h>     forecast = pd.DataFrame({
[?2004l[?2004h>         'week': forecast_weeks,
[?2004l[?2004h>         'cpu_hours': forecast_values,
[?2004l[?2004h>         'type': ['forecast'] * len(forecast_weeks)
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h>     # Combine
[?2004l[?2004h>     result = pd.concat([historical, forecast], ignore_index=True)
[?2004l[?2004h> 
[?2004l[?2004h>     return result
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     """Main pipeline."""
[?2004l[?2004h>     print("=" * 50)
[?2004l[?2004h>     print("Capacity Forecasting Pipeline")
[?2004l[?2004h>     print("=" * 50)
[?2004l[?2004h> 
[?2004l[?2004h>     # Load data
[?2004l[?2004h>     hosts, reservations = load_data()
[?2004l[?2004h>     print(f"Loaded {len(hosts)} host metric records")
[?2004l[?2004h>     print(f"Loaded {len(reservations)} reservation records")
[?2004l[?2004h> 
[?2004l[?2004h>     # Enrich metrics with reservation data
[?2004l[?2004h>     print("\nEnriching metrics with reservation context...")
[?2004l[?2004h>     enriched = enrich_metrics_with_reservations(hosts, reservations)
[?2004l[?2004h>     print(f"Enriched dataset has {len(enriched)} records")
[?2004l[?2004h> 
[?2004l[?2004h>     # Compute weekly totals
[?2004l[?2004h>     print("\nComputing weekly totals...")
[?2004l[?2004h>     weekly = compute_weekly_totals(enriched)
[?2004l[?2004h>     print(f"Generated {len(weekly)} weekly data points")
[?2004l[?2004h> 
[?2004l[?2004h>     # Fit growth curve
[?2004l[?2004h>     print("\nFitting growth curve...")
[?2004l[?2004h>     params = fit_growth_curve(weekly)
[?2004l[?2004h>     print(f"Model parameters: a={params[0]:.4f}, b={params[1]:.6f}, c={params[2]:.2f}")
[?2004l[?2004h> 
[?2004l[?2004h>     # Generate forecast
[?2004l[?2004h>     print("\nGenerating 8-week forecast...")
[?2004l[?2004h>     result = generate_forecast(weekly, params)
[?2004l[?2004h> 
[?2004l[?2004h>     # Save output
[?2004l[?2004h>     OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
[?2004l[?2004h>     result.to_csv(OUTPUT_CSV, index=False)
[?2004l[?2004h>     print(f"\nForecast saved to {OUTPUT_CSV}")
[?2004l[?2004h> 
[?2004l[?2004h>     # Summary
[?2004l[?2004h>     print("\n" + "=" * 50)
[?2004l[?2004h>     print("Summary")
[?2004l[?2004h>     print("=" * 50)
[?2004l[?2004h>     q4_weeks = weekly[weekly['week'] >= 40]
[?2004l[?2004h>     print(f"Q4 average (weeks 40-52): {q4_weeks['cpu_hours'].mean():.1f} cpu_hours/week")
[?2004l[?2004h>     print(f"Last week ({weekly['week'].max()}): {weekly['cpu_hours'].iloc[-1]:.1f} cpu_hours")
[?2004l[?2004h>     forecast_only = result[result['type'] == 'forecast']
[?2004l[?2004h>     print(f"Forecast range: {forecast_only['cpu_hours'].min():.1f} - {forecast_only['cpu_hours'].max():.1f} cpu_hours")
[?2004l[?2004h> 
[?2004l[?2004h> 
