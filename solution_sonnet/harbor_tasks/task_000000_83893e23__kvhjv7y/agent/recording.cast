[123.699857, "o", "            p0=[1, 0.01, y.mean()],\r\n\u001b[?2004l\r"]
[123.699888, "o", "\u001b[?2004h> "]
[123.69996, "o", "            maxfev=10000,\r\n\u001b[?2004l\r"]
[123.699986, "o", "\u001b[?2004h> "]
[123.700148, "o", "            bounds=([0, -0.1, 0], [np.inf, 0.5, np.inf])\r\n\u001b[?2004l\r"]
[123.700176, "o", "\u001b[?2004h> "]
[123.700208, "o", "        )\r\n\u001b[?2004l\r"]
[123.700235, "o", "\u001b[?2004h> "]
[123.70031, "o", "    except RuntimeError:\r\n\u001b[?2004l\r"]
[123.700337, "o", "\u001b[?2004h> "]
[123.700509, "o", "        # Fallback to linear if exponential doesn't converge\r\n\u001b[?2004l\r"]
[123.700536, "o", "\u001b[?2004h> "]
[123.700629, "o", "        popt = [0, 0, y.mean()]\r\n\u001b[?2004l\r"]
[123.700665, "o", "\u001b[?2004h> "]
[123.700692, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.700718, "o", "> "]
[123.700749, "o", "    return popt\r\n\u001b[?2004l\r"]
[123.700777, "o", "\u001b[?2004h"]
[123.700803, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[123.700833, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[123.700864, "o", "> "]
[123.700996, "o", "def generate_forecast(weekly, params, weeks_ahead=8):\r\n\u001b[?2004l\r"]
[123.701023, "o", "\u001b[?2004h> "]
[123.701154, "o", "    \"\"\"Generate forecast for future weeks.\"\"\"\r\n\u001b[?2004l\r"]
[123.701181, "o", "\u001b[?2004h> "]
[123.701288, "o", "    last_week = weekly['week'].max()\r\n\u001b[?2004l\r"]
[123.701319, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[123.701346, "o", "\u001b[?2004h> "]
[123.701413, "o", "    # Historical data\r\n\u001b[?2004l\r"]
[123.701439, "o", "\u001b[?2004h> "]
[123.70153, "o", "    historical = weekly.copy()\r\n\u001b[?2004l\r"]
[123.701556, "o", "\u001b[?2004h> "]
[123.701676, "o", "    historical['type'] = 'historical'\r\n\u001b[?2004l\r"]
[123.701703, "o", "\u001b[?2004h> "]
[123.70173, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.701762, "o", "> "]
[123.701795, "o", "    # Forecast data\r\n\u001b[?2004l\r"]
[123.701825, "o", "\u001b[?2004h> "]
[123.702037, "o", "    forecast_weeks = list(range(last_week + 1, last_week + weeks_ahead + 1))\r\n\u001b[?2004l\r"]
[123.702064, "o", "\u001b[?2004h> "]
[123.702285, "o", "    forecast_values = [exponential_growth(w, *params) for w in forecast_weeks]\r\n\u001b[?2004l\r"]
[123.702317, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[123.702348, "o", "\u001b[?2004h> "]
[123.702434, "o", "    forecast = pd.DataFrame({\r\n\u001b[?2004l\r"]
[123.702465, "o", "\u001b[?2004h> "]
[123.702554, "o", "        'week': forecast_weeks,\r\n\u001b[?2004l\r"]
[123.70258, "o", "\u001b[?2004h> "]
[123.702699, "o", "        'cpu_hours': forecast_values,\r\n\u001b[?2004l\r"]
[123.702724, "o", "\u001b[?2004h"]
[123.70275, "o", "> "]
[123.702872, "o", "        'type': ['forecast'] * len(forecast_weeks)\r\n\u001b[?2004l\r"]
[123.702894, "o", "\u001b[?2004h"]
[123.702924, "o", ">     })\r\n\u001b[?2004l\r"]
[123.702948, "o", "\u001b[?2004h"]
[123.702975, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[123.703006, "o", "> "]
[123.703032, "o", "    # Combine\r\n\u001b[?2004l\r"]
[123.703058, "o", "\u001b[?2004h> "]
[123.70324, "o", "    result = pd.concat([historical, forecast], ignore_index=True)\r\n\u001b[?2004l\r"]
[123.70327, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[123.703297, "o", "\u001b[?2004h"]
[123.703323, "o", "> "]
[123.703355, "o", "    return result\r\n\u001b[?2004l\r"]
[123.703387, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[123.703426, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[123.703454, "o", "\u001b[?2004h> "]
[123.703495, "o", "def main():\r\n\u001b[?2004l\r"]
[123.703526, "o", "\u001b[?2004h> "]
[123.703598, "o", "    \"\"\"Main pipeline.\"\"\"\r\n\u001b[?2004l\r"]
[123.703624, "o", "\u001b[?2004h> "]
[123.703695, "o", "    print(\"=\" * 50)\r\n\u001b[?2004l\r"]
[123.703727, "o", "\u001b[?2004h> "]
[123.703846, "o", "    print(\"Capacity Forecasting Pipeline\")\r\n\u001b[?2004l\r"]
[123.703876, "o", "\u001b[?2004h> "]
[123.703934, "o", "    print(\"=\" * 50)\r\n\u001b[?2004l\r"]
[123.703964, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[123.703991, "o", "\u001b[?2004h"]
[123.704022, "o", "> "]
[123.704048, "o", "    # Load data\r\n\u001b[?2004l\r"]
[123.704077, "o", "\u001b[?2004h> "]
[123.704181, "o", "    hosts, reservations = load_data()\r\n\u001b[?2004l\r"]
[123.704211, "o", "\u001b[?2004h> "]
[123.70436, "o", "    print(f\"Loaded {len(hosts)} host metric records\")\r\n\u001b[?2004l\r"]
[123.704392, "o", "\u001b[?2004h> "]
[123.704561, "o", "    print(f\"Loaded {len(reservations)} reservation records\")\r\n\u001b[?2004l\r"]
[123.704588, "o", "\u001b[?2004h> "]
[123.704614, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.704654, "o", "> "]
[123.704755, "o", "    # Enrich metrics with reservation data\r\n\u001b[?2004l\r"]
[123.704778, "o", "\u001b[?2004h"]
[123.704803, "o", "> "]
[123.704956, "o", "    print(\"\\nEnriching metrics with reservation context...\")\r\n\u001b[?2004l\r"]
[123.704987, "o", "\u001b[?2004h> "]
[123.705178, "o", "    enriched = enrich_metrics_with_reservations(hosts, reservations)\r\n\u001b[?2004l\r"]
[123.705203, "o", "\u001b[?2004h"]
[123.705238, "o", "> "]
[123.705377, "o", "    print(f\"Enriched dataset has {len(enriched)} records\")\r\n\u001b[?2004l\r"]
[123.7054, "o", "\u001b[?2004h> "]
[123.705434, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.705518, "o", "    # Compute weekly totals\r\n\u001b[?2004l\r"]
[123.705542, "o", "\u001b[?2004h> "]
[123.705674, "o", "    print(\"\\nComputing weekly totals...\")\r\n\u001b[?2004l\r"]
[123.705699, "o", "\u001b[?2004h"]
[123.705724, "o", "> "]
[123.705834, "o", "    weekly = compute_weekly_totals(enriched)\r\n\u001b[?2004l\r"]
[123.705867, "o", "\u001b[?2004h> "]
[123.706024, "o", "    print(f\"Generated {len(weekly)} weekly data points\")\r\n\u001b[?2004l\r"]
[123.706055, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[123.706085, "o", "\u001b[?2004h> "]
[123.706153, "o", "    # Fit growth curve\r\n\u001b[?2004l\r"]
[123.706186, "o", "\u001b[?2004h> "]
[123.706294, "o", "    print(\"\\nFitting growth curve...\")\r\n\u001b[?2004l\r"]
[123.706324, "o", "\u001b[?2004h> "]
[123.706429, "o", "    params = fit_growth_curve(weekly)\r\n\u001b[?2004l\r"]
[123.706455, "o", "\u001b[?2004h> "]
[123.706717, "o", "    print(f\"Model parameters: a={params[0]:.4f}, b={params[1]:.6f}, c={params[2]:.2f}\")\r\n\u001b[?2004l\r"]
[123.706755, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[123.706786, "o", "\u001b[?2004h> "]
[123.706849, "o", "    # Generate forecast\r\n\u001b[?2004l\r"]
[123.70688, "o", "\u001b[?2004h> "]
[123.707005, "o", "    print(\"\\nGenerating 8-week forecast...\")\r\n\u001b[?2004l\r"]
[123.707036, "o", "\u001b[?2004h> "]
[123.707167, "o", "    result = generate_forecast(weekly, params)\r\n\u001b[?2004l\r"]
[123.707195, "o", "\u001b[?2004h> "]
[123.707225, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.707256, "o", "> "]
[123.707283, "o", "    # Save output\r\n\u001b[?2004l\r"]
[123.707315, "o", "\u001b[?2004h> "]
[123.707464, "o", "    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[123.707493, "o", "\u001b[?2004h> "]
[123.707614, "o", "    result.to_csv(OUTPUT_CSV, index=False)\r\n\u001b[?2004l\r"]
[123.707654, "o", "\u001b[?2004h> "]
[123.707797, "o", "    print(f\"\\nForecast saved to {OUTPUT_CSV}\")\r\n\u001b[?2004l\r"]
[123.70782, "o", "\u001b[?2004h"]
[123.70785, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[123.70788, "o", "> "]
[123.707903, "o", "    # Summary\r\n\u001b[?2004l\r"]
[123.707929, "o", "\u001b[?2004h"]
[123.707953, "o", "> "]
[123.708009, "o", "    print(\"\\n\" + \"=\" * 50)\r\n\u001b[?2004l\r"]
[123.708035, "o", "\u001b[?2004h> "]
[123.708099, "o", "    print(\"Summary\")\r\n\u001b[?2004l\r"]
[123.708129, "o", "\u001b[?2004h> "]
[123.708185, "o", "    print(\"=\" * 50)\r\n\u001b[?2004l\r"]
[123.708217, "o", "\u001b[?2004h> "]
[123.708338, "o", "    q4_weeks = weekly[weekly['week'] >= 40]\r\n\u001b[?2004l\r"]
[123.708365, "o", "\u001b[?2004h> "]
[123.708617, "o", "    print(f\"Q4 average (weeks 40-52): {q4_weeks['cpu_hours'].mean():.1f} cpu_hours/week\")\r\n\u001b[?2004l\r"]
[123.708652, "o", "\u001b[?2004h> "]
[123.70892, "o", "    print(f\"Last week ({weekly['week'].max()}): {weekly['cpu_hours'].iloc[-1]:.1f} cpu_hours\")\r\n\u001b[?2004l\r"]
[123.70895, "o", "\u001b[?2004h> "]
[123.709111, "o", "    forecast_only = result[result['type'] == 'forecast']\r\n\u001b[?2004l\r"]
[123.709138, "o", "\u001b[?2004h> "]
[123.709475, "o", "    print(f\"Forecast range: {forecast_only['cpu_hours'].min():.1f} - {forecast_only['cpu_hours'].max():.1f} cpu_hours\")\r\n\u001b[?2004l\r"]
[123.709502, "o", "\u001b[?2004h> "]
[123.709527, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.709557, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[123.709586, "o", "> "]
[123.709661, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[123.709685, "o", "\u001b[?2004h> "]
[123.709722, "o", "    main()\r\n\u001b[?2004l\r"]
[123.709749, "o", "\u001b[?2004h> "]
[123.709785, "o", "SCRIPT_EOF\r\n\u001b[?2004l\r"]
