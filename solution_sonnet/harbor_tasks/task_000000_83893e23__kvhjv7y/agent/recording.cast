[88.167117, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r"]
[88.16715, "o", "\u001b[?2004h> "]
[88.167252, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[88.167289, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.167318, "o", "\u001b[?2004h> "]
[88.167357, "o", "# Paths\r\n\u001b[?2004l\r"]
[88.167389, "o", "\u001b[?2004h> "]
[88.167534, "o", "BASE_DIR = Path(__file__).parent\r\n\u001b[?2004l\r"]
[88.167569, "o", "\u001b[?2004h> "]
[88.167703, "o", "DATA_DIR = BASE_DIR / \"data\"\r\n\u001b[?2004l\r"]
[88.167739, "o", "\u001b[?2004h> "]
[88.167877, "o", "OUTPUT_DIR = BASE_DIR / \"output\"\r\n\u001b[?2004l\r"]
[88.167914, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.167946, "o", "\u001b[?2004h> "]
[88.168087, "o", "HOSTS_CSV = DATA_DIR / \"hosts.csv\"\r\n\u001b[?2004l\r"]
[88.16812, "o", "\u001b[?2004h> "]
[88.168299, "o", "RESERVATIONS_CSV = DATA_DIR / \"reservations.csv\"\r\n\u001b[?2004l\r"]
[88.168334, "o", "\u001b[?2004h> "]
[88.168505, "o", "OUTPUT_CSV = OUTPUT_DIR / \"forecast.csv\"\r\n\u001b[?2004l\r"]
[88.168535, "o", "\u001b[?2004h> \r\n"]
[88.168567, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[88.168598, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.16863, "o", "> "]
[88.168779, "o", "def exponential_growth(x, a, b, c):\r\n\u001b[?2004l\r"]
[88.168813, "o", "\u001b[?2004h> "]
[88.169046, "o", "    \"\"\"Exponential growth model: y = a * exp(b * x) + c\"\"\"\r\n\u001b[?2004l\r"]
[88.169079, "o", "\u001b[?2004h> "]
[88.16921, "o", "    return a * np.exp(b * x) + c\r\n\u001b[?2004l\r"]
[88.169243, "o", "\u001b[?2004h> "]
[88.169278, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.169309, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.169384, "o", "def load_data():\r\n\u001b[?2004l\r"]
[88.169416, "o", "\u001b[?2004h> "]
[88.16962, "o", "    \"\"\"Load host metrics and reservation data.\"\"\"\r\n\u001b[?2004l\r"]
[88.169673, "o", "\u001b[?2004h> "]
[88.169808, "o", "    print(\"Loading hosts.csv...\")\r\n\u001b[?2004l\r"]
[88.169836, "o", "\u001b[?2004h> "]
[88.169984, "o", "    hosts = pd.read_csv(HOSTS_CSV)\r\n\u001b[?2004l\r"]
[88.170017, "o", "\u001b[?2004h> "]
[88.170256, "o", "    hosts['timestamp'] = pd.to_datetime(hosts['timestamp'])\r\n\u001b[?2004l\r"]
[88.170291, "o", "\u001b[?2004h> "]
[88.170326, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.170492, "o", "    print(\"Loading reservations.csv...\")\r\n\u001b[?2004l\r"]
[88.170524, "o", "\u001b[?2004h> "]
[88.170737, "o", "    reservations = pd.read_csv(RESERVATIONS_CSV)\r\n\u001b[?2004l\r"]
[88.170772, "o", "\u001b[?2004h> "]
[88.171069, "o", "    reservations['start_time'] = pd.to_datetime(reservations['start_time'])\r\n\u001b[?2004l\r"]
[88.171104, "o", "\u001b[?2004h> "]
[88.171385, "o", "    reservations['end_time'] = pd.to_datetime(reservations['end_time'])\r\n\u001b[?2004l\r"]
[88.171426, "o", "\u001b[?2004h> "]
[88.171461, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.171589, "o", "    return hosts, reservations\r\n\u001b[?2004l\r"]
[88.171623, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.171666, "o", "\u001b[?2004h> "]
[88.171695, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.171726, "o", "> "]
[88.171954, "o", "def enrich_metrics_with_reservations(hosts, reservations):\r\n\u001b[?2004l\r"]
[88.171986, "o", "\u001b[?2004h> "]
[88.172293, "o", "    \"\"\"Merge host metrics with reservation context for enriched analysis.\"\"\"\r\n\u001b[?2004l\r"]
[88.17232, "o", "\u001b[?2004h> "]
[88.172638, "o", "    # FIX: Only join reservations that are active during the metric timestamp\r\n\u001b[?2004l\r"]
[88.172694, "o", "\u001b[?2004h"]
[88.172726, "o", "> "]
[88.173001, "o", "    # to avoid duplication. Use a conditional merge where timestamp is between\r\n\u001b[?2004l\r"]
[88.173029, "o", "\u001b[?2004h> "]
[88.173159, "o", "    # start_time and end_time.\r\n\u001b[?2004l\r"]
[88.173191, "o", "\u001b[?2004h> "]
[88.173221, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[88.173253, "o", "> "]
[88.173357, "o", "    # Create a cross join with conditions\r\n\u001b[?2004l\r"]
[88.173393, "o", "\u001b[?2004h> "]
[88.173448, "o", "    hosts['key'] = 1\r\n\u001b[?2004l\r"]
[88.173481, "o", "\u001b[?2004h> "]
[88.173559, "o", "    reservations['key'] = 1\r\n\u001b[?2004l\r"]
[88.173594, "o", "\u001b[?2004h> "]
[88.173625, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[88.173665, "o", "> "]
[88.173737, "o", "    # Merge all combinations\r\n\u001b[?2004l\r"]
[88.173768, "o", "\u001b[?2004h> "]
[88.17398, "o", "    merged = pd.merge(hosts, reservations, on='key', suffixes=('', '_res'))\r\n\u001b[?2004l\r"]
[88.174007, "o", "\u001b[?2004h> "]
[88.174035, "o", "    \r\n\u001b[?2004l\r"]
[88.174066, "o", "\u001b[?2004h> "]
[88.174254, "o", "    # Filter to only rows where timestamp is within reservation period\r\n\u001b[?2004l\r"]
[88.174282, "o", "\u001b[?2004h> "]
[88.17435, "o", "    merged = merged[\r\n\u001b[?2004l\r"]
[88.174383, "o", "\u001b[?2004h> "]
[88.174534, "o", "        (merged['timestamp'] >= merged['start_time']) & \r\n\u001b[?2004l\r"]
[88.174565, "o", "\u001b[?2004h> "]
[88.174726, "o", "        (merged['timestamp'] <= merged['end_time'])\r\n\u001b[?2004l\r"]
[88.174762, "o", "\u001b[?2004h> "]
[88.174798, "o", "    ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.174838, "o", ">     \r\n\u001b[?2004l\r"]
[88.174869, "o", "\u001b[?2004h> "]
[88.175018, "o", "    # Drop the temporary key and reservation time columns\r\n\u001b[?2004l\r"]
[88.175046, "o", "\u001b[?2004h> "]
[88.175238, "o", "    merged = merged.drop(columns=['key', 'start_time', 'end_time'])\r\n\u001b[?2004l\r"]
[88.175272, "o", "\u001b[?2004h> "]
[88.175303, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[88.175331, "o", "> "]
[88.175541, "o", "    # Drop duplicates to ensure each host metric timestamp appears only once\r\n\u001b[?2004l\r"]
[88.175578, "o", "\u001b[?2004h> "]
[88.175853, "o", "    # (a metric might fall within multiple reservations, but we only need it once for cpu_hours)\r\n\u001b[?2004l\r"]
[88.175885, "o", "\u001b[?2004h> "]
[88.17611, "o", "    merged = merged.drop_duplicates(subset=['host_id', 'timestamp', 'cpu_hours'])\r\n\u001b[?2004l\r"]
[88.176142, "o", "\u001b[?2004h> "]
[88.176172, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[88.176203, "o", "> "]
[88.176241, "o", "    return merged\r\n\u001b[?2004l\r"]
[88.176273, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.1763, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.176326, "o", "\u001b[?2004h"]
[88.176357, "o", "> "]
[88.176425, "o", "def compute_weekly_totals(data):\r\n\u001b[?2004l\r"]
[88.176456, "o", "\u001b[?2004h> "]
[88.176585, "o", "    \"\"\"Aggregate metrics to weekly totals.\"\"\"\r\n\u001b[?2004l\r"]
[88.176616, "o", "\u001b[?2004h> "]
[88.176733, "o", "    # Extract ISO week number\r\n\u001b[?2004l\r"]
[88.176768, "o", "\u001b[?2004h> "]
[88.176847, "o", "    data = data.copy()\r\n\u001b[?2004l\r"]
[88.176879, "o", "\u001b[?2004h> "]
[88.177042, "o", "    data['week'] = data['timestamp'].dt.isocalendar().week\r\n\u001b[?2004l\r"]
[88.177075, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.177103, "o", "\u001b[?2004h> "]
[88.177187, "o", "    # Sum cpu_hours by week\r\n\u001b[?2004l\r"]
[88.177219, "o", "\u001b[?2004h> "]
[88.177403, "o", "    weekly = data.groupby('week')['cpu_hours'].sum().reset_index()\r\n\u001b[?2004l\r"]
[88.177435, "o", "\u001b[?2004h> "]
[88.177555, "o", "    weekly.columns = ['week', 'cpu_hours']\r\n\u001b[?2004l\r"]
[88.177587, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.177619, "o", "\u001b[?2004h> "]
[88.177688, "o", "    return weekly\r\n\u001b[?2004l\r"]
[88.177721, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.177752, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.177784, "o", "\u001b[?2004h> "]
[88.17787, "o", "def fit_growth_curve(weekly):\r\n\u001b[?2004l\r"]
[88.177902, "o", "\u001b[?2004h> "]
[88.178056, "o", "    \"\"\"Fit exponential growth curve to weekly data.\"\"\"\r\n\u001b[?2004l\r"]
[88.178087, "o", "\u001b[?2004h> "]
[88.178172, "o", "    x = weekly['week'].values\r\n\u001b[?2004l\r"]
[88.178203, "o", "\u001b[?2004h> "]
[88.178302, "o", "    y = weekly['cpu_hours'].values\r\n\u001b[?2004l\r"]
[88.178332, "o", "\u001b[?2004h> "]
[88.178359, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.17839, "o", "> "]
[88.178468, "o", "    # Initial guess for parameters\r\n\u001b[?2004l\r"]
[88.178498, "o", "\u001b[?2004h> "]
[88.178528, "o", "    try:\r\n\u001b[?2004l\r"]
[88.17856, "o", "\u001b[?2004h> "]
[88.178641, "o", "        popt, _ = curve_fit(\r\n\u001b[?2004l\r"]
[88.178689, "o", "\u001b[?2004h> "]
[88.178776, "o", "            exponential_growth,\r\n\u001b[?2004l\r"]
[88.178807, "o", "\u001b[?2004h> "]
[88.178859, "o", "            x, y,\r\n\u001b[?2004l\r"]
[88.178891, "o", "\u001b[?2004h> "]
[88.178995, "o", "            p0=[1, 0.01, y.mean()],\r\n\u001b[?2004l\r"]
[88.179033, "o", "\u001b[?2004h> "]
[88.179101, "o", "            maxfev=10000,\r\n\u001b[?2004l\r"]
[88.179134, "o", "\u001b[?2004h> "]
[88.179289, "o", "            bounds=([0, -0.1, 0], [np.inf, 0.5, np.inf])\r\n\u001b[?2004l\r"]
[88.179321, "o", "\u001b[?2004h> "]
[88.179352, "o", "        )\r\n\u001b[?2004l\r"]
[88.179383, "o", "\u001b[?2004h> "]
[88.179465, "o", "    except RuntimeError:\r\n\u001b[?2004l\r"]
[88.179479, "o", "\u001b[?2004h"]
[88.179575, "o", "> "]
[88.17968, "o", "        # Fallback to linear if exponential doesn't converge\r\n\u001b[?2004l\r"]
[88.179719, "o", "\u001b[?2004h> "]
[88.179801, "o", "        popt = [0, 0, y.mean()]\r\n\u001b[?2004l\r"]
[88.179836, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.179868, "o", "\u001b[?2004h> "]
[88.179913, "o", "    return popt\r\n\u001b[?2004l\r"]
[88.179945, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.179976, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.180011, "o", "\u001b[?2004h> "]
[88.180155, "o", "def generate_forecast(weekly, params, weeks_ahead=8):\r\n\u001b[?2004l\r"]
[88.18019, "o", "\u001b[?2004h> "]
[88.180312, "o", "    \"\"\"Generate forecast for future weeks.\"\"\"\r\n\u001b[?2004l\r"]
[88.180351, "o", "\u001b[?2004h> "]
[88.18045, "o", "    last_week = weekly['week'].max()\r\n\u001b[?2004l\r"]
[88.180483, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.180513, "o", "\u001b[?2004h> "]
[88.180575, "o", "    # Historical data\r\n\u001b[?2004l\r"]
[88.180609, "o", "\u001b[?2004h> "]
[88.180705, "o", "    historical = weekly.copy()\r\n\u001b[?2004l\r"]
[88.180741, "o", "\u001b[?2004h> "]
[88.180843, "o", "    historical['type'] = 'historical'\r\n\u001b[?2004l\r"]
[88.180875, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.180902, "o", "\u001b[?2004h"]
[88.180933, "o", "> "]
[88.180964, "o", "    # Forecast data\r\n\u001b[?2004l\r"]
[88.180995, "o", "\u001b[?2004h> "]
[88.181208, "o", "    forecast_weeks = list(range(last_week + 1, last_week + weeks_ahead + 1))\r\n\u001b[?2004l\r"]
[88.181239, "o", "\u001b[?2004h> "]
[88.181456, "o", "    forecast_values = [exponential_growth(w, *params) for w in forecast_weeks]\r\n\u001b[?2004l\r"]
[88.181488, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.181515, "o", "\u001b[?2004h> "]
[88.181603, "o", "    forecast = pd.DataFrame({\r\n\u001b[?2004l\r"]
[88.181631, "o", "\u001b[?2004h> "]
[88.181745, "o", "        'week': forecast_weeks,\r\n\u001b[?2004l\r"]
[88.181776, "o", "\u001b[?2004h> "]
[88.181878, "o", "        'cpu_hours': forecast_values,\r\n\u001b[?2004l\r"]
[88.181905, "o", "\u001b[?2004h"]
[88.181931, "o", "> "]
[88.182055, "o", "        'type': ['forecast'] * len(forecast_weeks)\r\n\u001b[?2004l\r"]
[88.182086, "o", "\u001b[?2004h> "]
[88.182112, "o", "    })\r\n\u001b[?2004l\r"]
[88.182139, "o", "\u001b[?2004h> "]
[88.182166, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.182193, "o", "> "]
[88.182218, "o", "    # Combine\r\n\u001b[?2004l\r"]
[88.182247, "o", "\u001b[?2004h> "]
[88.182428, "o", "    result = pd.concat([historical, forecast], ignore_index=True)\r\n\u001b[?2004l\r"]
[88.182459, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.182491, "o", "\u001b[?2004h> "]
[88.182544, "o", "    return result\r\n\u001b[?2004l\r"]
[88.182575, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.182603, "o", "\u001b[?2004h> "]
[88.182634, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.18269, "o", "def main():\r\n\u001b[?2004l\r"]
[88.182721, "o", "\u001b[?2004h> "]
[88.182792, "o", "    \"\"\"Main pipeline.\"\"\"\r\n\u001b[?2004l\r"]
[88.18282, "o", "\u001b[?2004h> "]
[88.18288, "o", "    print(\"=\" * 50)\r\n\u001b[?2004l\r"]
[88.182911, "o", "\u001b[?2004h> "]
[88.18303, "o", "    print(\"Capacity Forecasting Pipeline\")\r\n\u001b[?2004l\r"]
[88.183058, "o", "\u001b[?2004h> "]
[88.18312, "o", "    print(\"=\" * 50)\r\n\u001b[?2004l\r"]
[88.183164, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.183201, "o", "\u001b[?2004h> "]
[88.183229, "o", "    # Load data\r\n\u001b[?2004l\r"]
[88.18326, "o", "\u001b[?2004h> "]
[88.183367, "o", "    hosts, reservations = load_data()\r\n\u001b[?2004l\r"]
[88.183409, "o", "\u001b[?2004h> "]
[88.183558, "o", "    print(f\"Loaded {len(hosts)} host metric records\")\r\n\u001b[?2004l\r"]
[88.183589, "o", "\u001b[?2004h> "]
[88.183777, "o", "    print(f\"Loaded {len(reservations)} reservation records\")\r\n\u001b[?2004l\r"]
[88.183812, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.18384, "o", "\u001b[?2004h> "]
[88.183963, "o", "    # Enrich metrics with reservation data\r\n\u001b[?2004l\r"]
[88.183995, "o", "\u001b[?2004h> "]
[88.184165, "o", "    print(\"\\nEnriching metrics with reservation context...\")\r\n\u001b[?2004l\r"]
[88.184197, "o", "\u001b[?2004h> "]
[88.184388, "o", "    enriched = enrich_metrics_with_reservations(hosts, reservations)\r\n\u001b[?2004l\r"]
[88.184422, "o", "\u001b[?2004h> "]
[88.184588, "o", "    print(f\"Enriched dataset has {len(enriched)} records\")\r\n\u001b[?2004l\r"]
[88.184622, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.18467, "o", "\u001b[?2004h> "]
[88.184742, "o", "    # Compute weekly totals\r\n\u001b[?2004l\r"]
[88.184781, "o", "\u001b[?2004h"]
[88.184815, "o", "> "]
[88.184891, "o", "    print(\"\\nComputing weekly totals...\")\r\n\u001b[?2004l\r"]
[88.184926, "o", "\u001b[?2004h> "]
[88.185046, "o", "    weekly = compute_weekly_totals(enriched)\r\n\u001b[?2004l\r"]
[88.185081, "o", "\u001b[?2004h"]
[88.185117, "o", "> "]
[88.185233, "o", "    print(f\"Generated {len(weekly)} weekly data points\")\r\n\u001b[?2004l\r"]
[88.185266, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.185301, "o", "\u001b[?2004h> "]
[88.185361, "o", "    # Fit growth curve\r\n\u001b[?2004l\r"]
[88.185396, "o", "\u001b[?2004h> "]
[88.185499, "o", "    print(\"\\nFitting growth curve...\")\r\n\u001b[?2004l\r"]
[88.185534, "o", "\u001b[?2004h> "]
[88.185635, "o", "    params = fit_growth_curve(weekly)\r\n\u001b[?2004l\r"]
[88.185682, "o", "\u001b[?2004h> "]
[88.185923, "o", "    print(f\"Model parameters: a={params[0]:.4f}, b={params[1]:.6f}, c={params[2]:.2f}\")\r\n\u001b[?2004l\r"]
[88.185957, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.185993, "o", "\u001b[?2004h"]
[88.186025, "o", "> "]
