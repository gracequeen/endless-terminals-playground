[175.538412, "o", "echo '\\n=== FIXED RULES ==='\r\n"]
[175.538471, "o", "\u001b[?2004l\r\\n=== FIXED RULES ===\r\n"]
[175.538512, "o", "\u001b[?2004h"]
[175.538543, "o", "root@d2d5f4ce02d5:/home/user/firewall# "]
[175.642293, "i", "cat rules.sh\n"]
[175.642406, "o", "cat rules.sh\r\n\u001b[?2004l\r"]
[175.643285, "o", "#!/bin/bash\r\n# Flush existing rules\r\niptables -F\r\niptables -t nat -F\r\n\r\n# Default policies\r\niptables -P INPUT DROP\r\niptables -P FORWARD DROP\r\niptables -P OUTPUT ACCEPT\r\n\r\n# Allow established connections\r\niptables -A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT\r\niptables -A FORWARD -m state --state ESTABLISHED,RELATED -j ACCEPT\r\n\r\n# Allow SSH to gateway\r\niptables -A INPUT -p tcp --dport 22 -j ACCEPT\r\n\r\n# Allow inference subnet to registry on port 5000 (FIXED: moved to FORWARD chain)\r\niptables -A FORWARD -s 10.200.0.0/16 -d 10.100.0.42 -p tcp --dport 5000 -j ACCEPT\r\n\r\n# NAT for outbound\r\niptables -t nat -A POSTROUTING -s 10.200.0.0/16 -o eth2 -j MASQUERADE\r\n\r\n# General forwarding between inference and registry networks\r\niptables -A FORWARD -i eth1 -o eth2 -j ACCEPT\r\niptables -A FORWARD -i eth2 -o eth1 -j ACCEPT\r\n"]
[175.643434, "o", "\u001b[?2004h"]
