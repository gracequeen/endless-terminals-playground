[175.326446, "o", "root@d2d5f4ce02d5:/home/user/firewall# "]
[175.431477, "i", "cat rules.sh.backup\n"]
[175.431587, "o", "cat rules.sh.backup\r\n\u001b[?2004l\r"]
[175.432443, "o", "#!/bin/bash\r\n# Flush existing rules\r\niptables -F\r\niptables -t nat -F\r\n\r\n# Default policies\r\niptables -P INPUT DROP\r\niptables -P FORWARD DROP\r\niptables -P OUTPUT ACCEPT\r\n\r\n# Allow established connections\r\niptables -A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT\r\niptables -A FORWARD -m state --state ESTABLISHED,RELATED -j ACCEPT\r\n\r\n# Allow SSH to gateway\r\niptables -A INPUT -p tcp --dport 22 -j ACCEPT\r\n\r\n# Allow inference subnet to registry (THE USER'S RULE - WRONG CHAIN)\r\niptables -A INPUT -s 10.200.0.0/16 -p tcp --dport 5000 -j ACCEPT\r\n\r\n# NAT for outbound\r\niptables -t nat -A POSTROUTING -s 10.200.0.0/16 -o eth2 -j MASQUERADE\r\n\r\n# Block known bad actors\r\niptables -A FORWARD -s 10.200.0.0/16 -d 10.100.0.0/16 -j LOG --log-prefix \"FORWARD_DROP: \"\r\niptables -A FORWARD -s 10.200.0.0/16 -d 10.100.0.0/16 -j DROP\r\n\r\n# General forwarding (added later, supposedly to fix things)\r\niptables -A FORWARD -i eth1 -o eth2 -j ACCEPT\r\n"]
[175.432617, "o", "\u001b[?2004h"]
[175.432699, "o", "root@d2d5f4ce02d5:/home/user/firewall# "]
