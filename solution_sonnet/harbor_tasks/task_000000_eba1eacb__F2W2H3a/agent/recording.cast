[45.314233, "i", "cat > Makefile << 'EOF'\n.PHONY: report clean\n\n# Check if hosts.conf exists\nhosts.conf:\n\t@test -f hosts.conf || (echo \"Error: hosts.conf not found\" && exit 1)\n\n# Run ping checks\nresults/ping.txt: hosts.conf scripts/check_ping.sh\n\t@echo \"Running ping checks...\"\n\t./scripts/check_ping.sh\n\n# Run port checks\nresults/ports.txt: hosts.conf scripts/check_ports.sh\n\t@echo \"Running port checks...\"\n\t./scripts/check_ports.sh\n\n# Generate aggregated report\nresults/status.json: results/ping.txt results/ports.txt aggregate.py\n\t@echo \"Generating aggregated report...\"\n\t./aggregate.py\n\n# Main target\nreport: results/status.json\n\t@echo \"Monitoring report complete!\"\n\t@cat results/status.json\n\n# Clean up results\nclean:\n\trm -rf results/\nEOF\n"]
