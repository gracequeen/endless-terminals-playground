[275.777894, "i", "python3 << 'PYEOF'\nimport re\n\nwith open('test.log', 'r') as f:\n    lines = f.readlines()\n\nselect_times = []\nupdate_times = []\ninsert_times = []\n\ni = 0\nwhile i < len(lines):\n    if 'Query_time:' in lines[i]:\n        match = re.search(r'Query_time:\\s+(\\d+\\.\\d+)', lines[i])\n        if match:\n            query_time = float(match.group(1))\n            # Find next non-comment line\n            j = i + 1\n            while j < len(lines) and lines[j].startswith('#'):\n                j += 1\n            if j < len(lines):\n                sql = lines[j].strip()\n                if sql.startswith('SELECT'):\n                    select_times.append(query_time)\n                elif sql.startswith('UPDATE'):\n                    update_times.append(query_time)\n                elif sql.startswith('INSERT'):\n                    insert_times.append(query_time)\n    i += 1\n\nprint(f\"SELECT: {len(select_times)} queries, total = {sum(select_times):.3f}s\")\nprint(f\"UPDATE: {len(update_times)} queries, total = {sum(update_times):.3f}s\")\np"]
[275.777954, "i", "rint(f\"INSERT: {len(insert_times)} queries, total = {sum(insert_times):.3f}s\")\nPYEOF\n"]
