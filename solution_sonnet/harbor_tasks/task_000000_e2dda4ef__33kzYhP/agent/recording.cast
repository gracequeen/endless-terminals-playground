[70.174144, "o", "def get_schema_hash(schema_path):\r\n\u001b[?2004l\r"]
[70.174179, "o", "\u001b[?2004h> "]
[70.174317, "o", "    \"\"\"Compute hash of schema file for caching.\"\"\"\r\n\u001b[?2004l\r"]
[70.174345, "o", "\u001b[?2004h> "]
[70.174468, "o", "    with open(schema_path, 'rb') as f:\r\n\u001b[?2004l\r"]
[70.17449, "o", "\u001b[?2004h"]
[70.174515, "o", "> "]
[70.174633, "o", "        return hashlib.md5(f.read()).hexdigest()\r\n\u001b[?2004l\r"]
[70.174658, "o", "\u001b[?2004h"]
[70.174682, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[70.174706, "o", "> \r\n\u001b[?2004l\r"]
[70.174731, "o", "\u001b[?2004h> "]
[70.174834, "o", "def get_cached_schema(schema_path):\r\n\u001b[?2004l\r"]
[70.174862, "o", "\u001b[?2004h"]
[70.174892, "o", ">     \"\"\"\r\n\u001b[?2004l\r"]
[70.174923, "o", "\u001b[?2004h> "]
[70.17505, "o", "    Try to get preprocessed schema from cache.\r\n\u001b[?2004l\r"]
[70.175075, "o", "\u001b[?2004h"]
[70.175099, "o", "> "]
[70.175243, "o", "    This was an optimization attempt that didn't help.\r\n\u001b[?2004l\r"]
[70.175269, "o", "\u001b[?2004h> "]
[70.175294, "o", "    \"\"\"\r\n"]
[70.175322, "o", "\u001b[?2004l\r\u001b[?2004h"]
[70.175347, "o", "> "]
[70.17547, "o", "    schema_hash = get_schema_hash(schema_path)\r\n\u001b[?2004l\r"]
[70.175497, "o", "\u001b[?2004h> "]
[70.175677, "o", "    cache_file = os.path.join(CACHE_DIR, f\"{schema_hash}.json\")\r\n\u001b[?2004l\r"]
[70.17571, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.175737, "o", "\u001b[?2004h"]
[70.175765, "o", "> "]
[70.175838, "o", "    if os.path.exists(cache_file):\r\n\u001b[?2004l\r"]
[70.175864, "o", "\u001b[?2004h> "]
[70.175983, "o", "        with open(cache_file, 'r') as f:\r\n\u001b[?2004l\r"]
[70.17601, "o", "\u001b[?2004h> "]
[70.176104, "o", "            return json.load(f)\r\n\u001b[?2004l\r"]
[70.176129, "o", "\u001b[?2004h> "]
[70.176152, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.176178, "o", "> "]
[70.176242, "o", "    # Preprocess and cache\r\n\u001b[?2004l\r"]
[70.176271, "o", "\u001b[?2004h> "]
[70.176399, "o", "    schema = preprocess_schema(schema_path)\r\n\u001b[?2004l\r"]
[70.176433, "o", "\u001b[?2004h"]
[70.17646, "o", "> "]
[70.176543, "o", "    with open(cache_file, 'w') as f:\r\n\u001b[?2004l\r"]
[70.176569, "o", "\u001b[?2004h> "]
[70.176658, "o", "        json.dump(schema, f)\r\n\u001b[?2004l\r"]
[70.176689, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.176719, "o", "\u001b[?2004h> "]
[70.176768, "o", "    return schema\r\n\u001b[?2004l\r"]
[70.176802, "o", "\u001b[?2004h"]
[70.176832, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.176857, "o", "\u001b[?2004h"]
[70.176888, "o", "> "]
[70.176952, "o", "def get_validator(schema_path):\r\n\u001b[?2004l\r"]
[70.176986, "o", "\u001b[?2004h> "]
[70.177017, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[70.177043, "o", "\u001b[?2004h> "]
[70.177187, "o", "    Get a cached validator for the given schema path.\r\n\u001b[?2004l\r"]
[70.177222, "o", "\u001b[?2004h> "]
[70.177428, "o", "    This caches both the preprocessed schema and the compiled validator.\r\n\u001b[?2004l\r"]
[70.177455, "o", "\u001b[?2004h> "]
[70.177484, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[70.177511, "o", "\u001b[?2004h> "]
[70.177636, "o", "    if schema_path not in _validator_cache:\r\n\u001b[?2004l\r"]
[70.177661, "o", "\u001b[?2004h> "]
[70.177769, "o", "        # Load and preprocess schema\r\n\u001b[?2004l\r"]
[70.177792, "o", "\u001b[?2004h"]
[70.177816, "o", "> "]
[70.177932, "o", "        schema = preprocess_schema(schema_path)\r\n\u001b[?2004l\r"]
[70.177957, "o", "\u001b[?2004h"]
[70.177982, "o", "> "]
[70.178067, "o", "        # Create and cache validator\r\n\u001b[?2004l\r"]
[70.178099, "o", "\u001b[?2004h> "]
[70.178275, "o", "        _validator_cache[schema_path] = Draft7Validator(schema)\r\n\u001b[?2004l\r"]
[70.178305, "o", "\u001b[?2004h"]
[70.178331, "o", ">     \r\n\u001b[?2004l\r"]
[70.178356, "o", "\u001b[?2004h"]
[70.178379, "o", "> "]
[70.178487, "o", "    return _validator_cache[schema_path]\r\n\u001b[?2004l\r"]
[70.17851, "o", "\u001b[?2004h"]
[70.178534, "o", "> \r\n\u001b[?2004l\r"]
[70.178559, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.178584, "o", "\u001b[?2004h> "]
[70.178699, "o", "def validate_document(doc, schema_path):\r\n\u001b[?2004l\r"]
[70.178725, "o", "\u001b[?2004h"]
[70.178749, "o", ">     \"\"\"\r\n"]
[70.178774, "o", "\u001b[?2004l\r\u001b[?2004h"]
[70.178802, "o", "> "]
[70.178903, "o", "    Validate a document against a schema.\r\n\u001b[?2004l\r"]
[70.178925, "o", "\u001b[?2004h"]
[70.178951, "o", "> "]
[70.178979, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.179006, "o", "> "]
[70.179064, "o", "    # Get cached validator\r\n\u001b[?2004l\r"]
[70.179088, "o", "\u001b[?2004h"]
[70.179112, "o", "> "]
[70.179224, "o", "    validator = get_validator(schema_path)\r\n\u001b[?2004l\r"]
[70.179252, "o", "\u001b[?2004h> "]
[70.179276, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.179305, "o", "> "]
[70.179332, "o", "    # Validate\r\n\u001b[?2004l\r"]
[70.17936, "o", "\u001b[?2004h> "]
[70.1795, "o", "    errors = list(validator.iter_errors(doc))\r\n\u001b[?2004l\r"]
[70.179532, "o", "\u001b[?2004h> "]
[70.179632, "o", "    return len(errors) == 0, errors\r\n\u001b[?2004l\r"]
[70.17966, "o", "\u001b[?2004h> \r\n"]
[70.179684, "o", "\u001b[?2004l\r\u001b[?2004h"]
[70.179702, "o", "> \r\n\u001b[?2004l\r"]
[70.179739, "o", "\u001b[?2004h> "]
[70.179846, "o", "def get_schema_for_document(doc_filename):\r\n\u001b[?2004l\r"]
[70.17987, "o", "\u001b[?2004h"]
[70.179894, "o", "> "]
[70.179923, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.179955, "o", "> "]
[70.18007, "o", "    Determine which schema to use for a document.\r\n\u001b[?2004l\r"]
[70.180097, "o", "\u001b[?2004h> "]
[70.180255, "o", "    Document naming convention: doc_NNN_SCHEMANAME.json\r\n\u001b[?2004l\r"]
[70.180289, "o", "\u001b[?2004h> "]
[70.180316, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[70.18035, "o", "\u001b[?2004h> "]
[70.180465, "o", "    # Extract schema name from filename\r\n\u001b[?2004l\r"]
[70.180501, "o", "\u001b[?2004h> "]
[70.180653, "o", "    parts = doc_filename.replace('.json', '').split('_')\r\n\u001b[?2004l\r"]
[70.180681, "o", "\u001b[?2004h> "]
[70.18075, "o", "    if len(parts) >= 3:\r\n\u001b[?2004l\r"]
[70.180777, "o", "\u001b[?2004h> "]
[70.18087, "o", "        schema_name = parts[2]\r\n\u001b[?2004l\r"]
[70.180895, "o", "\u001b[?2004h"]
[70.180913, "o", "> "]
[70.181101, "o", "        schema_path = os.path.join(SCHEMAS_DIR, f\"{schema_name}.json\")\r\n\u001b[?2004l\r"]
[70.181123, "o", "\u001b[?2004h"]
[70.181148, "o", "> "]
[70.181245, "o", "        if os.path.exists(schema_path):\r\n\u001b[?2004l\r"]
[70.181277, "o", "\u001b[?2004h> "]
[70.181362, "o", "            return schema_path\r\n\u001b[?2004l\r"]
[70.181386, "o", "\u001b[?2004h"]
[70.18142, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[70.181448, "o", "> "]
[70.18153, "o", "    # Fallback to first schema\r\n\u001b[?2004l\r"]
[70.181552, "o", "\u001b[?2004h"]
[70.181577, "o", "> "]
[70.181789, "o", "    schemas = sorted([f for f in os.listdir(SCHEMAS_DIR) if f.endswith('.json')])\r\n\u001b[?2004l\r"]
[70.181817, "o", "\u001b[?2004h> "]
[70.18187, "o", "    if schemas:\r\n\u001b[?2004l\r"]
[70.181893, "o", "\u001b[?2004h"]
[70.181922, "o", "> "]
[70.182048, "o", "        return os.path.join(SCHEMAS_DIR, schemas[0])\r\n\u001b[?2004l\r"]
[70.18208, "o", "\u001b[?2004h"]
[70.182108, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.182232, "o", "    raise RuntimeError(\"No schemas found\")\r\n\u001b[?2004l\r"]
[70.182257, "o", "\u001b[?2004h"]
[70.182282, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[70.182307, "o", "> \r\n\u001b[?2004l\r"]
[70.182331, "o", "\u001b[?2004h> "]
[70.182392, "o", "def run_benchmark():\r\n\u001b[?2004l\r"]
[70.182428, "o", "\u001b[?2004h> "]
[70.182457, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[70.182482, "o", "\u001b[?2004h> "]
[70.182671, "o", "    Run the benchmark suite - validate all documents in testdata/.\r\n\u001b[?2004l\r"]
[70.182694, "o", "\u001b[?2004h"]
[70.182719, "o", "> "]
[70.182748, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.182777, "o", "> "]
[70.182854, "o", "    print(\"Starting benchmark...\")\r\n\u001b[?2004l\r"]
[70.182881, "o", "\u001b[?2004h> "]
[70.182905, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.182928, "o", "> "]
[70.182998, "o", "    # Get all test documents\r\n\u001b[?2004l\r"]
[70.183027, "o", "\u001b[?2004h"]
[70.183052, "o", "> "]
[70.183274, "o", "    test_files = sorted([f for f in os.listdir(TESTDATA_DIR) if f.endswith('.json')])\r\n\u001b[?2004l\r"]
[70.183301, "o", "\u001b[?2004h> "]
[70.183326, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.183354, "o", "> "]
[70.183405, "o", "    if not test_files:\r\n\u001b[?2004l\r"]
[70.183439, "o", "\u001b[?2004h"]
[70.183466, "o", "> "]
[70.18355, "o", "        print(\"No test files found!\")\r\n\u001b[?2004l\r"]
[70.183573, "o", "\u001b[?2004h"]
[70.183598, "o", "> "]
[70.183627, "o", "        return\r\n\u001b[?2004l\r"]
[70.183651, "o", "\u001b[?2004h> \r\n"]
[70.18368, "o", "\u001b[?2004l\r\u001b[?2004h"]
[70.183705, "o", "> "]
[70.183833, "o", "    print(f\"Found {len(test_files)} test documents\")\r\n\u001b[?2004l\r"]
[70.183861, "o", "\u001b[?2004h> "]
[70.183886, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.183911, "o", "> "]
[70.183979, "o", "    start_time = time.time()\r\n\u001b[?2004l\r"]
[70.184004, "o", "\u001b[?2004h> "]
[70.18406, "o", "    validated = 0\r\n\u001b[?2004l\r"]
[70.184095, "o", "\u001b[?2004h> "]
[70.184151, "o", "    errors_found = 0\r\n\u001b[?2004l\r"]
[70.184176, "o", "\u001b[?2004h"]
[70.184205, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[70.184239, "o", "> "]
[70.184304, "o", "    for doc_file in test_files:\r\n\u001b[?2004l\r"]
[70.184329, "o", "\u001b[?2004h> "]
[70.184498, "o", "        doc_path = os.path.join(TESTDATA_DIR, doc_file)\r\n\u001b[?2004l\r"]
[70.184534, "o", "\u001b[?2004h> "]
[70.184685, "o", "        schema_path = get_schema_for_document(doc_file)\r\n\u001b[?2004l\r"]
[70.184711, "o", "\u001b[?2004h> "]
[70.184735, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.184766, "o", "> "]
[70.184855, "o", "        with open(doc_path, 'r') as f:\r\n\u001b[?2004l\r"]
[70.184882, "o", "\u001b[?2004h> "]
[70.184974, "o", "            doc = json.load(f)\r\n\u001b[?2004l\r"]
[70.185001, "o", "\u001b[?2004h> "]
[70.185031, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.185061, "o", "> "]
[70.185204, "o", "        valid, errors = validate_document(doc, schema_path)\r\n\u001b[?2004l\r"]
[70.185231, "o", "\u001b[?2004h"]
[70.185254, "o", "> "]
[70.185302, "o", "        validated += 1\r\n\u001b[?2004l\r"]
[70.185337, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.185368, "o", "\u001b[?2004h> "]
[70.185438, "o", "        if not valid:\r\n\u001b[?2004l\r"]
[70.185472, "o", "\u001b[?2004h> "]
[70.185552, "o", "            errors_found += 1\r\n\u001b[?2004l\r"]
[70.185575, "o", "\u001b[?2004h"]
[70.185605, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[70.185634, "o", "> "]
[70.185691, "o", "    end_time = time.time()\r\n\u001b[?2004l\r"]
[70.185719, "o", "\u001b[?2004h"]
[70.185748, "o", "> "]
[70.185822, "o", "    elapsed = end_time - start_time\r\n\u001b[?2004l\r"]
[70.185848, "o", "\u001b[?2004h> "]
[70.186015, "o", "    throughput = validated / elapsed if elapsed > 0 else 0\r\n\u001b[?2004l\r"]
[70.18604, "o", "\u001b[?2004h"]
[70.186064, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[70.186097, "o", "> "]
[70.186332, "o", "    print(f\"Validated {validated} documents in {elapsed:.2f}s ({throughput:.1f} docs/sec)\")\r\n\u001b[?2004l\r"]
[70.186369, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.186395, "o", "\u001b[?2004h"]
[70.186429, "o", "> "]
[70.186482, "o", "    if errors_found > 0:\r\n\u001b[?2004l\r"]
[70.186504, "o", "\u001b[?2004h"]
[70.186529, "o", "> "]
[70.186718, "o", "        print(f\"Warning: {errors_found} documents had validation errors\")\r\n\u001b[?2004l\r"]
[70.186742, "o", "\u001b[?2004h"]
[70.186766, "o", "> \r\n\u001b[?2004l\r"]
[70.18679, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.186817, "o", "\u001b[?2004h> "]
[70.186853, "o", "def main():\r\n\u001b[?2004l\r"]
[70.186876, "o", "\u001b[?2004h"]
[70.1869, "o", "> "]
[70.187091, "o", "    parser = argparse.ArgumentParser(description='JSON Schema Validator')\r\n\u001b[?2004l\r"]
[70.187115, "o", "\u001b[?2004h"]
[70.187139, "o", "> "]
[70.187371, "o", "    parser.add_argument('--benchmark', action='store_true', help='Run benchmark suite')\r\n\u001b[?2004l\r"]
[70.187402, "o", "\u001b[?2004h"]
[70.187438, "o", "> "]
[70.187615, "o", "    parser.add_argument('--document', '-d', help='Document to validate')\r\n\u001b[?2004l\r"]
[70.187638, "o", "\u001b[?2004h"]
[70.187663, "o", "> "]
[70.187858, "o", "    parser.add_argument('--schema', '-s', help='Schema to validate against')\r\n\u001b[?2004l\r"]
[70.187885, "o", "\u001b[?2004h> "]
[70.187914, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.18794, "o", "> "]
[70.188008, "o", "    args = parser.parse_args()\r\n\u001b[?2004l\r"]
[70.188033, "o", "\u001b[?2004h"]
[70.188056, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[70.188081, "o", "> "]
[70.188138, "o", "    if args.benchmark:\r\n\u001b[?2004l\r"]
[70.188166, "o", "\u001b[?2004h> "]
[70.188237, "o", "        run_benchmark()\r\n\u001b[?2004l\r"]
[70.188264, "o", "\u001b[?2004h> "]
[70.188378, "o", "    elif args.document and args.schema:\r\n\u001b[?2004l\r"]
[70.188403, "o", "\u001b[?2004h"]
[70.188429, "o", "> "]
[70.188545, "o", "        with open(args.document, 'r') as f:\r\n\u001b[?2004l\r"]
[70.18857, "o", "\u001b[?2004h"]
[70.188595, "o", "> "]
[70.188664, "o", "            doc = json.load(f)\r\n\u001b[?2004l\r"]
[70.18869, "o", "\u001b[?2004h"]
[70.188719, "o", "> "]
[70.188862, "o", "        valid, errors = validate_document(doc, args.schema)\r\n\u001b[?2004l\r"]
[70.188884, "o", "\u001b[?2004h"]
[70.188909, "o", "> "]
[70.188943, "o", "        if valid:\r\n\u001b[?2004l\r"]
[70.188971, "o", "\u001b[?2004h> "]
[70.189082, "o", "            print(\"Document is valid\")\r\n\u001b[?2004l\r"]
[70.189105, "o", "\u001b[?2004h"]
[70.189139, "o", "> "]
[70.189169, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.189193, "o", "> "]
[70.1893, "o", "            print(\"Document is invalid:\")\r\n\u001b[?2004l\r"]
[70.189326, "o", "\u001b[?2004h> "]
[70.189431, "o", "            for err in errors:\r\n\u001b[?2004l\r"]
[70.189462, "o", "\u001b[?2004h"]
[70.189494, "o", "> "]
[70.189583, "o", "                print(f\"  - {err.message}\")\r\n\u001b[?2004l\r"]
[70.189613, "o", "\u001b[?2004h> "]
