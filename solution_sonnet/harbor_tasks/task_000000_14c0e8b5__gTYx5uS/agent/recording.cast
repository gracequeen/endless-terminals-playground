[37.513516, "i", "cat > check.py << 'EOF'\n#!/usr/bin/env python3\nimport json\nimport csv\nimport ipaddress\nimport sys\n\ndef parse_port_spec(port_spec):\n    \"\"\"Parse a port specification into a set of allowed ports.\"\"\"\n    port_spec = str(port_spec).strip()\n    if '-' in port_spec:\n        # Port range\n        start, end = port_spec.split('-')\n        return set(range(int(start), int(end) + 1))\n    else:\n        # Single port\n        return {int(port_spec)}\n\ndef check_connection(src_ip, dest_port, rules):\n    \"\"\"Check if a connection is allowed.\n    Returns (allowed, matching_rule_info)\n    \"\"\"\n    src_ip_obj = ipaddress.ip_address(src_ip)\n    dest_port = int(dest_port)\n    \n    # Sort rules by prefix length (most specific first)\n    # This ensures more specific CIDRs take precedence\n    sorted_rules = sorted(rules, \n                         key=lambda r: ipaddress.ip_network(r['source_cidr']).prefixlen,\n                         reverse=True)\n    \n    for rule in sorted_rules:\n        network = ipaddress.ip_network(rule['source_ci"]
[37.513659, "i", "dr'])\n        \n        # Check if source IP is in this CIDR\n        if src_ip_obj in network:\n            # Check if destination port matches\n            allowed_ports = parse_port_spec(rule['dest_port'])\n            if dest_port in allowed_ports:\n                # Found a matching rule\n                if rule['action'] == 'allow':\n                    return True, rule\n                else:  # deny\n                    return False, rule\n    \n    # No matching rule found - default deny\n    return False, None\n\ndef main():\n    # Load firewall rules\n    with open('/home/user/audit/firewall_rules.json', 'r') as f:\n        config = json.load(f)\n        rules = config['rules']\n    \n    # Load connections\n    with open('/home/user/audit/connections.csv', 'r') as f:\n        reader = csv.DictReader(f)\n        connections = list(reader)\n    \n    # Check each connection\n    for conn in connections:\n        src_ip = conn['src_ip']\n        dest_port = conn['dest_port']\n        \n        allowed, matching_rule = check_connec"]
