[33.690042, "i", "cat verify.sh\n"]
[33.690167, "o", "cat verify.sh\r\n\u001b[?2004l\r"]
[33.691071, "o", "#!/bin/bash\r\n\r\n# Backup verification script\r\n# Reads manifest.txt and verifies SHA256 checksums of files\r\n\r\nMANIFEST_FILE=\"/home/user/backup-check/manifest.txt\"\r\nBASE_DIR=\"/home/user/backup-check\"\r\nERRORS=0\r\n\r\necho \"Starting backup verification...\"\r\necho \"Reading manifest: $MANIFEST_FILE\"\r\necho \"\"\r\n\r\nwhile IFS= read -r line || [ -n \"$line\" ]; do\r\n    # Skip empty lines\r\n    if [ -z \"$line\" ]; then\r\n        continue\r\n    fi\r\n\r\n    # Extract expected hash (first 64 characters)\r\n    expected=$(echo \"$line\" | cut -c1-64)\r\n\r\n    # Extract file path (after two spaces following the hash)\r\n    filepath=$(echo \"$line\" | cut -c67-)\r\n\r\n    # Full path to file\r\n    fullpath=\"$BASE_DIR/$filepath\"\r\n\r\n    # Check if file exists\r\n    if [ ! -f \"$fullpath\" ]; then\r\n        echo \"MISSING: $filepath\"\r\n        ERRORS=$((ERRORS + 1))\r\n        continue\r\n    fi\r\n\r\n    # Compute actual hash\r\n"]
[33.691175, "o", "    computed=$(sha256sum \"$fullpath\" | awk '{print $1}')\r\n\r\n    # Compare hashes\r\n    if [ \"$expected\" != \"$computed\" ]; then\r\n        echo \"MISMATCH: $filepath\"\r\n        echo \"  Expected: $expected\"\r\n        echo \"  Computed: $computed\"\r\n        ERRORS=$((ERRORS + 1))\r\n    else\r\n        echo \"OK: $filepath\"\r\n    fi\r\ndone < \"$MANIFEST_FILE\"\r\n\r\necho \"\"\r\necho \"Verification complete.\"\r\n\r\nif [ $ERRORS -gt 0 ]; then\r\n    echo \"FAILED: $ERRORS file(s) failed verification.\"\r\n    exit 1\r\nelse\r\n    echo \"SUCCESS: All files verified.\"\r\n    exit 0\r\nfi\r\n"]
[33.691318, "o", "\u001b[?2004h"]
[33.691387, "o", "user@621080ab1af0:~/backup-check$ "]
[39.90399, "i", "sed -i 's/\\r$//' manifest.txt\n"]
[39.904132, "o", "sed -i 's/\\r$//' manifest.txt\r\n"]
