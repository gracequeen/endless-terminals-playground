[34.218805, "o", "    entry_bytes += struct.pack(\"<I\", len(ciphertext_with_tag))\r\n\u001b[?2004l\r"]
[34.218833, "o", "\u001b[?2004h> "]
[34.218943, "o", "    entry_bytes += ciphertext_with_tag\r\n\u001b[?2004l\r"]
[34.21898, "o", "\u001b[?2004h> "]
[34.219115, "o", "    entry_bytes += struct.pack(\"<H\", len(metadata))\r\n\u001b[?2004l\r"]
[34.219151, "o", "\u001b[?2004h> "]
[34.219223, "o", "    entry_bytes += metadata\r\n\u001b[?2004l\r"]
[34.219268, "o", "\u001b[?2004h> "]
[34.219336, "o", "    return entry_bytes\r\n\u001b[?2004l\r"]
[34.219365, "o", "\u001b[?2004h> "]
[34.219394, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.219424, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[34.219444, "o", "> "]
[34.219479, "o", "def reencrypt():\r\n\u001b[?2004l\r"]
[34.219504, "o", "\u001b[?2004h> "]
[34.219617, "o", "    \"\"\"Main re-encryption function.\"\"\"\r\n\u001b[?2004l\r"]
[34.219646, "o", "\u001b[?2004h> "]
[34.219742, "o", "    # Load keys once at the start\r\n\u001b[?2004l\r"]
[34.219767, "o", "\u001b[?2004h"]
[34.219798, "o", "> "]
[34.219882, "o", "    with open(OLD_KEY_FILE, \"rb\") as f:\r\n\u001b[?2004l\r"]
[34.219908, "o", "\u001b[?2004h> "]
[34.219986, "o", "        old_key = f.read()\r\n\u001b[?2004l\r"]
[34.220011, "o", "\u001b[?2004h"]
[34.220022, "o", "> "]
[34.220126, "o", "    with open(NEW_KEY_FILE, \"rb\") as f:\r\n\u001b[?2004l\r"]
[34.220152, "o", "\u001b[?2004h> "]
[34.22023, "o", "        new_key = f.read()\r\n\u001b[?2004l\r"]
[34.220266, "o", "\u001b[?2004h"]
[34.220281, "o", "> "]
[34.220315, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[34.220345, "o", "> "]
[34.220422, "o", "    # Compute new key_id for header\r\n\u001b[?2004l\r"]
[34.22045, "o", "\u001b[?2004h> "]
[34.220594, "o", "    new_key_id = hashlib.sha256(new_key).digest()\r\n\u001b[?2004l\r"]
[34.22062, "o", "\u001b[?2004h"]
[34.220649, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[34.22068, "o", "> "]
[34.220763, "o", "    # Open input file and read header\r\n\u001b[?2004l\r"]
[34.220789, "o", "\u001b[?2004h"]
[34.220818, "o", "> "]
[34.220916, "o", "    with open(VAULT_DUMP, \"rb\") as infile:\r\n\u001b[?2004l\r"]
[34.220941, "o", "\u001b[?2004h"]
[34.220969, "o", "> "]
[34.22104, "o", "        header = infile.read(42)\r\n\u001b[?2004l\r"]
[34.221065, "o", "\u001b[?2004h"]
[34.221093, "o", "> "]
[34.221145, "o", "        magic = header[:6]\r\n\u001b[?2004l\r"]
[34.221175, "o", "\u001b[?2004h"]
[34.221204, "o", "> "]
[34.221352, "o", "        entry_count = struct.unpack(\"<I\", header[6:10])[0]\r\n\u001b[?2004l\r"]
[34.221375, "o", "\u001b[?2004h"]
[34.221412, "o", "> "]
[34.221486, "o", "        old_key_id = header[10:42]\r\n\u001b[?2004l\r"]
[34.22152, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[34.221552, "o", "\u001b[?2004h> "]
[34.221636, "o", "        if magic != b\"VAULT1\":\r\n\u001b[?2004l\r"]
[34.221667, "o", "\u001b[?2004h> "]
[34.221826, "o", "            raise ValueError(\"Invalid vault file magic\")\r\n\u001b[?2004l\r"]
[34.221848, "o", "\u001b[?2004h"]
[34.221876, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[34.221905, "o", "> "]
[34.222049, "o", "        print(f\"Processing {entry_count} entries...\")\r\n\u001b[?2004l\r"]
[34.222073, "o", "\u001b[?2004h"]
[34.222101, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[34.222125, "o", "> "]
[34.222233, "o", "        # Open output file and write header\r\n\u001b[?2004l\r"]
[34.222273, "o", "\u001b[?2004h> "]
[34.222412, "o", "        with open(OUTPUT_FILE, \"wb\") as outfile:\r\n\u001b[?2004l\r"]
[34.22244, "o", "\u001b[?2004h"]
[34.222452, "o", "> "]
[34.222544, "o", "            outfile.write(b\"VAULT1\")\r\n\u001b[?2004l\r"]
[34.222571, "o", "\u001b[?2004h"]
[34.2226, "o", "> "]
[34.222736, "o", "            outfile.write(struct.pack(\"<I\", entry_count))\r\n\u001b[?2004l\r"]
[34.22277, "o", "\u001b[?2004h> "]
[34.222867, "o", "            outfile.write(new_key_id)\r\n\u001b[?2004l\r"]
[34.2229, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[34.222926, "o", "\u001b[?2004h> "]
[34.223061, "o", "            # Process all entries sequentially\r\n\u001b[?2004l\r"]
[34.223091, "o", "\u001b[?2004h> "]
[34.223207, "o", "            for i in range(entry_count):\r\n\u001b[?2004l\r"]
[34.223233, "o", "\u001b[?2004h> "]
[34.223428, "o", "                # Read entry from current position (no seeking!)\r\n\u001b[?2004l\r"]
[34.223455, "o", "\u001b[?2004h> "]
[34.223587, "o", "                entry = read_one_entry(infile)\r\n\u001b[?2004l\r"]
[34.223614, "o", "\u001b[?2004h> "]
[34.223667, "o", "                \r\n\u001b[?2004l\r"]
[34.223687, "o", "\u001b[?2004h"]
[34.223715, "o", "> "]
[34.22379, "o", "                if entry is None:\r\n\u001b[?2004l\r"]
[34.223813, "o", "\u001b[?2004h"]
[34.223838, "o", "> "]
[34.224, "o", "                    raise ValueError(f\"Failed to read entry {i}\")\r\n\u001b[?2004l\r"]
[34.224027, "o", "\u001b[?2004h> "]
[34.224055, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.22408, "o", "> "]
[34.224169, "o", "                # Decrypt with old key\r\n\u001b[?2004l\r"]
[34.2242, "o", "\u001b[?2004h> "]
[34.224375, "o", "                plaintext = decrypt_entry(entry, old_key)\r\n\u001b[?2004l\r"]
[34.224407, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[34.224432, "o", "\u001b[?2004h> "]
[34.224551, "o", "                # Re-encrypt with new key\r\n\u001b[?2004l\r"]
[34.224575, "o", "\u001b[?2004h"]
[34.224604, "o", "> "]
[34.224819, "o", "                new_entry_bytes = encrypt_entry(plaintext, entry[\"metadata\"], new_key)\r\n\u001b[?2004l\r"]
[34.22485, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[34.224884, "o", "\u001b[?2004h> "]
[34.225023, "o", "                # Write to output (file stays open)\r\n\u001b[?2004l\r"]
[34.225044, "o", "\u001b[?2004h"]
[34.225073, "o", "> "]
[34.225182, "o", "                outfile.write(new_entry_bytes)\r\n\u001b[?2004l\r"]
[34.225212, "o", "\u001b[?2004h"]
[34.225247, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[34.225276, "o", "> "]
[34.225376, "o", "                if (i + 1) % 10000 == 0:\r\n\u001b[?2004l\r"]
[34.225397, "o", "\u001b[?2004h"]
[34.225426, "o", "> "]
[34.2256, "o", "                    print(f\"Processed {i + 1}/{entry_count} entries\")\r\n\u001b[?2004l\r"]
[34.225626, "o", "\u001b[?2004h> "]
[34.225652, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.225681, "o", "> "]
[34.225864, "o", "    print(f\"Re-encryption complete. Output written to {OUTPUT_FILE}\")\r\n\u001b[?2004l\r"]
[34.225895, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[34.225918, "o", "\u001b[?2004h"]
[34.225944, "o", "> \r\n\u001b[?2004l\r"]
[34.225961, "o", "\u001b[?2004h> "]
[34.226052, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[34.226081, "o", "\u001b[?2004h> "]
[34.226123, "o", "    reencrypt()\r\n\u001b[?2004l\r"]
[34.226153, "o", "\u001b[?2004h"]
[34.226182, "o", "> EOF\r\n\u001b[?2004l\r"]
[34.229016, "o", "\u001b[?2004h"]
