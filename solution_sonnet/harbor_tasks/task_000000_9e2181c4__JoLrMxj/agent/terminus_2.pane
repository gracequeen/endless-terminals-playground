[?2004l[?2004hroot@74de2392a746:/home/user/rotate# cat > reencrypt.py << 'EOF'
[?2004l    # Compute new key_id for header
    new_key_id = hashlib.sha256(new_key).digest()

    # Open input file and read header
    with open(VAULT_DUMP, "rb") as infile:
        header = infile.read(42)
        magic = header[:6]
        entry_count = struct.unpack("<I", header[6:10])[0]
        old_key_id = header[10:42]

        if magic != b"VAULT1":
            raise ValueError("Invalid vault file magic")

        print(f"Processing {entry_count} entries...")

        # Open output file and write header
        with open(OUTPUT_FILE, "wb") as outfile:
            outfile.write(b"VAULT1")
            outfile.write(struct.pack("<I", entry_count))
            outfile.write(new_key_id)

            # Process all entries sequentially
            for i in range(entry_count):
                # Read entry from current position (no seeking!)
                entry = read_one_entry(infile)
                
                if entry is None:
                    raise ValueError(f"Failed to read entry {i}")

                # Decrypt with old key
                plaintext = decrypt_entry(entry, old_key)

                # Re-encrypt with new key
                new_entry_bytes = encrypt_entry(plaintext, entry["metadata"], new_key)

                # Write to output (file stays open)
                outfile.write(new_entry_bytes)

                if (i + 1) % 10000 == 0:
                    print(f"Processed {i + 1}/{entry_count} entries")

    print(f"Re-encryption complete. Output written to {OUTPUT_FILE}")


if __name__ == "__main__":
    reencrypt()
