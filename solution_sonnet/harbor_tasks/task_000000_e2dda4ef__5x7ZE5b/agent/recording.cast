[66.884378, "o", "\r\n\u001b[?2004l\r"]
[66.884415, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[66.884445, "o", "> "]
[66.884576, "o", "def preprocess_schema(schema_path):\r\n\u001b[?2004l\r"]
[66.884605, "o", "\u001b[?2004h> "]
[66.884645, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[66.884674, "o", "\u001b[?2004h> "]
[66.884939, "o", "    Preprocess schema using jq to expand $shortref to $ref.\r\n\u001b[?2004l\r"]
[66.884968, "o", "\u001b[?2004h> "]
[66.885211, "o", "    This handles our team's non-standard schema extensions.\r\n\u001b[?2004l\r"]
[66.885243, "o", "\u001b[?2004h> "]
[66.885277, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[66.885305, "o", "\u001b[?2004h> "]
[66.885555, "o", "    # jq filter to expand $shortref to proper $ref format\r\n\u001b[?2004l\r"]
[66.88559, "o", "\u001b[?2004h> "]
[66.886122, "o", "    jq_filter = 'walk(if type == \"object\" and has(\"$shortref\") then . + {\"$ref\": .[\"$shortref\"]} | del(.[\"$shortref\"]) else . end)'\r\n\u001b[?2004l\r"]
[66.88616, "o", "\u001b[?2004h> \r\n"]
[66.886186, "o", "\u001b[?2004l\r\u001b[?2004h"]
[66.886214, "o", "> "]
[66.886318, "o", "    result = subprocess.run(\r\n\u001b[?2004l\r"]
[66.886343, "o", "\u001b[?2004h"]
[66.88637, "o", "> "]
[66.886516, "o", "        ['jq', jq_filter, schema_path],\r\n\u001b[?2004l\r"]
[66.886546, "o", "\u001b[?2004h> "]
[66.88666, "o", "        capture_output=True,\r\n\u001b[?2004l\r"]
[66.886686, "o", "\u001b[?2004h"]
[66.886727, "o", "> "]
[66.886785, "o", "        text=True\r\n\u001b[?2004l\r"]
[66.886808, "o", "\u001b[?2004h"]
[66.886837, "o", ">     )"]
[66.886866, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.886894, "o", "> \r\n\u001b[?2004l\r"]
[66.886913, "o", "\u001b[?2004h"]
[66.886948, "o", "> "]
[66.887048, "o", "    if result.returncode != 0:\r\n\u001b[?2004l\r"]
[66.887077, "o", "\u001b[?2004h> "]
[66.887437, "o", "        raise RuntimeError(f\"jq preprocessing failed for {schema_path}: {result.stderr}\")\r\n\u001b[?2004l\r"]
[66.887467, "o", "\u001b[?2004h> "]
[66.887495, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.887524, "o", "> "]
[66.887652, "o", "    return json.loads(result.stdout)\r\n\u001b[?2004l\r"]
[66.887679, "o", "\u001b[?2004h> "]
[66.887705, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.887746, "o", "> \r\n\u001b[?2004l\r"]
[66.887772, "o", "\u001b[?2004h> "]
[66.887865, "o", "def get_schema_hash(schema_path):\r\n\u001b[?2004l\r"]
[66.887897, "o", "\u001b[?2004h> "]
[66.888037, "o", "    \"\"\"Compute hash of schema file for caching.\"\"\"\r\n\u001b[?2004l\r"]
[66.888063, "o", "\u001b[?2004h> "]
[66.888175, "o", "    with open(schema_path, 'rb') as f:\r\n\u001b[?2004l\r"]
[66.888201, "o", "\u001b[?2004h> "]
[66.88834, "o", "        return hashlib.md5(f.read()).hexdigest()\r\n\u001b[?2004l\r"]
[66.888364, "o", "\u001b[?2004h"]
[66.888388, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[66.888413, "o", "> \r\n\u001b[?2004l\r"]
[66.888438, "o", "\u001b[?2004h> "]
[66.888539, "o", "def get_cached_schema(schema_path):\r\n\u001b[?2004l\r"]
[66.888563, "o", "\u001b[?2004h"]
[66.888592, "o", ">     \"\"\"\r\n"]
[66.888617, "o", "\u001b[?2004l\r\u001b[?2004h"]
[66.88864, "o", "> "]
[66.888772, "o", "    Try to get preprocessed schema from cache.\r\n\u001b[?2004l\r"]
[66.888805, "o", "\u001b[?2004h> "]
[66.888957, "o", "    This was an optimization attempt that didn't help.\r\n\u001b[?2004l\r"]
[66.888983, "o", "\u001b[?2004h> "]
[66.88901, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[66.889035, "o", "\u001b[?2004h"]
[66.88906, "o", "> "]
[66.889169, "o", "    schema_hash = get_schema_hash(schema_path)\r\n\u001b[?2004l\r"]
[66.889204, "o", "\u001b[?2004h> "]
[66.889375, "o", "    cache_file = os.path.join(CACHE_DIR, f\"{schema_hash}.json\")\r\n\u001b[?2004l\r"]
[66.889402, "o", "\u001b[?2004h> "]
[66.889432, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.889458, "o", "> "]
[66.889542, "o", "    if os.path.exists(cache_file):\r\n\u001b[?2004l\r"]
[66.889571, "o", "\u001b[?2004h> "]
[66.889689, "o", "        with open(cache_file, 'r') as f:\r\n\u001b[?2004l\r"]
[66.889726, "o", "\u001b[?2004h"]
[66.889764, "o", "> "]
[66.889823, "o", "            return json.load(f)\r\n\u001b[?2004l\r"]
[66.889853, "o", "\u001b[?2004h> "]
[66.889888, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.889963, "o", "    # Preprocess and cache\r\n\u001b[?2004l\r"]
[66.889989, "o", "\u001b[?2004h> "]
[66.890114, "o", "    schema = preprocess_schema(schema_path)\r\n\u001b[?2004l\r"]
[66.890142, "o", "\u001b[?2004h> "]
[66.890247, "o", "    with open(cache_file, 'w') as f:\r\n\u001b[?2004l\r"]
[66.89028, "o", "\u001b[?2004h> "]
[66.890358, "o", "        json.dump(schema, f)\r\n\u001b[?2004l\r"]
[66.890387, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[66.890416, "o", "\u001b[?2004h> "]
[66.890471, "o", "    return schema\r\n\u001b[?2004l\r"]
[66.890499, "o", "\u001b[?2004h> "]
[66.890529, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.890557, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.890585, "o", "> "]
[66.890654, "o", "def get_validator(schema_path):\r\n\u001b[?2004l\r"]
[66.890683, "o", "\u001b[?2004h> "]
[66.890724, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[66.890751, "o", "\u001b[?2004h> "]
[66.890901, "o", "    Get a cached validator for the given schema path.\r\n\u001b[?2004l\r"]
[66.890927, "o", "\u001b[?2004h> "]
[66.89113, "o", "    This caches both the preprocessed schema and the compiled validator.\r\n\u001b[?2004l\r"]
[66.89116, "o", "\u001b[?2004h> "]
[66.891189, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[66.891218, "o", "\u001b[?2004h> "]
[66.891337, "o", "    if schema_path not in _validator_cache:\r\n\u001b[?2004l\r"]
[66.891365, "o", "\u001b[?2004h"]
[66.891394, "o", "> "]
[66.891476, "o", "        # Load and preprocess schema\r\n\u001b[?2004l\r"]
[66.89151, "o", "\u001b[?2004h> "]
[66.89164, "o", "        schema = preprocess_schema(schema_path)\r\n\u001b[?2004l\r"]
[66.891668, "o", "\u001b[?2004h> "]
[66.89179, "o", "        # Create and cache validator\r\n\u001b[?2004l\r"]
[66.891817, "o", "\u001b[?2004h> "]
[66.892, "o", "        _validator_cache[schema_path] = Draft7Validator(schema)\r\n\u001b[?2004l\r"]
[66.892026, "o", "\u001b[?2004h"]
[66.892059, "o", ">     \r\n\u001b[?2004l\r"]
[66.892084, "o", "\u001b[?2004h> "]
[66.892197, "o", "    return _validator_cache[schema_path]\r\n\u001b[?2004l\r"]
[66.892226, "o", "\u001b[?2004h> "]
[66.892252, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.892281, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[66.892307, "o", "> "]
[66.892406, "o", "def validate_document(doc, schema_path):\r\n\u001b[?2004l\r"]
[66.892438, "o", "\u001b[?2004h> "]
[66.892464, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[66.89249, "o", "\u001b[?2004h> "]
[66.892604, "o", "    Validate a document against a schema.\r\n\u001b[?2004l\r"]
[66.892633, "o", "\u001b[?2004h> "]
[66.892662, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[66.892695, "o", "\u001b[?2004h"]
[66.892741, "o", "> "]
[66.892783, "o", "    # Get cached validator\r\n\u001b[?2004l\r"]
[66.892809, "o", "\u001b[?2004h"]
[66.892834, "o", "> "]
[66.892934, "o", "    validator = get_validator(schema_path)\r\n\u001b[?2004l\r"]
[66.892962, "o", "\u001b[?2004h> "]
[66.89299, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.893017, "o", "> "]
[66.893043, "o", "    # Validate\r\n\u001b[?2004l\r"]
[66.893068, "o", "\u001b[?2004h> "]
[66.893197, "o", "    errors = list(validator.iter_errors(doc))\r\n\u001b[?2004l\r"]
[66.893231, "o", "\u001b[?2004h> "]
[66.89333, "o", "    return len(errors) == 0, errors\r\n\u001b[?2004l\r"]
[66.893352, "o", "\u001b[?2004h"]
[66.893378, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[66.893408, "o", "> \r\n\u001b[?2004l\r"]
[66.893436, "o", "\u001b[?2004h> "]
[66.893556, "o", "def get_schema_for_document(doc_filename):\r\n\u001b[?2004l\r"]
[66.893582, "o", "\u001b[?2004h> "]
[66.89361, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[66.893639, "o", "\u001b[?2004h> "]
[66.893794, "o", "    Determine which schema to use for a document.\r\n\u001b[?2004l\r"]
[66.893826, "o", "\u001b[?2004h> "]
[66.893982, "o", "    Document naming convention: doc_NNN_SCHEMANAME.json\r\n\u001b[?2004l\r"]
[66.894012, "o", "\u001b[?2004h> "]
[66.894038, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[66.894067, "o", "\u001b[?2004h> "]
[66.894181, "o", "    # Extract schema name from filename\r\n\u001b[?2004l\r"]
[66.894211, "o", "\u001b[?2004h> "]
[66.894369, "o", "    parts = doc_filename.replace('.json', '').split('_')\r\n\u001b[?2004l\r"]
[66.894393, "o", "\u001b[?2004h"]
[66.894421, "o", "> "]
[66.894471, "o", "    if len(parts) >= 3:\r\n\u001b[?2004l\r"]
[66.894501, "o", "\u001b[?2004h> "]
[66.894591, "o", "        schema_name = parts[2]\r\n\u001b[?2004l\r"]
[66.894623, "o", "\u001b[?2004h> "]
[66.894836, "o", "        schema_path = os.path.join(SCHEMAS_DIR, f\"{schema_name}.json\")\r\n\u001b[?2004l\r"]
[66.894859, "o", "\u001b[?2004h"]
[66.894883, "o", "> "]
[66.894979, "o", "        if os.path.exists(schema_path):\r\n\u001b[?2004l\r"]
[66.895007, "o", "\u001b[?2004h> "]
[66.895097, "o", "            return schema_path\r\n\u001b[?2004l\r"]
[66.895122, "o", "\u001b[?2004h"]
[66.89515, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[66.895175, "o", "> "]
[66.895249, "o", "    # Fallback to first schema\r\n\u001b[?2004l\r"]
[66.895271, "o", "\u001b[?2004h"]
[66.895299, "o", "> "]
[66.895506, "o", "    schemas = sorted([f for f in os.listdir(SCHEMAS_DIR) if f.endswith('.json')])\r\n\u001b[?2004l\r"]
[66.895529, "o", "\u001b[?2004h"]
[66.895558, "o", "> "]
[66.895586, "o", "    if schemas:\r\n\u001b[?2004l\r"]
[66.895614, "o", "\u001b[?2004h> "]
[66.895779, "o", "        return os.path.join(SCHEMAS_DIR, schemas[0])\r\n\u001b[?2004l\r"]
[66.895816, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[66.895844, "o", "\u001b[?2004h> "]
[66.895962, "o", "    raise RuntimeError(\"No schemas found\")\r\n\u001b[?2004l\r"]
[66.895992, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[66.896022, "o", "\u001b[?2004h> "]
[66.896051, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.896079, "o", "> "]
[66.896119, "o", "def run_benchmark():\r\n\u001b[?2004l\r"]
[66.896148, "o", "\u001b[?2004h> "]
[66.896177, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[66.896205, "o", "\u001b[?2004h> "]
[66.896392, "o", "    Run the benchmark suite - validate all documents in testdata/.\r\n\u001b[?2004l\r"]
[66.896422, "o", "\u001b[?2004h> "]
[66.896451, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[66.896479, "o", "\u001b[?2004h> "]
[66.896572, "o", "    print(\"Starting benchmark...\")\r\n\u001b[?2004l\r"]
[66.896595, "o", "\u001b[?2004h"]
[66.896623, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[66.896652, "o", "> "]
[66.896735, "o", "    # Get all test documents\r\n\u001b[?2004l\r"]
[66.896768, "o", "\u001b[?2004h> "]
[66.897003, "o", "    test_files = sorted([f for f in os.listdir(TESTDATA_DIR) if f.endswith('.json')])\r\n\u001b[?2004l\r"]
[66.897026, "o", "\u001b[?2004h"]
[66.897055, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[66.897082, "o", "> "]
[66.89713, "o", "    if not test_files:\r\n\u001b[?2004l\r"]
[66.897159, "o", "\u001b[?2004h> "]
[66.897267, "o", "        print(\"No test files found!\")\r\n\u001b[?2004l\r"]
[66.897295, "o", "\u001b[?2004h> "]
[66.89734, "o", "        return\r\n\u001b[?2004l\r"]
[66.897374, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[66.897402, "o", "\u001b[?2004h> "]
[66.897557, "o", "    print(f\"Found {len(test_files)} test documents\")\r\n\u001b[?2004l\r"]
[66.897585, "o", "\u001b[?2004h> "]
[66.897614, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.897644, "o", "> "]
[66.897701, "o", "    start_time = time.time()\r\n\u001b[?2004l\r"]
[66.897747, "o", "\u001b[?2004h> "]
[66.897796, "o", "    validated = 0\r\n\u001b[?2004l\r"]
[66.897825, "o", "\u001b[?2004h> "]
[66.897888, "o", "    errors_found = 0\r\n\u001b[?2004l\r"]
[66.897923, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[66.897952, "o", "\u001b[?2004h> "]
[66.89804, "o", "    for doc_file in test_files:\r\n\u001b[?2004l\r"]
[66.898064, "o", "\u001b[?2004h"]
[66.898088, "o", "> "]
[66.898224, "o", "        doc_path = os.path.join(TESTDATA_DIR, doc_file)\r\n\u001b[?2004l\r"]
[66.898245, "o", "\u001b[?2004h"]
[66.898269, "o", "> "]
[66.898408, "o", "        schema_path = get_schema_for_document(doc_file)\r\n\u001b[?2004l\r"]
[66.898436, "o", "\u001b[?2004h> "]
[66.898454, "o", "\r\n\u001b[?2004l\r"]
[66.898484, "o", "\u001b[?2004h> "]
[66.898579, "o", "        with open(doc_path, 'r') as f:\r\n\u001b[?2004l\r"]
[66.898605, "o", "\u001b[?2004h> "]
[66.898696, "o", "            doc = json.load(f)\r\n\u001b[?2004l\r"]
[66.898731, "o", "\u001b[?2004h"]
[66.898759, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[66.898784, "o", "> "]
[66.898941, "o", "        valid, errors = validate_document(doc, schema_path)\r\n\u001b[?2004l\r"]
[66.898967, "o", "\u001b[?2004h"]
[66.898995, "o", "> "]
[66.899031, "o", "        validated += 1\r\n\u001b[?2004l\r"]
[66.899056, "o", "\u001b[?2004h"]
[66.899081, "o", "> \r\n\u001b[?2004l\r"]
[66.899106, "o", "\u001b[?2004h> "]
[66.89916, "o", "        if not valid:\r\n\u001b[?2004l\r"]
[66.899186, "o", "\u001b[?2004h> "]
[66.899273, "o", "            errors_found += 1\r\n\u001b[?2004l\r"]
[66.899301, "o", "\u001b[?2004h> "]
[66.89933, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.899358, "o", "> "]
[66.899411, "o", "    end_time = time.time()\r\n\u001b[?2004l\r"]
[66.899436, "o", "\u001b[?2004h"]
[66.899459, "o", "> "]
[66.899541, "o", "    elapsed = end_time - start_time\r\n\u001b[?2004l\r"]
[66.899576, "o", "\u001b[?2004h> "]
[66.899752, "o", "    throughput = validated / elapsed if elapsed > 0 else 0\r\n\u001b[?2004l\r"]
[66.899784, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[66.899812, "o", "\u001b[?2004h> "]
[66.900065, "o", "    print(f\"Validated {validated} documents in {elapsed:.2f}s ({throughput:.1f} docs/sec)\")\r\n\u001b[?2004l\r"]
[66.900091, "o", "\u001b[?2004h"]
[66.900116, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[66.900145, "o", "> "]
[66.900201, "o", "    if errors_found > 0:\r\n\u001b[?2004l\r"]
[66.900224, "o", "\u001b[?2004h"]
[66.900249, "o", "> "]
[66.900436, "o", "        print(f\"Warning: {errors_found} documents had validation errors\")\r\n\u001b[?2004l\r"]
[66.900465, "o", "\u001b[?2004h> "]
[66.900494, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.900523, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[66.900548, "o", "> "]
[66.900577, "o", "def main():\r\n\u001b[?2004l\r"]
[66.900612, "o", "\u001b[?2004h> "]
[66.900825, "o", "    parser = argparse.ArgumentParser(description='JSON Schema Validator')\r\n\u001b[?2004l\r"]
[66.900857, "o", "\u001b[?2004h> "]
[66.901099, "o", "    parser.add_argument('--benchmark', action='store_true', help='Run benchmark suite')\r\n\u001b[?2004l\r"]
