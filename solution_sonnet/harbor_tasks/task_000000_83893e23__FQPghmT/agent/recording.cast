[70.080618, "o", "\u001b[?2004h> "]
[70.080648, "o", "    # Combine\r\n"]
[70.080681, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[70.080863, "o", "    result = pd.concat([historical, forecast], ignore_index=True)\r\n\u001b[?2004l\r"]
[70.080896, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.080924, "o", "\u001b[?2004h> "]
[70.080977, "o", "    return result\r\n\u001b[?2004l\r"]
[70.081021, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.081058, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.081085, "o", "\u001b[?2004h> "]
[70.081124, "o", "def main():\r\n\u001b[?2004l\r"]
[70.081151, "o", "\u001b[?2004h> "]
[70.081224, "o", "    \"\"\"Main pipeline.\"\"\"\r\n\u001b[?2004l\r"]
[70.081257, "o", "\u001b[?2004h> "]
[70.08131, "o", "    print(\"=\" * 50)\r\n\u001b[?2004l\r"]
[70.081343, "o", "\u001b[?2004h> "]
[70.081459, "o", "    print(\"Capacity Forecasting Pipeline\")\r\n\u001b[?2004l\r"]
[70.081491, "o", "\u001b[?2004h> "]
[70.081544, "o", "    print(\"=\" * 50)\r\n\u001b[?2004l\r"]
[70.081576, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.081605, "o", "\u001b[?2004h> "]
[70.081654, "o", "    # Load data\r\n\u001b[?2004l\r"]
[70.081682, "o", "\u001b[?2004h> "]
[70.08179, "o", "    hosts, reservations = load_data()\r\n\u001b[?2004l\r"]
[70.081821, "o", "\u001b[?2004h> "]
[70.081969, "o", "    print(f\"Loaded {len(hosts)} host metric records\")\r\n\u001b[?2004l\r"]
[70.082, "o", "\u001b[?2004h> "]
[70.082182, "o", "    print(f\"Loaded {len(reservations)} reservation records\")\r\n\u001b[?2004l\r"]
[70.082215, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.082246, "o", "\u001b[?2004h> "]
[70.082428, "o", "    # Compute weekly totals directly from hosts (no merge needed)\r\n\u001b[?2004l\r"]
[70.082461, "o", "\u001b[?2004h> "]
[70.082574, "o", "    print(\"\\nComputing weekly totals...\")\r\n\u001b[?2004l\r"]
[70.082603, "o", "\u001b[?2004h> "]
[70.08272, "o", "    weekly = compute_weekly_totals(hosts)\r\n\u001b[?2004l\r"]
[70.082755, "o", "\u001b[?2004h> "]
[70.082906, "o", "    print(f\"Generated {len(weekly)} weekly data points\")\r\n\u001b[?2004l\r"]
[70.082939, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.08297, "o", "\u001b[?2004h> "]
[70.083051, "o", "    # Fit growth curve\r\n\u001b[?2004l\r"]
[70.08308, "o", "\u001b[?2004h> "]
[70.083192, "o", "    print(\"\\nFitting growth curve...\")\r\n\u001b[?2004l\r"]
[70.083221, "o", "\u001b[?2004h> "]
[70.08333, "o", "    params = fit_growth_curve(weekly)\r\n\u001b[?2004l\r"]
[70.083356, "o", "\u001b[?2004h"]
[70.083383, "o", "> "]
[70.083601, "o", "    print(f\"Model parameters: a={params[0]:.4f}, b={params[1]:.6f}, c={params[2]:.2f}\")\r\n\u001b[?2004l\r"]
[70.083632, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.083655, "o", "\u001b[?2004h"]
[70.083684, "o", "> "]
[70.083732, "o", "    # Generate forecast\r\n\u001b[?2004l\r"]
[70.083773, "o", "\u001b[?2004h> "]
[70.083894, "o", "    print(\"\\nGenerating 8-week forecast...\")\r\n\u001b[?2004l\r"]
[70.083925, "o", "\u001b[?2004h> "]
[70.08407, "o", "    result = generate_forecast(weekly, params)\r\n\u001b[?2004l\r"]
[70.084104, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.084132, "o", "\u001b[?2004h> "]
[70.084187, "o", "    # Save output\r\n\u001b[?2004l\r"]
[70.08422, "o", "\u001b[?2004h> "]
[70.084358, "o", "    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[70.084391, "o", "\u001b[?2004h> "]
[70.084506, "o", "    result.to_csv(OUTPUT_CSV, index=False)\r\n\u001b[?2004l\r"]
[70.084539, "o", "\u001b[?2004h> "]
[70.084666, "o", "    print(f\"\\nForecast saved to {OUTPUT_CSV}\")\r\n\u001b[?2004l\r"]
[70.084697, "o", "\u001b[?2004h> "]
[70.08473, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.084772, "o", "    # Summary\r\n\u001b[?2004l\r"]
[70.084805, "o", "\u001b[?2004h> "]
[70.084878, "o", "    print(\"\\n\" + \"=\" * 50)\r\n\u001b[?2004l\r"]
[70.084907, "o", "\u001b[?2004h> "]
[70.084967, "o", "    print(\"Summary\")\r\n\u001b[?2004l\r"]
[70.084998, "o", "\u001b[?2004h> "]
[70.085072, "o", "    print(\"=\" * 50)\r\n\u001b[?2004l\r"]
[70.085102, "o", "\u001b[?2004h> "]
[70.085225, "o", "    q4_weeks = weekly[weekly['week'] >= 40]\r\n\u001b[?2004l\r"]
[70.085256, "o", "\u001b[?2004h> "]
[70.085505, "o", "    print(f\"Q4 average (weeks 40-52): {q4_weeks['cpu_hours'].mean():.1f} cpu_hours/week\")\r\n\u001b[?2004l\r"]
[70.085536, "o", "\u001b[?2004h> "]
[70.085796, "o", "    print(f\"Last week ({weekly['week'].max()}): {weekly['cpu_hours'].iloc[-1]:.1f} cpu_hours\")\r\n\u001b[?2004l\r"]
[70.085822, "o", "\u001b[?2004h"]
[70.085851, "o", "> "]
[70.085986, "o", "    forecast_only = result[result['type'] == 'forecast']\r\n\u001b[?2004l\r"]
[70.086029, "o", "\u001b[?2004h> "]
[70.086365, "o", "    print(f\"Forecast range: {forecast_only['cpu_hours'].min():.1f} - {forecast_only['cpu_hours'].max():.1f} cpu_hours\")\r\n\u001b[?2004l\r"]
[70.0864, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.086431, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.086461, "o", "\u001b[?2004h> "]
[70.08654, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[70.086572, "o", "\u001b[?2004h> "]
[70.086605, "o", "    main()\r\n\u001b[?2004l\r"]
[70.086635, "o", "\u001b[?2004h> "]
[70.086666, "o", "EOF\r\n\u001b[?2004l\r"]
