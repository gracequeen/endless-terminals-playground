[80.804273, "i", "cat > start_service.sh << 'EOF'\n#!/bin/bash\n# Startup script for mlservice\n# This must be run from /home/user/mlservice directory\n\nSCRIPT_DIR=\"$( cd \"$( dirname \"${BASH_SOURCE[0]}\" )\" && pwd )\"\ncd \"$SCRIPT_DIR\"\n\n# Activate virtual environment\nsource .venv/bin/activate\n\n# Run service from parent directory to avoid module import issues\ncd ..\npython3 -m mlservice\nEOF\n"]
