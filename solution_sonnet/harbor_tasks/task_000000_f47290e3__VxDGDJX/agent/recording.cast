[32.595316, "o", "    done\r\n\u001b[?2004l\r"]
[32.595347, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[32.595379, "o", "\u001b[?2004h> "]
[32.595484, "o", "    if [[ -z \"$filepath\" ]]; then\r\n\u001b[?2004l\r"]
[32.595516, "o", "\u001b[?2004h> "]
[32.595631, "o", "        echo \"error: must specify -f\" >&2\r\n\u001b[?2004l\r"]
[32.595675, "o", "\u001b[?2004h> "]
[32.595721, "o", "        exit 1\r\n\u001b[?2004l\r"]
[32.595752, "o", "\u001b[?2004h> "]
[32.595783, "o", "    fi\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.595815, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[32.595847, "o", "> "]
[32.59593, "o", "    if [[ ! -f \"$filepath\" ]]; then\r\n\u001b[?2004l\r"]
[32.595963, "o", "\u001b[?2004h> "]
[32.596105, "o", "        echo \"error: file not found: $filepath\" >&2\r\n\u001b[?2004l\r"]
[32.596136, "o", "\u001b[?2004h> "]
[32.59618, "o", "        exit 1\r\n\u001b[?2004l\r"]
[32.59621, "o", "\u001b[?2004h> "]
[32.596241, "o", "    fi\r\n\u001b[?2004l\r"]
[32.596272, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[32.596304, "o", "\u001b[?2004h> "]
[32.596335, "o", "    local name\r\n"]
[32.596363, "o", "\u001b[?2004l\r\u001b[?2004h"]
[32.596399, "o", "> "]
[32.596492, "o", "    name=$(get_normalized_name \"$filepath\")\r\n\u001b[?2004l\r"]
[32.596524, "o", "\u001b[?2004h> "]
[32.596664, "o", "    local stored_path=\"$KUBE_STATE_DIR/$name\"\r\n\u001b[?2004l\r"]
[32.596703, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[32.596735, "o", "\u001b[?2004h> "]
[32.596835, "o", "    if [[ ! -f \"$stored_path\" ]]; then\r\n\u001b[?2004l\r"]
[32.596863, "o", "\u001b[?2004h> "]
[32.597026, "o", "        echo \"diff: file does not exist in cluster state\"\r\n\u001b[?2004l\r"]
[32.597059, "o", "\u001b[?2004h> "]
[32.5971, "o", "        exit 1\r\n\u001b[?2004l\r"]
[32.597131, "o", "\u001b[?2004h> "]
[32.597162, "o", "    fi\r\n\u001b[?2004l\r"]
[32.597193, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[32.597225, "o", "\u001b[?2004h> "]
[32.597353, "o", "    # FIX: Normalize both files before comparison\r\n\u001b[?2004l\r"]
[32.597383, "o", "\u001b[?2004h> "]
[32.597453, "o", "    local new_normalized\r\n\u001b[?2004l\r"]
[32.597485, "o", "\u001b[?2004h> "]
[32.597636, "o", "    new_normalized=$(cat \"$filepath\" | normalize_yaml)\r\n\u001b[?2004l\r"]
[32.597679, "o", "\u001b[?2004h> "]
[32.597713, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.597795, "o", "    local stored_normalized\r\n\u001b[?2004l\r"]
[32.597826, "o", "\u001b[?2004h> "]
[32.597995, "o", "    stored_normalized=$(cat \"$stored_path\" | normalize_yaml)\r\n\u001b[?2004l\r"]
[32.598025, "o", "\u001b[?2004h> "]
[32.598068, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.598227, "o", "    if [[ \"$new_normalized\" == \"$stored_normalized\" ]]; then\r\n\u001b[?2004l\r"]
[32.598258, "o", "\u001b[?2004h> "]
[32.5983, "o", "        exit 0\r\n\u001b[?2004l\r"]
[32.598332, "o", "\u001b[?2004h> "]
[32.598363, "o", "    else\r\n\u001b[?2004l\r"]
[32.598396, "o", "\u001b[?2004h> "]
[32.598556, "o", "        echo \"diff detected between local and cluster state\"\r\n\u001b[?2004l\r"]
[32.598588, "o", "\u001b[?2004h> "]
[32.598632, "o", "        exit 1\r\n\u001b[?2004l\r"]
[32.598677, "o", "\u001b[?2004h> "]
[32.598711, "o", "    fi\r\n\u001b[?2004l\r"]
[32.598743, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[32.598774, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[32.598803, "o", "\u001b[?2004h> "]
[32.598841, "o", "case \"$1\" in\r\n\u001b[?2004l\r"]
[32.598872, "o", "\u001b[?2004h> "]
[32.598905, "o", "    apply)\r\n\u001b[?2004l\r"]
[32.598936, "o", "\u001b[?2004h> "]
[32.598977, "o", "        shift\r\n\u001b[?2004l\r"]
[32.599008, "o", "\u001b[?2004h> "]
[32.599073, "o", "        cmd_apply \"$@\"\r\n\u001b[?2004l\r"]
[32.599105, "o", "\u001b[?2004h> "]
[32.599135, "o", "        ;;\r\n\u001b[?2004l\r"]
[32.599166, "o", "\u001b[?2004h> "]
[32.599197, "o", "    diff)\r\n\u001b[?2004l\r"]
[32.599228, "o", "\u001b[?2004h> "]
[32.599266, "o", "        shift\r\n\u001b[?2004l\r"]
[32.599297, "o", "\u001b[?2004h> "]
[32.59936, "o", "        cmd_diff \"$@\"\r\n\u001b[?2004l\r"]
[32.59939, "o", "\u001b[?2004h> "]
[32.59943, "o", "        ;;\r\n\u001b[?2004l\r"]
[32.599464, "o", "\u001b[?2004h> "]
[32.599495, "o", "    *)\r\n\u001b[?2004l\r"]
[32.599526, "o", "\u001b[?2004h> "]
[32.599685, "o", "        echo \"fake kubectl: unknown command '$1'\" >&2\r\n\u001b[?2004l\r"]
[32.599723, "o", "\u001b[?2004h> "]
[32.599761, "o", "        exit 1\r\n\u001b[?2004l\r"]
[32.599793, "o", "\u001b[?2004h> "]
[32.599829, "o", "        ;;\r\n\u001b[?2004l\r"]
[32.599859, "o", "\u001b[?2004h> "]
[32.59989, "o", "esac\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.599919, "o", "> EOF\r\n\u001b[?2004l\r"]
