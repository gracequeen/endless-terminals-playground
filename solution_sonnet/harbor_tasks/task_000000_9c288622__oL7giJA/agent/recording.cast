[8.636752, "o", "\u001b[?2004l\r"]
[8.63761, "o", "# Scheduler crontab - runs at the top of every hour\r\n0 * * * * cd /home/user/scheduler && python3 app.py >> /home/user/scheduler/output.log 2>&1\r\n"]
