[63.054407, "i", "cat > test_dst_fix.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Test script to verify DST fix for the scheduler.\"\"\"\n\nimport pytz\nfrom datetime import datetime\n\n# The problematic meeting from meetings.json\nMAINTENANCE_MEETING_UTC = '2024-03-31T01:30:00'\n\ndef convert_to_berlin_old(utc_time_str):\n    \"\"\"OLD buggy method.\"\"\"\n    berlin_tz = pytz.timezone('Europe/Berlin')\n    utc_dt = datetime.strptime(utc_time_str, '%Y-%m-%dT%H:%M:%S')\n    berlin_dt = berlin_tz.localize(utc_dt)  # BUG: treats UTC as Berlin\n    return berlin_dt\n\ndef convert_to_berlin_new(utc_time_str):\n    \"\"\"NEW fixed method.\"\"\"\n    berlin_tz = pytz.timezone('Europe/Berlin')\n    utc_tz = pytz.utc\n    utc_dt = datetime.strptime(utc_time_str, '%Y-%m-%dT%H:%M:%S')\n    utc_dt_aware = utc_tz.localize(utc_dt)\n    berlin_dt = utc_dt_aware.astimezone(berlin_tz)\n    return berlin_dt\n\nprint(\"=\"*70)\nprint(\"DST FIX VERIFICATION FOR MAINTENANCE WINDOW MEETING\")\nprint(\"=\"*70)\nprint(f\"\\nMeeting stored as UTC: {MAINTENANCE_MEETING_UTC}\")\nprint(\"\\nDST transition: March "]
[63.054538, "i", "31, 2024 at 2:00am CET -> 3:00am CEST\")\nprint(\"=\"*70)\n\nold_time = convert_to_berlin_old(MAINTENANCE_MEETING_UTC)\nnew_time = convert_to_berlin_new(MAINTENANCE_MEETING_UTC)\n\nprint(f\"\\nOLD (buggy) conversion:\")\nprint(f\"  Result: {old_time.strftime('%Y-%m-%d %H:%M:%S %Z (UTC%z)')}\")\nprint(f\"  Reminder would be sent at: {(old_time.hour - 1):02d}:{old_time.minute:02d} (15 min before)\")\nprint(f\"  Problem: Treats UTC time as if it were already Berlin time!\")\n\nprint(f\"\\nNEW (fixed) conversion:\")\nprint(f\"  Result: {new_time.strftime('%Y-%m-%d %H:%M:%S %Z (UTC%z)')}\")\nprint(f\"  Reminder would be sent at: {(new_time.hour):02d}:{(new_time.minute - 15):02d} (15 min before)\")\nprint(f\"  Correct: Properly converts from UTC to Berlin time with DST!\")\n\nprint(f\"\\nTime difference: {(new_time - old_time).total_seconds() / 3600} hour(s)\")\nprint(\"\\n\" + \"=\"*70)\nprint(\"RESULT: Fix correctly handles DST transition!\")\nprint(\"The meeting at 01:30 UTC = 03:30 CEST (not 01:30 CET)\")\nprint(\"Reminder will now be sent at the correct time: 03:"]
[63.054583, "o", "cat > test_dst_fix.py << 'EOF'\r\n"]
[63.054619, "i", "15 CEST\")\nprint(\"=\"*70)\nEOF\n"]
