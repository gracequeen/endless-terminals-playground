[79.987197, "o", "\u001b[01;31m\u001b[Kdef convert_to_berlin\u001b[m\u001b[K(utc_time_str):\r\n    \"\"\"\r\n    Convert UTC time string to Berlin timezone.\r\n    \"\"\"\r\n"]
[79.987221, "o", "    # Parse the UTC time string\r\n    utc_dt = datetime.strptime(utc_time_str, '%Y-%m-%dT%H:%M:%S')\r\n"]
