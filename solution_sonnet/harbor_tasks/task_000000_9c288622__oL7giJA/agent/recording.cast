[38.378894, "i", "python3 << 'EOF'\nimport pytz\nfrom datetime import datetime\n\n# Test the problematic time conversion\nutc_time_str = '2024-03-31T01:30:00'\nutc_dt = datetime.strptime(utc_time_str, '%Y-%m-%dT%H:%M:%S')\n\nprint(\"Testing UTC to Berlin conversion for DST transition date:\")\nprint(f\"UTC time (naive): {utc_dt}\")\n\n# OLD METHOD (buggy)\nberlin_tz = pytz.timezone('Europe/Berlin')\nold_method = berlin_tz.localize(utc_dt)\nprint(f\"OLD method (localize): {old_method} = {old_method.strftime('%Y-%m-%d %H:%M:%S %Z%z')}\")\n\n# NEW METHOD (correct)\nutc_tz = pytz.utc\nutc_aware = utc_tz.localize(utc_dt)\nnew_method = utc_aware.astimezone(berlin_tz)\nprint(f\"NEW method (UTC->Berlin): {new_method} = {new_method.strftime('%Y-%m-%d %H:%M:%S %Z%z')}\")\n\nprint(f\"\\nDifference: {(new_method - old_method).total_seconds() / 3600} hours\")\nEOF\n"]
