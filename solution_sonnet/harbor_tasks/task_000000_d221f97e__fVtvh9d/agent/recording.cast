[71.809012, "i", "python3 << 'EOF'\nimport re\npattern = r'response_time(?:_ms)?=(\\d+)(?:ms)?'\nvalues = []\nwith open('/home/user/perf/slow.txt', 'r') as f:\n    for line in f:\n        match = re.search(pattern, line)\n        if match:\n            values.append(int(match.group(1)))\nvalues.sort()\nprint(f\"Min: {min(values)}, Max: {max(values)}\")\nprint(f\"First 10 values: {values[:10]}\")\nprint(f\"Total: {len(values)}\")\nEOF\n"]
