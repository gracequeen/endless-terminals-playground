[55.169953, "o", "#!/bin/bash\r\ncd /home/user/builds\r\n\r\n# Find all .dSYM bundles older than 7 days and delete only those without matching .ipa\r\nfind . -name \"*.dSYM\" -type d -mtime +7 -print0 | while IFS= read -r -d '' dsym; do\r\n    ipa=\"${dsym%.dSYM}.ipa\"\r\n    if [ ! -e \"$ipa\" ]; then\r\n        echo \"Deleting: $dsym (no matching .ipa found)\"\r\n        rm -rf \"$dsym\"\r\n    else\r\n        echo \"Keeping: $dsym (matching .ipa exists)\"\r\n    fi\r\ndone\r\n"]
[55.170116, "o", "\u001b[?2004h"]
