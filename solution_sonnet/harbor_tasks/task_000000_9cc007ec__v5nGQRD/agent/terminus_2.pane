#!/bin/bash
cd /home/user/builds

# Find all .dSYM bundles older than 7 days and delete only those without matching .ipa
find . -name "*.dSYM" -type d -mtime +7 -print0 | while IFS= read -r -d '' dsym; do
    ipa="${dsym%.dSYM}.ipa"
    if [ ! -e "$ipa" ]; then
        echo "Deleting: $dsym (no matching .ipa found)"
        rm -rf "$dsym"
    else
        echo "Keeping: $dsym (matching .ipa exists)"
    fi
done
