[67.010377, "i", "cat > forecast.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nCapacity Forecasting Pipeline\n\nLoads host metrics and reservation data, rolls up to weekly totals,\nfits a growth curve, and projects forward.\n\"\"\"\n\nimport pandas as pd\nimport numpy as np\nfrom scipy.optimize import curve_fit\nfrom pathlib import Path\n\n# Paths\nBASE_DIR = Path(__file__).parent\nDATA_DIR = BASE_DIR / \"data\"\nOUTPUT_DIR = BASE_DIR / \"output\"\n\nHOSTS_CSV = DATA_DIR / \"hosts.csv\"\nRESERVATIONS_CSV = DATA_DIR / \"reservations.csv\"\nOUTPUT_CSV = OUTPUT_DIR / \"forecast.csv\"\n\n\ndef exponential_growth(x, a, b, c):\n    \"\"\"Exponential growth model: y = a * exp(b * x) + c\"\"\"\n    return a * np.exp(b * x) + c\n\n\ndef load_data():\n    \"\"\"Load host metrics and reservation data.\"\"\"\n    print(\"Loading hosts.csv...\")\n    hosts = pd.read_csv(HOSTS_CSV)\n    hosts['timestamp'] = pd.to_datetime(hosts['timestamp'])\n\n    print(\"Loading reservations.csv...\")\n    reservations = pd.read_csv(RESERVATIONS_CSV)\n    reservations['start_time'] = pd.to_datetime(reservations['start_time'"]
[67.010492, "i", "])\n    reservations['end_time'] = pd.to_datetime(reservations['end_time'])\n\n    return hosts, reservations\n\n\ndef compute_weekly_totals(data):\n    \"\"\"Aggregate metrics to weekly totals.\"\"\"\n    # Extract ISO week number\n    data = data.copy()\n    data['week'] = data['timestamp'].dt.isocalendar().week\n\n    # Sum cpu_hours by week\n    weekly = data.groupby('week')['cpu_hours'].sum().reset_index()\n    weekly.columns = ['week', 'cpu_hours']\n\n    return weekly\n\n\ndef fit_growth_curve(weekly):\n    \"\"\"Fit exponential growth curve to weekly data.\"\"\"\n    x = weekly['week'].values\n    y = weekly['cpu_hours'].values\n\n    # Initial guess for parameters\n    try:\n        popt, _ = curve_fit(\n            exponential_growth,\n            x, y,\n            p0=[1, 0.01, y.mean()],\n            maxfev=10000,\n            bounds=([0, -0.1, 0], [np.inf, 0.5, np.inf])\n        )\n    except RuntimeError:\n        # Fallback to linear if exponential doesn't converge\n        popt = [0, 0, y.mean()]\n\n    return popt\n\n\ndef generate_forecast(we"]
[67.01053, "o", "cat > forecast.py << 'EOF'\r\n\u001b[?2004l\r"]
[67.010567, "i", "ekly, params, weeks_ahead=8):\n    \"\"\"Generate forecast for future weeks.\"\"\"\n    last_week = weekly['week'].max()\n\n    # Historical data\n    historical = weekly.copy()\n    historical['type'] = 'historical'\n\n    # Forecast data\n    forecast_weeks = list(range(last_week + 1, last_week + weeks_ahead + 1))\n    forecast_values = [exponential_growth(w, *params) for w in forecast_weeks]\n\n    forecast = pd.DataFrame({\n        'week': forecast_weeks,\n        'cpu_hours': forecast_values,\n        'type': ['forecast'] * len(forecast_weeks)\n    })\n\n    # Combine\n    result = pd.concat([historical, forecast], ignore_index=True)\n\n    return result\n\n\ndef main():\n    \"\"\"Main pipeline.\"\"\"\n    print(\"=\" * 50)\n    print(\"Capacity Forecasting Pipeline\")\n    print(\"=\" * 50)\n\n    # Load data\n    hosts, reservations = load_data()\n    print(f\"Loaded {len(hosts)} host metric records\")\n    print(f\"Loaded {len(reservations)} reservation records\")\n\n    # Compute weekly totals directly from hosts (no merge needed)\n    print(\"\\nComputing w"]
[67.010616, "o", "\u001b[?2004h> "]
[67.010651, "i", "eekly totals...\")\n    weekly = compute_weekly_totals(hosts)\n    print(f\"Generated {len(weekly)} weekly data points\")\n\n    # Fit growth curve\n    print(\"\\nFitting growth curve...\")\n    params = fit_growth_curve(weekly)\n    print(f\"Model parameters: a={params[0]:.4f}, b={params[1]:.6f}, c={params[2]:.2f}\")\n\n    # Generate forecast\n    print(\"\\nGenerating 8-week forecast...\")\n    result = generate_forecast(weekly, params)\n\n    # Save output\n    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n    result.to_csv(OUTPUT_CSV, index=False)\n    print(f\"\\nForecast saved to {OUTPUT_CSV}\")\n\n    # Summary\n    print(\"\\n\" + \"=\" * 50)\n    print(\"Summary\")\n    print(\"=\" * 50)\n    q4_weeks = weekly[weekly['week'] >= 40]\n    print(f\"Q4 average (weeks 40-52): {q4_weeks['cpu_hours'].mean():.1f} cpu_hours/week\")\n    print(f\"Last week ({weekly['week'].max()}): {weekly['cpu_hours'].iloc[-1]:.1f} cpu_hours\")\n    forecast_only = result[result['type'] == 'forecast']\n    print(f\"Forecast range: {forecast_only['cpu_hours'].min():.1f} - {for"]
[67.010684, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\reekly totals...\")\r\n    weekly = compute_weekly_totals(hosts)\r\n    print(f\"Generate"]
[67.01072, "i", "ecast_only['cpu_hours'].max():.1f} cpu_hours\")\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
[67.01076, "o", "d {len(weekly)} weekly data points\")\r\n\r\n    # Fit growth curve\r\n    print(\"\\nFitting growth curve...\")\r\n    params = fit_growth_curve(weekly)\r\n    print(f\"Model parameters: a={params[0]:.4f}, b={params[1]:.6f}, c={params[2]:.2f}\")\r\n\r\n    # Generate forecast\r\n    print(\"\\nGenerating 8-week forecast...\")\r\n    res"]
[67.010793, "o", "ult = generate_forecast(weekly, params)\r\n\r\n    # Save output\r\n    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\r\n    result.to_csv(OUTPUT_CSV, index=False)\r\n    print(f"]
[67.010826, "o", "\"\\nForecast saved to {OUTPUT_CSV}\")\r\n\r\n    # Summary\r\n    print(\"\\n\" + \"=\" * 50)\r\n"]
[67.010855, "o", "    print(\"Summary\")\r\n    print(\"=\" * 50)\r\n    q4_weeks = weekly[weekly['week'] >= 40]\r\n    print(f\"Q4 aver"]
[67.010886, "o", "age (weeks 40-52): {q4_weeks['cpu_hours'].mean():.1f} cpu_hours/week\")\r\n    print(f\"Last week ({weekly['week'].max()}): {weekly['cpu_hours'].iloc[-1]:.1f} cpu_hours\")\r\n    forecast_only = result[result['type'] =="]
[67.010915, "o", " 'forecast']\r\n    print(f\"Forecast range: {forecast_only['cpu_hours'].mi"]
[67.010953, "o", "n():.1f} - {forecast_only['cpu_hours'].max():.1f} cpu_hours\")\r\n\r\n\r\n\u001b[?2004h"]
[67.010986, "o", "> \"\"\"\r\n\u001b[?2004l\r"]
[67.011017, "o", "\u001b[?2004h> "]
[67.011141, "o", "Capacity Forecasting Pipeline\r\n\u001b[?2004l\r"]
[67.011174, "o", "\u001b[?2004h> \r\n"]
[67.011205, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[67.011409, "o", "Loads host metrics and reservation data, rolls up to weekly totals,\r\n\u001b[?2004l\r"]
[67.011442, "o", "\u001b[?2004h> "]
[67.011559, "o", "fits a growth curve, and projects forward.\r\n\u001b[?2004l\r"]
[67.011606, "o", "\u001b[?2004h> "]
[67.011643, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.011676, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.011736, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[67.011769, "o", "\u001b[?2004h> "]
[67.011823, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[67.011861, "o", "\u001b[?2004h> "]
[67.01196, "o", "from scipy.optimize import curve_fit\r\n\u001b[?2004l\r"]
[67.011995, "o", "\u001b[?2004h> "]
[67.012062, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[67.012094, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.012125, "o", "\u001b[?2004h> "]
[67.012158, "o", "# Paths\r\n\u001b[?2004l\r"]
[67.012191, "o", "\u001b[?2004h> "]
[67.012273, "o", "BASE_DIR = Path(__file__).parent\r\n\u001b[?2004l\r"]
[67.012305, "o", "\u001b[?2004h> "]
[67.012386, "o", "DATA_DIR = BASE_DIR / \"data\"\r\n\u001b[?2004l\r"]
[67.012491, "o", "\u001b[?2004h> "]
[67.012552, "o", "OUTPUT_DIR = BASE_DIR / \"output\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.012616, "o", "\u001b[?2004h> "]
[67.012698, "o", "HOSTS_CSV = DATA_DIR / \"hosts.csv\"\r\n\u001b[?2004l\r"]
[67.012739, "o", "\u001b[?2004h> "]
[67.012859, "o", "RESERVATIONS_CSV = DATA_DIR / \"reservations.csv\"\r\n\u001b[?2004l\r"]
[67.012892, "o", "\u001b[?2004h> "]
[67.013006, "o", "OUTPUT_CSV = OUTPUT_DIR / \"forecast.csv\"\r\n\u001b[?2004l\r"]
[67.01305, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.013079, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.013106, "o", "\u001b[?2004h> "]
[67.0132, "o", "def exponential_growth(x, a, b, c):\r\n\u001b[?2004l\r"]
[67.013232, "o", "\u001b[?2004h> "]
[67.013398, "o", "    \"\"\"Exponential growth model: y = a * exp(b * x) + c\"\"\"\r\n\u001b[?2004l\r"]
[67.013436, "o", "\u001b[?2004h> "]
[67.013516, "o", "    return a * np.exp(b * x) + c\r\n\u001b[?2004l\r"]
[67.013548, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.013592, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.013627, "o", "\u001b[?2004h> "]
[67.013674, "o", "def load_data():\r\n\u001b[?2004l\r"]
[67.013702, "o", "\u001b[?2004h> "]
[67.013843, "o", "    \"\"\"Load host metrics and reservation data.\"\"\"\r\n\u001b[?2004l\r"]
[67.013877, "o", "\u001b[?2004h> "]
[67.013973, "o", "    print(\"Loading hosts.csv...\")\r\n\u001b[?2004l\r"]
[67.014007, "o", "\u001b[?2004h> "]
[67.014097, "o", "    hosts = pd.read_csv(HOSTS_CSV)\r\n\u001b[?2004l\r"]
[67.014127, "o", "\u001b[?2004h> "]
[67.014296, "o", "    hosts['timestamp'] = pd.to_datetime(hosts['timestamp'])\r\n\u001b[?2004l\r"]
[67.014322, "o", "\u001b[?2004h"]
[67.01436, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[67.014389, "o", "> "]
[67.014486, "o", "    print(\"Loading reservations.csv...\")\r\n\u001b[?2004l\r"]
[67.014517, "o", "\u001b[?2004h"]
[67.014548, "o", "> "]
[67.014673, "o", "    reservations = pd.read_csv(RESERVATIONS_CSV)\r\n\u001b[?2004l\r"]
[67.014706, "o", "\u001b[?2004h> "]
[67.014911, "o", "    reservations['start_time'] = pd.to_datetime(reservations['start_time'])\r\n\u001b[?2004l\r"]
[67.014939, "o", "\u001b[?2004h> "]
[67.015139, "o", "    reservations['end_time'] = pd.to_datetime(reservations['end_time'])\r\n\u001b[?2004l\r"]
[67.015174, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.015207, "o", "\u001b[?2004h> "]
[67.015291, "o", "    return hosts, reservations\r\n\u001b[?2004l\r"]
[67.015323, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.015356, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.015388, "o", "\u001b[?2004h> "]
[67.015481, "o", "def compute_weekly_totals(data):\r\n\u001b[?2004l\r"]
[67.015512, "o", "\u001b[?2004h> "]
[67.015651, "o", "    \"\"\"Aggregate metrics to weekly totals.\"\"\"\r\n\u001b[?2004l\r"]
[67.015686, "o", "\u001b[?2004h> "]
[67.015764, "o", "    # Extract ISO week number\r\n\u001b[?2004l\r"]
[67.015793, "o", "\u001b[?2004h> "]
[67.015861, "o", "    data = data.copy()\r\n\u001b[?2004l\r"]
[67.015889, "o", "\u001b[?2004h> "]
[67.016055, "o", "    data['week'] = data['timestamp'].dt.isocalendar().week\r\n\u001b[?2004l\r"]
[67.016084, "o", "\u001b[?2004h> "]
[67.01611, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.016141, "o", "> "]
[67.016198, "o", "    # Sum cpu_hours by week\r\n\u001b[?2004l\r"]
[67.01623, "o", "\u001b[?2004h> "]
[67.016416, "o", "    weekly = data.groupby('week')['cpu_hours'].sum().reset_index()\r\n\u001b[?2004l\r"]
[67.016444, "o", "\u001b[?2004h"]
[67.016471, "o", "> "]
[67.016568, "o", "    weekly.columns = ['week', 'cpu_hours']\r\n\u001b[?2004l\r"]
[67.016613, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.016646, "o", "\u001b[?2004h> "]
[67.016691, "o", "    return weekly\r\n\u001b[?2004l\r"]
[67.016724, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.016753, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.016784, "o", "\u001b[?2004h> "]
[67.01687, "o", "def fit_growth_curve(weekly):\r\n\u001b[?2004l\r"]
[67.016902, "o", "\u001b[?2004h> "]
[67.017054, "o", "    \"\"\"Fit exponential growth curve to weekly data.\"\"\"\r\n\u001b[?2004l\r"]
[67.017088, "o", "\u001b[?2004h> "]
[67.01717, "o", "    x = weekly['week'].values\r\n\u001b[?2004l\r"]
[67.0172, "o", "\u001b[?2004h> "]
[67.017297, "o", "    y = weekly['cpu_hours'].values\r\n\u001b[?2004l\r"]
[67.017328, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.017362, "o", "\u001b[?2004h> "]
[67.017457, "o", "    # Initial guess for parameters\r\n\u001b[?2004l\r"]
[67.017489, "o", "\u001b[?2004h> "]
[67.017518, "o", "    try:\r\n\u001b[?2004l\r"]
[67.01755, "o", "\u001b[?2004h> "]
[67.017637, "o", "        popt, _ = curve_fit(\r\n\u001b[?2004l\r"]
[67.017669, "o", "\u001b[?2004h> "]
[67.017759, "o", "            exponential_growth,\r\n\u001b[?2004l\r"]
[67.01779, "o", "\u001b[?2004h> "]
[67.017843, "o", "            x, y,\r\n\u001b[?2004l\r"]
[67.017876, "o", "\u001b[?2004h> "]
[67.017976, "o", "            p0=[1, 0.01, y.mean()],\r\n\u001b[?2004l\r"]
[67.018003, "o", "\u001b[?2004h> "]
[67.018079, "o", "            maxfev=10000,\r\n\u001b[?2004l\r"]
[67.018107, "o", "\u001b[?2004h> "]
[67.018268, "o", "            bounds=([0, -0.1, 0], [np.inf, 0.5, np.inf])\r\n\u001b[?2004l\r"]
[67.018302, "o", "\u001b[?2004h> "]
[67.018343, "o", "        )\r\n\u001b[?2004l\r"]
[67.018375, "o", "\u001b[?2004h> "]
[67.01844, "o", "    except RuntimeError:\r\n\u001b[?2004l\r"]
[67.018474, "o", "\u001b[?2004h> "]
[67.018653, "o", "        # Fallback to linear if exponential doesn't converge\r\n\u001b[?2004l\r"]
[67.018688, "o", "\u001b[?2004h> "]
[67.018776, "o", "        popt = [0, 0, y.mean()]\r\n\u001b[?2004l\r"]
[67.018809, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.018838, "o", "\u001b[?2004h"]
[67.01887, "o", "> "]
[67.018901, "o", "    return popt\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.018929, "o", "> \r\n\u001b[?2004l\r"]
[67.01896, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.018992, "o", "\u001b[?2004h> "]
[67.01913, "o", "def generate_forecast(weekly, params, weeks_ahead=8):\r\n\u001b[?2004l\r"]
[67.019163, "o", "\u001b[?2004h> "]
[67.019287, "o", "    \"\"\"Generate forecast for future weeks.\"\"\"\r\n\u001b[?2004l\r"]
[67.019314, "o", "\u001b[?2004h> "]
[67.019422, "o", "    last_week = weekly['week'].max()\r\n\u001b[?2004l\r"]
[67.019455, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.019483, "o", "\u001b[?2004h> "]
[67.019549, "o", "    # Historical data\r\n\u001b[?2004l\r"]
[67.019588, "o", "\u001b[?2004h> "]
[67.019679, "o", "    historical = weekly.copy()\r\n\u001b[?2004l\r"]
[67.019707, "o", "\u001b[?2004h> "]
[67.019816, "o", "    historical['type'] = 'historical'\r\n\u001b[?2004l\r"]
[67.019845, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.019871, "o", "\u001b[?2004h"]
[67.019902, "o", "> "]
[67.019936, "o", "    # Forecast data\r\n\u001b[?2004l\r"]
[67.019962, "o", "\u001b[?2004h> "]
[67.020178, "o", "    forecast_weeks = list(range(last_week + 1, last_week + weeks_ahead + 1))\r\n\u001b[?2004l\r"]
[67.020207, "o", "\u001b[?2004h> "]
[67.020423, "o", "    forecast_values = [exponential_growth(w, *params) for w in forecast_weeks]\r\n\u001b[?2004l\r"]
[67.020458, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.020487, "o", "\u001b[?2004h> "]
[67.020569, "o", "    forecast = pd.DataFrame({\r\n\u001b[?2004l\r"]
[67.020608, "o", "\u001b[?2004h"]
[67.020639, "o", "> "]
[67.020701, "o", "        'week': forecast_weeks,\r\n\u001b[?2004l\r"]
[67.020732, "o", "\u001b[?2004h> "]
[67.020839, "o", "        'cpu_hours': forecast_values,\r\n\u001b[?2004l\r"]
[67.020868, "o", "\u001b[?2004h> "]
[67.021012, "o", "        'type': ['forecast'] * len(forecast_weeks)\r\n\u001b[?2004l\r"]
[67.021039, "o", "\u001b[?2004h"]
[67.02107, "o", ">     })\r\n\u001b[?2004l\r"]
[67.021101, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.021134, "o", "\u001b[?2004h> "]
[67.021172, "o", "    # Combine\r\n\u001b[?2004l\r"]
[67.021204, "o", "\u001b[?2004h> "]
[67.021386, "o", "    result = pd.concat([historical, forecast], ignore_index=True)\r\n\u001b[?2004l\r"]
[67.02142, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.021454, "o", "\u001b[?2004h> "]
[67.021503, "o", "    return result\r\n\u001b[?2004l\r"]
[67.021535, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.021565, "o", "\u001b[?2004h> "]
[67.021611, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.021646, "o", "def main():\r\n\u001b[?2004l\r"]
[67.021677, "o", "\u001b[?2004h> "]
[67.021749, "o", "    \"\"\"Main pipeline.\"\"\"\r\n\u001b[?2004l\r"]
[67.021781, "o", "\u001b[?2004h"]
[67.021813, "o", "> "]
[67.021848, "o", "    print(\"=\" * 50)\r\n\u001b[?2004l\r"]
[67.02188, "o", "\u001b[?2004h> "]
[67.021988, "o", "    print(\"Capacity Forecasting Pipeline\")\r\n\u001b[?2004l\r"]
[67.022021, "o", "\u001b[?2004h> "]
[67.022078, "o", "    print(\"=\" * 50)\r\n\u001b[?2004l\r"]
[67.02211, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.022145, "o", "\u001b[?2004h> "]
[67.022188, "o", "    # Load data\r\n\u001b[?2004l\r"]
[67.022218, "o", "\u001b[?2004h> "]
[67.022333, "o", "    hosts, reservations = load_data()\r\n\u001b[?2004l\r"]
[67.022365, "o", "\u001b[?2004h> "]
[67.022515, "o", "    print(f\"Loaded {len(hosts)} host metric records\")\r\n\u001b[?2004l\r"]
[67.022547, "o", "\u001b[?2004h> "]
[67.022727, "o", "    print(f\"Loaded {len(reservations)} reservation records\")\r\n\u001b[?2004l\r"]
[67.022761, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.022792, "o", "\u001b[?2004h> "]
[67.022974, "o", "    # Compute weekly totals directly from hosts (no merge needed)\r\n\u001b[?2004l\r"]
[67.023006, "o", "\u001b[?2004h> "]
[67.023121, "o", "    print(\"\\nComputing weekly totals...\")\r\n\u001b[?2004l\r"]
[67.023151, "o", "\u001b[?2004h> "]
[67.023267, "o", "    weekly = compute_weekly_totals(hosts)\r\n\u001b[?2004l\r"]
[67.0233, "o", "\u001b[?2004h> "]
[67.023454, "o", "    print(f\"Generated {len(weekly)} weekly data points\")\r\n\u001b[?2004l\r"]
[67.023486, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.023515, "o", "\u001b[?2004h> "]
[67.023593, "o", "    # Fit growth curve\r\n\u001b[?2004l\r"]
[67.023627, "o", "\u001b[?2004h> "]
[67.023734, "o", "    print(\"\\nFitting growth curve...\")\r\n\u001b[?2004l\r"]
[67.023762, "o", "\u001b[?2004h> "]
[67.023872, "o", "    params = fit_growth_curve(weekly)\r\n\u001b[?2004l\r"]
[67.0239, "o", "\u001b[?2004h> "]
[67.024145, "o", "    print(f\"Model parameters: a={params[0]:.4f}, b={params[1]:.6f}, c={params[2]:.2f}\")\r\n\u001b[?2004l\r"]
[67.024173, "o", "\u001b[?2004h> "]
[67.024202, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.024233, "o", "> "]
[67.024278, "o", "    # Generate forecast\r\n\u001b[?2004l\r"]
[67.024305, "o", "\u001b[?2004h> "]
[67.024432, "o", "    print(\"\\nGenerating 8-week forecast...\")\r\n\u001b[?2004l\r"]
[67.02446, "o", "\u001b[?2004h> "]
[67.024602, "o", "    result = generate_forecast(weekly, params)\r\n\u001b[?2004l\r"]
[67.024633, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.024664, "o", "\u001b[?2004h> "]
[67.024716, "o", "    # Save output\r\n\u001b[?2004l\r"]
[67.024749, "o", "\u001b[?2004h> "]
[67.024887, "o", "    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[67.02492, "o", "\u001b[?2004h> "]
[67.025039, "o", "    result.to_csv(OUTPUT_CSV, index=False)\r\n\u001b[?2004l\r"]
[67.025073, "o", "\u001b[?2004h> "]
[67.025202, "o", "    print(f\"\\nForecast saved to {OUTPUT_CSV}\")\r\n\u001b[?2004l\r"]
[67.025237, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.025269, "o", "\u001b[?2004h> "]
[67.025308, "o", "    # Summary\r\n\u001b[?2004l\r"]
[67.02534, "o", "\u001b[?2004h> "]
[67.025414, "o", "    print(\"\\n\" + \"=\" * 50)\r\n\u001b[?2004l\r"]
[67.025446, "o", "\u001b[?2004h> "]
[67.025504, "o", "    print(\"Summary\")\r\n\u001b[?2004l\r"]
[67.02554, "o", "\u001b[?2004h> "]
[67.025603, "o", "    print(\"=\" * 50)\r\n\u001b[?2004l\r"]
[67.025632, "o", "\u001b[?2004h> "]
[67.025757, "o", "    q4_weeks = weekly[weekly['week'] >= 40]\r\n\u001b[?2004l\r"]
[67.025789, "o", "\u001b[?2004h> "]
[67.026035, "o", "    print(f\"Q4 average (weeks 40-52): {q4_weeks['cpu_hours'].mean():.1f} cpu_hours/week\")\r\n\u001b[?2004l\r"]
[67.026071, "o", "\u001b[?2004h> "]
[67.026336, "o", "    print(f\"Last week ({weekly['week'].max()}): {weekly['cpu_hours'].iloc[-1]:.1f} cpu_hours\")\r\n\u001b[?2004l\r"]
[67.026372, "o", "\u001b[?2004h> "]
[67.026527, "o", "    forecast_only = result[result['type'] == 'forecast']\r\n\u001b[?2004l\r"]
[67.026555, "o", "\u001b[?2004h> "]
[67.026903, "o", "    print(f\"Forecast range: {forecast_only['cpu_hours'].min():.1f} - {forecast_only['cpu_hours'].max():.1f} cpu_hours\")\r\n\u001b[?2004l\r"]
