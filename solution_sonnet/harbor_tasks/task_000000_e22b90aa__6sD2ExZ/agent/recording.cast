[132.671683, "i", "python3 << 'EOF'\nimport pandas as pd\ndf = pd.read_parquet('output/merged.parquet')\nprint('Final verification:')\nprint(f'Total rows: {len(df)}')\nprint(f'NaT values: {df[\"recorded_at\"].isna().sum()}')\nprint(f'Unique sensors: {df[\"sensor_id\"].str.split(\"_\").str[0:2].str.join(\"_\").nunique()}')\nprint(f'\\nRow counts by sensor:')\nprint(df.groupby(df['sensor_id'].str.split('_').str[0:2].str.join('_')).size())\nprint('\\nDatetime range:')\nprint(f'Min: {df[\"recorded_at\"].min()}')\nprint(f'Max: {df[\"recorded_at\"].max()}')\nprint('\\n✓ All timestamps are valid - ready for publication!')\nEOF\n"]
