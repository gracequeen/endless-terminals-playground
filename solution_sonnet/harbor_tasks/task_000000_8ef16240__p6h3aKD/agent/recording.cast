[257.120022, "o", "> "]
[257.120133, "o", "    print(f\"Starting from line {start_from}\")\r\n\u001b[?2004l\r"]
[257.120167, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[257.120191, "o", "\u001b[?2004h"]
[257.12022, "o", "> "]
[257.120323, "o", "    with open('data/events.json', 'r') as f:\r\n\u001b[?2004l\r"]
[257.120358, "o", "\u001b[?2004h> "]
[257.120407, "o", "        batch = []\r\n\u001b[?2004l\r"]
[257.12043, "o", "\u001b[?2004h"]
[257.120454, "o", "> "]
[257.120518, "o", "        lines_processed = 0\r\n\u001b[?2004l\r"]
[257.120549, "o", "\u001b[?2004h> "]
[257.120653, "o", "        for i, line in enumerate(f):\r\n\u001b[?2004l\r"]
[257.120683, "o", "\u001b[?2004h> "]
[257.120773, "o", "            if i < start_from:\r\n\u001b[?2004l\r"]
[257.120811, "o", "\u001b[?2004h> "]
[257.120883, "o", "                continue\r\n\u001b[?2004l\r"]
[257.120912, "o", "\u001b[?2004h> "]
[257.121034, "o", "            batch.append(json.loads(line))\r\n\u001b[?2004l\r"]
[257.121077, "o", "\u001b[?2004h> "]
[257.121184, "o", "            lines_processed = i + 1\r\n\u001b[?2004l\r"]
[257.121211, "o", "\u001b[?2004h> "]
[257.121254, "o", "            \r\n\u001b[?2004l\r"]
[257.121283, "o", "\u001b[?2004h> "]
[257.121413, "o", "            # Simulate crash at specific line\r\n\u001b[?2004l\r"]
