[257.122342, "o", "\u001b[?2004h> "]
[257.122463, "o", "                process_batch(conn, batch)\r\n\u001b[?2004l\r"]
[257.122492, "o", "\u001b[?2004h"]
[257.122522, "o", "> "]
[257.122629, "o", "                save_checkpoint(lines_processed)\r\n\u001b[?2004l\r"]
[257.122658, "o", "\u001b[?2004h> "]
