[160.24383, "i", "cat > check_db.py << 'EOF'\nimport sqlite3\nimport sys\n\nconn = sqlite3.connect('output/summary.db')\nprint(f\"Total categories: {conn.execute('SELECT COUNT(*) FROM summary').fetchone()[0]}\")\nprint(f\"Total records: {conn.execute('SELECT SUM(count) FROM summary').fetchone()[0]}\")\nprint(f\"Total value sum: {conn.execute('SELECT SUM(total_value) FROM summary').fetchone()[0]}\")\nprint(\"\\nSample categories:\")\nfor row in conn.execute('SELECT category, total_value, count FROM summary ORDER BY category LIMIT 10'):\n    print(f\"  {row[0]}: total={row[1]:.2f}, count={row[2]}\")\nconn.close()\nEOF\n"]
