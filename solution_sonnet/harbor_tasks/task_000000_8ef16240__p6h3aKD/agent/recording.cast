[257.114339, "i", "cat > test_crash.py << 'EOF'\nimport json\nimport sqlite3\nimport os\nimport sys\n\nBATCH_SIZE = 1000\nCRASH_AT_LINE = 15000\n\ndef load_checkpoint():\n    try:\n        with open('.checkpoint', 'r') as f:\n            return json.load(f)\n    except FileNotFoundError:\n        return None\n\ndef save_checkpoint(lines_processed):\n    with open('.checkpoint', 'w') as f:\n        json.dump({'lines_processed': lines_processed}, f)\n        f.flush()\n        os.fsync(f.fileno())\n\ndef process_batch(conn, batch):\n    aggregates = {}\n    for event in batch:\n        cat = event['category']\n        if cat not in aggregates:\n            aggregates[cat] = {'total': 0, 'count': 0}\n        aggregates[cat]['total'] += event['value']\n        aggregates[cat]['count'] += 1\n\n    for cat, data in aggregates.items():\n        conn.execute('INSERT OR IGNORE INTO summary VALUES (?, 0, 0)', (cat,))\n        conn.execute('UPDATE summary SET total_value = total_value + ?, count = count + ? WHERE category = ?',\n                     (data['total'], data['"]
[257.114455, "i", "count'], cat))\n    conn.commit()\n\ndef process():\n    conn = sqlite3.connect('output/summary.db')\n    conn.execute('CREATE TABLE IF NOT EXISTS summary (category TEXT PRIMARY KEY, total_value REAL, count INTEGER)')\n\n    checkpoint = load_checkpoint()\n    start_from = checkpoint['lines_processed'] if checkpoint else 0\n    \n    print(f\"Starting from line {start_from}\")\n\n    with open('data/events.json', 'r') as f:\n        batch = []\n        lines_processed = 0\n        for i, line in enumerate(f):\n            if i < start_from:\n                continue\n            batch.append(json.loads(line))\n            lines_processed = i + 1\n            \n            # Simulate crash at specific line\n            if lines_processed == CRASH_AT_LINE:\n                save_checkpoint(lines_processed)\n                print(f\"SIMULATED CRASH at line {lines_processed}\")\n                sys.exit(1)\n            \n            if len(batch) >= BATCH_SIZE:\n                process_batch(conn, batch)\n                save_checkpoint(lines_pro"]
[257.114496, "i", "cessed)\n                print(f\"Processed batch, checkpoint at line {lines_processed}\")\n                batch = []\n        if batch:\n            process_batch(conn, batch)\n            save_checkpoint(lines_processed)\n            print(f\"Processed final batch, checkpoint at line {lines_processed}\")\n\n    conn.commit()\n    conn.close()\n    print(\"Processing complete!\")\n\nif __name__ == '__main__':\n    process()\nEOF\n"]
