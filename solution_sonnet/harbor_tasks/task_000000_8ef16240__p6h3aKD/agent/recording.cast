[257.122906, "o", "\u001b[?2004h"]
[257.122931, "o", "> "]
[257.12299, "o", "                batch = []\r\n\u001b[?2004l\r"]
[257.123019, "o", "\u001b[?2004h> "]
[257.123085, "o", "        if batch:\r\n\u001b[?2004l\r"]
[257.123114, "o", "\u001b[?2004h"]
[257.123151, "o", "> "]
[257.123224, "o", "            process_batch(conn, batch)\r\n\u001b[?2004l\r"]
[257.12325, "o", "\u001b[?2004h"]
[257.123285, "o", "> "]
[257.12338, "o", "            save_checkpoint(lines_processed)\r\n\u001b[?2004l\r"]
[257.12341, "o", "\u001b[?2004h> "]
[257.123638, "o", "            print(f\"Processed final batch, checkpoint at line {lines_processed}\")\r\n\u001b[?2004l\r"]
[257.123666, "o", "\u001b[?2004h> "]
[257.123685, "o", "\r\n\u001b[?2004l\r"]
[257.123715, "o", "\u001b[?2004h> "]
[257.123756, "o", "    conn.commit()\r\n\u001b[?2004l\r"]
[257.123778, "o", "\u001b[?2004h"]
[257.123806, "o", "> "]
