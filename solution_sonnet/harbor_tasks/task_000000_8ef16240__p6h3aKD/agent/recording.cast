[257.11921, "o", "\u001b[?2004h> "]
[257.11953, "o", "    conn.execute('CREATE TABLE IF NOT EXISTS summary (category TEXT PRIMARY KEY, total_value REAL, count INTEGER)')\r\n\u001b[?2004l\r"]
