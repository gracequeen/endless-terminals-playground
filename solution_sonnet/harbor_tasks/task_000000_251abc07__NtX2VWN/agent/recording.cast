[26.549127, "i", "awk '\n/\\/api\\/v[0-9]+\\/internal\\// {\n  if ($1 !~ /^10\\./) {\n    # Extract timestamp\n    match($0, /\\[([^\\]]+)\\]/, ts);\n    timestamp = ts[1];\n    \n    # Parse: 23/Aug/2024:03:38:50 +0000\n    split(timestamp, parts, /[:\\/]/);\n    day = parts[1];\n    month = parts[2];\n    year = parts[3];\n    time = parts[4] \":\" parts[5] \":\" parts[6];\n    \n    # Convert month name to number\n    months[\"Jan\"]=\"01\"; months[\"Feb\"]=\"02\"; months[\"Mar\"]=\"03\";\n    months[\"Apr\"]=\"04\"; months[\"May\"]=\"05\"; months[\"Jun\"]=\"06\";\n    months[\"Jul\"]=\"07\"; months[\"Aug\"]=\"08\"; months[\"Sep\"]=\"09\";\n    months[\"Oct\"]=\"10\"; months[\"Nov\"]=\"11\"; months[\"Dec\"]=\"12\";\n    \n    iso_timestamp = year \"-\" months[month] \"-\" day \"T\" time;\n    \n    # Replace timestamp in the line\n    sub(/\\[[^\\]]+\\]/, iso_timestamp);\n    print;\n  }\n}' /var/log/app/access.log > /home/user/internal_hits.log\n"]
