[30.149779, "i", "cat > /home/user/backup.sh << 'EOF'\n#!/bin/bash\n\n# Backup script that copies readable files from /home/user/projects to /home/user/backups\n# and creates a manifest with ownership information\n\nSOURCE_DIR=\"/home/user/projects\"\nBACKUP_DIR=\"/home/user/backups\"\nMANIFEST=\"${BACKUP_DIR}/manifest.txt\"\n\n# Initialize manifest\necho \"Backup Manifest - $(date)\" > \"$MANIFEST\"\necho \"Format: filepath owner:group\" >> \"$MANIFEST\"\necho \"\" >> \"$MANIFEST\"\n\n# Find all files in source directory (suppress permission errors)\nfind \"$SOURCE_DIR\" -type f 2>/dev/null | while read -r filepath; do\n    # Test if file is readable\n    if [ -r \"$filepath\" ]; then\n        # Get relative path from source directory\n        relpath=\"${filepath#$SOURCE_DIR/}\"\n        \n        # Get ownership information\n        ownership=$(stat -c '%U:%G' \"$filepath\" 2>/dev/null)\n        \n        # Create target directory structure\n        target_file=\"${BACKUP_DIR}/${relpath}\"\n        target_dir=$(dirname \"$target_file\")\n        mkdir -p \"$target_dir\" 2>/dev/null\n"]
[30.149909, "i", "        \n        # Copy the file\n        if cp \"$filepath\" \"$target_file\" 2>/dev/null; then\n            # Log to manifest\n            echo \"${relpath} ${ownership}\" >> \"$MANIFEST\"\n        fi\n    fi\ndone\n\necho \"Backup complete. See ${MANIFEST} for details.\"\nEOF\n"]
[30.149988, "o", "cat > /home/user/backup.sh << 'EOF'\r\n\u001b[?2004l\r"]
