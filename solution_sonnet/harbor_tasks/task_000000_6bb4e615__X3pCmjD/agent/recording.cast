[52.72181, "o", "        content = f.read()\r\n\u001b[?2004l\r"]
[52.721837, "o", "\u001b[?2004h> "]
[52.721925, "o", "        hasher.update(content)\r\n\u001b[?2004l\r"]
[52.721953, "o", "\u001b[?2004h> "]
[52.722039, "o", "    return hasher.hexdigest()\r\n\u001b[?2004l\r"]
[52.722069, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.722094, "o", "\u001b[?2004h"]
[52.722132, "o", "> "]
[52.722225, "o", "def load_manifest(manifest_path):\r\n\u001b[?2004l\r"]
[52.722256, "o", "\u001b[?2004h"]
[52.722285, "o", "> "]
[52.722577, "o", "    \"\"\"Load the manifest file and return a dict of path -> expected_hash.\"\"\"\r\n\u001b[?2004l\r"]
[52.722609, "o", "\u001b[?2004h"]
[52.722639, "o", "> "]
[52.722694, "o", "    manifest = {}\r\n\u001b[?2004l\r"]
[52.722724, "o", "\u001b[?2004h"]
[52.722755, "o", "> "]
[52.722888, "o", "    with open(manifest_path, 'r') as f:\r\n\u001b[?2004l\r"]
[52.72292, "o", "\u001b[?2004h"]
[52.722947, "o", "> "]
[52.723022, "o", "        for line in f:\r\n\u001b[?2004l\r"]
[52.723054, "o", "\u001b[?2004h"]
[52.723085, "o", "> "]
[52.723187, "o", "            line = line.strip()\r\n\u001b[?2004l\r"]
[52.723228, "o", "\u001b[?2004h"]
[52.723258, "o", "> "]
[52.723332, "o", "            if not line:\r\n\u001b[?2004l\r"]
[52.72336, "o", "\u001b[?2004h"]
[52.723385, "o", "> "]
[52.723465, "o", "                continue\r\n\u001b[?2004l\r"]
[52.723511, "o", "\u001b[?2004h"]
[52.723544, "o", "> "]
[52.723705, "o", "            # Format: <hash>  <path> (two spaces)\r\n\u001b[?2004l\r"]
[52.723737, "o", "\u001b[?2004h"]
[52.723774, "o", "> "]
[52.723897, "o", "            parts = line.split('  ', 1)\r\n\u001b[?2004l\r"]
[52.723957, "o", "\u001b[?2004h> "]
[52.724054, "o", "            if len(parts) == 2:\r\n\u001b[?2004l\r"]
[52.724082, "o", "\u001b[?2004h"]
[52.724119, "o", "> "]
[52.724276, "o", "                expected_hash, filepath = parts\r\n\u001b[?2004l\r"]
[52.724309, "o", "\u001b[?2004h"]
[52.724345, "o", "> "]
[52.724552, "o", "                manifest[filepath] = expected_hash.lower()\r\n\u001b[?2004l\r"]
[52.72459, "o", "\u001b[?2004h"]
[52.724606, "o", "> "]
[52.724648, "o", "    return manifest\r\n\u001b[?2004l\r"]
[52.724689, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.724722, "o", "\u001b[?2004h> "]
[52.724782, "o", "def verify_integrity():\r\n\u001b[?2004l\r"]
[52.724812, "o", "\u001b[?2004h"]
[52.724844, "o", "> "]
[52.724917, "o", "    \"\"\"Main verification routine.\"\"\"\r\n\u001b[?2004l\r"]
[52.724952, "o", "\u001b[?2004h> "]
[52.725066, "o", "    if not os.path.exists(MANIFEST_FILE):\r\n\u001b[?2004l\r"]
[52.725094, "o", "\u001b[?2004h> "]
[52.725282, "o", "        print(f\"ERROR: Manifest file '{MANIFEST_FILE}' not found\")\r\n\u001b[?2004l\r"]
[52.725314, "o", "\u001b[?2004h> "]
[52.725374, "o", "        return False\r\n\u001b[?2004l\r"]
[52.725406, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.725436, "o", "\u001b[?2004h> "]
[52.725577, "o", "    manifest = load_manifest(MANIFEST_FILE)\r\n\u001b[?2004l\r"]
[52.725611, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.725639, "o", "\u001b[?2004h> "]
[52.725703, "o", "    if not manifest:\r\n\u001b[?2004l\r"]
[52.725734, "o", "\u001b[?2004h> "]
[52.72585, "o", "        print(\"ERROR: Manifest is empty\")\r\n\u001b[?2004l\r"]
[52.725881, "o", "\u001b[?2004h> "]
[52.725949, "o", "        return False\r\n\u001b[?2004l\r"]
[52.725981, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.726012, "o", "\u001b[?2004h> "]
[52.726143, "o", "    print(f\"Verifying {len(manifest)} files...\")\r\n\u001b[?2004l\r"]
[52.726175, "o", "\u001b[?2004h> "]
[52.72623, "o", "    print(\"-\" * 50)\r\n\u001b[?2004l\r"]
[52.72626, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.726292, "o", "\u001b[?2004h> "]
[52.726342, "o", "    failures = []\r\n\u001b[?2004l\r"]
[52.726374, "o", "\u001b[?2004h> "]
[52.726422, "o", "    successes = 0\r\n\u001b[?2004l\r"]
[52.72645, "o", "\u001b[?2004h> "]
[52.726495, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.726666, "o", "    for filepath, expected_hash in sorted(manifest.items()):\r\n\u001b[?2004l\r"]
[52.726697, "o", "\u001b[?2004h> "]
[52.726811, "o", "        if not os.path.exists(filepath):\r\n\u001b[?2004l\r"]
[52.72684, "o", "\u001b[?2004h> "]
[52.726995, "o", "            print(f\"FAIL: {filepath} - file not found\")\r\n\u001b[?2004l\r"]
[52.727026, "o", "\u001b[?2004h> "]
[52.727127, "o", "            failures.append(filepath)\r\n\u001b[?2004l\r"]
[52.727159, "o", "\u001b[?2004h> "]
[52.727225, "o", "            continue\r\n\u001b[?2004l\r"]
[52.727253, "o", "\u001b[?2004h"]
[52.72728, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[52.727309, "o", "> "]
[52.727341, "o", "        try:\r\n\u001b[?2004l\r"]
[52.727371, "o", "\u001b[?2004h> "]
[52.727509, "o", "            actual_hash = compute_hash(filepath)\r\n\u001b[?2004l\r"]
[52.72754, "o", "\u001b[?2004h> "]
[52.727668, "o", "            if actual_hash == expected_hash:\r\n\u001b[?2004l\r"]
[52.727695, "o", "\u001b[?2004h> "]
[52.727811, "o", "                print(f\"OK: {filepath}\")\r\n\u001b[?2004l\r"]
[52.727839, "o", "\u001b[?2004h"]
[52.727865, "o", "> "]
[52.72793, "o", "                successes += 1\r\n\u001b[?2004l\r"]
[52.727957, "o", "\u001b[?2004h> "]
[52.728012, "o", "            else:\r\n\u001b[?2004l\r"]
[52.72804, "o", "\u001b[?2004h> "]
[52.728205, "o", "                print(f\"FAIL: {filepath} - hash mismatch\")\r\n\u001b[?2004l\r"]
[52.728233, "o", "\u001b[?2004h> "]
[52.728396, "o", "                print(f\"      expected: {expected_hash}\")\r\n\u001b[?2004l\r"]
[52.728424, "o", "\u001b[?2004h> "]
[52.728597, "o", "                print(f\"      actual:   {actual_hash}\")\r\n\u001b[?2004l\r"]
[52.728627, "o", "\u001b[?2004h"]
[52.728658, "o", "> "]
[52.728747, "o", "                failures.append(filepath)\r\n\u001b[?2004l\r"]
[52.728771, "o", "\u001b[?2004h> "]
[52.728863, "o", "        except Exception as e:\r\n\u001b[?2004l\r"]
[52.728887, "o", "\u001b[?2004h> "]
[52.729035, "o", "            print(f\"FAIL: {filepath} - error: {e}\")\r\n\u001b[?2004l\r"]
[52.729062, "o", "\u001b[?2004h> "]
[52.729169, "o", "            failures.append(filepath)\r\n\u001b[?2004l\r"]
[52.729199, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.729229, "o", "\u001b[?2004h> "]
[52.729291, "o", "    print(\"-\" * 50)\r\n\u001b[?2004l\r"]
[52.729323, "o", "\u001b[?2004h> "]
[52.729519, "o", "    print(f\"Results: {successes} passed, {len(failures)} failed\")\r\n\u001b[?2004l\r"]
[52.729553, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.729579, "o", "\u001b[?2004h"]
[52.72961, "o", "> "]
[52.729637, "o", "    if failures:\r\n\u001b[?2004l\r"]
[52.729667, "o", "\u001b[?2004h> "]
[52.729755, "o", "        print(\"\\nFailed files:\")\r\n\u001b[?2004l\r"]
[52.729783, "o", "\u001b[?2004h> "]
[52.729861, "o", "        for f in failures:\r\n\u001b[?2004l\r"]
[52.729888, "o", "\u001b[?2004h> "]
[52.729973, "o", "            print(f\"  - {f}\")\r\n\u001b[?2004l\r"]
[52.730001, "o", "\u001b[?2004h> "]
[52.730062, "o", "        return False\r\n\u001b[?2004l\r"]
[52.73009, "o", "\u001b[?2004h> "]
[52.73012, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.730258, "o", "    print(\"\\nAll files verified successfully!\")\r\n\u001b[?2004l\r"]
[52.730288, "o", "\u001b[?2004h> "]
[52.730338, "o", "    return True\r\n\u001b[?2004l\r"]
[52.730369, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.730397, "o", "\u001b[?2004h> "]
[52.730493, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[52.730523, "o", "\u001b[?2004h> "]
[52.730618, "o", "    success = verify_integrity()\r\n\u001b[?2004l\r"]
[52.730649, "o", "\u001b[?2004h> "]
[52.730747, "o", "    sys.exit(0 if success else 1)\r\n\u001b[?2004l\r"]
[52.730774, "o", "\u001b[?2004h> "]
[52.730799, "o", "EOF\r\n\u001b[?2004l\r"]
[52.733621, "o", "\u001b[?2004h"]
[52.733655, "o", "root@dc16f7d76fd8:/home/user/audit# "]
