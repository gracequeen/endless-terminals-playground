[39.729541, "o", "sqlite3 survey.db \".schema responses\"\r\n\u001b[?2004l\r"]
[39.731602, "o", "CREATE TABLE responses (\r\n        id INTEGER PRIMARY KEY,\r\n        email TEXT,\r\n        response TEXT,\r\n        submitted_at TEXT\r\n    );\r\n"]
[39.731898, "o", "\u001b[?2004h"]
