[51.173537, "i", "cat > clean.sql << 'EOF'\nDROP TABLE IF EXISTS responses_clean;\nCREATE TABLE responses_clean AS\nSELECT r.*\nFROM responses r\nINNER JOIN (\n    SELECT email, MIN(submitted_at) as first_sub\n    FROM responses\n    WHERE email IS NOT NULL\n    GROUP BY email\n) earliest ON r.email = earliest.email AND r.submitted_at = earliest.first_sub\nUNION ALL\nSELECT r.*\nFROM responses r\nWHERE r.email IS NULL\nAND r.submitted_at = (\n    SELECT MIN(submitted_at)\n    FROM responses\n    WHERE email IS NULL\n);\nEOF\n"]
