[35.179397, "o", "> "]
[35.179521, "o", "    new_key_id = hashlib.sha256(new_key).digest()\r\n\u001b[?2004l\r"]
[35.179552, "o", "\u001b[?2004h"]
[35.179585, "o", ">     \r\n\u001b[?2004l\r"]
[35.179615, "o", "\u001b[?2004h> "]
[35.179721, "o", "    # Open input file once and read header\r\n\u001b[?2004l\r"]
[35.179749, "o", "\u001b[?2004h> "]
[35.179855, "o", "    with open(VAULT_DUMP, \"rb\") as f:\r\n\u001b[?2004l\r"]
[35.179886, "o", "\u001b[?2004h"]
[35.179915, "o", "> "]
[35.179963, "o", "        header = f.read(42)\r\n\u001b[?2004l\r"]
[35.17999, "o", "\u001b[?2004h> "]
