[35.180096, "o", "\u001b[?2004h> "]
[35.180259, "o", "        entry_count = struct.unpack(\"<I\", header[6:10])[0]\r\n\u001b[?2004l\r"]
[35.180289, "o", "\u001b[?2004h> "]
[35.180385, "o", "        old_key_id = header[10:42]\r\n\u001b[?2004l\r"]
[35.180412, "o", "\u001b[?2004h> "]
[35.180443, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.180471, "o", "> "]
[35.180552, "o", "        if magic != b\"VAULT1\":\r\n\u001b[?2004l\r"]
