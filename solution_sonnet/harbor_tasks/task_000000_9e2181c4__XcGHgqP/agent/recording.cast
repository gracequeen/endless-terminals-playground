[35.178946, "o", "\u001b[?2004h> "]
[35.17905, "o", "    with open(NEW_KEY_FILE, \"rb\") as f:\r\n\u001b[?2004l\r"]
[35.179075, "o", "\u001b[?2004h> "]
[35.179154, "o", "        new_key = f.read()\r\n\u001b[?2004l\r"]
[35.179179, "o", "\u001b[?2004h> "]
[35.179207, "o", "    \r\n\u001b[?2004l\r"]
[35.179234, "o", "\u001b[?2004h> "]
[35.17934, "o", "    # Compute new key_id for header\r\n\u001b[?2004l\r"]
