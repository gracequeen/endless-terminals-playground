[35.183882, "o", "> "]
[35.183983, "o", "                if (i + 1) % 10000 == 0:\r\n\u001b[?2004l\r"]
[35.184008, "o", "\u001b[?2004h> "]
[35.184201, "o", "                    print(f\"Processed {i + 1}/{entry_count} entries\")\r\n\u001b[?2004l\r"]
[35.184224, "o", "\u001b[?2004h"]
[35.184255, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[35.184283, "o", "> "]
