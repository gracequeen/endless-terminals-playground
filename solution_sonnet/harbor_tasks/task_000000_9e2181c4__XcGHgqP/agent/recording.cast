[35.181455, "o", "\u001b[?2004h> "]
[35.181614, "o", "            out.write(struct.pack(\"<I\", entry_count))\r\n\u001b[?2004l\r"]
[35.181642, "o", "\u001b[?2004h> "]
[35.181739, "o", "            out.write(new_key_id)\r\n\u001b[?2004l\r"]
[35.181769, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[35.181802, "o", "\u001b[?2004h"]
[35.181826, "o", "> "]
[35.181938, "o", "            # Process each entry sequentially\r\n\u001b[?2004l\r"]
[35.181961, "o", "\u001b[?2004h"]
[35.181991, "o", "> "]
[35.182081, "o", "            for i in range(entry_count):\r\n\u001b[?2004l\r"]
