[35.18095, "o", "        print(f\"Processing {entry_count} entries...\")\r\n\u001b[?2004l\r"]
[35.180978, "o", "\u001b[?2004h> "]
[35.180997, "o", "\r\n\u001b[?2004l\r"]
[35.181026, "o", "\u001b[?2004h> "]
[35.181149, "o", "        # Open output file once and write header\r\n\u001b[?2004l\r"]
[35.181178, "o", "\u001b[?2004h> "]
[35.181302, "o", "        with open(OUTPUT_FILE, \"wb\") as out:\r\n\u001b[?2004l\r"]
[35.181327, "o", "\u001b[?2004h> "]
