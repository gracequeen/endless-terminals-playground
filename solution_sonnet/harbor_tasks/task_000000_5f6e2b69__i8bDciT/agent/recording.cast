[17.378933, "o", "cat verify_artifacts.sh\r\n\u001b[?2004l\r"]
[17.379845, "o", "#!/bin/bash\r\ncd \"$(dirname \"$0\")/artifacts\"\r\nfailures=0\r\nwhile IFS=' ' read -r expected_sum filename; do\r\n    if [[ -z \"$filename\" ]]; then continue; fi\r\n    actual_sum=$(sha256sum \"$filename\" 2>/dev/null | cut -d' ' -f1)\r\n    if [[ \"$actual_sum\" != \"$expected_sum\" ]]; then\r\n        echo \"FAIL: $filename\"\r\n        ((failures++))\r\n    else\r\n        echo \"OK: $filename\"\r\n    fi\r\ndone < ../checksums.manifest\r\necho \"---\"\r\necho \"Failures: $failures\"\r\nexit $failures\r\n"]
[17.380003, "o", "\u001b[?2004h"]
[17.380034, "o", "root@f1fd6106b6f9:/home/user/qa# "]
