[99.483568, "i", "cat > demonstrate_fix.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Demonstrate the bug fix for timezone conversion.\"\"\"\n\nimport pytz\nfrom datetime import datetime\n\nBERLIN_TZ = pytz.timezone('Europe/Berlin')\nUTC_TZ = pytz.utc\n\ndef buggy_convert_to_berlin(utc_time_str):\n    \"\"\"BUGGY: The old incorrect way - treats UTC time as Berlin time.\"\"\"\n    utc_dt = datetime.strptime(utc_time_str, '%Y-%m-%dT%H:%M:%S')\n    berlin_dt = BERLIN_TZ.localize(utc_dt)  # BUG: This is wrong!\n    return berlin_dt\n\ndef correct_convert_to_berlin(utc_time_str):\n    \"\"\"FIXED: The correct way - converts FROM UTC TO Berlin.\"\"\"\n    utc_dt = datetime.strptime(utc_time_str, '%Y-%m-%dT%H:%M:%S')\n    utc_dt_aware = UTC_TZ.localize(utc_dt)  # Make it UTC-aware\n    berlin_dt = utc_dt_aware.astimezone(BERLIN_TZ)  # Convert to Berlin\n    return berlin_dt\n\nprint(\"=\" * 70)\nprint(\"DEMONSTRATING THE BUG FIX\")\nprint(\"=\" * 70)\nprint()\n\n# Test with the problematic maintenance window time\ntest_cases = [\n    (\"2024-03-31T01:30:00\", \"Maintenance Window - DST transi"]
[99.483617, "i", "tion day\"),\n    (\"2024-03-31T08:00:00\", \"Daily Standup - DST transition day\"),\n    (\"2024-06-15T10:00:00\", \"Summer meeting\"),\n    (\"2024-12-15T10:00:00\", \"Winter meeting\"),\n]\n\nfor utc_time_str, description in test_cases:\n    print(f\"Test: {description}\")\n    print(f\"UTC Time: {utc_time_str}\")\n    print()\n    \n    buggy_result = buggy_convert_to_berlin(utc_time_str)\n    correct_result = correct_convert_to_berlin(utc_time_str)\n    \n    print(f\"  BUGGY (old):   {buggy_result.strftime('%Y-%m-%d %H:%M:%S %Z (UTC%z)')}\")\n    print(f\"  CORRECT (new): {correct_result.strftime('%Y-%m-%d %H:%M:%S %Z (UTC%z)')}\")\n    \n    # Calculate the difference\n    diff = (correct_result - buggy_result).total_seconds() / 3600\n    if diff != 0:\n        print(f\"  ⚠️  DIFFERENCE: {abs(diff):.1f} hour(s) off!\")\n    else:\n        print(f\"  ✓ No difference (both happen to be correct)\")\n    print()\n\nprint(\"=\" * 70)\nprint(\"EXPLANATION OF THE BUG:\")\nprint(\"=\" * 70)\nprint()\nprint(\"The buggy code used: BERLIN_TZ.localize(naive_utc_dateti"]
[99.483734, "i", "me)\")\nprint(\"  - This TREATS the datetime AS IF it's already in Berlin timezone\")\nprint(\"  - It doesn't CONVERT from UTC to Berlin\")\nprint()\nprint(\"The correct code uses: UTC_TZ.localize(naive_dt).astimezone(BERLIN_TZ)\")\nprint(\"  - First makes the datetime UTC-aware\")\nprint(\"  - Then CONVERTS it to Berlin timezone\")\nprint()\nprint(\"This bug caused a 1-hour offset, especially problematic during DST\")\nprint(\"transitions when the 2am-3am hour is skipped or repeated.\")\nEOF\n"]
[99.483745, "o", "cat > demonstrate_fix.py << 'EOF'\r\n\u001b[?2004l\r"]
[99.483838, "o", "me)\")\r\nprint(\"  - This TREATS the datetime AS IF it's already in Berlin timezone\")\r\nprint(\"  - It doesn't CONVERT from UTC to Berlin\")\r\nprint()\r\nprint(\"The correct code uses: UTC_TZ.localize(naive_dt).astimezone(BERLIN_TZ)\")\r\nprint(\"  - First makes the datetime UTC-aware\")\r\nprint(\"  - Then CONVERTS it to Berlin timezone\")\r\nprint()\r\nprint(\"This bug caused a 1-hour offset, especially problematic during DST\")\r\nprint(\"transitions when the 2am-3am hour is skipped or repeated.\")\r\nEOF\r\n\u001b[?2004h"]
[99.483878, "o", "> "]
