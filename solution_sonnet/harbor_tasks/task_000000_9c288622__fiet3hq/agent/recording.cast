[99.484179, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.484242, "o", "import pytz\r\n\u001b[?2004l\r"]
[99.48427, "o", "\u001b[?2004h> "]
[99.484357, "o", "from datetime import datetime\r\n\u001b[?2004l\r"]
[99.484388, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[99.484414, "o", "\u001b[?2004h> "]
[99.484537, "o", "BERLIN_TZ = pytz.timezone('Europe/Berlin')\r\n\u001b[?2004l\r"]
[99.484561, "o", "\u001b[?2004h> "]
[99.484617, "o", "UTC_TZ = pytz.utc\r\n\u001b[?2004l\r"]
[99.484644, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[99.48467, "o", "\u001b[?2004h"]
[99.48468, "o", "> "]
[99.484797, "o", "def buggy_convert_to_berlin(utc_time_str):\r\n\u001b[?2004l\r"]
[99.484833, "o", "\u001b[?2004h> "]
[99.485028, "o", "    \"\"\"BUGGY: The old incorrect way - treats UTC time as Berlin time.\"\"\"\r\n\u001b[?2004l\r"]
[99.485053, "o", "\u001b[?2004h> "]
[99.485256, "o", "    utc_dt = datetime.strptime(utc_time_str, '%Y-%m-%dT%H:%M:%S')\r\n\u001b[?2004l\r"]
[99.485287, "o", "\u001b[?2004h> "]
[99.485467, "o", "    berlin_dt = BERLIN_TZ.localize(utc_dt)  # BUG: This is wrong!\r\n\u001b[?2004l\r"]
[99.48549, "o", "\u001b[?2004h"]
[99.485519, "o", "> "]
[99.485559, "o", "    return berlin_dt\r\n\u001b[?2004l\r"]
[99.485583, "o", "\u001b[?2004h> "]
[99.485607, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.485635, "o", "> "]
[99.485741, "o", "def correct_convert_to_berlin(utc_time_str):\r\n\u001b[?2004l\r"]
[99.48577, "o", "\u001b[?2004h> "]
[99.485951, "o", "    \"\"\"FIXED: The correct way - converts FROM UTC TO Berlin.\"\"\"\r\n\u001b[?2004l\r"]
[99.485977, "o", "\u001b[?2004h> "]
[99.486158, "o", "    utc_dt = datetime.strptime(utc_time_str, '%Y-%m-%dT%H:%M:%S')\r\n\u001b[?2004l\r"]
[99.486202, "o", "\u001b[?2004h> "]
[99.486386, "o", "    utc_dt_aware = UTC_TZ.localize(utc_dt)  # Make it UTC-aware\r\n\u001b[?2004l\r"]
[99.48641, "o", "\u001b[?2004h"]
[99.486443, "o", "> "]
[99.486619, "o", "    berlin_dt = utc_dt_aware.astimezone(BERLIN_TZ)  # Convert to Berlin\r\n\u001b[?2004l\r"]
[99.486642, "o", "\u001b[?2004h> "]
[99.486707, "o", "    return berlin_dt\r\n\u001b[?2004l\r"]
[99.48673, "o", "\u001b[?2004h"]
[99.486758, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[99.486788, "o", "> "]
[99.486815, "o", "print(\"=\" * 70)\r\n\u001b[?2004l\r"]
[99.486845, "o", "\u001b[?2004h> "]
[99.486943, "o", "print(\"DEMONSTRATING THE BUG FIX\")\r\n\u001b[?2004l\r"]
[99.486971, "o", "\u001b[?2004h> "]
[99.487021, "o", "print(\"=\" * 70)\r\n\u001b[?2004l\r"]
[99.487057, "o", "\u001b[?2004h> "]
[99.487087, "o", "print()\r\n\u001b[?2004l\r"]
[99.487116, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[99.487153, "o", "\u001b[?2004h> "]
[99.487294, "o", "# Test with the problematic maintenance window time\r\n\u001b[?2004l\r"]
[99.487323, "o", "\u001b[?2004h> "]
[99.48737, "o", "test_cases = [\r\n\u001b[?2004l\r"]
[99.487398, "o", "\u001b[?2004h> "]
[99.487597, "o", "    (\"2024-03-31T01:30:00\", \"Maintenance Window - DST transition day\"),\r\n\u001b[?2004l\r"]
[99.487621, "o", "\u001b[?2004h"]
[99.487651, "o", "> "]
[99.487813, "o", "    (\"2024-03-31T08:00:00\", \"Daily Standup - DST transition day\"),\r\n\u001b[?2004l\r"]
[99.487838, "o", "\u001b[?2004h"]
[99.487874, "o", "> "]
[99.487988, "o", "    (\"2024-06-15T10:00:00\", \"Summer meeting\"),\r\n\u001b[?2004l\r"]
[99.488024, "o", "\u001b[?2004h> "]
[99.488146, "o", "    (\"2024-12-15T10:00:00\", \"Winter meeting\"),\r\n\u001b[?2004l\r"]
[99.488174, "o", "\u001b[?2004h> "]
[99.488217, "o", "]\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.488247, "o", "> \r\n\u001b[?2004l\r"]
[99.488274, "o", "\u001b[?2004h> "]
[99.488389, "o", "for utc_time_str, description in test_cases:\r\n\u001b[?2004l\r"]
[99.488424, "o", "\u001b[?2004h"]
[99.48846, "o", "> "]
[99.48851, "o", "    print(f\"Test: {description}\")\r\n\u001b[?2004l\r"]
[99.488538, "o", "\u001b[?2004h> "]
[99.488648, "o", "    print(f\"UTC Time: {utc_time_str}\")\r\n\u001b[?2004l\r"]
[99.488683, "o", "\u001b[?2004h> "]
[99.488712, "o", "    print()\r\n\u001b[?2004l\r"]
[99.488742, "o", "\u001b[?2004h> "]
[99.488768, "o", "    \r\n\u001b[?2004l\r"]
[99.488796, "o", "\u001b[?2004h> "]
[99.488947, "o", "    buggy_result = buggy_convert_to_berlin(utc_time_str)\r\n\u001b[?2004l\r"]
[99.488973, "o", "\u001b[?2004h> "]
[99.489146, "o", "    correct_result = correct_convert_to_berlin(utc_time_str)\r\n\u001b[?2004l\r"]
[99.48917, "o", "\u001b[?2004h"]
[99.489214, "o", ">     \r\n\u001b[?2004l\r"]
[99.489242, "o", "\u001b[?2004h> "]
[99.489473, "o", "    print(f\"  BUGGY (old):   {buggy_result.strftime('%Y-%m-%d %H:%M:%S %Z (UTC%z)')}\")\r\n\u001b[?2004l\r"]
[99.489496, "o", "\u001b[?2004h"]
[99.489521, "o", "> "]
[99.489746, "o", "    print(f\"  CORRECT (new): {correct_result.strftime('%Y-%m-%d %H:%M:%S %Z (UTC%z)')}\")\r\n\u001b[?2004l\r"]
[99.489781, "o", "\u001b[?2004h"]
[99.489807, "o", ">     \r\n\u001b[?2004l\r"]
[99.489834, "o", "\u001b[?2004h> "]
[99.489912, "o", "    # Calculate the difference\r\n\u001b[?2004l\r"]
[99.489942, "o", "\u001b[?2004h> "]
[99.490123, "o", "    diff = (correct_result - buggy_result).total_seconds() / 3600\r\n\u001b[?2004l\r"]
[99.490149, "o", "\u001b[?2004h> "]
[99.490218, "o", "    if diff != 0:\r\n\u001b[?2004l\r"]
[99.490248, "o", "\u001b[?2004h> "]
[99.490439, "o", "        print(f\"  ⚠️  DIFFERENCE: {abs(diff):.1f} hour(s) off!\")\r\n\u001b[?2004l\r"]
[99.490465, "o", "\u001b[?2004h> "]
[99.490498, "o", "    else:\r\n\u001b[?2004l\r"]
[99.49052, "o", "\u001b[?2004h"]
[99.490546, "o", "> "]
[99.490709, "o", "        print(f\"  ✓ No difference (both happen to be correct)\")\r\n\u001b[?2004l\r"]
[99.490741, "o", "\u001b[?2004h> "]
[99.490773, "o", "    print()\r\n\u001b[?2004l\r"]
[99.490801, "o", "\u001b[?2004h> "]
[99.490832, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.490884, "o", "print(\"=\" * 70)\r\n\u001b[?2004l\r"]
[99.490912, "o", "\u001b[?2004h> "]
[99.491006, "o", "print(\"EXPLANATION OF THE BUG:\")\r\n\u001b[?2004l\r"]
[99.491034, "o", "\u001b[?2004h> "]
[99.491082, "o", "print(\"=\" * 70)\r\n\u001b[?2004l\r"]
[99.491112, "o", "\u001b[?2004h> "]
[99.491147, "o", "print()\r\n\u001b[?2004l\r"]
[99.491176, "o", "\u001b[?2004h> "]
[99.491368, "o", "print(\"The buggy code used: BERLIN_TZ.localize(naive_utc_datetime)\")\r\n\u001b[?2004l\r"]
[99.491404, "o", "\u001b[?2004h> "]
[99.491607, "o", "print(\"  - This TREATS the datetime AS IF it's already in Berlin timezone\")\r\n\u001b[?2004l\r"]
[99.491637, "o", "\u001b[?2004h> "]
[99.491777, "o", "print(\"  - It doesn't CONVERT from UTC to Berlin\")\r\n\u001b[?2004l\r"]
[99.491804, "o", "\u001b[?2004h"]
[99.491814, "o", "> "]
[99.491848, "o", "print()\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.491872, "o", "> "]
[99.492095, "o", "print(\"The correct code uses: UTC_TZ.localize(naive_dt).astimezone(BERLIN_TZ)\")\r\n\u001b[?2004l\r"]
[99.492125, "o", "\u001b[?2004h> "]
[99.492272, "o", "print(\"  - First makes the datetime UTC-aware\")\r\n\u001b[?2004l\r"]
[99.492301, "o", "\u001b[?2004h"]
[99.492331, "o", "> "]
[99.492438, "o", "print(\"  - Then CONVERTS it to Berlin timezone\")\r\n\u001b[?2004l\r"]
