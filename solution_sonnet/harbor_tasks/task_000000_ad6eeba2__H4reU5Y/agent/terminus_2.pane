[?2004l[?2004h> import csv
[?2004l[?2004h> import json
[?2004l[?2004h> import re
[?2004l[?2004h> from datetime import datetime
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> 
[?2004l[?2004h> def parse_date(date_str):
[?2004l[?2004h>     """Parse dates in multiple formats and return ISO 8601 string"""
[?2004l[?2004h>     if not date_str or not date_str.strip():
[?2004l[?2004h>         return None
[?2004l[?2004h>     
[?2004l[?2004h>     date_str = date_str.strip()
[?2004l[?2004h>     formats = [
[?2004l[?2004h>         '%m/%d/%Y',    # MM/DD/YYYY
[?2004l[?2004h>         '%Y-%m-%d',    # YYYY-MM-DD
[?2004l[?2004h>         '%d.%m.%Y',    # DD.MM.YYYY
[?2004l[?2004h>         '%d/%m/%Y',    # DD/MM/YYYY
[?2004l[?2004h>     ]
[?2004l[?2004h>     
[?2004l[?2004h>     for fmt in formats:
[?2004l[?2004h>         try:
[?2004l[?2004h>             dt = datetime.strptime(date_str, fmt)
[?2004l[?2004h>             return dt.strftime('%Y-%m-%d')
[?2004l[?2004h>         except ValueError:
[?2004l[?2004h>             continue
[?2004l[?2004h>     
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> def parse_price(price_str):
[?2004l[?2004h>     """Parse price and convert to cents (integer)"""
[?2004l[?2004h>     if not price_str or not str(price_str).strip():
[?2004l[?2004h>         return None
[?2004l[?2004h>     
[?2004l[?2004h>     price_str = str(price_str).strip()
[?2004l[?2004h>     # Remove dollar signs, commas, and spaces
[?2004l[?2004h>     price_str = price_str.replace('$', '').replace(',', '').replace(' ', '')
[?2004l[?2004h>     
[?2004l[?2004h>     try:
[?2004l[?2004h>         price_float = float(price_str)
[?2004l[?2004h>         if price_float < 0:
[?2004l[?2004h>             return None  # Negative prices are invalid
[?2004l[?2004h>         price_cents = int(round(price_float * 100))
[?2004l[?2004h>         return price_cents if price_cents > 0 else None
[?2004l[?2004h>     except (ValueError, OverflowError):
[?2004l[?2004h>         return None
[?2004l[?2004h> 
[?2004l[?2004h> def is_serial_format(value):
[?2004l[?2004h>     """Check if a value looks like a serial number (starts with SN-)"""
[?2004l[?2004h>     return value and str(value).strip().startswith('SN-')
[?2004l[?2004h> 
[?2004l[?2004h> def process_row(row, row_num):
[?2004l[?2004h>     """Process a single row and return (asset_dict, error_message)"""
[?2004l[?2004h>     try:
[?2004l[?2004h>         asset_id = row.get('id', '').strip()
[?2004l[?2004h>         name = row.get('name', '').strip()
[?2004l[?2004h>         serial = row.get('serial', '').strip()
[?2004l[?2004h>         purchase_date_raw = row.get('purchase_date', '').strip()
[?2004l[?2004h>         price_raw = row.get('price', '').strip()
[?2004l[?2004h>         location = row.get('location', '').strip()
[?2004l[?2004h>         
[?2004l[?2004h>         # Check if serial and name are swapped
[?2004l[?2004h>         if not is_serial_format(serial) and is_serial_format(name):
[?2004l[?2004h>             name, serial = serial, name
[?2004l[?2004h>         
[?2004l[?2004h>         # Validate ID
[?2004l[?2004h>         if not asset_id:
[?2004l[?2004h>             return None, "Missing asset ID"
[?2004l[?2004h>         
[?2004l[?2004h>         # Parse date
[?2004l[?2004h>         purchase_date = parse_date(purchase_date_raw)
[?2004l[?2004h>         if not purchase_date:
[?2004l[?2004h>             return None, f"Invalid purchase date: {purchase_date_raw}"
[?2004l[?2004h>         
[?2004l[?2004h>         # Parse price
[?2004l[?2004h>         price_cents = parse_price(price_raw)
[?2004l[?2004h>         if price_cents is None:
[?2004l[?2004h>             return None, f"Invalid price: {price_raw}"
[?2004l[?2004h>         
[?2004l[?2004h>         # Validate required fields
[?2004l[?2004h>         if not name:
[?2004l[?2004h>             return None, "Missing name"
[?2004l[?2004h>         if not serial:
[?2004l[?2004h>             return None, "Missing serial"
[?2004l[?2004h>         if not location:
[?2004l[?2004h>             return None, "Missing location"
[?2004l[?2004h>         
[?2004l[?2004h>         asset = {
[?2004l[?2004h>             'id': asset_id,
[?2004l[?2004h>             'name': name,
[?2004l[?2004h>             'serial': serial,
[?2004l[?2004h>             'purchase_date': purchase_date,
[?2004l[?2004h>             'price_cents': price_cents,
[?2004l[?2004h>             'location': location
[?2004l[?2004h>         }
[?2004l[?2004h>         
[?2004l[?2004h>         return asset, None
[?2004l[?2004h>         
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         return None, f"Processing error: {str(e)}"
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     input_file = '/home/user/inventory/assets.csv'
[?2004l[?2004h>     output_file = '/home/user/inventory/assets.json'
[?2004l[?2004h>     rejected_file = '/home/user/inventory/rejected.json'
[?2004l[?2004h>     
[?2004l[?2004h>     assets_by_id = {}  # For deduplication
[?2004l[?2004h>     rejected = []
[?2004l[?2004h>     
[?2004l[?2004h>     with open(input_file, 'r', encoding='utf-8') as f:
[?2004l[?2004h>         reader = csv.DictReader(f)
[?2004l[?2004h>         
[?2004l[?2004h>         for row_num, row in enumerate(reader, start=2):  # Start at 2 (header is row 1)
[?2004l[?2004h>             asset, error = process_row(row, row_num)
[?2004l[?2004h>             
[?2004l[?2004h>             if error:
[?2004l[?2004h>                 rejected.append({
[?2004l[?2004h>                     'original_row': dict(row),
[?2004l[?2004h>                     'reason': error,
[?2004l[?2004h>                     'row_number': row_num
[?2004l[?2004h>                 })
[?2004l[?2004h>             else:
[?2004l[?2004h>                 asset_id = asset['id']
[?2004l[?2004h>                 # Handle duplicates: keep the one with latest purchase date
[?2004l[?2004h>                 if asset_id in assets_by_id:
[?2004l[?2004h>                     existing_date = assets_by_id[asset_id]['purchase_date']
[?2004l[?2004h>                     new_date = asset['purchase_date']
[?2004l[?2004h>                     if new_date > existing_date:
[?2004l[?2004h>                         assets_by_id[asset_id] = asset
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     assets_by_id[asset_id] = asset
[?2004l[?2004h>     
[?2004l[?2004h>     # Convert to list sorted by ID
[?2004l[?2004h>     assets_list = [assets_by_id[aid] for aid in sorted(assets_by_id.keys())]
[?2004l[?2004h>     
[?2004l[?2004h>     # Write output files
[?2004l[?2004h>     with open(output_file, 'w', encoding='utf-8') as f:
[?2004l[?2004h>         json.dump(assets_list, f, indent=2)
[?2004l[?2004h>     
[?2004l[?2004h>     with open(rejected_file, 'w', encoding='utf-8') as f:
[?2004l[?2004h>         json.dump(rejected, f, indent=2)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"Processed {len(assets_list)} valid assets")
[?2004l[?2004h>     print(f"Rejected {len(rejected)} invalid rows")
[?2004l[?2004h>     print(f"Output written to {output_file}")
[?2004l[?2004h>     print(f"Rejected rows written to {rejected_file}")
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == '__main__':
[?2004l[?2004h>     main()
[?2004l[?2004h> EOF
