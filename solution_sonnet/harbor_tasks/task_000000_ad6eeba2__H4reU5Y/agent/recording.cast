[52.471469, "i", "cat > /home/user/inventory/process_assets.py << 'EOF'\nimport csv\nimport json\nimport re\nfrom datetime import datetime\nfrom collections import defaultdict\n\ndef parse_date(date_str):\n    \"\"\"Parse dates in multiple formats and return ISO 8601 string\"\"\"\n    if not date_str or not date_str.strip():\n        return None\n    \n    date_str = date_str.strip()\n    formats = [\n        '%m/%d/%Y',    # MM/DD/YYYY\n        '%Y-%m-%d',    # YYYY-MM-DD\n        '%d.%m.%Y',    # DD.MM.YYYY\n        '%d/%m/%Y',    # DD/MM/YYYY\n    ]\n    \n    for fmt in formats:\n        try:\n            dt = datetime.strptime(date_str, fmt)\n            return dt.strftime('%Y-%m-%d')\n        except ValueError:\n            continue\n    \n    return None\n\ndef parse_price(price_str):\n    \"\"\"Parse price and convert to cents (integer)\"\"\"\n    if not price_str or not str(price_str).strip():\n        return None\n    \n    price_str = str(price_str).strip()\n    # Remove dollar signs, commas, and spaces\n    price_str = price_str.replace('$', '').replace(',', '')"]
[52.471503, "i", ".replace(' ', '')\n    \n    try:\n        price_float = float(price_str)\n        if price_float < 0:\n            return None  # Negative prices are invalid\n        price_cents = int(round(price_float * 100))\n        return price_cents if price_cents > 0 else None\n    except (ValueError, OverflowError):\n        return None\n\ndef is_serial_format(value):\n    \"\"\"Check if a value looks like a serial number (starts with SN-)\"\"\"\n    return value and str(value).strip().startswith('SN-')\n\ndef process_row(row, row_num):\n    \"\"\"Process a single row and return (asset_dict, error_message)\"\"\"\n    try:\n        asset_id = row.get('id', '').strip()\n        name = row.get('name', '').strip()\n        serial = row.get('serial', '').strip()\n        purchase_date_raw = row.get('purchase_date', '').strip()\n        price_raw = row.get('price', '').strip()\n        location = row.get('location', '').strip()\n        \n        # Check if serial and name are swapped\n        if not is_serial_format(serial) and is_serial_format(name):\n       "]
[52.47159, "i", "     name, serial = serial, name\n        \n        # Validate ID\n        if not asset_id:\n            return None, \"Missing asset ID\"\n        \n        # Parse date\n        purchase_date = parse_date(purchase_date_raw)\n        if not purchase_date:\n            return None, f\"Invalid purchase date: {purchase_date_raw}\"\n        \n        # Parse price\n        price_cents = parse_price(price_raw)\n        if price_cents is None:\n            return None, f\"Invalid price: {price_raw}\"\n        \n        # Validate required fields\n        if not name:\n            return None, \"Missing name\"\n        if not serial:\n            return None, \"Missing serial\"\n        if not location:\n            return None, \"Missing location\"\n        \n        asset = {\n            'id': asset_id,\n            'name': name,\n            'serial': serial,\n            'purchase_date': purchase_date,\n            'price_cents': price_cents,\n            'location': location\n        }\n        \n        return asset, None\n        \n    except Exception "]
[52.471652, "i", "as e:\n        return None, f\"Processing error: {str(e)}\"\n\ndef main():\n    input_file = '/home/user/inventory/assets.csv'\n    output_file = '/home/user/inventory/assets.json'\n    rejected_file = '/home/user/inventory/rejected.json'\n    \n    assets_by_id = {}  # For deduplication\n    rejected = []\n    \n    with open(input_file, 'r', encoding='utf-8') as f:\n        reader = csv.DictReader(f)\n        \n        for row_num, row in enumerate(reader, start=2):  # Start at 2 (header is row 1)\n            asset, error = process_row(row, row_num)\n            \n            if error:\n                rejected.append({\n                    'original_row': dict(row),\n                    'reason': error,\n                    'row_number': row_num\n                })\n            else:\n                asset_id = asset['id']\n                # Handle duplicates: keep the one with latest purchase date\n                if asset_id in assets_by_id:\n                    existing_date = assets_by_id[asset_id]['purchase_date']\n              "]
[52.471695, "i", "      new_date = asset['purchase_date']\n                    if new_date > existing_date:\n                        assets_by_id[asset_id] = asset\n                else:\n                    assets_by_id[asset_id] = asset\n    \n    # Convert to list sorted by ID\n    assets_list = [assets_by_id[aid] for aid in sorted(assets_by_id.keys())]\n    \n    # Write output files\n    with open(output_file, 'w', encoding='utf-8') as f:\n        json.dump(assets_list, f, indent=2)\n    \n    with open(rejected_file, 'w', encoding='utf-8') as f:\n        json.dump(rejected, f, indent=2)\n    \n    print(f\"Processed {len(assets_list)} valid assets\")\n    print(f\"Rejected {len(rejected)} invalid rows\")\n    print(f\"Output written to {output_file}\")\n    print(f\"Rejected rows written to {rejected_file}\")\n\nif __name__ == '__main__':\n    main()\nEOF\n"]
