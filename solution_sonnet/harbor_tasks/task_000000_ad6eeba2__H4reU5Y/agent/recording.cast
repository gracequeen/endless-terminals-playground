[52.480484, "o", "            name, serial = serial, name\r\n\u001b[?2004l\r"]
[52.480512, "o", "\u001b[?2004h> "]
[52.480546, "o", "        \r\n\u001b[?2004l\r"]
[52.480572, "o", "\u001b[?2004h> "]
[52.480635, "o", "        # Validate ID\r\n\u001b[?2004l\r"]
[52.48066, "o", "\u001b[?2004h"]
[52.480686, "o", "> "]
[52.480738, "o", "        if not asset_id:\r\n\u001b[?2004l\r"]
[52.480765, "o", "\u001b[?2004h> "]
[52.480901, "o", "            return None, \"Missing asset ID\"\r\n\u001b[?2004l\r"]
[52.48093, "o", "\u001b[?2004h> "]
[52.480957, "o", "        \r\n"]
[52.480984, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[52.481049, "o", "        # Parse date\r\n\u001b[?2004l\r"]
[52.481095, "o", "\u001b[?2004h> "]
[52.481238, "o", "        purchase_date = parse_date(purchase_date_raw)\r\n\u001b[?2004l\r"]
[52.481264, "o", "\u001b[?2004h> "]
[52.48135, "o", "        if not purchase_date:\r\n\u001b[?2004l\r"]
[52.481376, "o", "\u001b[?2004h"]
[52.481407, "o", "> "]
[52.481577, "o", "            return None, f\"Invalid purchase date: {purchase_date_raw}\"\r\n\u001b[?2004l\r"]
[52.481604, "o", "\u001b[?2004h> "]
[52.481634, "o", "        \r\n\u001b[?2004l\r"]
[52.481664, "o", "\u001b[?2004h> "]
[52.481731, "o", "        # Parse price\r\n\u001b[?2004l\r"]
[52.481757, "o", "\u001b[?2004h"]
[52.481782, "o", "> "]
[52.481886, "o", "        price_cents = parse_price(price_raw)\r\n\u001b[?2004l\r"]
[52.481913, "o", "\u001b[?2004h> "]
[52.482001, "o", "        if price_cents is None:\r\n\u001b[?2004l\r"]
[52.482028, "o", "\u001b[?2004h> "]
[52.482194, "o", "            return None, f\"Invalid price: {price_raw}\"\r\n\u001b[?2004l\r"]
[52.482222, "o", "\u001b[?2004h> "]
[52.482249, "o", "        \r\n\u001b[?2004l\r"]
[52.482279, "o", "\u001b[?2004h> "]
[52.482377, "o", "        # Validate required fields\r\n\u001b[?2004l\r"]
[52.482403, "o", "\u001b[?2004h> "]
[52.482466, "o", "        if not name:\r\n\u001b[?2004l\r"]
[52.482491, "o", "\u001b[?2004h> "]
[52.482607, "o", "            return None, \"Missing name\"\r\n\u001b[?2004l\r"]
[52.482633, "o", "\u001b[?2004h> "]
[52.482702, "o", "        if not serial:\r\n\u001b[?2004l\r"]
[52.482729, "o", "\u001b[?2004h> "]
[52.482847, "o", "            return None, \"Missing serial\"\r\n\u001b[?2004l\r"]
[52.482873, "o", "\u001b[?2004h> "]
[52.482946, "o", "        if not location:\r\n\u001b[?2004l\r"]
[52.482976, "o", "\u001b[?2004h> "]
[52.483109, "o", "            return None, \"Missing location\"\r\n\u001b[?2004l\r"]
[52.48314, "o", "\u001b[?2004h> "]
[52.483173, "o", "        \r\n\u001b[?2004l\r"]
[52.483205, "o", "\u001b[?2004h> "]
[52.483247, "o", "        asset = {\r\n\u001b[?2004l\r"]
[52.483277, "o", "\u001b[?2004h> "]
[52.483358, "o", "            'id': asset_id,\r\n\u001b[?2004l\r"]
[52.483383, "o", "\u001b[?2004h"]
[52.483408, "o", "> "]
[52.483463, "o", "            'name': name,\r\n\u001b[?2004l\r"]
[52.483489, "o", "\u001b[?2004h"]
[52.483519, "o", "> "]
[52.483579, "o", "            'serial': serial,\r\n\u001b[?2004l\r"]
[52.483607, "o", "\u001b[?2004h> "]
[52.483732, "o", "            'purchase_date': purchase_date,\r\n\u001b[?2004l\r"]
[52.483762, "o", "\u001b[?2004h> "]
[52.483875, "o", "            'price_cents': price_cents,\r\n\u001b[?2004l\r"]
[52.4839, "o", "\u001b[?2004h"]
[52.483931, "o", "> "]
[52.483998, "o", "            'location': location\r\n\u001b[?2004l\r"]
[52.484024, "o", "\u001b[?2004h> "]
[52.484071, "o", "        }\r\n\u001b[?2004l\r"]
[52.484105, "o", "\u001b[?2004h> "]
[52.484131, "o", "        \r\n\u001b[?2004l\r"]
[52.484156, "o", "\u001b[?2004h> "]
[52.484232, "o", "        return asset, None\r\n\u001b[?2004l\r"]
[52.484258, "o", "\u001b[?2004h> "]
[52.484289, "o", "        \r\n\u001b[?2004l\r"]
[52.484314, "o", "\u001b[?2004h"]
[52.484339, "o", "> "]
[52.484396, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[52.484421, "o", "\u001b[?2004h"]
[52.484447, "o", "> "]
[52.48457, "o", "        return None, f\"Processing error: {str(e)}\"\r\n\u001b[?2004l\r"]
[52.484596, "o", "\u001b[?2004h> "]
[52.484626, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.484659, "o", "> "]
[52.484685, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.484713, "o", "> "]
[52.484848, "o", "    input_file = '/home/user/inventory/assets.csv'\r\n\u001b[?2004l\r"]
[52.484878, "o", "\u001b[?2004h> "]
[52.485027, "o", "    output_file = '/home/user/inventory/assets.json'\r\n\u001b[?2004l\r"]
[52.485077, "o", "\u001b[?2004h> "]
[52.485224, "o", "    rejected_file = '/home/user/inventory/rejected.json'\r\n\u001b[?2004l\r"]
[52.485251, "o", "\u001b[?2004h> "]
[52.485278, "o", "    \r\n\u001b[?2004l\r"]
[52.485308, "o", "\u001b[?2004h> "]
[52.485426, "o", "    assets_by_id = {}  # For deduplication\r\n\u001b[?2004l\r"]
[52.485453, "o", "\u001b[?2004h"]
[52.48548, "o", "> "]
[52.485509, "o", "    rejected = []\r\n\u001b[?2004l\r"]
[52.485535, "o", "\u001b[?2004h"]
[52.485561, "o", ">     \r\n\u001b[?2004l\r"]
[52.485587, "o", "\u001b[?2004h> "]
[52.485741, "o", "    with open(input_file, 'r', encoding='utf-8') as f:\r\n\u001b[?2004l\r"]
[52.485767, "o", "\u001b[?2004h> "]
[52.485867, "o", "        reader = csv.DictReader(f)\r\n\u001b[?2004l\r"]
[52.485892, "o", "\u001b[?2004h> "]
[52.485918, "o", "        \r\n"]
[52.485944, "o", "\u001b[?2004l\r\u001b[?2004h"]
[52.485969, "o", "> "]
[52.486204, "o", "        for row_num, row in enumerate(reader, start=2):  # Start at 2 (header is row 1)\r\n\u001b[?2004l\r"]
[52.486235, "o", "\u001b[?2004h> "]
[52.486383, "o", "            asset, error = process_row(row, row_num)\r\n\u001b[?2004l\r"]
[52.486409, "o", "\u001b[?2004h"]
[52.48644, "o", "> "]
[52.486466, "o", "            \r\n\u001b[?2004l\r"]
[52.486492, "o", "\u001b[?2004h> "]
[52.486546, "o", "            if error:\r\n\u001b[?2004l\r"]
[52.486576, "o", "\u001b[?2004h> "]
[52.486673, "o", "                rejected.append({\r\n\u001b[?2004l\r"]
[52.486699, "o", "\u001b[?2004h"]
[52.486729, "o", "> "]
[52.486834, "o", "                    'original_row': dict(row),\r\n\u001b[?2004l\r"]
[52.486861, "o", "\u001b[?2004h> "]
[52.486968, "o", "                    'reason': error,\r\n\u001b[?2004l\r"]
[52.486993, "o", "\u001b[?2004h> "]
[52.487124, "o", "                    'row_number': row_num\r\n\u001b[?2004l\r"]
[52.487153, "o", "\u001b[?2004h"]
[52.487179, "o", "> "]
[52.487207, "o", "                })\r\n\u001b[?2004l\r"]
[52.487231, "o", "\u001b[?2004h"]
[52.487259, "o", "> "]
[52.487289, "o", "            else:\r\n\u001b[?2004l\r"]
[52.48732, "o", "\u001b[?2004h> "]
[52.487426, "o", "                asset_id = asset['id']\r\n\u001b[?2004l\r"]
[52.487451, "o", "\u001b[?2004h> "]
[52.487664, "o", "                # Handle duplicates: keep the one with latest purchase date\r\n\u001b[?2004l\r"]
[52.48769, "o", "\u001b[?2004h> "]
[52.487818, "o", "                if asset_id in assets_by_id:\r\n\u001b[?2004l\r"]
[52.487847, "o", "\u001b[?2004h> "]
[52.488074, "o", "                    existing_date = assets_by_id[asset_id]['purchase_date']\r\n\u001b[?2004l\r"]
[52.488106, "o", "\u001b[?2004h> "]
[52.48825, "o", "                    new_date = asset['purchase_date']\r\n\u001b[?2004l\r"]
[52.48828, "o", "\u001b[?2004h> "]
[52.488412, "o", "                    if new_date > existing_date:\r\n\u001b[?2004l\r"]
[52.48844, "o", "\u001b[?2004h"]
[52.488467, "o", "> "]
[52.488592, "o", "                        assets_by_id[asset_id] = asset\r\n\u001b[?2004l\r"]
[52.488617, "o", "\u001b[?2004h"]
[52.488648, "o", "> "]
[52.488689, "o", "                else:\r\n\u001b[?2004l\r"]
[52.488715, "o", "\u001b[?2004h"]
[52.488741, "o", "> "]
[52.488872, "o", "                    assets_by_id[asset_id] = asset\r\n\u001b[?2004l\r"]
[52.488901, "o", "\u001b[?2004h> "]
[52.488927, "o", "    \r\n\u001b[?2004l\r"]
[52.488954, "o", "\u001b[?2004h> "]
[52.489067, "o", "    # Convert to list sorted by ID\r\n\u001b[?2004l\r"]
[52.489097, "o", "\u001b[?2004h> "]
[52.489301, "o", "    assets_list = [assets_by_id[aid] for aid in sorted(assets_by_id.keys())]\r\n\u001b[?2004l\r"]
[52.489331, "o", "\u001b[?2004h> "]
[52.489361, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[52.489388, "o", "> "]
[52.489447, "o", "    # Write output files\r\n\u001b[?2004l\r"]
[52.48948, "o", "\u001b[?2004h> "]
[52.48963, "o", "    with open(output_file, 'w', encoding='utf-8') as f:\r\n\u001b[?2004l\r"]
[52.48966, "o", "\u001b[?2004h> "]
[52.489781, "o", "        json.dump(assets_list, f, indent=2)\r\n\u001b[?2004l\r"]
[52.48981, "o", "\u001b[?2004h> "]
[52.489843, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[52.489872, "o", "> "]
[52.490016, "o", "    with open(rejected_file, 'w', encoding='utf-8') as f:\r\n\u001b[?2004l\r"]
[52.490044, "o", "\u001b[?2004h> "]
[52.490167, "o", "        json.dump(rejected, f, indent=2)\r\n\u001b[?2004l\r"]
[52.490201, "o", "\u001b[?2004h> "]
[52.490235, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[52.490262, "o", "> "]
[52.490395, "o", "    print(f\"Processed {len(assets_list)} valid assets\")\r\n\u001b[?2004l\r"]
[52.490424, "o", "\u001b[?2004h> "]
[52.490568, "o", "    print(f\"Rejected {len(rejected)} invalid rows\")\r\n\u001b[?2004l\r"]
[52.490603, "o", "\u001b[?2004h> "]
[52.490726, "o", "    print(f\"Output written to {output_file}\")\r\n\u001b[?2004l\r"]
[52.490758, "o", "\u001b[?2004h> "]
[52.49091, "o", "    print(f\"Rejected rows written to {rejected_file}\")\r\n\u001b[?2004l\r"]
[52.490942, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.49097, "o", "\u001b[?2004h> "]
[52.491067, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[52.491092, "o", "\u001b[?2004h> "]
[52.491133, "o", "    main()\r\n\u001b[?2004l\r"]
[52.491161, "o", "\u001b[?2004h> "]
[52.491192, "o", "EOF\r\n\u001b[?2004l\r"]
