[160.151184, "o", "uppercase for comparison\r\n    normalized_tags = [tag.upper() for tag in commit_tags]\r\n\r\n    # Check from highest to lowest priority\r\n    # Check if ANY tag triggers a major bump\r\n   "]
[160.151213, "o", " for tag in normalized_tags:\r\n        if tag in rules['major_triggers']:\r\n            return bump_major(current)\r\n    \r\n    # Check if ANY tag triggers a minor bump\r\n  "]
[160.151241, "o", "  for tag in normalized_tags:\r\n        if tag in rules['minor_triggers']:\r\n            return bump_minor(current)\r\n    \r\n    # Check if ANY tag trigge"]
[160.151284, "o", "rs a patch bump\r\n    for tag in normalized_tags:\r\n        if tag in rules['patch_triggers']:\r\n            return bump_patch(current)\r\n\r\n    # No matching rule found\r\n    return None\r\nEOF\r\n\u001b[?2004h"]
