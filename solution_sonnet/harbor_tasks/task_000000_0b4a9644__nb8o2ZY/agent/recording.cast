[175.25711, "o", "\u001b[?2004h"]
[175.257142, "o", "> "]
[175.257291, "o", "Changelog generation logic for the release tooling.\r\n\u001b[?2004l\r"]
[175.257322, "o", "\u001b[?2004h> "]
[175.257361, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.257393, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[175.257421, "o", "> "]
[175.257488, "o", "from datetime import datetime\r\n\u001b[?2004l\r"]
[175.257518, "o", "\u001b[?2004h> "]
[175.25755, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.257568, "o", "> \r\n\u001b[?2004l\r"]
[175.257608, "o", "\u001b[?2004h> "]
[175.25771, "o", "def get_section_for_tag(tag, config):\r\n\u001b[?2004l\r"]
[175.257739, "o", "\u001b[?2004h> "]
[175.257768, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[175.2578, "o", "\u001b[?2004h> "]
[175.258005, "o", "    Determine which changelog section a commit tag belongs to.\r\n\u001b[?2004l\r"]
[175.258036, "o", "\u001b[?2004h> "]
[175.258201, "o", "    Returns the section name or 'Other' if no match found.\r\n\u001b[?2004l\r"]
[175.258238, "o", "\u001b[?2004h> "]
[175.25827, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[175.258298, "o", "\u001b[?2004h> "]
[175.258416, "o", "    sections = config['changelog_sections']\r\n\u001b[?2004l\r"]
[175.258448, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[175.258528, "o", "\u001b[?2004h> "]
[175.258582, "o", "    # Normalize tag for comparison\r\n\u001b[?2004l\r"]
[175.258615, "o", "\u001b[?2004h> "]
[175.258713, "o", "    normalized_tag = tag.upper()\r\n\u001b[?2004l\r"]
[175.258747, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[175.258779, "o", "\u001b[?2004h> "]
[175.258949, "o", "    for section_name, section_tags in sections.items():\r\n\u001b[?2004l\r"]
[175.258984, "o", "\u001b[?2004h> "]
[175.259098, "o", "        if normalized_tag in section_tags:\r\n\u001b[?2004l\r"]
[175.25913, "o", "\u001b[?2004h> "]
[175.259221, "o", "            return section_name\r\n\u001b[?2004l\r"]
[175.259254, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[175.259286, "o", "\u001b[?2004h> "]
[175.25938, "o", "    # Default section if no match\r\n\u001b[?2004l\r"]
[175.259409, "o", "\u001b[?2004h> "]
[175.259466, "o", "    return 'other'\r\n\u001b[?2004l\r"]
[175.259498, "o", "\u001b[?2004h> "]
[175.259525, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.259557, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[175.259584, "o", "> "]
[175.259719, "o", "def generate_changelog_entry(version, commits, config):\r\n\u001b[?2004l\r"]
[175.25975, "o", "\u001b[?2004h> "]
[175.259779, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[175.259811, "o", "\u001b[?2004h> "]
[175.260004, "o", "    Generate a changelog entry for the given version and commits.\r\n\u001b[?2004l\r"]
[175.260043, "o", "\u001b[?2004h"]
[175.260075, "o", "> "]
[175.260169, "o", "    Groups commits by their appropriate sections.\r\n\u001b[?2004l\r"]
[175.260201, "o", "\u001b[?2004h> "]
[175.260229, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[175.260259, "o", "\u001b[?2004h> "]
[175.260311, "o", "    sections = {}\r\n\u001b[?2004l\r"]
[175.260342, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[175.26037, "o", "\u001b[?2004h> "]
[175.260449, "o", "    for commit in commits:\r\n\u001b[?2004l\r"]
[175.260484, "o", "\u001b[?2004h> "]
[175.260595, "o", "        tag = commit.get('tag', 'OTHER')\r\n\u001b[?2004l\r"]
[175.260627, "o", "\u001b[?2004h> "]
[175.260748, "o", "        message = commit.get('message', '')\r\n\u001b[?2004l\r"]
[175.260779, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[175.260805, "o", "\u001b[?2004h"]
[175.260831, "o", "> "]
[175.260971, "o", "        section = get_section_for_tag(tag, config)\r\n\u001b[?2004l\r"]
[175.26101, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[175.261041, "o", "\u001b[?2004h> "]
[175.261137, "o", "        if section not in sections:\r\n\u001b[?2004l\r"]
[175.261168, "o", "\u001b[?2004h> "]
[175.261269, "o", "            sections[section] = []\r\n\u001b[?2004l\r"]
[175.261296, "o", "\u001b[?2004h"]
[175.261323, "o", "> "]
[175.261421, "o", "        sections[section].append(message)\r\n\u001b[?2004l\r"]
[175.261452, "o", "\u001b[?2004h"]
[175.261484, "o", "> \r\n\u001b[?2004l\r"]
[175.261512, "o", "\u001b[?2004h> "]
[175.261591, "o", "    # Build the changelog entry\r\n\u001b[?2004l\r"]
[175.261622, "o", "\u001b[?2004h> "]
[175.261762, "o", "    date_str = datetime.now().strftime('%Y-%m-%d')\r\n\u001b[?2004l\r"]
[175.26179, "o", "\u001b[?2004h> "]
[175.261962, "o", "    entry_lines = [f\"\\n## [{version}] - {date_str}\\n\"]\r\n\u001b[?2004l\r"]
[175.262001, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[175.262033, "o", "\u001b[?2004h> "]
[175.262235, "o", "    # Use section order from config, with proper capitalization for display\r\n"]
[175.262266, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[175.262383, "o", "    # Map lowercase keys to display names\r\n"]
[175.262411, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[175.262499, "o", "    section_display_names = {\r\n\u001b[?2004l\r"]
[175.262527, "o", "\u001b[?2004h> "]
[175.262673, "o", "        'breaking changes': 'Breaking Changes',\r\n\u001b[?2004l\r"]
[175.262705, "o", "\u001b[?2004h> "]
[175.262795, "o", "        'features': 'Features',\r\n\u001b[?2004l\r"]
[175.262826, "o", "\u001b[?2004h> "]
[175.262938, "o", "        'bug fixes': 'Bug Fixes',\r\n\u001b[?2004l\r"]
[175.262972, "o", "\u001b[?2004h> "]
[175.26306, "o", "        'security': 'Security',\r\n\u001b[?2004l\r"]
[175.263091, "o", "\u001b[?2004h> "]
[175.263207, "o", "        'documentation': 'Documentation',\r\n\u001b[?2004l\r"]
[175.263238, "o", "\u001b[?2004h> "]
[175.263309, "o", "        'other': 'Other'\r\n\u001b[?2004l\r"]
[175.26334, "o", "\u001b[?2004h> "]
[175.263371, "o", "    }\r\n\u001b[?2004l\r"]
[175.263403, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[175.263434, "o", "\u001b[?2004h> "]
[175.263546, "o", "    # Define preferred order for sections\r\n\u001b[?2004l\r"]
[175.263575, "o", "\u001b[?2004h> "]
[175.263862, "o", "    section_order = ['breaking changes', 'features', 'bug fixes', 'security', 'documentation', 'other']\r\n\u001b[?2004l\r"]
[175.263908, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[175.263946, "o", "\u001b[?2004h> "]
[175.264046, "o", "    for section_key in section_order:\r\n\u001b[?2004l\r"]
[175.264077, "o", "\u001b[?2004h> "]
[175.264179, "o", "        if section_key in sections:\r\n\u001b[?2004l\r"]
[175.264209, "o", "\u001b[?2004h> "]
[175.264449, "o", "            display_name = section_display_names.get(section_key, section_key.title())\r\n\u001b[?2004l\r"]
[175.264495, "o", "\u001b[?2004h> "]
[175.264639, "o", "            entry_lines.append(f\"\\n### {display_name}\\n\")\r\n\u001b[?2004l\r"]
[175.264677, "o", "\u001b[?2004h> "]
[175.264799, "o", "            for msg in sections[section_key]:\r\n\u001b[?2004l\r"]
[175.26483, "o", "\u001b[?2004h> "]
[175.264982, "o", "                entry_lines.append(f\"- {msg}\\n\")\r\n\u001b[?2004l\r"]
[175.265018, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[175.265049, "o", "\u001b[?2004h> "]
[175.265138, "o", "    return ''.join(entry_lines)\r\n\u001b[?2004l\r"]
[175.26517, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[175.265201, "o", "\u001b[?2004h> "]
[175.265233, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.26537, "o", "def update_changelog(changelog_path, new_entry):\r\n\u001b[?2004l\r"]
[175.265402, "o", "\u001b[?2004h> "]
[175.265434, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[175.265465, "o", "\u001b[?2004h> "]
[175.26566, "o", "    Update the changelog file by inserting the new entry after the header.\r\n\u001b[?2004l\r"]
[175.265691, "o", "\u001b[?2004h> "]
[175.265718, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[175.26575, "o", "\u001b[?2004h> "]
[175.26586, "o", "    with open(changelog_path, 'r') as f:\r\n\u001b[?2004l\r"]
[175.265903, "o", "\u001b[?2004h> "]
[175.265981, "o", "        content = f.read()\r\n\u001b[?2004l\r"]
[175.266013, "o", "\u001b[?2004h> "]
[175.266041, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.266072, "o", "> "]
[175.26619, "o", "    # Find the position after \"# Changelog\" header\r\n\u001b[?2004l\r"]
[175.266221, "o", "\u001b[?2004h> "]
[175.266296, "o", "    header = \"# Changelog\"\r\n\u001b[?2004l\r"]
[175.266328, "o", "\u001b[?2004h> "]
[175.266401, "o", "    if header in content:\r\n\u001b[?2004l\r"]
[175.266432, "o", "\u001b[?2004h> "]
[175.266567, "o", "        pos = content.find(header) + len(header)\r\n\u001b[?2004l\r"]
[175.266598, "o", "\u001b[?2004h> "]
[175.266782, "o", "        new_content = content[:pos] + new_entry + content[pos:]\r\n\u001b[?2004l\r"]
[175.26682, "o", "\u001b[?2004h> "]
[175.266847, "o", "    else:\r\n\u001b[?2004l\r"]
[175.266879, "o", "\u001b[?2004h> "]
[175.267054, "o", "        new_content = header + new_entry + \"\\n\" + content\r\n\u001b[?2004l\r"]
[175.267087, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[175.267117, "o", "\u001b[?2004h> "]
[175.267234, "o", "    with open(changelog_path, 'w') as f:\r\n\u001b[?2004l\r"]
[175.267265, "o", "\u001b[?2004h> "]
[175.267348, "o", "        f.write(new_content)\r\n\u001b[?2004l\r"]
[175.267379, "o", "\u001b[?2004h> "]
[175.267411, "o", "EOF\r\n\u001b[?2004l\r"]
