[281.103979, "o", "\u001b[?2004h"]
[281.104012, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.104308, "o", "**Fix**: Rewrote bump_version() to check ALL tags at each priority level before moving to the next:\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.104364, "o", "> "]
[281.104444, "o", "- First check if ANY tag triggers major bump\r\n\u001b[?2004l\r"]
[281.104477, "o", "\u001b[?2004h> "]
[281.104604, "o", "- Then check if ANY tag triggers minor bump  \r\n\u001b[?2004l\r"]
[281.104635, "o", "\u001b[?2004h> "]
[281.104769, "o", "- Finally check if ANY tag triggers patch bump\r\n\u001b[?2004l\r"]
[281.104802, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[281.104839, "o", "\u001b[?2004h> "]
[281.105041, "o", "**Result**: Tag order no longer matters; highest priority always wins.\r\n\u001b[?2004l\r"]
[281.105076, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[281.105109, "o", "\u001b[?2004h> "]
[281.105251, "o", "### 2. Changelog Section Mismatch Bug (changelog.py)\r\n\u001b[?2004l\r"]
[281.105286, "o", "\u001b[?2004h> "]
[281.106158, "o", "**Problem**: The utils.py config loader normalized all dictionary keys to lowercase ('security', 'features'), but generate_changelog_entry() used a hardcoded section_order list with mixed case ('Security', 'Features'). This caused section keys to never match, resulting in missing or misplaced changelog entries.\r\n\u001b[?2004l\r"]
[281.106193, "o", "\u001b[?2004h> "]
[281.10622, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.106253, "o", "> "]
[281.106461, "o", "**Example**: Security commits were missing from changelog or defaulted to 'Features'\r\n\u001b[?2004l\r"]
[281.10649, "o", "\u001b[?2004h> "]
[281.106517, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.106544, "o", "> "]
[281.106586, "o", "**Fix**: \r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.106779, "o", "- Updated get_section_for_tag() to return lowercase section keys\r\n\u001b[?2004l\r"]
[281.106815, "o", "\u001b[?2004h> "]
[281.107012, "o", "- Added section_display_names mapping for proper capitalization\r\n\u001b[?2004l\r"]
[281.107049, "o", "\u001b[?2004h> "]
[281.107222, "o", "- Updated section_order to use lowercase keys matching the config\r\n\u001b[?2004l\r"]
[281.107255, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[281.107288, "o", "\u001b[?2004h> "]
[281.107502, "o", "**Result**: Commits now appear under correct sections with proper formatting.\r\n\u001b[?2004l\r"]
[281.107531, "o", "\u001b[?2004h> "]
[281.107561, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.107613, "o", "## Verification\r\n\u001b[?2004l\r"]
[281.107645, "o", "\u001b[?2004h> "]
[281.107735, "o", "Both fixes tested and verified:\r\n\u001b[?2004l\r"]
[281.107767, "o", "\u001b[?2004h> "]
[281.107933, "o", "- SECURITY tag correctly bumps 2.3.1 -> 2.3.2 (patch)\r\n\u001b[?2004l\r"]
[281.107967, "o", "\u001b[?2004h> "]
[281.108159, "o", "- Security commits appear under 'Security' section in CHANGELOG.md\r\n\u001b[?2004l\r"]
[281.108189, "o", "\u001b[?2004h> "]
[281.108333, "o", "- Priority handling works correctly for mixed tags\r\n\u001b[?2004l\r"]
[281.108365, "o", "\u001b[?2004h> "]
[281.108398, "o", "EOF\r\n\u001b[?2004l\r"]
