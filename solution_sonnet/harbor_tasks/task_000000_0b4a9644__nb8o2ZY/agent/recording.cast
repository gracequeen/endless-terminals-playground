[160.150956, "i", "cat > semver.py << 'EOF'\n\"\"\"\nSemantic versioning logic for the release tooling.\n\"\"\"\n\n\ndef parse_version(version_str):\n    \"\"\"Parse a version string into (major, minor, patch) tuple.\"\"\"\n    parts = version_str.strip().split('.')\n    return int(parts[0]), int(parts[1]), int(parts[2])\n\n\ndef format_version(major, minor, patch):\n    \"\"\"Format version tuple back to string.\"\"\"\n    return f\"{major}.{minor}.{patch}\"\n\n\ndef bump_major(version_str):\n    \"\"\"Bump the major version, reset minor and patch.\"\"\"\n    major, minor, patch = parse_version(version_str)\n    return format_version(major + 1, 0, 0)\n\n\ndef bump_minor(version_str):\n    \"\"\"Bump the minor version, reset patch.\"\"\"\n    major, minor, patch = parse_version(version_str)\n    return format_version(major, minor + 1, 0)\n\n\ndef bump_patch(version_str):\n    \"\"\"Bump the patch version.\"\"\"\n    major, minor, patch = parse_version(version_str)\n    return format_version(major, minor, patch + 1)\n\n\ndef bump_version(current, commit_tags, config):\n    \"\"\"\n    Determine the approp"]
[160.151085, "i", "riate version bump based on commit tags and config rules.\n\n    Priority: major > minor > patch\n    Checks all tags at each priority level before moving to the next.\n    \"\"\"\n    rules = config['version_rules']\n    \n    # Normalize all tags to uppercase for comparison\n    normalized_tags = [tag.upper() for tag in commit_tags]\n\n    # Check from highest to lowest priority\n    # Check if ANY tag triggers a major bump\n    for tag in normalized_tags:\n        if tag in rules['major_triggers']:\n            return bump_major(current)\n    \n    # Check if ANY tag triggers a minor bump\n    for tag in normalized_tags:\n        if tag in rules['minor_triggers']:\n            return bump_minor(current)\n    \n    # Check if ANY tag triggers a patch bump\n    for tag in normalized_tags:\n        if tag in rules['patch_triggers']:\n            return bump_patch(current)\n\n    # No matching rule found\n    return None\nEOF\n"]
[160.151119, "o", "cat > semver.py << 'EOF'\r\n\u001b[?2004l\rriate version bump based on commit tags and config rules.\r\n\r\n    Priority: major > minor > patch\r\n    C"]
