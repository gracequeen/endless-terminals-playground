[122.322803, "o", "cat semver.py | grep -A 20 'def bump_version'\r\n\u001b[?2004l\r"]
[122.324349, "o", "\u001b[01;31m\u001b[Kdef bump_version\u001b[m\u001b[K(current, commit_tags, config):\r\n    \"\"\"\r\n    Determine the appropriate version bump based on commit tags and config rules.\r\n\r\n    Priority: major > minor > patch\r\n    Iterates through commit tags and checks against rules.\r\n    \"\"\"\r\n"]
[122.324417, "o", "    rules = config['version_rules']\r\n\r\n    # Check from highest to lowest priority\r\n    for tag in commit_tags:\r\n        # Normalize tag to uppercase for comparison\r\n        normalized_tag = tag.upper()\r\n\r\n        if normalized_tag in rules['major_triggers']:\r\n            return bump_major(current)\r\n        if normalized_tag in rules['minor_triggers']:\r\n            return bump_minor(current)\r\n        if normalized_tag in rules['patch_triggers']:\r\n            return bump_patch(current)\r\n\r\n"]
[122.324594, "o", "\u001b[?2004h"]
[122.324638, "o", "root@3ad32447bdd5:/home/user/releaser# "]
[135.758698, "i", "python3 << 'EOF'\n# Test the priority bug\nfrom utils import load_config\nfrom semver import bump_version\n\nconfig = load_config('config.yaml')\n\n# Test case 1: SECURITY alone (should be patch)\nresult1 = bump_version('2.3.1', ['SECURITY'], config)\nprint(f\"Test 1 - ['SECURITY']: {result1}\")\n\n# Test case 2: FEATURE then SECURITY (should be minor due to FEATURE, but with wrong logic might be different)\nresult2 = bump_version('2.3.1', ['FEATURE', 'SECURITY'], config)\nprint(f\"Test 2 - ['FEATURE', 'SECURITY']: {result2}\")\n\n# Test case 3: SECURITY then FEATURE (should be minor due to FEATURE priority, but current code returns based on first match)\nresult3 = bump_version('2.3.1', ['SECURITY', 'FEATURE'], config)\nprint(f\"Test 3 - ['SECURITY', 'FEATURE']: {result3}\")\nEOF\n"]
