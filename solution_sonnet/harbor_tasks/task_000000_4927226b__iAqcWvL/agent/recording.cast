[64.293172, "i", "python3 << 'PYEOF'\nimport re\n\nwith open('test.log', 'r') as f:\n    lines = f.readlines()\n\nselect_times = []\nupdate_times = []\ninsert_times = []\n\ni = 0\nwhile i < len(lines):\n    if 'Query_time:' in lines[i]:\n        match = re.search(r'Query_time:\\s*(\\d+\\.\\d+)', lines[i])\n        if match:\n            query_time = float(match.group(1))\n            # Find the SQL query (next non-comment line)\n            j = i + 1\n            while j < len(lines) and lines[j].startswith('#'):\n                j += 1\n            if j < len(lines):\n                sql = lines[j].strip()\n                if sql.startswith('SELECT'):\n                    select_times.append(query_time)\n                elif sql.startswith('UPDATE'):\n                    update_times.append(query_time)\n                elif sql.startswith('INSERT'):\n                    insert_times.append(query_time)\n    i += 1\n\nprint(f\"SELECT queries: {len(select_times)} queries\")\nprint(f\"  Times: {select_times}\")\nprint(f\"  Total: {sum(select_times):.3f}s\")\nprint()\nprint"]
[64.293295, "i", "(f\"UPDATE queries: {len(update_times)} queries\")\nprint(f\"  Times: {update_times}\")\nprint(f\"  Total: {sum(update_times):.3f}s\")\nprint()\nprint(f\"INSERT queries: {len(insert_times)} queries\")\nprint(f\"  Times: {insert_times}\")\nprint(f\"  Total: {sum(insert_times):.3f}s\")\nPYEOF\n"]
