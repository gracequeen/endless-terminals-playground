[19.818504, "o", "#!/bin/bash\r\n\r\n# env-merge.sh - Merge two .env files, second file wins on conflicts\r\n\r\nif [ $# -ne 2 ]; then\r\n    echo \"Usage: $0 <file1.env> <file2.env>\" >&2\r\n    exit 1\r\nfi\r\n\r\nif [ ! -f \"$1\" ]; then\r\n    echo \"Error: File '$1' not found\" >&2\r\n    exit 1\r\nfi\r\n\r\nif [ ! -f \"$2\" ]; then\r\n    echo \"Error: File '$2' not found\" >&2\r\n    exit 1\r\nfi\r\n\r\n# Use awk to merge the files\r\nawk -F= '\r\n# Skip empty lines and comments\r\n/^[[:space:]]*$/ { next }\r\n/^[[:space:]]*#/ { next }\r\n\r\n# Process KEY=VALUE lines\r\n/=/ {\r\n    # Extract key (trim whitespace)\r\n    key = $1\r\n    gsub(/^[[:space:]]+|[[:space:]]+$/, \"\", key)\r\n    \r\n    # Store the entire line with the key\r\n    # Later entries overwrite earlier ones\r\n    env[key] = $0\r\n}\r\n\r\nEND {\r\n    # Output all entries in sorted order\r\n    for (key in env) {\r\n        print env[key]\r\n    }\r\n}\r\n' \"$1\" \"$2\" | sort\r\n"]
