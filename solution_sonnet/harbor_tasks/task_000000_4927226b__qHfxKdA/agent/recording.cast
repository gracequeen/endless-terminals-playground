[61.298891, "o", "Slow Query Analysis Results\r\n============================================================\r\nTotal: 13.44s | SELECT * FROM orders WHERE customer_id = ?;\r\nTotal: 7.51s | UPDATE inventory SET qty = ? WHERE sku = ?;\r\nTotal: 2.34s | INSERT INTO audit_log VALUES (?, ?, ?);\r\n============================================================\r\n"]
[61.301544, "o", "\u001b[?2004h"]
