[92.099289, "i", "python3 << 'PYEOF'\nimport re\n\nwith open('test.log', 'r') as f:\n    content = f.read()\n\n# Extract all query blocks\npattern = r'# Query_time: ([\\d.]+).*?\\n([^#]+)'\nmatches = re.findall(pattern, content, re.DOTALL)\n\nselect_total = 0\nupdate_total = 0\ninsert_total = 0\n\nfor time_str, query in matches:\n    time = float(time_str)\n    query = query.strip()\n    if query.startswith('SELECT'):\n        select_total += time\n    elif query.startswith('UPDATE'):\n        update_total += time\n    elif query.startswith('INSERT'):\n        insert_total += time\n\nprint(f\"SELECT queries: {select_total:.3f}s\")\nprint(f\"UPDATE queries: {update_total:.3f}s\")\nprint(f\"INSERT queries: {insert_total:.3f}s\")\nprint(f\"Total queries found: {len(matches)}\")\nPYEOF\n"]
