[46.056328, "o", "\u001b[?2004h> "]
[46.056386, "o", "    print(\"=\" * 60)\r\n\u001b[?2004l\r"]
[46.056417, "o", "\u001b[?2004h> "]
[46.056654, "o", "    for fingerprint, total_time in sorted(groups.items(), key=lambda x: -x[1]):\r\n\u001b[?2004l\r"]
[46.056686, "o", "\u001b[?2004h> "]
[46.056853, "o", "        print(f\"Total: {total_time:.2f}s | {fingerprint}\")\r\n\u001b[?2004l\r"]
[46.056883, "o", "\u001b[?2004h> "]
[46.056945, "o", "    print(\"=\" * 60)\r\n\u001b[?2004l\r"]
