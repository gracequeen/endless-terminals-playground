[46.045067, "i", "cat > slow_log.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nSlow query log parser - groups queries by normalized fingerprint and outputs timing stats.\n\"\"\"\n\nimport re\nimport sys\n\ndef upload_to_db(results):\n    \"\"\"Upload results to database (not used in main codepath).\"\"\"\n    import mysql.connector\n    conn = mysql.connector.connect(\n        host=\"localhost\",\n        user=\"root\",\n        password=\"password\",\n        database=\"slow_query_stats\"\n    )\n    cursor = conn.cursor()\n    for fingerprint, total_time in results.items():\n        cursor.execute(\n            \"INSERT INTO query_stats (fingerprint, total_time) VALUES (%s, %s)\",\n            (fingerprint, total_time)\n        )\n    conn.commit()\n    cursor.close()\n    conn.close()\n\ndef normalize_fingerprint(sql):\n    \"\"\"Normalize SQL by replacing literals with ? placeholders.\"\"\"\n    # Replace quoted strings\n    normalized = re.sub(r\"'[^']*'\", \"?\", sql)\n    # Replace numbers\n    normalized = re.sub(r'\\b\\d+\\.?\\d*\\b', '?', normalized)\n    # Clean up whitespace\n    normal"]
[46.04521, "i", "ized = re.sub(r'\\s+', ' ', normalized).strip()\n    return normalized\n\ndef parse_slow_log(filepath):\n    \"\"\"Parse slow query log and return list of (query_time, sql) tuples.\"\"\"\n    queries = []\n    # Bug 2: greedy regex that can grab extra content on some logs\n    time_pattern = re.compile(r'#\\s*Query_time:\\s*(\\d+\\.\\d+.*?)\\s')\n\n    with open(filepath, 'r') as f:\n        lines = f.readlines()\n\n    i = 0\n    while i < len(lines):\n        line = lines[i]\n        match = time_pattern.search(line)\n        if match:\n            try:\n                query_time = float(match.group(1).split()[0])\n            except ValueError:\n                i += 1\n                continue\n            # Next non-comment line is the SQL\n            i += 1\n            while i < len(lines) and lines[i].startswith('#'):\n                i += 1\n            if i < len(lines):\n                sql = lines[i].strip()\n                if sql:\n                    queries.append((query_time, sql))\n        i += 1\n\n    return queries\n\ndef group_by_fi"]
[46.045232, "o", "cat > slow_log.py << 'EOF'\r\n\u001b[?2004l\rized = re.sub(r'\\s+', ' ', normalized).strip()\r\n    return normalized\r\n\r\ndef parse_slow_log(filepath):\r\n    \""]
[46.045339, "i", "ngerprint(queries):\n    \"\"\"Group queries by fingerprint and sum execution times.\"\"\"\n    groups = {}\n\n    for i in range(len(queries)):\n        query_time, sql = queries[i]\n        fingerprint = normalize_fingerprint(sql)\n\n        if fingerprint not in groups:\n            groups[fingerprint] = 0.0\n\n        groups[fingerprint] += query_time\n\n    return groups\n\ndef main():\n    if len(sys.argv) != 2:\n        print(\"Usage: slow_log.py <logfile>\")\n        sys.exit(1)\n\n    filepath = sys.argv[1]\n    queries = parse_slow_log(filepath)\n    groups = group_by_fingerprint(queries)\n\n    print(\"Slow Query Analysis Results\")\n    print(\"=\" * 60)\n    for fingerprint, total_time in sorted(groups.items(), key=lambda x: -x[1]):\n        print(f\"Total: {total_time:.2f}s | {fingerprint}\")\n    print(\"=\" * 60)\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
[46.045377, "o", "\"\"Parse slow query log and return list of (query_time, sql) tuples.\"\"\"\r\n    queries = []\r\n    # Bug 2: greedy regex that can grab extra content on some logs\r\n    time_pattern = re.compile(r'#\\s*Query_time:\\s*(\\d+\\.\\d+.*?)\\s')\r\n\r\n    with open(filepath, 'r') as f:\r\n        lines = f.readlines()\r\n\r\n    i = 0\r\n    while i < len(lines):\r\n        line = lines[i]\r\n        match = time_pattern.search(line)\r\n        if match:\r\n            try:\r\n                query_time = float(match.group(1).split()[0])\r\n            except ValueError:\r\n                i += 1\r\n                continue\r\n            # Next non-comment line is the SQL\r\n      "]
[46.045424, "o", "      i += 1\r\n            while i < len(lines) and lines[i].startswith('#'):\r\n                i += 1\r\n            if i < len(lines):\r\n           "]
[46.045473, "o", "     sql = lines[i].strip()\r\n                if sql:\r\n                    queries.append((query_time, sql))\r\n        i += 1\r\n\r\n    return queries\r\n\r\ndef group_b"]
[46.04551, "o", "y_fi"]
[46.045541, "o", "ngerprint(queries):\r\n    \"\"\"Group queries by fingerprint and sum execution times.\"\"\"\r\n    groups = {}\r\n\r\n    for i in range(len(queries)):\r\n        query_time, sql = queries[i]\r\n        fingerprint = normalize_fingerprint(sql)\r\n\r\n        if fingerprint not in groups:\r\n            groups[fingerprint] = 0.0\r\n\r\n        groups[fingerprint] += query_tim"]
[46.045575, "o", "e\r\n\r\n    return groups\r\n\r\ndef main():\r\n    if len(sys.argv) != 2:\r\n        print(\"Usage: slow_log.py <logfile>\""]
[46.045613, "o", ")\r\n        sys.exit(1)\r\n\r\n    filepath = sys.argv[1]\r\n    queries = parse_slow_log(filepath)\r\n    groups = group_by_fingerprint(queries)\r\n\r\n    print(\"Slow Query Analysis Resu"]
[46.045651, "o", "lts\")\r\n    print(\"=\" * 60)\r\n    for fingerprint, total_time in sorted(groups.items(), key=lambda x: -x[1]):\r\n        print(f\"Total: {total_time:.2f}s | {fingerprint}\")\r\n    print(\"=\" * 60)\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\nEOF\r\n"]
