[50.565178, "o", "\u001b[?2004l\r"]
[50.566068, "o", "#!/usr/bin/env python3\r\n\"\"\"\r\nSlow query log parser - groups queries by normalized fingerprint and outputs timing stats.\r\n\"\"\"\r\n\r\nimport re\r\nimport sys"]
[50.566116, "o", "\r\n\r\ndef upload_to_db(results):\r\n    \"\"\"Upload results to database (not used in main codepath).\"\"\"\r\n    import mysql.connector\r\n    conn = mysql.connector.connect(\r\n        host=\"localhost\",\r\n        user=\"root\",\r\n        password=\"password\",\r\n        database=\"slow_query_stats\"\r\n    )\r\n    cursor = conn.cursor()\r\n    for fingerprint, total_time in results.items():\r\n        cursor.execute(\r\n"]
[50.566273, "o", "\u001b[?2004h"]
[50.566306, "o", "root@f73cd7803db9:/home/user/analyze# "]
[54.938944, "i", "grep -A 20 'def group_by_fingerprint' slow_log.py\n"]
[54.939146, "o", "grep -A 20 'def group_by_fingerprint' slow_log.py\r\n\u001b[?2004l\r"]
[54.940325, "o", "\u001b[01;31m\u001b[Kdef group_by_fingerprint\u001b[m\u001b[K(queries):\r\n    \"\"\"Group queries by fingerprint and sum execution times.\"\"\"\r\n    groups = {}\r\n\r\n    for i in range(len(queries)):\r\n        query_time, sql = queries[i]\r\n        fingerprint = normalize_fingerprint(sql)\r\n\r\n        if fingerprint not in groups:\r\n            groups[fingerprint] = 0.0\r\n\r\n"]
[54.940381, "o", "        groups[fingerprint] += query_time\r\n\r\n    return groups\r\n\r\ndef main():\r\n    if len(sys.argv) != 2:\r\n        print(\"Usage: slow_log.py <logfile>\")\r\n        sys.exit(1)\r\n\r\n    filepath = sys.argv[1]\r\n"]
[54.940536, "o", "\u001b[?2004h"]
[54.940574, "o", "root@f73cd7803db9:/home/user/analyze# "]
[61.280166, "i", "python3 slow_log.py test.log\n"]
[61.280289, "o", "python3 slow_log.py test.log\r\n"]
