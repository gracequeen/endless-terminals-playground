[46.045762, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r"]
[46.045798, "o", "\u001b[?2004h> "]
[46.045831, "o", "\"\"\"\r\n\u001b[?2004l\r"]
[46.045868, "o", "\u001b[?2004h> "]
[46.046145, "o", "Slow query log parser - groups queries by normalized fingerprint and outputs timing stats.\r\n\u001b[?2004l\r"]
[46.046189, "o", "\u001b[?2004h> \"\"\"\r\n"]
[46.046223, "o", "\u001b[?2004l\r\u001b[?2004h"]
[46.046256, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[46.046285, "o", "> "]
[46.046316, "o", "import re\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.046352, "o", "> import sys\r\n"]
[46.046392, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[46.046438, "o", "\u001b[?2004h> "]
[46.04653, "o", "def upload_to_db(results):\r\n\u001b[?2004l\r"]
[46.046566, "o", "\u001b[?2004h> "]
[46.046742, "o", "    \"\"\"Upload results to database (not used in main codepath).\"\"\"\r\n\u001b[?2004l\r"]
[46.046788, "o", "\u001b[?2004h> "]
[46.046852, "o", "    import mysql.connector\r\n\u001b[?2004l\r"]
[46.046885, "o", "\u001b[?2004h> "]
[46.046985, "o", "    conn = mysql.connector.connect(\r\n\u001b[?2004l\r"]
[46.047023, "o", "\u001b[?2004h> "]
[46.047092, "o", "        host=\"localhost\",\r\n\u001b[?2004l\r"]
[46.047117, "o", "\u001b[?2004h"]
[46.047146, "o", "> "]
[46.047223, "o", "        user=\"root\",\r\n\u001b[?2004l\r"]
[46.047286, "o", "\u001b[?2004h> "]
[46.047331, "o", "        password=\"password\",\r\n\u001b[?2004l\r"]
[46.047364, "o", "\u001b[?2004h> "]
[46.047479, "o", "        database=\"slow_query_stats\"\r\n\u001b[?2004l\r"]
[46.047516, "o", "\u001b[?2004h> "]
[46.047547, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.04758, "o", "> "]
[46.047637, "o", "    cursor = conn.cursor()\r\n\u001b[?2004l\r"]
[46.047668, "o", "\u001b[?2004h> "]
[46.047811, "o", "    for fingerprint, total_time in results.items():\r\n\u001b[?2004l\r"]
[46.047841, "o", "\u001b[?2004h> "]
[46.047919, "o", "        cursor.execute(\r\n\u001b[?2004l\r"]
[46.047953, "o", "\u001b[?2004h> "]
[46.048192, "o", "            \"INSERT INTO query_stats (fingerprint, total_time) VALUES (%s, %s)\",\r\n\u001b[?2004l\r"]
[46.048225, "o", "\u001b[?2004h> "]
[46.04833, "o", "            (fingerprint, total_time)\r\n\u001b[?2004l\r"]
[46.048362, "o", "\u001b[?2004h> "]
[46.048393, "o", "        )\r\n\u001b[?2004l\r"]
[46.048425, "o", "\u001b[?2004h> "]
[46.048492, "o", "    conn.commit()\r\n\u001b[?2004l\r"]
[46.048522, "o", "\u001b[?2004h> "]
[46.048579, "o", "    cursor.close()\r\n\u001b[?2004l\r"]
[46.04861, "o", "\u001b[?2004h> "]
[46.04866, "o", "    conn.close()\r\n\u001b[?2004l\r"]
[46.048691, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[46.048723, "o", "\u001b[?2004h> "]
[46.048811, "o", "def normalize_fingerprint(sql):\r\n\u001b[?2004l\r"]
[46.048842, "o", "\u001b[?2004h> "]
[46.049029, "o", "    \"\"\"Normalize SQL by replacing literals with ? placeholders.\"\"\"\r\n\u001b[?2004l\r"]
[46.049064, "o", "\u001b[?2004h> "]
[46.049141, "o", "    # Replace quoted strings\r\n\u001b[?2004l\r"]
[46.049173, "o", "\u001b[?2004h> "]
[46.049302, "o", "    normalized = re.sub(r\"'[^']*'\", \"?\", sql)\r\n\u001b[?2004l\r"]
[46.049334, "o", "\u001b[?2004h> "]
[46.049404, "o", "    # Replace numbers\r\n\u001b[?2004l\r"]
[46.04945, "o", "\u001b[?2004h> "]
[46.049608, "o", "    normalized = re.sub(r'\\b\\d+\\.?\\d*\\b', '?', normalized)\r\n\u001b[?2004l\r"]
[46.049632, "o", "\u001b[?2004h"]
[46.049664, "o", "> "]
[46.049715, "o", "    # Clean up whitespace\r\n\u001b[?2004l\r"]
[46.049745, "o", "\u001b[?2004h> "]
[46.049902, "o", "    normalized = re.sub(r'\\s+', ' ', normalized).strip()\r\n\u001b[?2004l\r"]
[46.049936, "o", "\u001b[?2004h> "]
[46.049997, "o", "    return normalized\r\n\u001b[?2004l\r"]
[46.050025, "o", "\u001b[?2004h> "]
[46.050056, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.050086, "o", "> "]
[46.050145, "o", "def parse_slow_log(filepath):\r\n\u001b[?2004l\r"]
[46.050176, "o", "\u001b[?2004h> "]
[46.050384, "o", "    \"\"\"Parse slow query log and return list of (query_time, sql) tuples.\"\"\"\r\n\u001b[?2004l\r"]
[46.050412, "o", "\u001b[?2004h"]
[46.050459, "o", "> "]
[46.050492, "o", "    queries = []\r\n\u001b[?2004l\r"]
[46.050523, "o", "\u001b[?2004h> "]
[46.050696, "o", "    # Bug 2: greedy regex that can grab extra content on some logs\r\n\u001b[?2004l\r"]
[46.050726, "o", "\u001b[?2004h> "]
[46.050917, "o", "    time_pattern = re.compile(r'#\\s*Query_time:\\s*(\\d+\\.\\d+.*?)\\s')\r\n\u001b[?2004l\r"]
[46.05095, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[46.050981, "o", "\u001b[?2004h> "]
[46.051074, "o", "    with open(filepath, 'r') as f:\r\n\u001b[?2004l\r"]
[46.051103, "o", "\u001b[?2004h> "]
[46.0512, "o", "        lines = f.readlines()\r\n\u001b[?2004l\r"]
[46.051233, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[46.051262, "o", "\u001b[?2004h"]
[46.051293, "o", ">     i = 0\r\n"]
[46.051323, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[46.051402, "o", "    while i < len(lines):\r\n\u001b[?2004l\r"]
[46.051444, "o", "\u001b[?2004h> "]
[46.051514, "o", "        line = lines[i]\r\n\u001b[?2004l\r"]
[46.051546, "o", "\u001b[?2004h"]
[46.051576, "o", "> "]
[46.051668, "o", "        match = time_pattern.search(line)\r\n\u001b[?2004l\r"]
[46.051702, "o", "\u001b[?2004h> "]
[46.051753, "o", "        if match:\r\n\u001b[?2004l\r"]
[46.051784, "o", "\u001b[?2004h> "]
[46.051834, "o", "            try:\r\n\u001b[?2004l\r"]
[46.051864, "o", "\u001b[?2004h> "]
[46.052035, "o", "                query_time = float(match.group(1).split()[0])\r\n\u001b[?2004l\r"]
[46.052066, "o", "\u001b[?2004h> "]
[46.052154, "o", "            except ValueError:\r\n\u001b[?2004l\r"]
[46.052185, "o", "\u001b[?2004h> "]
[46.052249, "o", "                i += 1\r\n\u001b[?2004l\r"]
[46.05228, "o", "\u001b[?2004h> "]
[46.05235, "o", "                continue\r\n\u001b[?2004l\r"]
[46.052381, "o", "\u001b[?2004h> "]
[46.052526, "o", "            # Next non-comment line is the SQL\r\n\u001b[?2004l\r"]
[46.05256, "o", "\u001b[?2004h> "]
[46.052613, "o", "            i += 1\r\n\u001b[?2004l\r"]
[46.052646, "o", "\u001b[?2004h> "]
[46.052816, "o", "            while i < len(lines) and lines[i].startswith('#'):\r\n\u001b[?2004l\r"]
[46.052844, "o", "\u001b[?2004h> "]
[46.052912, "o", "                i += 1\r\n\u001b[?2004l\r"]
[46.052941, "o", "\u001b[?2004h"]
[46.052973, "o", "> "]
[46.053029, "o", "            if i < len(lines):\r\n\u001b[?2004l\r"]
[46.05306, "o", "\u001b[?2004h> "]
[46.053169, "o", "                sql = lines[i].strip()\r\n\u001b[?2004l\r"]
[46.0532, "o", "\u001b[?2004h> "]
[46.053269, "o", "                if sql:\r\n\u001b[?2004l\r"]
[46.0533, "o", "\u001b[?2004h> "]
[46.053467, "o", "                    queries.append((query_time, sql))\r\n\u001b[?2004l\r"]
[46.053503, "o", "\u001b[?2004h> "]
[46.053545, "o", "        i += 1\r\n\u001b[?2004l\r"]
[46.053577, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[46.053607, "o", "\u001b[?2004h> "]
[46.053667, "o", "    return queries\r\n\u001b[?2004l\r"]
[46.053698, "o", "\u001b[?2004h> "]
[46.053729, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.053833, "o", "def group_by_fingerprint(queries):\r\n\u001b[?2004l\r"]
[46.05386, "o", "\u001b[?2004h> "]
[46.054045, "o", "    \"\"\"Group queries by fingerprint and sum execution times.\"\"\"\r\n\u001b[?2004l\r"]
[46.054077, "o", "\u001b[?2004h> "]
[46.054123, "o", "    groups = {}\r\n\u001b[?2004l\r"]
[46.054153, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[46.054185, "o", "\u001b[?2004h> "]
[46.054281, "o", "    for i in range(len(queries)):\r\n\u001b[?2004l\r"]
[46.05431, "o", "\u001b[?2004h> "]
[46.054418, "o", "        query_time, sql = queries[i]\r\n\u001b[?2004l\r"]
[46.054463, "o", "\u001b[?2004h> "]
[46.054597, "o", "        fingerprint = normalize_fingerprint(sql)\r\n\u001b[?2004l\r"]
[46.054628, "o", "\u001b[?2004h> "]
[46.054659, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.054772, "o", "        if fingerprint not in groups:\r\n\u001b[?2004l\r"]
[46.054804, "o", "\u001b[?2004h> "]
[46.054907, "o", "            groups[fingerprint] = 0.0\r\n\u001b[?2004l\r"]
[46.054936, "o", "\u001b[?2004h> "]
[46.054963, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.054992, "o", "> "]
[46.055086, "o", "        groups[fingerprint] += query_time\r\n\u001b[?2004l\r"]
[46.055117, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[46.055149, "o", "\u001b[?2004h> "]
[46.055212, "o", "    return groups\r\n\u001b[?2004l\r"]
[46.055246, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[46.055274, "o", "\u001b[?2004h> "]
[46.055314, "o", "def main():\r\n\u001b[?2004l\r"]
[46.055344, "o", "\u001b[?2004h> "]
[46.055421, "o", "    if len(sys.argv) != 2:\r\n\u001b[?2004l\r"]
[46.05547, "o", "\u001b[?2004h> "]
[46.055595, "o", "        print(\"Usage: slow_log.py <logfile>\")\r\n\u001b[?2004l\r"]
[46.055626, "o", "\u001b[?2004h> "]
[46.055687, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[46.055719, "o", "\u001b[?2004h> "]
[46.05575, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.055828, "o", "    filepath = sys.argv[1]\r\n\u001b[?2004l\r"]
[46.055859, "o", "\u001b[?2004h> "]
[46.055967, "o", "    queries = parse_slow_log(filepath)\r\n\u001b[?2004l\r"]
[46.055998, "o", "\u001b[?2004h> "]
[46.056117, "o", "    groups = group_by_fingerprint(queries)\r\n\u001b[?2004l\r"]
[46.056146, "o", "\u001b[?2004h> "]
[46.056175, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.056206, "o", "> "]
