[?2004l user
while IFS='|' read -r username uid gid gecos homedir shell; do
    # Get email for this uid - FIXED: use tab delimiter
    email=$(awk -F$'\t' -v u="$uid" '$1 == u {print $2}' "$TMPDIR/emails_sorted.tmp")
    
    # Use placeholder if no email found
    if [ -z "$email" ]; then
        email="no-email@corp.local"
    fi

    # Resolve primary group name - FIXED: use colon as field separator
    primary_group=$(awk -F':' -v g="$gid" '$1 == g {print $2}' "$TMPDIR/groups_sorted.tmp")

    # If group resolution failed, just use the gid
    if [ -z "$primary_group" ]; then
        primary_group="$gid"
    fi

    # Get supplementary groups for this uid
    supp_gids=$(awk -v u="$uid" '$1 == u {$1=""; print $0}' "$TMPDIR/memberships_sorted.tmp" | sed 's/^ //')

    # Resolve supplementary group names - FIXED: use colon as field separator
    supp_names=""
    for sgid in $supp_gids; do
        gname=$(awk -F':' -v g="$sgid" '$1 == g {print $2}' "$TMPDIR/groups_sorted.tmp")
        if [ -z "$gname" ]; then
            gname="$sgid"
        fi
        if [ -z "$supp_names" ]; then
            supp_names="$gname"
        else
            supp_names="$supp_names;$gname"
        fi
    done

    # Output CSV line
    echo "$username,$uid,$primary_group,$email,$shell,$supp_names"

done < "$TMPDIR/users_sorted.tmp" >> "$OUTPUT_FILE"

exit 0
EOF
