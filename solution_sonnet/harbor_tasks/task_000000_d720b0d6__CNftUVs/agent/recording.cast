[99.598187, "o", "\u001b[?2004h> "]
[99.598306, "o", "   - Reality: emails.dat is TAB-delimited\r\n\u001b[?2004l\r"]
[99.598339, "o", "\u001b[?2004h> "]
[99.598509, "o", "   - Result: Email field showed \"UID<TAB>email\" merged together\r\n\u001b[?2004l\r"]
[99.598541, "o", "\u001b[?2004h> "]
[99.598703, "o", "   - Fix: Changed to use tab delimiter in awk: awk -F$'\\t'\r\n\u001b[?2004l\r"]
[99.598731, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[99.598758, "o", "\u001b[?2004h"]
[99.598786, "o", "> "]
[99.598893, "o", "2. SORTING MISMATCH CAUSING DATA MISALIGNMENT\r\n\u001b[?2004l\r"]
[99.598921, "o", "\u001b[?2004h> "]
[99.599185, "o", "   - Problem: Users sorted alphabetically by username, emails sorted numerically by UID\r\n\u001b[?2004l\r"]
[99.599219, "o", "\u001b[?2004h> "]
[99.599402, "o", "   - Result: Line N of users didn't correspond to line N of emails\r\n\u001b[?2004l\r"]
[99.599431, "o", "\u001b[?2004h> "]
[99.599632, "o", "   - Fix: Changed users.dat sort to numeric by UID (sort -t'|' -k2,2n)\r\n\u001b[?2004l\r"]
[99.599666, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[99.599704, "o", "\u001b[?2004h> "]
[99.599819, "o", "3. WRONG FIELD SEPARATOR FOR GROUPS.DAT\r\n\u001b[?2004l\r"]
