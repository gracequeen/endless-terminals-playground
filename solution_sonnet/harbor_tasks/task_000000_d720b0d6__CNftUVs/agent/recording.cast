[35.256297, "o", "> "]
[35.256394, "o", "    # Get supplementary groups for this uid\r\n\u001b[?2004l\r"]
[35.256425, "o", "\u001b[?2004h> "]
[35.256727, "o", "    supp_gids=$(awk -v u=\"$uid\" '$1 == u {$1=\"\"; print $0}' \"$TMPDIR/memberships_sorted.tmp\" | sed 's/^ //')\r\n\u001b[?2004l\r"]
[35.256758, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[35.256782, "o", "\u001b[?2004h"]
[35.256808, "o", "> "]
[35.257022, "o", "    # Resolve supplementary group names - FIXED: use colon as field separator\r\n\u001b[?2004l\r"]
[35.257051, "o", "\u001b[?2004h> "]
[35.257107, "o", "    supp_names=\"\"\r\n\u001b[?2004l\r"]
[35.25713, "o", "\u001b[?2004h"]
[35.257161, "o", "> "]
[35.257229, "o", "    for sgid in $supp_gids; do\r\n\u001b[?2004l\r"]
[35.25726, "o", "\u001b[?2004h> "]
[35.257506, "o", "        gname=$(awk -F':' -v g=\"$sgid\" '$1 == g {print $2}' \"$TMPDIR/groups_sorted.tmp\")\r\n\u001b[?2004l\r"]
[35.257534, "o", "\u001b[?2004h> "]
[35.257632, "o", "        if [ -z \"$gname\" ]; then\r\n\u001b[?2004l\r"]
[35.257662, "o", "\u001b[?2004h> "]
[35.257737, "o", "            gname=\"$sgid\"\r\n\u001b[?2004l\r"]
[35.257769, "o", "\u001b[?2004h> "]
[35.257802, "o", "        fi\r\n\u001b[?2004l\r"]
[35.257832, "o", "\u001b[?2004h> "]
[35.25794, "o", "        if [ -z \"$supp_names\" ]; then\r\n\u001b[?2004l\r"]
[35.257986, "o", "\u001b[?2004h> "]
[35.258088, "o", "            supp_names=\"$gname\"\r\n\u001b[?2004l\r"]
[35.258116, "o", "\u001b[?2004h"]
[35.258141, "o", "> "]
[35.258168, "o", "        else\r\n\u001b[?2004l\r"]
[35.258199, "o", "\u001b[?2004h> "]
[35.258313, "o", "            supp_names=\"$supp_names;$gname\"\r\n\u001b[?2004l\r"]
[35.258344, "o", "\u001b[?2004h> "]
[35.258378, "o", "        fi\r\n\u001b[?2004l\r"]
[35.258406, "o", "\u001b[?2004h> "]
[35.258434, "o", "    done\r\n\u001b[?2004l\r"]
[35.25846, "o", "\u001b[?2004h"]
[35.258487, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[35.258513, "o", "> "]
[35.258561, "o", "    # Output CSV line\r\n\u001b[?2004l\r"]
[35.258592, "o", "\u001b[?2004h> "]
[35.258785, "o", "    echo \"$username,$uid,$primary_group,$email,$shell,$supp_names\"\r\n\u001b[?2004l\r"]
[35.258819, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[35.25885, "o", "\u001b[?2004h> "]
[35.259021, "o", "done < \"$TMPDIR/users_sorted.tmp\" >> \"$OUTPUT_FILE\"\r\n\u001b[?2004l\r"]
[35.259056, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[35.259086, "o", "\u001b[?2004h> "]
[35.259113, "o", "exit 0\r\n\u001b[?2004l\r"]
[35.259141, "o", "\u001b[?2004h> "]
[35.259168, "o", "EOF\r\n\u001b[?2004l\r"]
