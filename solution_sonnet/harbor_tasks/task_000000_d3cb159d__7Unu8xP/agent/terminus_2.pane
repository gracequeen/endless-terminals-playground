[?2004l[?2004h> #!/bin/bash
[?2004l[?2004h> # Safe commit wrapper for automation tools
[?2004l[?2004h> # This script ensures hooks are ALWAYS run and cannot be bypassed
[?2004l[?2004h> 
[?2004l[?2004h> set -e
[?2004l[?2004h> 
[?2004l[?2004h> echo "=== Safe Commit Wrapper ==="
[?2004l[?2004h> echo "This script ensures all git hooks are executed."
[?2004l[?2004h> echo ""
[?2004l[?2004h> 
[?2004l[?2004h> # First, run the pre-commit hook manually
[?2004l[?2004h> if [ -x .git/hooks/pre-commit ]; then
[?2004l[?2004h>     echo "Running pre-commit hook..."
[?2004l[?2004h>     .git/hooks/pre-commit
[?2004l[?2004h>     if [ $? -ne 0 ]; then
[?2004l[?2004h>         echo "Pre-commit hook failed. Aborting."
[?2004l[?2004h>         exit 1
[?2004l[?2004h>     fi
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> # Perform the commit WITHOUT --no-verify
[?2004l[?2004h> echo "Creating commit..."
[?2004l[?2004h> git commit "$@"
[?2004l[?2004h> 
[?2004l[?2004h> if [ $? -eq 0 ]; then
[?2004l[?2004h>     echo ""
[?2004l[?2004h>     echo "Commit successful and validated."
[?2004l[?2004h> fi
[?2004l[?2004h> EOF
