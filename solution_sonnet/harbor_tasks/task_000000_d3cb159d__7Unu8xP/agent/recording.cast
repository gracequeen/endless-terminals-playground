[123.215409, "o", "\u001b[?2004h> "]
[123.215509, "o", "- These cannot be bypassed by clients\r\n\u001b[?2004l\r"]
[123.215542, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[123.215573, "o", "\u001b[?2004h> "]
