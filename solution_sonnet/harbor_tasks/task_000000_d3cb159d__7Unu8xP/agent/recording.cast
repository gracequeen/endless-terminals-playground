[103.727993, "i", "cat > safe-commit.sh << 'EOF'\n#!/bin/bash\n# Safe commit wrapper for automation tools\n# This script ensures hooks are ALWAYS run and cannot be bypassed\n\nset -e\n\necho \"=== Safe Commit Wrapper ===\"\necho \"This script ensures all git hooks are executed.\"\necho \"\"\n\n# First, run the pre-commit hook manually\nif [ -x .git/hooks/pre-commit ]; then\n    echo \"Running pre-commit hook...\"\n    .git/hooks/pre-commit\n    if [ $? -ne 0 ]; then\n        echo \"Pre-commit hook failed. Aborting.\"\n        exit 1\n    fi\nfi\n\n# Perform the commit WITHOUT --no-verify\necho \"Creating commit...\"\ngit commit \"$@\"\n\nif [ $? -eq 0 ]; then\n    echo \"\"\n    echo \"Commit successful and validated.\"\nfi\nEOF\n"]
