[81.672428, "i", "cat > .git/hooks/pre-push << 'EOF'\n#!/bin/bash\n# Pre-push hook to block pushing commits with world-readable private keys\n# This runs even if pre-commit was bypassed with --no-verify\n\necho \"Running pre-push validation...\"\n\nremote=\"$1\"\nurl=\"$2\"\n\nz40=0000000000000000000000000000000000000000\n\nexit_code=0\n\nwhile read local_ref local_sha remote_ref remote_sha\ndo\n    if [ \"$local_sha\" = $z40 ]; then\n        continue\n    fi\n\n    if [ \"$remote_sha\" = $z40 ]; then\n        range=\"$local_sha\"\n    else\n        range=\"$remote_sha..$local_sha\"\n    fi\n\n    for commit in $(git rev-list \"$range\"); do\n        for file in $(git diff-tree --no-commit-id --name-only -r \"$commit\"); do\n            if [[ \"$file\" == *.pem ]] || [[ \"$file\" == *.key ]]; then\n                if [ -f \"$file\" ]; then\n                    perms=$(stat -c \"%a\" \"$file\")\n                    other_read=$((perms % 10))\n                    \n                    if [ \"$perms\" -ge 644 ] && [ $((other_read & 4)) -ne 0 ]; then\n                        echo \"ERROR: Commi"]
[81.672554, "i", "t $commit contains $file with world-readable permissions ($perms)\"\n                        echo \"ERROR: Private keys must have permissions 600 or stricter\"\n                        exit_code=1\n                    fi\n                fi\n            fi\n        done\n    done\ndone\n\nif [ $exit_code -ne 0 ]; then\n    echo \"\"\n    echo \"Push rejected: World-readable private keys detected\"\n    echo \"Please fix the permissions and amend the commits\"\nfi\n\nexit $exit_code\nEOF\n"]
[81.6726, "o", "cat > .git/hooks/pre-push << 'EOF'\r\n\u001b[?2004l\r"]
