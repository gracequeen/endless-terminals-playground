[74.032663, "i", "cat > .git/hooks/pre-push << 'EOF'\n#!/bin/bash\n# Pre-push hook to block pushing commits with world-readable private keys\n# This runs even if pre-commit was bypassed with --no-verify\n\necho \"Running pre-push validation...\"\n\nremote=\"$1\"\nurl=\"$2\"\n\nz40=0000000000000000000000000000000000000000\n\nexit_code=0\n\nwhile read local_ref local_sha remote_ref remote_sha\ndо\n    if [ \"$local_sha\" = $z40 ]; then\n        # Handle delete\n        continue\n    fi\n\n    if [ \"$remote_sha\" = $z40 ]; then\n        # New branch, examine all commits\n        range=\"$local_sha\"\n    else\n        # Update to existing branch, examine new commits\n        range=\"$remote_sha..$local_sha\"\n    fi\n\n    # Check all commits in the range\n    for commit in $(git rev-list \"$range\"); do\n        # Get files changed in this commit\n        for file in $(git diff-tree --no-commit-id --name-only -r \"$commit\"); do\n            if [[ \"$file\" == *.pem ]] || [[ \"$file\" == *.key ]]; then\n                # Check file permissions in that commit\n                if git "]
[74.032804, "i", "cat-file -e \"$commit:$file\" 2>/dev/null; then\n                    # Extract file to temp location and check permissions\n                    temp_file=$(mktemp)\n                    git show \"$commit:$file\" > \"$temp_file\" 2>/dev/null\n                    \n                    # Check if file exists in working tree to get its permissions\n                    if [ -f \"$file\" ]; then\n                        perms=$(stat -c \"%a\" \"$file\")\n                        other_read=$((perms % 10))\n                        \n                        if [ \"$perms\" -ge 644 ] && [ $((other_read & 4)) -ne 0 ]; then\n                            echo \"ERROR: Commit $commit contains $file with world-readable permissions ($perms)\"\n                            echo \"ERROR: Private keys must have permissions 600 or stricter\"\n                            echo \"ERROR: Fix with: chmod 600 $file\"\n                            exit_code=1\n                        fi\n                    fi\n                    rm -f \"$temp_file\"\n                fi\n      "]
[74.032826, "o", "cat > .git/hooks/pre-push << 'EOF'\r\n\u001b[?2004l\r"]
[74.032922, "i", "      fi\n        done\n    done\ndone\n\nif [ $exit_code -ne 0 ]; then\n    echo \"\"\n    echo \"Push rejected: World-readable private keys detected\"\n    echo \"Please fix the permissions and amend the commits\"\nfi\n\nexit $exit_code\nEOF\n"]
[74.032955, "o", "      fi\r\n        done\r\n    done\r\ndone\r\n\r\nif [ $exit_code -ne 0 ]; then\r\n    echo \"\"\r\n    echo \"Push rejected: World-readable private keys detected\"\r\n    echo \"Please fix the permissions and amend the commits\"\r\nfi\r\n\r\nexit $exit_code\r\nEOF\r\n\u001b[?2004h> "]
