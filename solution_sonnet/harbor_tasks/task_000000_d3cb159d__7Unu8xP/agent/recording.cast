[123.214908, "o", "\u001b[?2004h> "]
[123.215073, "o", "For production environments, implement server-side hooks:\r\n\u001b[?2004l\r"]
[123.215102, "o", "\u001b[?2004h> "]
[123.215219, "o", "- **pre-receive hook** on the Git server\r\n\u001b[?2004l\r"]
