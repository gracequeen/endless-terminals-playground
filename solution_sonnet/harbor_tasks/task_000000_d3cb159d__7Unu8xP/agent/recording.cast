[137.473583, "o", "\u001b[?2004h> "]
[137.473796, "o", "allowing commit 29e769c with world-readable private key (secrets/deploy.key).\r\n\u001b[?2004l\r"]
[137.473835, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
