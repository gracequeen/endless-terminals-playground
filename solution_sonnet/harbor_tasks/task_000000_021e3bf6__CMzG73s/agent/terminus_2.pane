[?2004l[?2004h> #!/bin/bash
[?2004l[?2004h> 
[?2004l[?2004h> # Output file
[?2004l[?2004h> OUTPUT="/home/user/low_memory_report.txt"
[?2004l[?2004h> 
[?2004l[?2004h> # Temporary file for collecting results
[?2004l[?2004h> TEMP_FILE=$(mktemp)
[?2004l[?2004h> 
[?2004l[?2004h> # Process each host file
[?2004l[?2004h> for hostfile in /home/user/memstats/host*.txt; do
[?2004l[?2004h>     hostname=$(basename "$hostfile" .txt)
[?2004l[?2004h>     
[?2004l[?2004h>     # Extract MemTotal and MemAvailable, handling missing values
[?2004l[?2004h>     mem_total=$(grep -E '^MemTotal:' "$hostfile" 2>/dev/null | awk '{print $2}')
[?2004l[?2004h>     mem_available=$(grep -E '^MemAvailable:' "$hostfile" 2>/dev/null | awk '{print $2}')
[?2004l[?2004h>     
[?2004l[?2004h>     # Skip if either value is missing or empty
[?2004l[?2004h>     if [[ -z "$mem_total" ]] || [[ -z "$mem_available" ]]; then
[?2004l[?2004h>         continue
[?2004l[?2004h>     fi
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate percentage available (using bc for floating point)
[?2004l[?2004h>     percentage=$(echo "scale=2; ($mem_available * 100) / $mem_total" | bc)
[?2004l[?2004h>     
[?2004l[?2004h>     # Check if less than 20%
[?2004l[?2004h>     is_low=$(echo "$percentage < 20" | bc)
[?2004l[?2004h>     
[?2004l[?2004h>     if [[ $is_low -eq 1 ]]; then
[?2004l[?2004h>         # Store for sorting: percentage, hostname, percentage (for output)
[?2004l[?2004h>         echo "$percentage$hostname$percentage" >> "$TEMP_FILE"
[?2004l[?2004h>     fi
[?2004l[?2004h> done
[?2004l[?2004h> 
[?2004l[?2004h> # Sort by percentage (ascending = worst first) and output hostname + percentage
[?2004l[?2004h> if [[ -f "$TEMP_FILE" ]] && [[ -s "$TEMP_FILE" ]]; then
[?2004l[?2004h>     sort -n "$TEMP_FILE" | awk -F'\t' '{print $2 "\t" $3}' > "$OUTPUT"
[?2004l[?2004h> else
[?2004l[?2004h>     # Create empty file if no hosts meet criteria
[?2004l[?2004h>     touch "$OUTPUT"
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> # Cleanup
[?2004l[?2004h> rm -f "$TEMP_FILE"
[?2004l[?2004h> EOF
