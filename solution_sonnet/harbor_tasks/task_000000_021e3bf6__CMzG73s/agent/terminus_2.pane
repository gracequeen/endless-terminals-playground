[?2004l[?2004h>     
[?2004l[?2004h>     # Extract MemTotal and MemAvailable, handling missing values
[?2004l[?2004h>     mem_total=$(grep -E '^MemTotal:' "$hostfile" 2>/dev/null | awk '{print $2}')
[?2004l[?2004h>     mem_available=$(grep -E '^MemAvailable:' "$hostfile" 2>/dev/null | awk '{print $2}')
[?2004l[?2004h>     
[?2004l[?2004h>     # Skip if either value is missing or empty
