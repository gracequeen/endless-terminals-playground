[39.049021, "i", "cat > process_memory.sh << 'EOF'\n#!/bin/bash\n\n# Output file\nOUTPUT=\"/home/user/low_memory_report.txt\"\n\n# Temporary file for collecting results\nTEMP_FILE=$(mktemp)\n\n# Process each host file\nfor hostfile in /home/user/memstats/host*.txt; do\n    hostname=$(basename \"$hostfile\" .txt)\n    \n    # Extract MemTotal and MemAvailable, handling missing values\n    mem_total=$(grep -E '^MemTotal:' \"$hostfile\" 2>/dev/null | awk '{print $2}')\n    mem_available=$(grep -E '^MemAvailable:' \"$hostfile\" 2>/dev/null | awk '{print $2}')\n    \n    # Skip if either value is missing or empty\n    if [[ -z \"$mem_total\" ]] || [[ -z \"$mem_available\" ]]; then\n        continue\n    fi\n    \n    # Calculate percentage available and check if less than 20% using awk\n    awk -v total=\"$mem_total\" -v avail=\"$mem_available\" -v host=\"$hostname\" '\n    BEGIN {\n        if (total > 0) {\n            percentage = (avail * 100) / total\n            if (percentage < 20) {\n                printf \"%.2f\\t%s\\t%.2f\\n\", percentage, host, percentage\n            }\n "]
[39.049156, "i", "       }\n    }' >> \"$TEMP_FILE\"\ndone\n\n# Sort by percentage (ascending = worst first) and output hostname + percentage\nif [[ -f \"$TEMP_FILE\" ]] && [[ -s \"$TEMP_FILE\" ]]; then\n    sort -n \"$TEMP_FILE\" | awk -F'\\t' '{print $2 \"\\t\" $3}' > \"$OUTPUT\"\nelse\n    # Create empty file if no hosts meet criteria\n    touch \"$OUTPUT\"\nfi\n\n# Cleanup\nrm -f \"$TEMP_FILE\"\nEOF\n"]
