[39.053693, "o", "if [[ -f \"$TEMP_FILE\" ]] && [[ -s \"$TEMP_FILE\" ]]; then\r\n\u001b[?2004l\r"]
[39.053726, "o", "\u001b[?2004h> "]
[39.053973, "o", "    sort -n \"$TEMP_FILE\" | awk -F'\\t' '{print $2 \"\\t\" $3}' > \"$OUTPUT\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[39.05409, "o", "> else\r\n\u001b[?2004l\r\u001b[?2004h> "]
[39.054261, "o", "    # Create empty file if no hosts meet criteria\r\n\u001b[?2004l\r"]
[39.05437, "o", "\u001b[?2004h> "]
[39.054411, "o", "    touch \"$OUTPUT\"\r\n"]
[39.05444, "o", "\u001b[?2004l\r"]
[39.054473, "o", "\u001b[?2004h"]
[39.054494, "o", "> "]
[39.054546, "o", "fi\r\n\u001b[?2004l\r"]
[39.054568, "o", "\u001b[?2004h> "]
[39.054581, "o", "\r\n\u001b[?2004l\r"]
[39.054622, "o", "\u001b[?2004h"]
[39.05464, "o", "> "]
[39.054686, "o", "# Cleanup\r\n\u001b[?2004l\r"]
[39.054898, "o", "\u001b[?2004h> rm -f \"$TEMP_FILE\"\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
