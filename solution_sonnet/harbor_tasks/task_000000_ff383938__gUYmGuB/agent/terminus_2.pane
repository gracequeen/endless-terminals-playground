def load_job_runtimes(jobs):
    log_dir = Path(LOG_DIR)
    for job in jobs:
        log_name = job.name.replace('.sh', '.log')
        log_path = log_dir / log_name
        if log_path.exists():
            start_time, end_time = parse_log_file(log_path)
            job.start_time = start_time
            job.end_time = end_time
    return jobs

jobs = parse_crontab()
jobs = load_job_runtimes(jobs)
jobs_with_data = [j for j in jobs if j.start_time and j.end_time]

if jobs_with_data:
    reference_date = jobs_with_data[0].start_time.date()
    print(f"Reference date: {reference_date}")
    
    for test_hour in [1, 4, 6]:
        print(f"\nChecking hour {test_hour}:")
        hour_start = datetime.combine(reference_date, datetime.min.time()).replace(hour=test_hour)
        hour_end = hour_start.replace(minute=59, second=59, microsecond=999999)
        print(f"  Hour range: {hour_start} to {hour_end}")
        
        is_idle = True
        for job in jobs_with_data:
            overlaps = job.start_time <= hour_end and job.end_time >= hour_start
            if overlaps:
                print(f"  {job.name}: {job.start_time} to {job.end_time} - OVERLAPS")
                is_idle = False
        
        print(f"  Result: {'IDLE' if is_idle else 'BUSY'}")
