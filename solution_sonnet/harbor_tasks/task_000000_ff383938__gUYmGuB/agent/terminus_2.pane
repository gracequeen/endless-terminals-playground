def load_job_runtimes(jobs):
    log_dir = Path(LOG_DIR)
    for job in jobs:
        log_name = job.name.replace('.sh', '.log')
        log_path = log_dir / log_name
        if log_path.exists():
            start_time, end_time = parse_log_file(log_path)
            job.start_time = start_time
            job.end_time = end_time
    return jobs

jobs = parse_crontab()
jobs = load_job_runtimes(jobs)
jobs_with_data = [j for j in jobs if j.start_time and j.end_time]

reference_date = jobs_with_data[0].start_time.date()
print(f"Reference date: {reference_date}\n")

idle = []
for hour in range(24):
    is_idle = True
    hour_start = datetime.combine(reference_date, datetime.min.time()).replace(hour=hour)
    hour_end = hour_start.replace(minute=59, second=59, microsecond=999999)
    
    if hour in [1, 4, 6]:
        print(f"Hour {hour}: {hour_start} to {hour_end}")
    
    for job in jobs_with_data:
        if job.start_time <= hour_end and job.end_time >= hour_start:
            if hour in [1, 4, 6]:
                print(f"  Job {job.name} overlaps: {job.start_time} to {job.end_time}")
            is_idle = False
            break
    
    if hour in [1, 4, 6]:
        print(f"  Result: {'IDLE' if is_idle else 'BUSY'}\n")
    
    if is_idle:
        idle.append(hour)

print(f"Idle hours: {idle}")
