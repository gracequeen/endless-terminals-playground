[175.42566, "o", "    with open(CRONTAB_PATH, 'r') as f:\r\n\u001b[?2004l\r"]
[175.42569, "o", "\u001b[?2004h> "]
[175.425759, "o", "        for line in f:\r\n\u001b[?2004l\r"]
[175.425789, "o", "\u001b[?2004h> "]
[175.425878, "o", "            line = line.strip()\r\n\u001b[?2004l\r"]
[175.425908, "o", "\u001b[?2004h> "]
[175.426044, "o", "            if not line or line.startswith('#'):\r\n\u001b[?2004l\r"]
[175.426084, "o", "\u001b[?2004h> "]
[175.426142, "o", "                continue\r\n\u001b[?2004l\r"]
[175.426171, "o", "\u001b[?2004h> "]
[175.426263, "o", "            parts = line.split()\r\n\u001b[?2004l\r"]
[175.426294, "o", "\u001b[?2004h> "]
[175.42638, "o", "            if len(parts) >= 6:\r\n\u001b[?2004l\r"]
[175.426441, "o", "\u001b[?2004h> "]
[175.42657, "o", "                job_name = os.path.basename(parts[5])\r\n\u001b[?2004l\r"]
[175.426597, "o", "\u001b[?2004h"]
[175.426623, "o", "> "]
[175.426734, "o", "                scheduled_hour = int(parts[1])\r\n\u001b[?2004l\r"]
[175.426763, "o", "\u001b[?2004h> "]
[175.426926, "o", "                jobs.append(Job(job_name, scheduled_hour))\r\n\u001b[?2004l\r"]
[175.426955, "o", "\u001b[?2004h> "]
[175.427005, "o", "    return jobs\r\n\u001b[?2004l\r"]
[175.427032, "o", "\u001b[?2004h"]
[175.427058, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[175.427084, "o", "> "]
[175.427153, "o", "def parse_log_file(log_path):\r\n\u001b[?2004l\r"]
[175.427184, "o", "\u001b[?2004h> "]
[175.427248, "o", "    start_time = None\r\n\u001b[?2004l\r"]
[175.427276, "o", "\u001b[?2004h> "]
[175.427336, "o", "    end_time = None\r\n\u001b[?2004l\r"]
[175.427363, "o", "\u001b[?2004h> "]
[175.42748, "o", "    with open(log_path, 'r') as f:\r\n\u001b[?2004l\r"]
[175.427515, "o", "\u001b[?2004h> "]
[175.427588, "o", "        content = f.read()\r\n\u001b[?2004l\r"]
[175.427615, "o", "\u001b[?2004h> "]
[175.427862, "o", "    start_match = re.search(r'START\\s+(\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2})', content)\r\n\u001b[?2004l\r"]
[175.427889, "o", "\u001b[?2004h> "]
[175.427948, "o", "    if start_match:\r\n\u001b[?2004l\r"]
[175.427971, "o", "\u001b[?2004h"]
[175.427998, "o", "> "]
[175.428212, "o", "        start_time = datetime.strptime(start_match.group(1), '%Y-%m-%d %H:%M:%S')\r\n\u001b[?2004l\r"]
[175.428241, "o", "\u001b[?2004h"]
[175.428274, "o", "> "]
[175.428487, "o", "    end_match = re.search(r'END\\s+(\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2})', content)\r\n\u001b[?2004l\r"]
[175.428521, "o", "\u001b[?2004h> "]
[175.428571, "o", "    if end_match:\r\n\u001b[?2004l\r"]
[175.428598, "o", "\u001b[?2004h> "]
[175.428813, "o", "        end_time = datetime.strptime(end_match.group(1), '%Y-%m-%d %H:%M:%S')\r\n\u001b[?2004l\r"]
[175.428844, "o", "\u001b[?2004h> "]
[175.428932, "o", "    return start_time, end_time\r\n\u001b[?2004l\r"]
[175.428963, "o", "\u001b[?2004h> "]
[175.428994, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.429076, "o", "def load_job_runtimes(jobs):\r\n\u001b[?2004l\r"]
[175.429106, "o", "\u001b[?2004h> "]
[175.429186, "o", "    log_dir = Path(LOG_DIR)\r\n\u001b[?2004l\r"]
[175.429217, "o", "\u001b[?2004h> "]
[175.429275, "o", "    for job in jobs:\r\n\u001b[?2004l\r"]
[175.429307, "o", "\u001b[?2004h> "]
[175.42946, "o", "        log_name = job.name.replace('.sh', '.log')\r\n\u001b[?2004l\r"]
[175.429495, "o", "\u001b[?2004h> "]
[175.429598, "o", "        log_path = log_dir / log_name\r\n\u001b[?2004l\r"]
[175.42963, "o", "\u001b[?2004h> "]
[175.429712, "o", "        if log_path.exists():\r\n\u001b[?2004l\r"]
[175.429743, "o", "\u001b[?2004h> "]
[175.429905, "o", "            start_time, end_time = parse_log_file(log_path)\r\n\u001b[?2004l\r"]
[175.429933, "o", "\u001b[?2004h> "]
[175.430046, "o", "            job.start_time = start_time\r\n\u001b[?2004l\r"]
[175.430074, "o", "\u001b[?2004h> "]
[175.430178, "o", "            job.end_time = end_time\r\n\u001b[?2004l\r"]
[175.430207, "o", "\u001b[?2004h> "]
[175.430255, "o", "    return jobs\r\n\u001b[?2004l\r"]
[175.430277, "o", "\u001b[?2004h"]
[175.430306, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[175.430337, "o", "> "]
[175.430382, "o", "jobs = parse_crontab()\r\n\u001b[?2004l\r"]
[175.430423, "o", "\u001b[?2004h> "]
[175.430511, "o", "jobs = load_job_runtimes(jobs)\r\n\u001b[?2004l\r"]
[175.430538, "o", "\u001b[?2004h"]
[175.430569, "o", "> "]
[175.430725, "o", "jobs_with_data = [j for j in jobs if j.start_time and j.end_time]\r\n\u001b[?2004l\r"]
[175.430757, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[175.430788, "o", "\u001b[?2004h> "]
[175.430843, "o", "if jobs_with_data:\r\n\u001b[?2004l\r"]
[175.430872, "o", "\u001b[?2004h> "]
[175.431031, "o", "    reference_date = jobs_with_data[0].start_time.date()\r\n\u001b[?2004l\r"]
[175.431058, "o", "\u001b[?2004h> "]
[175.43119, "o", "    print(f\"Reference date: {reference_date}\")\r\n\u001b[?2004l\r"]
[175.431217, "o", "\u001b[?2004h> "]
[175.431246, "o", "    \r\n\u001b[?2004l\r"]
[175.431277, "o", "\u001b[?2004h> "]
[175.431359, "o", "    for test_hour in [1, 4, 6]:\r\n\u001b[?2004l\r"]
[175.431386, "o", "\u001b[?2004h> "]
[175.431535, "o", "        print(f\"\\nChecking hour {test_hour}:\")\r\n\u001b[?2004l\r"]
[175.43157, "o", "\u001b[?2004h> "]
[175.431834, "o", "        hour_start = datetime.combine(reference_date, datetime.min.time()).replace(hour=test_hour)\r\n\u001b[?2004l\r"]
[175.431865, "o", "\u001b[?2004h> "]
[175.43208, "o", "        hour_end = hour_start.replace(minute=59, second=59, microsecond=999999)\r\n\u001b[?2004l\r"]
[175.43211, "o", "\u001b[?2004h> "]
[175.432282, "o", "        print(f\"  Hour range: {hour_start} to {hour_end}\")\r\n\u001b[?2004l\r"]
[175.43231, "o", "\u001b[?2004h> "]
[175.432341, "o", "        \r\n\u001b[?2004l\r"]
[175.432371, "o", "\u001b[?2004h> "]
[175.432452, "o", "        is_idle = True\r\n\u001b[?2004l\r"]
[175.432485, "o", "\u001b[?2004h> "]
[175.432582, "o", "        for job in jobs_with_data:\r\n\u001b[?2004l\r"]
[175.432616, "o", "\u001b[?2004h> "]
[175.432834, "o", "            overlaps = job.start_time <= hour_end and job.end_time >= hour_start\r\n\u001b[?2004l\r"]
[175.432865, "o", "\u001b[?2004h> "]
[175.432934, "o", "            if overlaps:\r\n\u001b[?2004l\r"]
[175.432965, "o", "\u001b[?2004h> "]
[175.433198, "o", "                print(f\"  {job.name}: {job.start_time} to {job.end_time} - OVERLAPS\")\r\n\u001b[?2004l\r"]
[175.433229, "o", "\u001b[?2004h> "]
[175.43332, "o", "                is_idle = False\r\n\u001b[?2004l\r"]
[175.433351, "o", "\u001b[?2004h> "]
[175.433382, "o", "        \r\n\u001b[?2004l\r"]
[175.433426, "o", "\u001b[?2004h> "]
[175.43359, "o", "        print(f\"  Result: {'IDLE' if is_idle else 'BUSY'}\")\r\n\u001b[?2004l\r"]
[175.433618, "o", "\u001b[?2004h> "]
[175.433645, "o", "PYEOF\r\n\u001b[?2004l\r"]
[175.459682, "o", "Reference date: 2024-01-15\r\n\r\nChecking hour 1:\r\n"]
[175.459731, "o", "  Hour range: 2024-01-15 01:00:00 to 2024-01-15 01:59:59.999999\r\n  etl_main.sh: 2024-01-15 01:00:03 to 2024-01-15 02:47:19 - OVERLAPS\r\n  Result: BUSY\r\n\r\nChecking hour 4:\r\n"]
[175.45976, "o", "  Hour range: 2024-01-15 04:00:00 to 2024-01-15 04:59:59.999999\r\n  reports.sh: 2024-01-15 04:00:01 to 2024-01-15 04:22:17 - OVERLAPS\r\n  Result: BUSY\r\n\r\nChecking hour 6:\r\n"]
[175.459787, "o", "  Hour range: 2024-01-15 06:00:00 to 2024-01-15 06:59:59.999999\r\n  health_check.sh: 2024-01-15 06:00:02 to 2024-01-15 06:03:41 - OVERLAPS\r\n  Result: BUSY\r\n"]
