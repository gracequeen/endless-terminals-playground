[182.010159, "o", "grep -A 20 'def find_idle_hours' /home/user/tools/capacity_report.py\r\n\u001b[?2004l\r"]
[182.011249, "o", "def find_idle_hours(jobs):\r\n    \"\"\"Find hours that were genuinely idle.\"\"\"\r\n    idle = []\r\n    \r\n    # Filter jobs that have actual runtime data\r\n"]
[182.011264, "o", "    jobs_with_data = [j for j in jobs if j.start_time and j.end_time]\r\n    \r\n    if not jobs_with_data:\r\n        return list(range(24))\r\n    \r\n    # Use the date from the first job as reference\r\n"]
[182.011334, "o", "    reference_date = jobs_with_data[0].start_time.date()\r\n\r\n    for hour in range(24):\r\n        is_idle = True\r\n\r\n        # Create datetime objects for the start and end of this hour\r\n"]
[182.011384, "o", "        hour_start = datetime.combine(reference_date, datetime.min.time()).replace(hour=hour)\r\n        hour_end = hour_start.replace(minute=59, second=59, microsecond=999999)\r\n        \r\n        # Check if any job was running during this hour\r\n"]
[182.011483, "o", "\u001b[?2004h"]
[182.011519, "o", "user@bae130232a6d:~$ "]
[186.364011, "i", "grep -A 30 'def find_idle_hours' /home/user/tools/capacity_report.py\n"]
[186.364257, "o", "grep -A 30 'def find_idle_hours' /home/user/tools/capacity_report.py\r\n\u001b[?2004l\r"]
[186.36535, "o", "def find_idle_hours(jobs):\r\n    \"\"\"Find hours that were genuinely idle.\"\"\"\r\n    idle = []\r\n    \r\n"]
[186.365408, "o", "    # Filter jobs that have actual runtime data\r\n    jobs_with_data = [j for j in jobs if j.start_time and j.end_time]\r\n    \r\n    if not jobs_with_data:\r\n        return list(range(24))\r\n    \r\n    # Use the date from the first job as reference\r\n    reference_date = jobs_with_data[0].start_time.date()\r\n\r\n    for hour in range(24):\r\n        is_idle = True\r\n\r\n        # Create datetime objects for the start and end of this hour\r\n        hour_start = datetime.combine(reference_date, datetime.min.time()).replace(hour=hour)\r\n        hour_end = hour_start.replace(minute=59, second=59, microsecond=999999)\r\n        \r\n        # Check if any job was running during this hour\r\n        for job in jobs_with_data:\r\n            # A job runs during this hour if its time range overlaps with the hour's time range\r\n            # Job overlaps hour if: job starts before hour ends AND job ends after hour starts\r\n"]
[186.365464, "o", "            if job.start_time <= hour_end and job.end_time >= hour_start:\r\n                is_idle = False\r\n                break\r\n\r\n        if is_idle:\r\n            idle.append(hour)\r\n\r\n"]
