[59.019017, "o", "CRONTAB_PATH = \"/var/spool/cron/crontabs/user\"\r\n\u001b[?2004l\r"]
[59.019051, "o", "\u001b[?2004h> "]
[59.019161, "o", "LOG_DIR = \"/var/log/batch\"\r\n\u001b[?2004l\r"]
[59.01919, "o", "\u001b[?2004h> "]
[59.019382, "o", "OUTPUT_PATH = \"/home/user/reports/windows.json\"\r\n\u001b[?2004l\r"]
[59.019432, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.01947, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.019503, "o", "\u001b[?2004h> "]
[59.019556, "o", "class Job:\r\n\u001b[?2004l\r"]
[59.019593, "o", "\u001b[?2004h"]
[59.019629, "o", "> "]
[59.019905, "o", "    def __init__(self, name, scheduled_hour, start_time=None, end_time=None):\r\n\u001b[?2004l\r"]
[59.019942, "o", "\u001b[?2004h> "]
[59.020043, "o", "        self.name = name\r\n\u001b[?2004l\r"]
[59.020074, "o", "\u001b[?2004h> "]
[59.020282, "o", "        self.scheduled_hour = scheduled_hour\r\n\u001b[?2004l\r"]
[59.020313, "o", "\u001b[?2004h"]
[59.020349, "o", "> "]
[59.020502, "o", "        self.start_time = start_time\r\n\u001b[?2004l\r"]
[59.020535, "o", "\u001b[?2004h> "]
[59.020671, "o", "        self.end_time = end_time\r\n\u001b[?2004l\r"]
[59.020703, "o", "\u001b[?2004h> \r\n"]
[59.020743, "o", "\u001b[?2004l\r\u001b[?2004h"]
[59.020776, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.020873, "o", "def parse_crontab():\r\n\u001b[?2004l\r"]
[59.020906, "o", "\u001b[?2004h> "]
[59.021136, "o", "    \"\"\"Parse crontab file and extract job schedules.\"\"\"\r\n\u001b[?2004l\r"]
[59.021172, "o", "\u001b[?2004h> "]
[59.021232, "o", "    jobs = []\r\n\u001b[?2004l\r"]
[59.021264, "o", "\u001b[?2004h> "]
[59.021295, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.021474, "o", "    with open(CRONTAB_PATH, 'r') as f:\r\n\u001b[?2004l\r"]
[59.021507, "o", "\u001b[?2004h> "]
[59.021601, "o", "        for line in f:\r\n\u001b[?2004l\r"]
[59.021633, "o", "\u001b[?2004h> "]
[59.021767, "o", "            line = line.strip()\r\n\u001b[?2004l\r"]
[59.021799, "o", "\u001b[?2004h> "]
[59.021995, "o", "            if not line or line.startswith('#'):\r\n\u001b[?2004l\r"]
[59.022028, "o", "\u001b[?2004h> "]
[59.022135, "o", "                continue\r\n\u001b[?2004l\r"]
[59.022165, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.022195, "o", "\u001b[?2004h"]
[59.022228, "o", "> "]
[59.022341, "o", "            parts = line.split()\r\n\u001b[?2004l\r"]
[59.022374, "o", "\u001b[?2004h> "]
[59.022513, "o", "            if len(parts) >= 6:\r\n\u001b[?2004l\r"]
[59.022555, "o", "\u001b[?2004h> "]
[59.022686, "o", "                minute = parts[0]\r\n\u001b[?2004l\r"]
[59.022721, "o", "\u001b[?2004h> "]
[59.022851, "o", "                hour = parts[1]\r\n\u001b[?2004l\r"]
[59.022893, "o", "\u001b[?2004h> "]
[59.023028, "o", "                command = parts[5]\r\n\u001b[?2004l\r"]
[59.02307, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.023101, "o", "\u001b[?2004h> "]
[59.023301, "o", "                job_name = os.path.basename(command)\r\n\u001b[?2004l\r"]
[59.023333, "o", "\u001b[?2004h> "]
[59.023524, "o", "                scheduled_hour = int(hour)\r\n\u001b[?2004l\r"]
[59.023562, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.023598, "o", "\u001b[?2004h> "]
[59.023826, "o", "                jobs.append(Job(job_name, scheduled_hour))\r\n\u001b[?2004l\r"]
[59.023859, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.023897, "o", "\u001b[?2004h> "]
[59.023962, "o", "    return jobs\r\n\u001b[?2004l\r"]
[59.023994, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.024029, "o", "\u001b[?2004h> "]
[59.02406, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[59.02409, "o", "> "]
[59.024202, "o", "def parse_log_file(log_path):\r\n\u001b[?2004l\r"]
[59.02424, "o", "\u001b[?2004h> "]
[59.024486, "o", "    \"\"\"Parse a log file to extract start and end timestamps.\"\"\"\r\n\u001b[?2004l\r"]
[59.02452, "o", "\u001b[?2004h> "]
[59.024577, "o", "    start_time = None\r\n\u001b[?2004l\r"]
[59.024608, "o", "\u001b[?2004h> "]
[59.024663, "o", "    end_time = None\r\n\u001b[?2004l\r"]
[59.024694, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.024724, "o", "\u001b[?2004h> "]
[59.024821, "o", "    with open(log_path, 'r') as f:\r\n\u001b[?2004l\r"]
[59.024858, "o", "\u001b[?2004h> "]
[59.024926, "o", "        content = f.read()\r\n\u001b[?2004l\r"]
[59.024962, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.024993, "o", "\u001b[?2004h> "]
[59.025065, "o", "    # Match START timestamp\r\n\u001b[?2004l\r"]
[59.025096, "o", "\u001b[?2004h> "]
[59.025341, "o", "    start_match = re.search(r'START\\s+(\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2})', content)\r\n\u001b[?2004l\r"]
[59.025371, "o", "\u001b[?2004h> "]
[59.025446, "o", "    if start_match:\r\n\u001b[?2004l\r"]
[59.025479, "o", "\u001b[?2004h> "]
[59.025702, "o", "        start_time = datetime.strptime(start_match.group(1), '%Y-%m-%d %H:%M:%S')\r\n\u001b[?2004l\r"]
[59.025732, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.025767, "o", "\u001b[?2004h> "]
[59.02584, "o", "    # Match END timestamp\r\n\u001b[?2004l\r"]
[59.025871, "o", "\u001b[?2004h> "]
[59.0261, "o", "    end_match = re.search(r'END\\s+(\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2})', content)\r\n\u001b[?2004l\r"]
[59.026134, "o", "\u001b[?2004h> "]
[59.026183, "o", "    if end_match:\r\n\u001b[?2004l\r"]
[59.026227, "o", "\u001b[?2004h> "]
[59.026439, "o", "        end_time = datetime.strptime(end_match.group(1), '%Y-%m-%d %H:%M:%S')\r\n\u001b[?2004l\r"]
[59.026481, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.026511, "o", "\u001b[?2004h> "]
[59.026591, "o", "    return start_time, end_time\r\n\u001b[?2004l\r"]
[59.02662, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.02665, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.026679, "o", "\u001b[?2004h> "]
[59.026764, "o", "def load_job_runtimes(jobs):\r\n\u001b[?2004l\r"]
[59.026794, "o", "\u001b[?2004h> "]
[59.026988, "o", "    \"\"\"Load actual runtime data from log files into job objects.\"\"\"\r\n\u001b[?2004l\r"]
[59.027023, "o", "\u001b[?2004h> "]
[59.027088, "o", "    log_dir = Path(LOG_DIR)\r\n\u001b[?2004l\r"]
[59.027118, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.027149, "o", "\u001b[?2004h> "]
[59.027213, "o", "    for job in jobs:\r\n\u001b[?2004l\r"]
[59.027243, "o", "\u001b[?2004h> "]
[59.027347, "o", "        # Find corresponding log file\r\n\u001b[?2004l\r"]
[59.027377, "o", "\u001b[?2004h> "]
[59.027534, "o", "        log_name = job.name.replace('.sh', '.log')\r\n\u001b[?2004l\r"]
[59.027569, "o", "\u001b[?2004h> "]
[59.02767, "o", "        log_path = log_dir / log_name\r\n\u001b[?2004l\r"]
[59.027707, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.027739, "o", "\u001b[?2004h> "]
[59.027817, "o", "        if log_path.exists():\r\n\u001b[?2004l\r"]
[59.02785, "o", "\u001b[?2004h> "]
[59.02801, "o", "            start_time, end_time = parse_log_file(log_path)\r\n\u001b[?2004l\r"]
[59.02804, "o", "\u001b[?2004h> "]
[59.028149, "o", "            job.start_time = start_time\r\n\u001b[?2004l\r"]
[59.028186, "o", "\u001b[?2004h> "]
[59.028288, "o", "            job.end_time = end_time\r\n\u001b[?2004l\r"]
[59.028322, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.028359, "o", "\u001b[?2004h> "]
[59.028397, "o", "    return jobs\r\n\u001b[?2004l\r"]
[59.028443, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.028481, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.028518, "o", "\u001b[?2004h> "]
[59.028603, "o", "def find_overlapping_hours(jobs):\r\n\u001b[?2004l\r"]
[59.028633, "o", "\u001b[?2004h> "]
[59.028754, "o", "    \"\"\"Find hours where jobs overlapped.\"\"\"\r\n\u001b[?2004l\r"]
[59.028783, "o", "\u001b[?2004h> "]
[59.028851, "o", "    overlapping = set()\r\n\u001b[?2004l\r"]
[59.028881, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.028911, "o", "\u001b[?2004h> "]
[59.029048, "o", "    # Filter jobs that have actual runtime data\r\n\u001b[?2004l\r"]
[59.029078, "o", "\u001b[?2004h> "]
[59.029269, "o", "    jobs_with_data = [j for j in jobs if j.start_time and j.end_time]\r\n\u001b[?2004l\r"]
[59.029299, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.029328, "o", "\u001b[?2004h"]
[59.029358, "o", "> "]
[59.029479, "o", "    for i, job1 in enumerate(jobs_with_data):\r\n\u001b[?2004l\r"]
[59.029518, "o", "\u001b[?2004h> "]
[59.029627, "o", "        for job2 in jobs_with_data[i+1:]:\r\n\u001b[?2004l\r"]
[59.029657, "o", "\u001b[?2004h> "]
[59.029826, "o", "            # Check if jobs overlap using actual timestamps\r\n\u001b[?2004l\r"]
[59.02986, "o", "\u001b[?2004h> "]
[59.030107, "o", "            # Jobs overlap if: job1 starts before job2 ends AND job2 starts before job1 ends\r\n\u001b[?2004l\r"]
[59.030142, "o", "\u001b[?2004h> "]
[59.030371, "o", "            if job1.start_time < job2.end_time and job2.start_time < job1.end_time:\r\n\u001b[?2004l\r"]
[59.030406, "o", "\u001b[?2004h> "]
[59.030594, "o", "                # Find all hours during which the overlap occurs\r\n\u001b[?2004l\r"]
[59.030628, "o", "\u001b[?2004h> "]
[59.030818, "o", "                overlap_start = max(job1.start_time, job2.start_time)\r\n\u001b[?2004l\r"]
[59.03086, "o", "\u001b[?2004h> "]
[59.031021, "o", "                overlap_end = min(job1.end_time, job2.end_time)\r\n\u001b[?2004l\r"]
[59.031051, "o", "\u001b[?2004h> "]
[59.031099, "o", "                \r\n\u001b[?2004l\r"]
[59.031132, "o", "\u001b[?2004h> "]
[59.031315, "o", "                # Add all hours that contain any part of the overlap\r\n\u001b[?2004l\r"]
[59.031345, "o", "\u001b[?2004h> "]
[59.031471, "o", "                current = overlap_start\r\n\u001b[?2004l\r"]
[59.031505, "o", "\u001b[?2004h> "]
[59.031627, "o", "                while current <= overlap_end:\r\n\u001b[?2004l\r"]
[59.031661, "o", "\u001b[?2004h> "]
[59.031793, "o", "                    overlapping.add(current.hour)\r\n\u001b[?2004l\r"]
[59.031829, "o", "\u001b[?2004h> "]
[59.031941, "o", "                    # Move to next hour\r\n\u001b[?2004l\r"]
[59.031981, "o", "\u001b[?2004h> "]
[59.032193, "o", "                    current = current.replace(minute=0, second=0, microsecond=0)\r\n\u001b[?2004l\r"]
[59.032229, "o", "\u001b[?2004h> "]
[59.032341, "o", "                    if current.hour == 23:\r\n\u001b[?2004l\r"]
[59.032377, "o", "\u001b[?2004h> "]
[59.032474, "o", "                        break\r\n\u001b[?2004l\r"]
[59.032507, "o", "\u001b[?2004h> "]
[59.032693, "o", "                    current = current.replace(hour=current.hour + 1)\r\n\u001b[?2004l\r"]
[59.032725, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.032766, "o", "\u001b[?2004h> "]
[59.032857, "o", "    return sorted(list(overlapping))\r\n\u001b[?2004l\r"]
[59.032887, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.032917, "o", "\u001b[?2004h> "]
[59.032947, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[59.032977, "o", "> "]
[59.033031, "o", "def find_idle_hours(jobs):\r\n\u001b[?2004l\r"]
[59.033061, "o", "\u001b[?2004h> "]
[59.033193, "o", "    \"\"\"Find hours that were genuinely idle.\"\"\"\r\n\u001b[?2004l\r"]
[59.033223, "o", "\u001b[?2004h> "]
[59.033264, "o", "    idle = []\r\n\u001b[?2004l\r"]
[59.033295, "o", "\u001b[?2004h> "]
[59.033324, "o", "    \r\n\u001b[?2004l\r"]
[59.033353, "o", "\u001b[?2004h> "]
[59.033493, "o", "    # Filter jobs that have actual runtime data\r\n\u001b[?2004l\r"]
[59.033526, "o", "\u001b[?2004h> "]
[59.033715, "o", "    jobs_with_data = [j for j in jobs if j.start_time and j.end_time]\r\n\u001b[?2004l\r"]
[59.03375, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.033782, "o", "\u001b[?2004h> "]
[59.033852, "o", "    for hour in range(24):\r\n\u001b[?2004l\r"]
[59.03388, "o", "\u001b[?2004h> "]
[59.033948, "o", "        is_idle = True\r\n\u001b[?2004l\r"]
[59.033978, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.034015, "o", "\u001b[?2004h> "]
[59.034163, "o", "        # Check if any job was running during this hour\r\n\u001b[?2004l\r"]
[59.034193, "o", "\u001b[?2004h> "]
[59.034289, "o", "        for job in jobs_with_data:\r\n\u001b[?2004l\r"]
[59.034318, "o", "\u001b[?2004h> "]
[59.034536, "o", "            # A job affects this hour if it started before the hour ends\r\n\u001b[?2004l\r"]
[59.03457, "o", "\u001b[?2004h> "]
[59.03469, "o", "            # and ended after the hour starts\r\n\u001b[?2004l\r"]
[59.034722, "o", "\u001b[?2004h> "]
[59.034816, "o", "            hour_start_hour = hour\r\n\u001b[?2004l\r"]
[59.034859, "o", "\u001b[?2004h> "]
[59.03494, "o", "            hour_end_hour = hour\r\n\u001b[?2004l\r"]
[59.034977, "o", "\u001b[?2004h> "]
[59.035007, "o", "            \r\n\u001b[?2004l\r"]
[59.035036, "o", "\u001b[?2004h> "]
[59.035172, "o", "            job_start_hour = job.start_time.hour\r\n\u001b[?2004l\r"]
[59.035201, "o", "\u001b[?2004h> "]
[59.035327, "o", "            job_end_hour = job.end_time.hour\r\n\u001b[?2004l\r"]
[59.035357, "o", "\u001b[?2004h> "]
[59.035396, "o", "            \r\n\u001b[?2004l\r"]
[59.035437, "o", "\u001b[?2004h> "]
[59.035602, "o", "            # Check if job spans into or through this hour\r\n\u001b[?2004l\r"]
[59.035636, "o", "\u001b[?2004h> "]
[59.035753, "o", "            # Job runs during hour H if:\r\n\u001b[?2004l\r"]
[59.035787, "o", "\u001b[?2004h> "]
[59.035939, "o", "            # - It starts in hour H or earlier, AND\r\n\u001b[?2004l\r"]
[59.035975, "o", "\u001b[?2004h> "]
[59.03609, "o", "            # - It ends in hour H or later\r\n\u001b[?2004l\r"]
[59.03613, "o", "\u001b[?2004h> "]
[59.036322, "o", "            if job_start_hour <= hour and job_end_hour >= hour:\r\n\u001b[?2004l\r"]
[59.036356, "o", "\u001b[?2004h> "]
[59.036453, "o", "                is_idle = False\r\n\u001b[?2004l\r"]
[59.036478, "o", "\u001b[?2004h"]
[59.036507, "o", "> "]
[59.036546, "o", "                break\r\n\u001b[?2004l\r"]
[59.036578, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.036608, "o", "\u001b[?2004h> "]
[59.036665, "o", "        if is_idle:\r\n\u001b[?2004l\r"]
[59.036696, "o", "\u001b[?2004h> "]
[59.036782, "o", "            idle.append(hour)\r\n\u001b[?2004l\r"]
[59.036812, "o", "\u001b[?2004h> "]
[59.036842, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.036891, "o", "    return idle\r\n\u001b[?2004l\r"]
[59.036923, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.036955, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.036986, "o", "\u001b[?2004h> "]
[59.037023, "o", "def main():\r\n\u001b[?2004l\r"]
[59.037053, "o", "\u001b[?2004h> "]
[59.037167, "o", "    # Parse crontab to get scheduled jobs\r\n\u001b[?2004l\r"]
[59.037196, "o", "\u001b[?2004h> "]
[59.037272, "o", "    jobs = parse_crontab()\r\n\u001b[?2004l\r"]
[59.037301, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.037332, "o", "\u001b[?2004h> "]
[59.037457, "o", "    # Load actual runtime data from logs\r\n\u001b[?2004l\r"]
[59.037488, "o", "\u001b[?2004h> "]
[59.037585, "o", "    jobs = load_job_runtimes(jobs)\r\n\u001b[?2004l\r"]
[59.037615, "o", "\u001b[?2004h> "]
[59.037644, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[59.037674, "o", "> "]
[59.037754, "o", "    # Find overlapping and idle hours\r\n\u001b[?2004l\r"]
[59.037785, "o", "\u001b[?2004h> "]
[59.03793, "o", "    overlapping_hours = find_overlapping_hours(jobs)\r\n\u001b[?2004l\r"]
[59.037962, "o", "\u001b[?2004h> "]
[59.038069, "o", "    idle_hours = find_idle_hours(jobs)\r\n\u001b[?2004l\r"]
