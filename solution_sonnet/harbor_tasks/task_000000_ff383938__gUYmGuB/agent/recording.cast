[142.42559, "i", "cat > /home/user/tools/capacity_report.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nCapacity Report Generator\n\nParses crontab entries and batch job logs to identify:\n1. Hours where jobs overlapped (one started before another finished)\n2. Hours that were genuinely idle (no jobs scheduled or running)\n\nOutput: /home/user/reports/windows.json\n\"\"\"\n\nimport os\nimport re\nimport json\nfrom datetime import datetime, timedelta\nfrom pathlib import Path\n\n\nCRONTAB_PATH = \"/var/spool/cron/crontabs/user\"\nLOG_DIR = \"/var/log/batch\"\nOUTPUT_PATH = \"/home/user/reports/windows.json\"\n\n\nclass Job:\n    def __init__(self, name, scheduled_hour, start_time=None, end_time=None):\n        self.name = name\n        self.scheduled_hour = scheduled_hour\n        self.start_time = start_time\n        self.end_time = end_time\n\n\ndef parse_crontab():\n    \"\"\"Parse crontab file and extract job schedules.\"\"\"\n    jobs = []\n\n    with open(CRONTAB_PATH, 'r') as f:\n        for line in f:\n            line = line.strip()\n            if not line or line.startswith("]
[142.425716, "i", "'#'):\n                continue\n\n            parts = line.split()\n            if len(parts) >= 6:\n                minute = parts[0]\n                hour = parts[1]\n                command = parts[5]\n\n                job_name = os.path.basename(command)\n                scheduled_hour = int(hour)\n\n                jobs.append(Job(job_name, scheduled_hour))\n\n    return jobs\n\n\ndef parse_log_file(log_path):\n    \"\"\"Parse a log file to extract start and end timestamps.\"\"\"\n    start_time = None\n    end_time = None\n\n    with open(log_path, 'r') as f:\n        content = f.read()\n\n    # Match START timestamp\n    start_match = re.search(r'START\\s+(\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2})', content)\n    if start_match:\n        start_time = datetime.strptime(start_match.group(1), '%Y-%m-%d %H:%M:%S')\n\n    # Match END timestamp\n    end_match = re.search(r'END\\s+(\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2})', content)\n    if end_match:\n        end_time = datetime.strptime(end_match.group(1), '%Y-%m-%d %H:%M:%S')\n\n    return start_time,"]
[142.425778, "i", " end_time\n\n\ndef load_job_runtimes(jobs):\n    \"\"\"Load actual runtime data from log files into job objects.\"\"\"\n    log_dir = Path(LOG_DIR)\n\n    for job in jobs:\n        # Find corresponding log file\n        log_name = job.name.replace('.sh', '.log')\n        log_path = log_dir / log_name\n\n        if log_path.exists():\n            start_time, end_time = parse_log_file(log_path)\n            job.start_time = start_time\n            job.end_time = end_time\n\n    return jobs\n\n\ndef find_overlapping_hours(jobs):\n    \"\"\"Find hours where jobs overlapped.\"\"\"\n    overlapping = set()\n\n    # Filter jobs that have actual runtime data\n    jobs_with_data = [j for j in jobs if j.start_time and j.end_time]\n\n    for i, job1 in enumerate(jobs_with_data):\n        for job2 in jobs_with_data[i+1:]:\n            # Check if jobs overlap using actual timestamps\n            # Jobs overlap if: job1 starts before job2 ends AND job2 starts before job1 ends\n            if job1.start_time < job2.end_time and job2.start_time < job1.end_time:\n     "]
[142.425822, "o", "cat > /home/user/tools/capacity_report.py << 'EOF'\r\n"]
[142.425866, "i", "           # Find all hours during which the overlap occurs\n                overlap_start = max(job1.start_time, job2.start_time)\n                overlap_end = min(job1.end_time, job2.end_time)\n                \n                # Add all hours that contain any part of the overlap\n                current = overlap_start\n                while current <= overlap_end:\n                    overlapping.add(current.hour)\n                    # Move to next hour\n                    current = current.replace(minute=0, second=0, microsecond=0)\n                    if current.hour == 23:\n                        break\n                    current = current.replace(hour=current.hour + 1)\n\n    return sorted(list(overlapping))\n\n\ndef find_idle_hours(jobs):\n    \"\"\"Find hours that were genuinely idle.\"\"\"\n    idle = []\n    \n    # Filter jobs that have actual runtime data\n    jobs_with_data = [j for j in jobs if j.start_time and j.end_time]\n    \n    if not jobs_with_data:\n        return list(range(24))\n    \n    # Use the date from th"]
[142.425907, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[142.425948, "i", "e first job as reference\n    reference_date = jobs_with_data[0].start_time.date()\n\n    for hour in range(24):\n        is_idle = True\n\n        # Create datetime objects for the start and end of this hour\n        hour_start = datetime.combine(reference_date, datetime.min.time()).replace(hour=hour)\n        hour_end = hour_start.replace(minute=59, second=59, microsecond=999999)\n        \n        # Check if any job was running during this hour\n        for job in jobs_with_data:\n            # A job runs during this hour if its time range overlaps with the hour's time range\n            # Job overlaps hour if: job starts before hour ends AND job ends after hour starts\n            if job.start_time <= hour_end and job.end_time >= hour_start:\n                is_idle = False\n                break\n\n        if is_idle:\n            idle.append(hour)\n\n    return idle\n\n\ndef main():\n    # Parse crontab to get scheduled jobs\n    jobs = parse_crontab()\n\n    # Load actual runtime data from logs\n    jobs = load_job_runtimes(jobs)\n"]
[142.425967, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.42604, "i", "\n    # Find overlapping and idle hours\n    overlapping_hours = find_overlapping_hours(jobs)\n    idle_hours = find_idle_hours(jobs)\n\n    # Write output\n    result = {\n        \"overlapping_hours\": overlapping_hours,\n        \"idle_hours\": idle_hours\n    }\n\n    os.makedirs(os.path.dirname(OUTPUT_PATH), exist_ok=True)\n    with open(OUTPUT_PATH, 'w') as f:\n        json.dump(result, f, indent=2)\n\n    print(f\"Report written to {OUTPUT_PATH}\")\n    print(f\"Overlapping hours: {overlapping_hours}\")\n    print(f\"Idle hours: {idle_hours}\")\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
[142.426082, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.426135, "o", "Capacity Report Generator\r\n\u001b[?2004l\r"]
[142.426178, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[142.426219, "o", "> "]
[142.42643, "o", "Parses crontab entries and batch job logs to identify:\r\n\u001b[?2004l\r"]
[142.426471, "o", "\u001b[?2004h> "]
[142.426749, "o", "1. Hours where jobs overlapped (one started before another finished)\r\n\u001b[?2004l\r"]
[142.426782, "o", "\u001b[?2004h> "]
[142.427039, "o", "2. Hours that were genuinely idle (no jobs scheduled or running)\r\n\u001b[?2004l\r"]
[142.427077, "o", "\u001b[?2004h> "]
[142.427106, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.427139, "o", "> "]
[142.427275, "o", "Output: /home/user/reports/windows.json\r\n\u001b[?2004l\r"]
[142.427304, "o", "\u001b[?2004h> "]
[142.427332, "o", "\"\"\"\r\n\u001b[?2004l\r"]
[142.427364, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.427393, "o", "\u001b[?2004h> "]
[142.427457, "o", "import os\r\n"]
[142.427497, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[142.427535, "o", "import re\r\n\u001b[?2004l\r"]
[142.427572, "o", "\u001b[?2004h> "]
[142.427622, "o", "import json\r\n\u001b[?2004l\r"]
[142.427659, "o", "\u001b[?2004h> "]
[142.427832, "o", "from datetime import datetime, timedelta\r\n\u001b[?2004l\r"]
[142.427876, "o", "\u001b[?2004h> "]
[142.427963, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[142.428001, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.428041, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.428086, "o", "\u001b[?2004h> "]
[142.428267, "o", "CRONTAB_PATH = \"/var/spool/cron/crontabs/user\"\r\n\u001b[?2004l\r"]
[142.428312, "o", "\u001b[?2004h> "]
[142.428405, "o", "LOG_DIR = \"/var/log/batch\"\r\n\u001b[?2004l\r"]
[142.428466, "o", "\u001b[?2004h> "]
[142.428647, "o", "OUTPUT_PATH = \"/home/user/reports/windows.json\"\r\n\u001b[?2004l\r"]
[142.428688, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.428738, "o", "\u001b[?2004h> "]
[142.428783, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.428823, "o", "class Job:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.42914, "o", "    def __init__(self, name, scheduled_hour, start_time=None, end_time=None):\r\n\u001b[?2004l\r"]
[142.429181, "o", "\u001b[?2004h> "]
[142.429286, "o", "        self.name = name\r\n\u001b[?2004l\r"]
[142.429329, "o", "\u001b[?2004h> "]
[142.429512, "o", "        self.scheduled_hour = scheduled_hour\r\n\u001b[?2004l\r"]
[142.429562, "o", "\u001b[?2004h> "]
[142.429694, "o", "        self.start_time = start_time\r\n\u001b[?2004l\r"]
[142.429726, "o", "\u001b[?2004h> "]
[142.429858, "o", "        self.end_time = end_time\r\n\u001b[?2004l\r"]
[142.429891, "o", "\u001b[?2004h> \r\n"]
[142.429927, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[142.429963, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[142.430052, "o", "def parse_crontab():\r\n\u001b[?2004l\r"]
[142.430082, "o", "\u001b[?2004h> "]
[142.430311, "o", "    \"\"\"Parse crontab file and extract job schedules.\"\"\"\r\n\u001b[?2004l\r"]
[142.430347, "o", "\u001b[?2004h> "]
[142.430406, "o", "    jobs = []\r\n\u001b[?2004l\r"]
[142.43048, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[142.430524, "o", "> "]
[142.43065, "o", "    with open(CRONTAB_PATH, 'r') as f:\r\n\u001b[?2004l\r"]
[142.430681, "o", "\u001b[?2004h> "]
[142.430778, "o", "        for line in f:\r\n\u001b[?2004l\r"]
[142.43082, "o", "\u001b[?2004h> "]
[142.430943, "o", "            line = line.strip()\r\n\u001b[?2004l\r"]
[142.430979, "o", "\u001b[?2004h> "]
[142.431178, "o", "            if not line or line.startswith('#'):\r\n\u001b[?2004l\r"]
[142.431218, "o", "\u001b[?2004h> "]
[142.431314, "o", "                continue\r\n\u001b[?2004l\r"]
[142.431351, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.431386, "o", "\u001b[?2004h> "]
[142.43153, "o", "            parts = line.split()\r\n\u001b[?2004l\r"]
[142.431574, "o", "\u001b[?2004h> "]
[142.431698, "o", "            if len(parts) >= 6:\r\n\u001b[?2004l\r"]
[142.431741, "o", "\u001b[?2004h> "]
[142.431865, "o", "                minute = parts[0]\r\n\u001b[?2004l\r"]
[142.431907, "o", "\u001b[?2004h> "]
[142.432023, "o", "                hour = parts[1]\r\n\u001b[?2004l\r"]
[142.432064, "o", "\u001b[?2004h> "]
[142.432207, "o", "                command = parts[5]\r\n\u001b[?2004l\r"]
[142.432248, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.432286, "o", "\u001b[?2004h> "]
[142.432509, "o", "                job_name = os.path.basename(command)\r\n\u001b[?2004l\r"]
[142.432551, "o", "\u001b[?2004h> "]
[142.432712, "o", "                scheduled_hour = int(hour)\r\n\u001b[?2004l\r"]
[142.43275, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.432782, "o", "\u001b[?2004h> "]
[142.433015, "o", "                jobs.append(Job(job_name, scheduled_hour))\r\n\u001b[?2004l\r"]
[142.433043, "o", "\u001b[?2004h> "]
[142.43307, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.433098, "o", "> "]
[142.433149, "o", "    return jobs\r\n\u001b[?2004l\r"]
[142.433182, "o", "\u001b[?2004h> \r\n"]
[142.433232, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.433272, "o", "\u001b[?2004h> "]
[142.433376, "o", "def parse_log_file(log_path):\r\n\u001b[?2004l\r"]
[142.433434, "o", "\u001b[?2004h> "]
[142.433673, "o", "    \"\"\"Parse a log file to extract start and end timestamps.\"\"\"\r\n\u001b[?2004l\r"]
[142.433713, "o", "\u001b[?2004h> "]
[142.433803, "o", "    start_time = None\r\n\u001b[?2004l\r"]
[142.433844, "o", "\u001b[?2004h> "]
[142.43392, "o", "    end_time = None\r\n\u001b[?2004l\r"]
[142.433963, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.434002, "o", "\u001b[?2004h> "]
[142.434132, "o", "    with open(log_path, 'r') as f:\r\n\u001b[?2004l\r"]
[142.434175, "o", "\u001b[?2004h> "]
[142.434267, "o", "        content = f.read()\r\n\u001b[?2004l\r"]
[142.434306, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.434345, "o", "\u001b[?2004h> "]
[142.434426, "o", "    # Match START timestamp\r\n\u001b[?2004l\r"]
[142.434465, "o", "\u001b[?2004h> "]
[142.434699, "o", "    start_match = re.search(r'START\\s+(\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2})', content)\r\n\u001b[?2004l\r"]
[142.434729, "o", "\u001b[?2004h> "]
[142.434789, "o", "    if start_match:\r\n\u001b[?2004l\r"]
[142.434822, "o", "\u001b[?2004h> "]
[142.435049, "o", "        start_time = datetime.strptime(start_match.group(1), '%Y-%m-%d %H:%M:%S')\r\n\u001b[?2004l\r"]
[142.435087, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.435123, "o", "\u001b[?2004h> "]
[142.435189, "o", "    # Match END timestamp\r\n\u001b[?2004l\r"]
[142.435228, "o", "\u001b[?2004h> "]
[142.435463, "o", "    end_match = re.search(r'END\\s+(\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2})', content)\r\n\u001b[?2004l\r"]
[142.435502, "o", "\u001b[?2004h> "]
[142.435548, "o", "    if end_match:\r\n\u001b[?2004l\r"]
[142.435596, "o", "\u001b[?2004h> "]
[142.435789, "o", "        end_time = datetime.strptime(end_match.group(1), '%Y-%m-%d %H:%M:%S')\r\n\u001b[?2004l\r"]
[142.435827, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.435865, "o", "\u001b[?2004h> "]
[142.435946, "o", "    return start_time, end_time\r\n\u001b[?2004l\r"]
[142.435984, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.436022, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[142.436059, "o", "> "]
[142.43612, "o", "def load_job_runtimes(jobs):\r\n\u001b[?2004l\r"]
[142.436169, "o", "\u001b[?2004h> "]
[142.436356, "o", "    \"\"\"Load actual runtime data from log files into job objects.\"\"\"\r\n\u001b[?2004l\r"]
[142.436396, "o", "\u001b[?2004h> "]
[142.43647, "o", "    log_dir = Path(LOG_DIR)\r\n\u001b[?2004l\r"]
[142.436505, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.436543, "o", "\u001b[?2004h> "]
[142.436592, "o", "    for job in jobs:\r\n\u001b[?2004l\r"]
[142.436623, "o", "\u001b[?2004h> "]
[142.436726, "o", "        # Find corresponding log file\r\n\u001b[?2004l\r"]
[142.436761, "o", "\u001b[?2004h> "]
[142.436898, "o", "        log_name = job.name.replace('.sh', '.log')\r\n\u001b[?2004l\r"]
[142.436934, "o", "\u001b[?2004h> "]
[142.437037, "o", "        log_path = log_dir / log_name\r\n\u001b[?2004l\r"]
[142.437079, "o", "\u001b[?2004h"]
[142.437122, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.437187, "o", "        if log_path.exists():\r\n\u001b[?2004l\r"]
[142.437224, "o", "\u001b[?2004h> "]
[142.437384, "o", "            start_time, end_time = parse_log_file(log_path)\r\n\u001b[?2004l\r"]
[142.437441, "o", "\u001b[?2004h> "]
[142.437539, "o", "            job.start_time = start_time\r\n\u001b[?2004l\r"]
[142.43758, "o", "\u001b[?2004h> "]
[142.437672, "o", "            job.end_time = end_time\r\n\u001b[?2004l\r"]
[142.437707, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.437745, "o", "\u001b[?2004h> "]
[142.437779, "o", "    return jobs\r\n\u001b[?2004l\r"]
[142.437816, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.437852, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.43789, "o", "\u001b[?2004h> "]
[142.437972, "o", "def find_overlapping_hours(jobs):\r\n\u001b[?2004l\r"]
[142.43801, "o", "\u001b[?2004h> "]
[142.438127, "o", "    \"\"\"Find hours where jobs overlapped.\"\"\"\r\n\u001b[?2004l\r"]
[142.438163, "o", "\u001b[?2004h> "]
[142.438227, "o", "    overlapping = set()\r\n\u001b[?2004l\r"]
[142.438264, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.438302, "o", "\u001b[?2004h> "]
[142.438434, "o", "    # Filter jobs that have actual runtime data\r\n\u001b[?2004l\r"]
[142.43847, "o", "\u001b[?2004h> "]
[142.438657, "o", "    jobs_with_data = [j for j in jobs if j.start_time and j.end_time]\r\n\u001b[?2004l\r"]
[142.438688, "o", "\u001b[?2004h"]
[142.438726, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.438849, "o", "    for i, job1 in enumerate(jobs_with_data):\r\n\u001b[?2004l\r"]
[142.43889, "o", "\u001b[?2004h> "]
[142.438995, "o", "        for job2 in jobs_with_data[i+1:]:\r\n\u001b[?2004l\r"]
[142.439031, "o", "\u001b[?2004h> "]
[142.439191, "o", "            # Check if jobs overlap using actual timestamps\r\n\u001b[?2004l\r"]
[142.439233, "o", "\u001b[?2004h> "]
[142.43949, "o", "            # Jobs overlap if: job1 starts before job2 ends AND job2 starts before job1 ends\r\n\u001b[?2004l\r"]
[142.439527, "o", "\u001b[?2004h> "]
[142.439754, "o", "            if job1.start_time < job2.end_time and job2.start_time < job1.end_time:\r\n\u001b[?2004l\r"]
[142.43979, "o", "\u001b[?2004h> "]
[142.439964, "o", "                # Find all hours during which the overlap occurs\r\n\u001b[?2004l\r"]
[142.440002, "o", "\u001b[?2004h> "]
[142.440199, "o", "                overlap_start = max(job1.start_time, job2.start_time)\r\n\u001b[?2004l\r"]
[142.440239, "o", "\u001b[?2004h> "]
[142.440408, "o", "                overlap_end = min(job1.end_time, job2.end_time)\r\n\u001b[?2004l\r"]
[142.440462, "o", "\u001b[?2004h> "]
[142.440501, "o", "                \r\n\u001b[?2004l\r"]
[142.440537, "o", "\u001b[?2004h> "]
[142.440722, "o", "                # Add all hours that contain any part of the overlap\r\n\u001b[?2004l\r"]
[142.440758, "o", "\u001b[?2004h> "]
[142.440865, "o", "                current = overlap_start\r\n\u001b[?2004l\r"]
[142.440902, "o", "\u001b[?2004h> "]
[142.441026, "o", "                while current <= overlap_end:\r\n\u001b[?2004l\r"]
[142.441061, "o", "\u001b[?2004h> "]
[142.441197, "o", "                    overlapping.add(current.hour)\r\n\u001b[?2004l\r"]
[142.441232, "o", "\u001b[?2004h> "]
[142.441341, "o", "                    # Move to next hour\r\n\u001b[?2004l\r"]
[142.441376, "o", "\u001b[?2004h> "]
[142.441603, "o", "                    current = current.replace(minute=0, second=0, microsecond=0)\r\n\u001b[?2004l\r"]
[142.441638, "o", "\u001b[?2004h> "]
[142.441752, "o", "                    if current.hour == 23:\r\n\u001b[?2004l\r"]
[142.44178, "o", "\u001b[?2004h"]
[142.441811, "o", "> "]
[142.441876, "o", "                        break\r\n\u001b[?2004l\r"]
[142.44191, "o", "\u001b[?2004h"]
[142.441946, "o", "> "]
[142.442108, "o", "                    current = current.replace(hour=current.hour + 1)\r\n\u001b[?2004l\r"]
[142.442149, "o", "\u001b[?2004h> "]
[142.442188, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.442276, "o", "    return sorted(list(overlapping))\r\n\u001b[?2004l\r"]
[142.442312, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.442352, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.442389, "o", "\u001b[?2004h> "]
[142.44246, "o", "def find_idle_hours(jobs):\r\n\u001b[?2004l\r"]
[142.442496, "o", "\u001b[?2004h> "]
[142.442622, "o", "    \"\"\"Find hours that were genuinely idle.\"\"\"\r\n\u001b[?2004l\r"]
[142.442657, "o", "\u001b[?2004h> "]
[142.442695, "o", "    idle = []\r\n\u001b[?2004l\r"]
[142.442732, "o", "\u001b[?2004h> "]
[142.44277, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.442906, "o", "    # Filter jobs that have actual runtime data\r\n\u001b[?2004l\r"]
[142.442942, "o", "\u001b[?2004h> "]
[142.44313, "o", "    jobs_with_data = [j for j in jobs if j.start_time and j.end_time]\r\n\u001b[?2004l\r"]
[142.443167, "o", "\u001b[?2004h> "]
[142.443204, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.44328, "o", "    if not jobs_with_data:\r\n\u001b[?2004l\r"]
[142.443317, "o", "\u001b[?2004h> "]
[142.4434, "o", "        return list(range(24))\r\n\u001b[?2004l\r"]
[142.443452, "o", "\u001b[?2004h> "]
[142.443496, "o", "    \r\n\u001b[?2004l\r"]
[142.443534, "o", "\u001b[?2004h> "]
[142.443631, "o", "    # Use the date from the first job as reference\r\n\u001b[?2004l\r"]
[142.443674, "o", "\u001b[?2004h> "]
[142.443826, "o", "    reference_date = jobs_with_data[0].start_time.date()\r\n\u001b[?2004l\r"]
[142.443859, "o", "\u001b[?2004h"]
[142.443896, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.443968, "o", "    for hour in range(24):\r\n\u001b[?2004l\r"]
[142.444005, "o", "\u001b[?2004h> "]
[142.444066, "o", "        is_idle = True\r\n\u001b[?2004l\r"]
[142.444106, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.444145, "o", "\u001b[?2004h> "]
[142.444328, "o", "        # Create datetime objects for the start and end of this hour\r\n\u001b[?2004l\r"]
[142.444364, "o", "\u001b[?2004h> "]
[142.444628, "o", "        hour_start = datetime.combine(reference_date, datetime.min.time()).replace(hour=hour)\r\n\u001b[?2004l\r"]
[142.444669, "o", "\u001b[?2004h> "]
[142.444879, "o", "        hour_end = hour_start.replace(minute=59, second=59, microsecond=999999)\r\n\u001b[?2004l\r"]
[142.444913, "o", "\u001b[?2004h> "]
[142.44495, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[142.444994, "o", "> "]
[142.445117, "o", "        # Check if any job was running during this hour\r\n\u001b[?2004l\r"]
[142.44515, "o", "\u001b[?2004h> "]
[142.445248, "o", "        for job in jobs_with_data:\r\n\u001b[?2004l\r"]
[142.445284, "o", "\u001b[?2004h> "]
[142.445552, "o", "            # A job runs during this hour if its time range overlaps with the hour's time range\r\n\u001b[?2004l\r"]
[142.445589, "o", "\u001b[?2004h> "]
[142.445843, "o", "            # Job overlaps hour if: job starts before hour ends AND job ends after hour starts\r\n\u001b[?2004l\r"]
[142.445876, "o", "\u001b[?2004h"]
[142.445917, "o", "> "]
[142.446079, "o", "            if job.start_time <= hour_end and job.end_time >= hour_start:\r\n\u001b[?2004l\r"]
[142.446121, "o", "\u001b[?2004h> "]
[142.446201, "o", "                is_idle = False\r\n\u001b[?2004l\r"]
[142.44624, "o", "\u001b[?2004h> "]
[142.446295, "o", "                break\r\n\u001b[?2004l\r"]
[142.446329, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.446368, "o", "\u001b[?2004h> "]
[142.446428, "o", "        if is_idle:\r\n\u001b[?2004l\r"]
[142.446462, "o", "\u001b[?2004h> "]
[142.446541, "o", "            idle.append(hour)\r\n\u001b[?2004l\r"]
[142.446567, "o", "\u001b[?2004h> "]
