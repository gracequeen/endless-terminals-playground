[49.765413, "o", "    with open(\"results/\u001b[01;31m\u001b[Kstatus.json\u001b[m\u001b[K\", \"w\") as f:\r\n        json.dump(results, f, indent=2)\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n    print(\"Report generated: results/\u001b[01;31m\u001b[Kstatus.json\u001b[m\u001b[K\")\r\n\r\n"]
