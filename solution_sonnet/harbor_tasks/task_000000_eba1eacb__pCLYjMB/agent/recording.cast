[65.035032, "o", ".PHONY: report clean check-config\r\n\r\n# Main target to generate the full report\r\nreport: results/status.json\r\n@echo \"Monitoring report complete!\"\r\n\r\n# Check if hosts.conf exists before doing anything\r\ncheck-config:\r\n@test -f hosts.conf || (echo \"ERROR: hosts.conf not found!\" && exit 1)\r\n\r\n# Generate ping results\r\nresults/ping.txt: hosts.conf scripts/check_ping.sh check-config\r\n@echo \"Running ping checks...\"\r\n./scripts/check_ping.sh\r\n\r\n# Generate port scan results\r\nresults/ports.txt: hosts.conf scripts/check_ports.sh check-config\r\n@echo \"Running port checks...\"\r\n./scripts/check_ports.sh\r\n\r\n# Aggregate results into JSON report\r\n"]
[65.03508, "o", "results/status.json: results/ping.txt results/ports.txt aggregate.py\r\n@echo \"Aggregating results...\"\r\npython3 aggregate.py\r\n\r\n# Clean up generated results\r\nclean:\r\nrm -rf results/\r\n@echo \"Cleaned up results directory\"\r\n"]
