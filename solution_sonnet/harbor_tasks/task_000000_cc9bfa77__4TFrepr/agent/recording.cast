[204.951359, "i", "python3 << 'EOF'\n# Let's try to understand the pattern better\n# Check if there's a repeating XOR key pattern\n\nwith open('primary_wal/000000010000000000000003', 'rb') as f:\n    data = f.read(1024)\n\n# PostgreSQL WAL page header for first page should have:\n# - magic: 0xF003 (for PG15) at offset 0\n# - info: various flags at offset 2  \n# - tli: timeline ID (usually 1) at offset 4\n# - pageaddr: should be 0x3000000 for segment 3 at offset 8\n# - rem_len: at offset 16\n\n# Let's see if XOR pattern changes\nprint(\"Trying different XOR patterns:\")\nprint(f\"Byte 0: {data[0]:02x} -> want 0x03, XOR key: {data[0] ^ 0x03:02x}\")\nprint(f\"Byte 1: {data[1]:02x} -> want 0xf0, XOR key: {data[1] ^ 0xf0:02x}\")\nprint(f\"Byte 4: {data[4]:02x} -> want 0x01 (tli), XOR key: {data[4] ^ 0x01:02x}\")\nprint(f\"Byte 8: {data[8]:02x} -> want 0x00 (pageaddr low), XOR key: {data[8] ^ 0x00:02x}\")\nprint(f\"Byte 12: {data[12]:02x} -> want 0x00 (pageaddr mid), XOR key: {data[12] ^ 0x00:02x}\")\nprint(f\"Byte 13: {data[13]:02x} -> want 0x00, XOR key: {data[13] "]
[204.951497, "i", "^ 0x00:02x}\")\nprint(f\"Byte 14: {data[14]:02x} -> want 0x00, XOR key: {data[14] ^ 0x00:02x}\")\nprint(f\"Byte 15: {data[15]:02x} -> want 0x03, XOR key: {data[15] ^ 0x03:02x}\")\nEOF\n"]
[204.951553, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r^ 0x00:02x}\")\r\nprint(f\"Byte 14: {data[14]:02x} -> want 0x00, XOR key: {data[14] ^ 0x00:02x}\")\r\nprint(f\"Byte 15: {data[15]:02x} -> want 0x"]
[204.951604, "o", "03, XOR key: {data[15] ^ 0x03:02x}\")\r\nEOF\r\n\u001b[?2004h> "]
