[249.80451, "i", "python3 << 'EOF'\nimport hashlib\n\n# Test if XOR key is derived from filename hash\nsegments = ['000000010000000000000003', '000000010000000000000004']\n\nfor seg_name in segments:\n    # Try MD5 of filename\n    md5_key = hashlib.md5(seg_name.encode()).digest()\n    print(f\"\\nSegment: {seg_name}\")\n    print(f\"  MD5: {md5_key.hex()}\")\n    \n    # Read first 16 bytes of the file\n    with open(f'primary_wal/{seg_name}', 'rb') as f:\n        data = f.read(16)\n    \n    # Try decoding with MD5 as repeating key\n    decoded = bytes([data[i] ^ md5_key[i % len(md5_key)] for i in range(16)])\n    print(f\"  Decoded first 16: {decoded.hex()}\")\n    print(f\"  First 2 bytes: {decoded[0]:02x}{decoded[1]:02x} (expect f003)\")\nEOF\n"]
