[240.783045, "i", "python3 << 'EOF'\nimport struct\n\n# Function to extract XOR key from first 8 bytes\ndef find_xor_key(data, expected):\n    \"\"\"Find XOR key that transforms data to expected\"\"\"\n    key = bytes([d ^ e for d, e in zip(data, expected)])\n    return key\n\n# Expected start of WAL page for segment 3 (at LSN 0x3000000)\n# Magic: 0xF003, info flags, timeline 1, pageaddr 0x03000000\nexpected_seg3 = bytes([0x03, 0xf0, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00,\n                       0x00, 0x00, 0x00, 0x03, 0x00, 0x00, 0x00, 0x00])\n\n# Expected start for segment 4 (at LSN 0x4000000)\nexpected_seg4 = bytes([0x03, 0xf0, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00,\n                       0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x00])\n\n# Read actual data\nwith open('primary_wal/000000010000000000000003', 'rb') as f:\n    actual_seg3 = f.read(16)\n\nwith open('primary_wal/000000010000000000000004', 'rb') as f:\n    actual_seg4 = f.read(16)\n\nkey3 = find_xor_key(actual_seg3, expected_seg3)\nkey4 = find_xor_key(actual_seg4, expected_seg4)\n\nprint(\"XOR key for "]
[240.783194, "i", "segment 3:\")\nprint(f\"  Hex: {key3.hex()}\")\nprint(f\"  Bytes: {' '.join(f'{b:02x}' for b in key3)}\")\n\nprint(\"\\nXOR key for segment 4:\")\nprint(f\"  Hex: {key4.hex()}\")\nprint(f\"  Bytes: {' '.join(f'{b:02x}' for b in key4)}\")\n\n# Check if there's a pattern\nprint(\"\\nDifferences:\")\nfor i in range(16):\n    if key3[i] != key4[i]:\n        print(f\"  Byte {i}: seg3={key3[i]:02x}, seg4={key4[i]:02x}, diff={key3[i]^key4[i]:02x}\")\nEOF\n"]
[240.783266, "o", "python3 << 'EOF'\r\n\u001b[?2004l\rsegment 3:\")\r\nprint(f\"  Hex: {key3.hex()}\")\r\nprint(f\"  Bytes: {' '.join(f'{b:02x}' for b in key3)}\")\r\n\r\nprint(\"\\nXOR key for segment 4:\")\r\nprint(f\"  Hex: {key4.hex()}\")\r\nprint(f\"  B"]
[240.783333, "o", "ytes: {' '.join(f'{b:02x}' for b in key4)}\")\r\n\r\n# Check if there's a pattern\r\nprint(\"\\nDifferences:\")\r\nfor i in range(16):\r\n    if key3[i] != key4[i]:\r\n   "]
