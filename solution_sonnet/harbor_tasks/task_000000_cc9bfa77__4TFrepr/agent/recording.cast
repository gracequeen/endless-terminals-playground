[277.244936, "i", "pg_waldump --help 2>&1 | grep -A 5 -i 'option\\|usage'\n"]
[277.245168, "o", "pg_waldump --help 2>&1 | grep -A 5 -i 'option\\|usage'\r\n\u001b[?2004l\r"]
[277.247009, "o", "Usage:\r\n  pg_waldump [OPTION]... [STARTSEG [ENDSEG]]\r\n"]
[277.247093, "o", "\r\nOptions:\r\n  -b, --bkp-details      output detailed information about backup blocks\r\n  -B, --block=N          with --relation, only show records that modify block N\r\n  -e, --end=RECPTR       stop reading at WAL location RECPTR\r\n  -f, --follow           keep retrying after reaching end of WAL\r\n  -F, --fork=FORK        only show records that modify blocks in fork FORK;\r\n--\r\n                         (optionally, show per-record statistics)\r\n"]
[277.247155, "o", "  -?, --help             show this help, then exit\r\n\r\nReport bugs to <pgsql-bugs@lists.postgresql.org>.\r\nPostgreSQL home page: <https://www.postgresql.org/>\r\n"]
