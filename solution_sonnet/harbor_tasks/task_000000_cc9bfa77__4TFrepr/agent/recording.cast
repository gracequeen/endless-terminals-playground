[155.897198, "i", "python3 << 'EOF'\n# PostgreSQL WAL magic number is typically 0xD110 for PG15\n# Let's check what we have and see if it's XOR'd\nimport struct\n\nwith open('primary_wal/000000010000000000000003', 'rb') as f:\n    header = f.read(24)\n    print(\"First 24 bytes:\", header.hex())\n    # Try to find XOR pattern\n    # PG15 magic should be around 0xD110 or similar\n    first_two = struct.unpack('<H', header[0:2])[0]\n    print(f\"First 2 bytes as uint16: {first_two:#06x}\")\n    \n    # Check if XOR with common values\n    for xor_val in [0xFF, 0xAA, 0x55, 0xCC]:\n        result = first_two ^ (xor_val | (xor_val << 8))\n        print(f\"XOR with {xor_val:#04x}: {result:#06x}\")\nEOF\n"]
