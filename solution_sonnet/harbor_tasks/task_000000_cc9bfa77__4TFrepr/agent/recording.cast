[204.9557, "o", "EOF\r\n\u001b[?2004l\r"]
[204.966405, "o", "Trying different XOR patterns:\r\n"]
[204.96645, "o", "Byte 0: fc -> want 0x03, XOR key: ff\r\nByte 1: 0f -> want 0xf0, XOR key: ff\r\nByte 4: 6b -> want 0x01 (tli), XOR key: 6a\r\nByte 8: fc -> want 0x00 (pageaddr low), XOR key: fc\r\nByte 12: 26 -> want 0x00 (pageaddr mid), XOR key: 26\r\nByte 13: 0d -> want 0x00, XOR key: 0d\r\nByte 14: b8 -> want 0x00, XOR key: b8\r\nByte 15: c1 -> want 0x03, XOR key: c2\r\n"]
[204.968427, "o", "\u001b[?2004huser@b01184b52a1a:~/wal_recovery$ "]
[215.559029, "i", "python3 << 'EOF'\nimport struct\n\n# Read the encoded file\nwith open('primary_wal/000000010000000000000003', 'rb') as f:\n    data = f.read(8192)  # First page\n\n# XOR with 0xFF and check\nxor_ff = bytes([b ^ 0xFF for b in data[:100]])\nprint(\"First 100 bytes XOR 0xFF:\")\nfor i in range(0, 100, 16):\n    hex_str = ' '.join(f'{b:02x}' for b in xor_ff[i:i+16])\n    print(f\"{i:04x}: {hex_str}\")\n\n# Check if it's a repeating key\nprint(\"\\nLooking for repeating XOR key pattern:\")\nfor key_len in [4, 8, 16, 32]:\n    # Assume key repeats every key_len bytes\n    # Extract potential key from first key_len bytes\n    # by XORing with what we expect\n    expected_start = bytes([0x03, 0xf0, 0x00, 0x00])  # magic + flags start\n    potential_key = bytes([data[i] ^ expected_start[i] if i < len(expected_start) else 0 \n                          for i in range(key_len)])\n    print(f\"\\nKey length {key_len}: {potential_key[:16].hex()}\")\nEOF\n"]
