[277.356295, "i", "python3 << 'EOF'\n# Maybe the corruption is in specific bytes\n# Let's check if the files have any valid PostgreSQL WAL page headers\n# WAL pages are 8KB each, so check every 8192 bytes\n\nimport struct\n\ndef check_wal_pages(filename, max_pages=10):\n    with open(filename, 'rb') as f:\n        data = f.read()\n    \n    page_size = 8192\n    print(f\"\\nChecking {filename}:\")\n    print(f\"  File size: {len(data)} bytes ({len(data)//page_size} pages)\")\n    \n    for page_num in range(min(max_pages, len(data)//page_size)):\n        offset = page_num * page_size\n        page_data = data[offset:offset+page_size]\n        \n        # Check magic number (should be 0xF003 for PG15 or similar)\n        magic = struct.unpack('<H', page_data[0:2])[0]\n        \n        # Check various XOR possibilities\n        for xor_val in [0x0000, 0xFFFF, 0xAAAA, 0x5555]:\n            xor_magic = magic ^ xor_val\n            if xor_magic in [0xF003, 0xD110, 0xD113]:  # Known PG magic numbers\n                print(f\"  Page {page_num}: magic={magic:#06x}, "]
[277.356415, "i", "XOR {xor_val:#06x} = {xor_magic:#06x} (MATCH!)\")\n                break\n\ncheck_wal_pages('primary_wal/000000010000000000000003', 5)\ncheck_wal_pages('primary_wal/000000010000000000000004', 5)\nEOF\n"]
[277.356456, "o", "python3 << 'EOF'\r\n\u001b[?2004l\rXOR {xor_val:#06x} = {xor_magic:#06x} (MATCH!)\")\r\n                break\r\n\r\ncheck_wal_pages"]
[277.356495, "o", "('primary_wal/000000010000000000000003', 5)\r\ncheck_wal_pages('primary_wal/000000010000000000000004', 5)\r\nEOF\r\n\u001b[?2004h> "]
