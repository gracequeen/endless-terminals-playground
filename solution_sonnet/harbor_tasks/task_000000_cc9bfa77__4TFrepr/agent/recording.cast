[190.921093, "i", "python3 << 'EOF'\nimport struct\n\n# Read decoded header\nwith open('decoded_wal/000000010000000000000003', 'rb') as f:\n    data = f.read(100)\n\nprint(\"Decoded header (first 100 bytes):\")\nfor i in range(0, 100, 16):\n    hex_str = ' '.join(f'{b:02x}' for b in data[i:i+16])\n    print(f\"{i:04x}: {hex_str}\")\n\n# Parse key fields\nprint(\"\\nKey fields:\")\nprint(f\"Magic (offset 0): {struct.unpack('<H', data[0:2])[0]:#06x}\")\nprint(f\"Flag (offset 2): {struct.unpack('<H', data[2:4])[0]:#06x}\")\nprint(f\"PageAddr (offset 4): {struct.unpack('<Q', data[4:12])[0]:#018x}\")\nprint(f\"Timeline (offset 12): {struct.unpack('<I', data[12:16])[0]}\")\nprint(f\"PageSize (offset 16): {struct.unpack('<I', data[16:20])[0]}\")\nEOF\n"]
