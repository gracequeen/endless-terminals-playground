[262.280006, "i", "python3 << 'EOF'\n# Check segment 5 XOR key pattern\nexpected_seg5 = bytes([0x03, 0xf0, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00,\n                       0x00, 0x00, 0x00, 0x05, 0x00, 0x00, 0x00, 0x00])\n\nwith open('primary_wal/000000010000000000000005', 'rb') as f:\n    actual_seg5 = f.read(16)\n\nkey5 = bytes([a ^ e for a, e in zip(actual_seg5, expected_seg5)])\nprint(f\"XOR key for segment 5: {key5.hex()}\")\n\n# Check segment 6\nexpected_seg6 = bytes([0x03, 0xf0, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00,\n                       0x00, 0x00, 0x00, 0x06, 0x00, 0x00, 0x00, 0x00])\n\nwith open('primary_wal/000000010000000000000006', 'rb') as f:\n    actual_seg6 = f.read(16)\n\nkey6 = bytes([a ^ e for a, e in zip(actual_seg6, expected_seg6)])\nprint(f\"XOR key for segment 6: {key6.hex()}\")\nEOF\n"]
