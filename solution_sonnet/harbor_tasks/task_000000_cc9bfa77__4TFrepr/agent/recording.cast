[165.224092, "i", "python3 << 'EOF'\n# Try XOR decoding with 0xFF\nimport os\n\ndef xor_decode_file(input_path, output_path, xor_byte=0xFF):\n    with open(input_path, 'rb') as fin:\n        data = fin.read()\n    decoded = bytes([b ^ xor_byte for b in data])\n    with open(output_path, 'wb') as fout:\n        fout.write(decoded)\n    print(f\"Decoded {input_path} -> {output_path}\")\n\n# Create decoded directory\nos.makedirs('decoded_wal', exist_ok=True)\n\n# Decode segment 3 from primary\nxor_decode_file('primary_wal/000000010000000000000003', \n                'decoded_wal/000000010000000000000003', 0xFF)\n\n# Check the header\nwith open('decoded_wal/000000010000000000000003', 'rb') as f:\n    header = f.read(24)\n    print(\"Decoded first 24 bytes:\", header.hex())\nEOF\n"]
