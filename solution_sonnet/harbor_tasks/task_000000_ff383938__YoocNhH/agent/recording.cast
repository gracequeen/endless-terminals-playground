[120.447045, "o", "\u001b[?2004h> "]
[120.44716, "o", "    print(f\"Idle hours: {idle_hours}\")\r\n\u001b[?2004l\r"]
[120.447193, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[120.447218, "o", "\u001b[?2004h"]
[120.447249, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[120.447276, "o", "> "]
[120.447338, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[120.447365, "o", "\u001b[?2004h> "]
[120.447402, "o", "    main()\r\n\u001b[?2004l\r"]
