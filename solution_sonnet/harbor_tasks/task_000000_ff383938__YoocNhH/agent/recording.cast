[120.422439, "o", "\u001b[?2004h> "]
[120.422561, "o", "from datetime import datetime\r\n\u001b[?2004l\r"]
[120.422593, "o", "\u001b[?2004h> "]
[120.422694, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[120.422725, "o", "\u001b[?2004h> \r\n"]
[120.422761, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[120.422796, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[120.423, "o", "CRONTAB_PATH = \"/var/spool/cron/crontabs/user\"\r\n\u001b[?2004l\r"]
[120.423043, "o", "\u001b[?2004h> "]
[120.42314, "o", "LOG_DIR = \"/var/log/batch\"\r\n\u001b[?2004l\r"]
[120.423168, "o", "\u001b[?2004h> "]
[120.423344, "o", "OUTPUT_PATH = \"/home/user/reports/windows.json\"\r\n\u001b[?2004l\r"]
[120.423371, "o", "\u001b[?2004h"]
[120.4234, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[120.423427, "o", "> \r\n\u001b[?2004l\r"]
[120.423454, "o", "\u001b[?2004h> "]
[120.423501, "o", "class Job:\r\n\u001b[?2004l\r"]
[120.423531, "o", "\u001b[?2004h> "]
[120.423864, "o", "    def __init__(self, name, scheduled_hour, start_time=None, end_time=None):\r\n\u001b[?2004l\r"]
[120.423891, "o", "\u001b[?2004h"]
[120.423928, "o", "> "]
[120.42401, "o", "        self.name = name\r\n\u001b[?2004l\r"]
[120.42405, "o", "\u001b[?2004h> "]
[120.424229, "o", "        self.scheduled_hour = scheduled_hour\r\n\u001b[?2004l\r"]
[120.424258, "o", "\u001b[?2004h"]
[120.424295, "o", "> "]
[120.42442, "o", "        self.start_time = start_time\r\n\u001b[?2004l\r"]
[120.424448, "o", "\u001b[?2004h> "]
[120.424598, "o", "        self.end_time = end_time\r\n\u001b[?2004l\r"]
[120.424632, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[120.424663, "o", "\u001b[?2004h> "]
[120.424727, "o", "    @property\r\n\u001b[?2004l\r"]
[120.424757, "o", "\u001b[?2004h> "]
[120.424869, "o", "    def start_hour(self):\r\n\u001b[?2004l\r"]
[120.424896, "o", "\u001b[?2004h> "]
[120.425034, "o", "        if self.start_time:\r\n\u001b[?2004l\r"]
[120.425067, "o", "\u001b[?2004h> "]
[120.425225, "o", "            return self.start_time.hour\r\n\u001b[?2004l\r"]
[120.425253, "o", "\u001b[?2004h> "]
[120.425405, "o", "        return self.scheduled_hour\r\n\u001b[?2004l\r"]
[120.425431, "o", "\u001b[?2004h"]
[120.425459, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[120.425484, "o", "> "]
[120.425532, "o", "    @property\r\n\u001b[?2004l\r"]
[120.425563, "o", "\u001b[?2004h> "]
[120.42566, "o", "    def end_hour(self):\r\n\u001b[?2004l\r"]
[120.425693, "o", "\u001b[?2004h> "]
[120.425811, "o", "        if self.end_time:\r\n\u001b[?2004l\r"]
[120.425841, "o", "\u001b[?2004h> "]
[120.42601, "o", "            return self.end_time.hour\r\n\u001b[?2004l\r"]
[120.426036, "o", "\u001b[?2004h"]
[120.426066, "o", "> "]
[120.426177, "o", "        return self.scheduled_hour\r\n\u001b[?2004l\r"]
[120.426205, "o", "\u001b[?2004h> "]
[120.426233, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[120.42626, "o", "> \r\n\u001b[?2004l\r"]
[120.426286, "o", "\u001b[?2004h> "]
[120.426371, "o", "def parse_crontab():\r\n\u001b[?2004l\r"]
[120.426404, "o", "\u001b[?2004h> "]
[120.42664, "o", "    \"\"\"Parse crontab file and extract job schedules.\"\"\"\r\n\u001b[?2004l\r"]
[120.426675, "o", "\u001b[?2004h> "]
[120.426724, "o", "    jobs = []\r\n\u001b[?2004l\r"]
[120.426754, "o", "\u001b[?2004h> \r\n"]
[120.426782, "o", "\u001b[?2004l\r\u001b[?2004h"]
[120.426814, "o", "> "]
[120.426961, "o", "    with open(CRONTAB_PATH, 'r') as f:\r\n\u001b[?2004l\r"]
[120.426999, "o", "\u001b[?2004h> "]
[120.427097, "o", "        for line in f:\r\n\u001b[?2004l\r"]
[120.427128, "o", "\u001b[?2004h> "]
[120.427254, "o", "            line = line.strip()\r\n\u001b[?2004l\r"]
[120.427281, "o", "\u001b[?2004h> "]
[120.427481, "o", "            if not line or line.startswith('#'):\r\n\u001b[?2004l\r"]
[120.427508, "o", "\u001b[?2004h> "]
[120.42762, "o", "                continue\r\n\u001b[?2004l\r"]
[120.427651, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[120.427673, "o", "\u001b[?2004h"]
[120.427703, "o", "> "]
[120.427822, "o", "            parts = line.split()\r\n\u001b[?2004l\r"]
[120.42785, "o", "\u001b[?2004h> "]
[120.428004, "o", "            if len(parts) >= 6:\r\n\u001b[?2004l\r"]
[120.428036, "o", "\u001b[?2004h> "]
[120.42818, "o", "                minute = parts[0]\r\n\u001b[?2004l\r"]
[120.428207, "o", "\u001b[?2004h"]
[120.428237, "o", "> "]
[120.428349, "o", "                hour = parts[1]\r\n\u001b[?2004l\r"]
[120.428375, "o", "\u001b[?2004h> "]
[120.428525, "o", "                command = parts[5]\r\n\u001b[?2004l\r"]
[120.428554, "o", "\u001b[?2004h"]
[120.428588, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[120.428808, "o", "                job_name = os.path.basename(command)\r\n\u001b[?2004l\r"]
[120.428837, "o", "\u001b[?2004h> "]
[120.429034, "o", "                scheduled_hour = int(hour)\r\n\u001b[?2004l\r"]
[120.42907, "o", "\u001b[?2004h"]
[120.429097, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[120.429343, "o", "                jobs.append(Job(job_name, scheduled_hour))\r\n\u001b[?2004l\r"]
[120.429372, "o", "\u001b[?2004h"]
[120.429405, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[120.429441, "o", "> "]
[120.429479, "o", "    return jobs\r\n\u001b[?2004l\r"]
[120.429507, "o", "\u001b[?2004h> "]
[120.429534, "o", "\r\n\u001b[?2004l\r"]
[120.429562, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[120.42959, "o", "\u001b[?2004h> "]
[120.42972, "o", "def parse_log_file(log_path):\r\n\u001b[?2004l\r"]
[120.42976, "o", "\u001b[?2004h> "]
[120.430033, "o", "    \"\"\"Parse a log file to extract start and end timestamps.\"\"\"\r\n\u001b[?2004l\r"]
[120.430068, "o", "\u001b[?2004h> "]
[120.430157, "o", "    start_time = None\r\n\u001b[?2004l\r"]
[120.430188, "o", "\u001b[?2004h> "]
[120.430273, "o", "    end_time = None\r\n\u001b[?2004l\r"]
[120.430304, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[120.430334, "o", "\u001b[?2004h> "]
[120.430478, "o", "    with open(log_path, 'r') as f:\r\n\u001b[?2004l\r"]
[120.430517, "o", "\u001b[?2004h> "]
[120.430622, "o", "        content = f.read()\r\n\u001b[?2004l\r"]
[120.430654, "o", "\u001b[?2004h> "]
[120.430685, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[120.430806, "o", "    # Match START timestamp\r\n\u001b[?2004l\r"]
[120.430838, "o", "\u001b[?2004h> "]
[120.431201, "o", "    start_match = re.search(r'START\\s+(\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2})', content)\r\n\u001b[?2004l\r"]
[120.431231, "o", "\u001b[?2004h"]
[120.431262, "o", "> "]
[120.431318, "o", "    if start_match:\r\n\u001b[?2004l\r"]
[120.431342, "o", "\u001b[?2004h"]
[120.431366, "o", "> "]
[120.431693, "o", "        start_time = datetime.strptime(start_match.group(1), '%Y-%m-%d %H:%M:%S')\r\n\u001b[?2004l\r"]
[120.431724, "o", "\u001b[?2004h"]
[120.431755, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[120.431788, "o", "> "]
[120.431873, "o", "    # Match END timestamp\r\n\u001b[?2004l\r"]
[120.431906, "o", "\u001b[?2004h> "]
[120.432197, "o", "    end_match = re.search(r'END\\s+(\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2})', content)\r\n\u001b[?2004l\r"]
[120.432225, "o", "\u001b[?2004h"]
[120.432255, "o", "> "]
[120.432282, "o", "    if end_match:\r\n\u001b[?2004l\r"]
[120.43231, "o", "\u001b[?2004h> "]
[120.432529, "o", "        end_time = datetime.strptime(end_match.group(1), '%Y-%m-%d %H:%M:%S')\r\n\u001b[?2004l\r"]
[120.432561, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[120.43259, "o", "\u001b[?2004h> "]
[120.432683, "o", "    return start_time, end_time\r\n\u001b[?2004l\r"]
[120.432715, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[120.432748, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[120.432784, "o", "\u001b[?2004h> "]
[120.432862, "o", "def load_job_runtimes(jobs):\r\n\u001b[?2004l\r"]
[120.432892, "o", "\u001b[?2004h> "]
[120.433093, "o", "    \"\"\"Load actual runtime data from log files into job objects.\"\"\"\r\n\u001b[?2004l\r"]
[120.433125, "o", "\u001b[?2004h> "]
[120.433203, "o", "    log_dir = Path(LOG_DIR)\r\n\u001b[?2004l\r"]
[120.433233, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[120.43326, "o", "\u001b[?2004h> "]
[120.433324, "o", "    for job in jobs:\r\n\u001b[?2004l\r"]
[120.433351, "o", "\u001b[?2004h"]
[120.433378, "o", "> "]
[120.433463, "o", "        # Find corresponding log file\r\n\u001b[?2004l\r"]
[120.433493, "o", "\u001b[?2004h> "]
[120.433635, "o", "        log_name = job.name.replace('.sh', '.log')\r\n\u001b[?2004l\r"]
[120.433667, "o", "\u001b[?2004h> "]
[120.43378, "o", "        log_path = log_dir / log_name\r\n\u001b[?2004l\r"]
[120.433814, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[120.433847, "o", "\u001b[?2004h> "]
[120.433928, "o", "        if log_path.exists():\r\n\u001b[?2004l\r"]
[120.433959, "o", "\u001b[?2004h> "]
[120.434135, "o", "            start_time, end_time = parse_log_file(log_path)\r\n\u001b[?2004l\r"]
[120.434168, "o", "\u001b[?2004h> "]
[120.434282, "o", "            job.start_time = start_time\r\n\u001b[?2004l\r"]
[120.434313, "o", "\u001b[?2004h> "]
[120.43442, "o", "            job.end_time = end_time\r\n\u001b[?2004l\r"]
[120.43445, "o", "\u001b[?2004h> \r\n"]
[120.434477, "o", "\u001b[?2004l\r\u001b[?2004h"]
[120.434508, "o", "> "]
[120.43454, "o", "    return jobs\r\n\u001b[?2004l\r"]
[120.434571, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[120.434602, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[120.434632, "o", "\u001b[?2004h> "]
[120.434726, "o", "def find_overlapping_hours(jobs):\r\n\u001b[?2004l\r"]
[120.434757, "o", "\u001b[?2004h> "]
[120.434879, "o", "    \"\"\"Find hours where jobs overlapped.\"\"\"\r\n\u001b[?2004l\r"]
[120.434911, "o", "\u001b[?2004h> "]
[120.434989, "o", "    overlapping = set()\r\n\u001b[?2004l\r"]
[120.435021, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[120.435052, "o", "\u001b[?2004h> "]
[120.435138, "o", "    # Check all pairs of jobs\r\n\u001b[?2004l\r"]
[120.435171, "o", "\u001b[?2004h> "]
[120.435269, "o", "    for i, job1 in enumerate(jobs):\r\n\u001b[?2004l\r"]
[120.435298, "o", "\u001b[?2004h> "]
[120.435389, "o", "        for job2 in jobs[i+1:]:\r\n\u001b[?2004l\r"]
[120.43542, "o", "\u001b[?2004h> "]
[120.435544, "o", "            # Skip jobs without runtime data\r\n\u001b[?2004l\r"]
[120.435577, "o", "\u001b[?2004h> "]
[120.435754, "o", "            if job1.start_time is None or job1.end_time is None:\r\n\u001b[?2004l\r"]
[120.435788, "o", "\u001b[?2004h> "]
[120.435857, "o", "                continue\r\n\u001b[?2004l\r"]
[120.435888, "o", "\u001b[?2004h> "]
[120.436081, "o", "            if job2.start_time is None or job2.end_time is None:\r\n\u001b[?2004l\r"]
[120.436113, "o", "\u001b[?2004h> "]
[120.436182, "o", "                continue\r\n\u001b[?2004l\r"]
[120.436203, "o", "\u001b[?2004h"]
[120.43623, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[120.436262, "o", "> "]
[120.43641, "o", "            # Check if jobs overlap using actual timestamps\r\n\u001b[?2004l\r"]
[120.436438, "o", "\u001b[?2004h"]
[120.43647, "o", "> "]
[120.43663, "o", "            # Two jobs overlap if: start1 < end2 AND start2 < end1\r\n\u001b[?2004l\r"]
[120.436662, "o", "\u001b[?2004h> "]
[120.436888, "o", "            if job1.start_time < job2.end_time and job2.start_time < job1.end_time:\r\n\u001b[?2004l\r"]
[120.436918, "o", "\u001b[?2004h> "]
[120.437132, "o", "                # Jobs overlap! Find all hours affected by this overlap\r\n\u001b[?2004l\r"]
[120.437162, "o", "\u001b[?2004h"]
[120.437188, "o", "> "]
[120.437394, "o", "                # The overlap period is from max(start1, start2) to min(end1, end2)\r\n\u001b[?2004l\r"]
[120.437425, "o", "\u001b[?2004h> "]
[120.437617, "o", "                overlap_start = max(job1.start_time, job2.start_time)\r\n\u001b[?2004l\r"]
[120.437649, "o", "\u001b[?2004h> "]
[120.437839, "o", "                overlap_end = min(job1.end_time, job2.end_time)\r\n\u001b[?2004l\r"]
[120.437873, "o", "\u001b[?2004h> "]
[120.437915, "o", "                \r\n\u001b[?2004l\r"]
[120.437947, "o", "\u001b[?2004h> "]
[120.438124, "o", "                # Add all hours during the overlap period\r\n\u001b[?2004l\r"]
[120.438154, "o", "\u001b[?2004h> "]
[120.438296, "o", "                current_hour = overlap_start.hour\r\n\u001b[?2004l\r"]
[120.438323, "o", "\u001b[?2004h> "]
[120.438449, "o", "                end_hour = overlap_end.hour\r\n\u001b[?2004l\r"]
[120.438472, "o", "\u001b[?2004h"]
[120.438502, "o", "> "]
[120.438527, "o", "                \r\n\u001b[?2004l\r"]
[120.438553, "o", "\u001b[?2004h> "]
[120.438748, "o", "                # Handle the case where overlap spans multiple hours\r\n\u001b[?2004l\r"]
[120.438778, "o", "\u001b[?2004h> "]
[120.438905, "o", "                if current_hour <= end_hour:\r\n\u001b[?2004l\r"]
[120.438933, "o", "\u001b[?2004h> "]
[120.439126, "o", "                    for h in range(current_hour, end_hour + 1):\r\n\u001b[?2004l\r"]
[120.439158, "o", "\u001b[?2004h> "]
[120.439275, "o", "                        overlapping.add(h)\r\n\u001b[?2004l\r"]
[120.439305, "o", "\u001b[?2004h> "]
[120.439368, "o", "                else:\r\n\u001b[?2004l\r"]
[120.439396, "o", "\u001b[?2004h> "]
[120.439627, "o", "                    # Handle day boundary (shouldn't happen in this case)\r\n\u001b[?2004l\r\u001b[?2004h"]
[120.439692, "o", "> "]
[120.439788, "o", "                    for h in range(current_hour, 24):\r\n\u001b[?2004l\r"]
[120.439824, "o", "\u001b[?2004h> "]
[120.439937, "o", "                        overlapping.add(h)\r\n\u001b[?2004l\r"]
[120.439965, "o", "\u001b[?2004h> "]
[120.440125, "o", "                    for h in range(0, end_hour + 1):\r\n\u001b[?2004l\r"]
[120.440156, "o", "\u001b[?2004h> "]
[120.440278, "o", "                        overlapping.add(h)\r\n\u001b[?2004l\r"]
[120.440305, "o", "\u001b[?2004h> "]
[120.440333, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[120.440361, "o", "> "]
[120.440446, "o", "    return sorted(list(overlapping))\r\n\u001b[?2004l\r"]
[120.440477, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[120.440504, "o", "\u001b[?2004h"]
[120.440532, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[120.44056, "o", "> "]
[120.440619, "o", "def find_idle_hours(jobs):\r\n\u001b[?2004l\r"]
[120.440649, "o", "\u001b[?2004h> "]
[120.440781, "o", "    \"\"\"Find hours that were genuinely idle.\"\"\"\r\n\u001b[?2004l\r"]
[120.440809, "o", "\u001b[?2004h> "]
[120.440854, "o", "    idle = []\r\n\u001b[?2004l\r"]
[120.440881, "o", "\u001b[?2004h> "]
[120.440909, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[120.440937, "o", "> "]
[120.441003, "o", "    for hour in range(24):\r\n\u001b[?2004l\r"]
[120.441035, "o", "\u001b[?2004h> "]
[120.4411, "o", "        is_idle = True\r\n\u001b[?2004l\r"]
[120.441128, "o", "\u001b[?2004h> "]
[120.441156, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[120.441184, "o", "> "]
[120.441321, "o", "        # Check if any job was running during this hour\r\n\u001b[?2004l\r"]
[120.44135, "o", "\u001b[?2004h> "]
[120.441424, "o", "        for job in jobs:\r\n\u001b[?2004l\r"]
[120.441451, "o", "\u001b[?2004h> "]
[120.44158, "o", "            # Skip jobs without runtime data\r\n\u001b[?2004l\r"]
[120.441607, "o", "\u001b[?2004h> "]
[120.441793, "o", "            if job.start_time is None or job.end_time is None:\r\n\u001b[?2004l\r"]
[120.441827, "o", "\u001b[?2004h> "]
[120.442029, "o", "                # If no runtime data, check if scheduled in this hour\r\n\u001b[?2004l\r"]
[120.442053, "o", "\u001b[?2004h"]
[120.442084, "o", "> "]
[120.442191, "o", "                if job.scheduled_hour == hour:\r\n\u001b[?2004l\r"]
[120.442215, "o", "\u001b[?2004h"]
[120.442241, "o", "> "]
[120.442323, "o", "                    is_idle = False\r\n\u001b[?2004l\r"]
[120.442353, "o", "\u001b[?2004h> "]
[120.442429, "o", "                    break\r\n\u001b[?2004l\r"]
[120.442461, "o", "\u001b[?2004h> "]
[120.442513, "o", "            else:\r\n\u001b[?2004l\r"]
[120.442536, "o", "\u001b[?2004h"]
[120.442569, "o", "> "]
[120.442756, "o", "                # Check if the job was running at any point during this hour\r\n\u001b[?2004l\r"]
[120.442786, "o", "\u001b[?2004h> "]
[120.442992, "o", "                # A job runs in hour H if: start_hour <= H <= end_hour\r\n\u001b[?2004l\r"]
[120.443029, "o", "\u001b[?2004h> "]
[120.443235, "o", "                # But we need to be more precise: the job runs in hour H if\r\n\u001b[?2004l\r"]
[120.443267, "o", "\u001b[?2004h> "]
[120.443566, "o", "                # its start time is before the end of hour H and its end time is after the start of hour H\r\n\u001b[?2004l\r"]
[120.443594, "o", "\u001b[?2004h> "]
[120.443788, "o", "                if job.start_time.hour <= hour <= job.end_time.hour:\r\n\u001b[?2004l\r"]
[120.443813, "o", "\u001b[?2004h> "]
[120.443919, "o", "                    is_idle = False\r\n\u001b[?2004l\r"]
[120.443948, "o", "\u001b[?2004h> "]
[120.444033, "o", "                    break\r\n\u001b[?2004l\r"]
[120.444067, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[120.444095, "o", "\u001b[?2004h> "]
[120.444155, "o", "        if is_idle:\r\n\u001b[?2004l\r"]
[120.444185, "o", "\u001b[?2004h> "]
[120.444269, "o", "            idle.append(hour)\r\n\u001b[?2004l\r"]
[120.4443, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[120.444331, "o", "\u001b[?2004h> "]
[120.444378, "o", "    return idle\r\n\u001b[?2004l\r"]
[120.444409, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[120.444436, "o", "\u001b[?2004h> "]
[120.444467, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[120.444497, "o", "> "]
[120.444525, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h"]
[120.444552, "o", "> "]
[120.444658, "o", "    # Parse crontab to get scheduled jobs\r\n\u001b[?2004l\r"]
[120.444689, "o", "\u001b[?2004h> "]
[120.444768, "o", "    jobs = parse_crontab()\r\n\u001b[?2004l\r"]
[120.444795, "o", "\u001b[?2004h"]
[120.444823, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[120.44485, "o", "> "]
[120.444948, "o", "    # Load actual runtime data from logs\r\n\u001b[?2004l\r"]
[120.444992, "o", "\u001b[?2004h> "]
[120.445086, "o", "    jobs = load_job_runtimes(jobs)\r\n\u001b[?2004l\r"]
[120.445118, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[120.445147, "o", "\u001b[?2004h> "]
[120.445256, "o", "    # Find overlapping and idle hours\r\n\u001b[?2004l\r"]
[120.445287, "o", "\u001b[?2004h> "]
[120.445433, "o", "    overlapping_hours = find_overlapping_hours(jobs)\r\n\u001b[?2004l\r"]
[120.44546, "o", "\u001b[?2004h"]
[120.445493, "o", "> "]
[120.445575, "o", "    idle_hours = find_idle_hours(jobs)\r\n\u001b[?2004l\r"]
[120.445606, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[120.445633, "o", "\u001b[?2004h> "]
[120.445692, "o", "    # Write output\r\n\u001b[?2004l\r"]
[120.445723, "o", "\u001b[?2004h> "]
[120.445774, "o", "    result = {\r\n\u001b[?2004l\r"]
[120.445805, "o", "\u001b[?2004h> "]
[120.44594, "o", "        \"overlapping_hours\": overlapping_hours,\r\n\u001b[?2004l\r"]
[120.445971, "o", "\u001b[?2004h> "]
[120.446074, "o", "        \"idle_hours\": idle_hours\r\n\u001b[?2004l\r"]
[120.446102, "o", "\u001b[?2004h> "]
[120.446131, "o", "    }\r\n\u001b[?2004l\r"]
[120.446158, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[120.446186, "o", "\u001b[?2004h> "]
[120.446358, "o", "    os.makedirs(os.path.dirname(OUTPUT_PATH), exist_ok=True)\r\n\u001b[?2004l\r"]
[120.446384, "o", "\u001b[?2004h> "]
[120.446494, "o", "    with open(OUTPUT_PATH, 'w') as f:\r\n\u001b[?2004l\r"]
[120.446521, "o", "\u001b[?2004h> "]
