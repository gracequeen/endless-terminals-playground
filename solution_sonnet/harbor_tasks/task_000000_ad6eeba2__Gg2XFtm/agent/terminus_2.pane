[?2004l[?2004h>         return dt.strftime('%Y-%m-%d')
[?2004l[?2004h>     except ValueError:
[?2004l[?2004h>         pass
[?2004l[?2004h>     
[?2004l[?2004h>     # Try MM/DD/YYYY
[?2004l[?2004h>     try:
[?2004l[?2004h>         dt = datetime.strptime(date_str, '%m/%d/%Y')
[?2004l[?2004h>         return dt.strftime('%Y-%m-%d')
[?2004l[?2004h>     except ValueError:
[?2004l[?2004h>         pass
[?2004l[?2004h>     
[?2004l[?2004h>     # Try DD.MM.YYYY
[?2004l[?2004h>     try:
[?2004l[?2004h>         dt = datetime.strptime(date_str, '%d.%m.%Y')
[?2004l[?2004h>         return dt.strftime('%Y-%m-%d')
[?2004l[?2004h>     except ValueError:
[?2004l[?2004h>         pass
[?2004l[?2004h>     
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> def parse_price(price_str):
[?2004l[?2004h>     """Parse price and convert to cents (positive integer)"""
[?2004l[?2004h>     try:
[?2004l[?2004h>         # Remove dollar signs, commas, and whitespace
[?2004l[?2004h>         price_str = price_str.strip().replace('$', '').replace(',', '')
[?2004l[?2004h>         price_float = float(price_str)
[?2004l[?2004h>         
[?2004l[?2004h>         # Convert to cents
[?2004l[?2004h>         price_cents = int(round(abs(price_float) * 100))
[?2004l[?2004h>         
[?2004l[?2004h>         # Must be positive
[?2004l[?2004h>         if price_cents <= 0:
[?2004l[?2004h>             return None
[?2004l[?2004h>         
[?2004l[?2004h>         return price_cents
[?2004l[?2004h>     except (ValueError, AttributeError):
[?2004l[?2004h>         return None
[?2004l[?2004h> 
[?2004l[?2004h> def process_row(row):
[?2004l[?2004h>     """Process a single row and return normalized data or error"""
[?2004l[?2004h>     try:
[?2004l[?2004h>         asset_id = row['id'].strip()
[?2004l[?2004h>         name = row['name'].strip()
[?2004l[?2004h>         serial = row['serial'].strip()
[?2004l[?2004h>         purchase_date_raw = row['purchase_date'].strip()
[?2004l[?2004h>         price_raw = row['price'].strip()
[?2004l[?2004h>         location = row['location'].strip()
[?2004l[?2004h>         
[?2004l[?2004h>         # Check if serial and name are swapped (serial should start with SN-)
[?2004l[?2004h>         if not serial.startswith('SN-') and name.startswith('SN-'):
[?2004l[?2004h>             name, serial = serial, name
[?2004l[?2004h>         
[?2004l[?2004h>         # Validate basic fields
[?2004l[?2004h>         if not asset_id or not name or not serial or not location:
[?2004l[?2004h>             return None, "Missing required fields"
[?2004l[?2004h>         
[?2004l[?2004h>         # Parse date
[?2004l[?2004h>         purchase_date = parse_date(purchase_date_raw)
[?2004l[?2004h>         if not purchase_date:
[?2004l[?2004h>             return None, f"Invalid date format: {purchase_date_raw}"
[?2004l[?2004h>         
[?2004l[?2004h>         # Parse price
[?2004l[?2004h>         price_cents = parse_price(price_raw)
[?2004l[?2004h>         if price_cents is None:
[?2004l[?2004h>             return None, f"Invalid price: {price_raw}"
[?2004l[?2004h>         
[?2004l[?2004h>         return {
[?2004l[?2004h>             'id': asset_id,
[?2004l[?2004h>             'name': name,
[?2004l[?2004h>             'serial': serial,
[?2004l[?2004h>             'purchase_date': purchase_date,
[?2004l[?2004h>             'price_cents': price_cents,
[?2004l[?2004h>             'location': location
[?2004l[?2004h>         }, None
[?2004l[?2004h>         
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         return None, f"Processing error: {str(e)}"
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     assets_by_id = defaultdict(list)
[?2004l[?2004h>     rejected = []
[?2004l[?2004h>     
[?2004l[?2004h>     # Read and process CSV
[?2004l[?2004h>     with open('/home/user/inventory/assets.csv', 'r') as f:
[?2004l[?2004h>         reader = csv.DictReader(f)
[?2004l[?2004h>         for idx, row in enumerate(reader, start=2):  # start=2 because of header
[?2004l[?2004h>             processed, error = process_row(row)
[?2004l[?2004h>             
[?2004l[?2004h>             if error:
[?2004l[?2004h>                 rejected.append({
[?2004l[?2004h>                     'original_row': dict(row),
[?2004l[?2004h>                     'reason': error,
[?2004l[?2004h>                     'line_number': idx
[?2004l[?2004h>                 })
[?2004l[?2004h>             else:
[?2004l[?2004h>                 assets_by_id[processed['id']].append(processed)
[?2004l[?2004h>     
[?2004l[?2004h>     # Deduplicate - keep the one with latest purchase_date
[?2004l[?2004h>     final_assets = []
[?2004l[?2004h>     for asset_id, asset_list in assets_by_id.items():
[?2004l[?2004h>         if len(asset_list) == 1:
[?2004l[?2004h>             final_assets.append(asset_list[0])
[?2004l[?2004h>         else:
[?2004l[?2004h>             # Sort by purchase_date and take the latest
[?2004l[?2004h>             latest = max(asset_list, key=lambda x: x['purchase_date'])
[?2004l[?2004h>             final_assets.append(latest)
[?2004l[?2004h>     
[?2004l[?2004h>     # Sort by ID for consistent output
[?2004l[?2004h>     final_assets.sort(key=lambda x: x['id'])
[?2004l[?2004h>     
[?2004l[?2004h>     # Write outputs
[?2004l[?2004h>     with open('/home/user/inventory/assets.json', 'w') as f:
[?2004l[?2004h>         json.dump(final_assets, f, indent=2)
[?2004l[?2004h>     
[?2004l[?2004h>     with open('/home/user/inventory/rejected.json', 'w') as f:
[?2004l[?2004h>         json.dump(rejected, f, indent=2)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"Processed {len(final_assets)} valid assets")
[?2004l[?2004h>     print(f"Rejected {len(rejected)} invalid rows")
[?2004l[?2004h>     print(f"Deduplicated {sum(len(v) for v in assets_by_id.values()) - len(final_assets)} duplicate entries")
[?2004l[?2004h> 
