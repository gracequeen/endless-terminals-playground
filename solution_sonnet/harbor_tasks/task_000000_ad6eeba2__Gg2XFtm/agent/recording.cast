[34.88571, "i", "cat > process_assets.py << 'EOF'\nimport csv\nimport json\nimport re\nfrom datetime import datetime\nfrom collections import defaultdict\n\ndef parse_date(date_str):\n    \"\"\"Parse date from multiple formats to ISO 8601\"\"\"\n    date_str = date_str.strip()\n    \n    # Try YYYY-MM-DD\n    try:\n        dt = datetime.strptime(date_str, '%Y-%m-%d')\n        return dt.strftime('%Y-%m-%d')\n    except ValueError:\n        pass\n    \n    # Try MM/DD/YYYY\n    try:\n        dt = datetime.strptime(date_str, '%m/%d/%Y')\n        return dt.strftime('%Y-%m-%d')\n    except ValueError:\n        pass\n    \n    # Try DD.MM.YYYY\n    try:\n        dt = datetime.strptime(date_str, '%d.%m.%Y')\n        return dt.strftime('%Y-%m-%d')\n    except ValueError:\n        pass\n    \n    return None\n\ndef parse_price(price_str):\n    \"\"\"Parse price and convert to cents (positive integer)\"\"\"\n    try:\n        # Remove dollar signs, commas, and whitespace\n        price_str = price_str.strip().replace('$', '').replace(',', '')\n        price_float = float(price_str)\n   "]
[34.885762, "i", "     \n        # Convert to cents\n        price_cents = int(round(abs(price_float) * 100))\n        \n        # Must be positive\n        if price_cents <= 0:\n            return None\n        \n        return price_cents\n    except (ValueError, AttributeError):\n        return None\n\ndef process_row(row):\n    \"\"\"Process a single row and return normalized data or error\"\"\"\n    try:\n        asset_id = row['id'].strip()\n        name = row['name'].strip()\n        serial = row['serial'].strip()\n        purchase_date_raw = row['purchase_date'].strip()\n        price_raw = row['price'].strip()\n        location = row['location'].strip()\n        \n        # Check if serial and name are swapped (serial should start with SN-)\n        if not serial.startswith('SN-') and name.startswith('SN-'):\n            name, serial = serial, name\n        \n        # Validate basic fields\n        if not asset_id or not name or not serial or not location:\n            return None, \"Missing required fields\"\n        \n        # Parse date\n        purch"]
[34.88589, "i", "ase_date = parse_date(purchase_date_raw)\n        if not purchase_date:\n            return None, f\"Invalid date format: {purchase_date_raw}\"\n        \n        # Parse price\n        price_cents = parse_price(price_raw)\n        if price_cents is None:\n            return None, f\"Invalid price: {price_raw}\"\n        \n        return {\n            'id': asset_id,\n            'name': name,\n            'serial': serial,\n            'purchase_date': purchase_date,\n            'price_cents': price_cents,\n            'location': location\n        }, None\n        \n    except Exception as e:\n        return None, f\"Processing error: {str(e)}\"\n\ndef main():\n    assets_by_id = defaultdict(list)\n    rejected = []\n    \n    # Read and process CSV\n    with open('/home/user/inventory/assets.csv', 'r') as f:\n        reader = csv.DictReader(f)\n        for idx, row in enumerate(reader, start=2):  # start=2 because of header\n            processed, error = process_row(row)\n            \n            if error:\n                rejected.append("]
[34.885943, "i", "{\n                    'original_row': dict(row),\n                    'reason': error,\n                    'line_number': idx\n                })\n            else:\n                assets_by_id[processed['id']].append(processed)\n    \n    # Deduplicate - keep the one with latest purchase_date\n    final_assets = []\n    for asset_id, asset_list in assets_by_id.items():\n        if len(asset_list) == 1:\n            final_assets.append(asset_list[0])\n        else:\n            # Sort by purchase_date and take the latest\n            latest = max(asset_list, key=lambda x: x['purchase_date'])\n            final_assets.append(latest)\n    \n    # Sort by ID for consistent output\n    final_assets.sort(key=lambda x: x['id'])\n    \n    # Write outputs\n    with open('/home/user/inventory/assets.json', 'w') as f:\n        json.dump(final_assets, f, indent=2)\n    \n    with open('/home/user/inventory/rejected.json', 'w') as f:\n        json.dump(rejected, f, indent=2)\n    \n    print(f\"Processed {len(final_assets)} valid assets\")\n    pr"]
[34.885974, "o", "cat > process_assets.py << 'EOF'\r\n\u001b[?2004l\r"]
[34.886019, "i", "int(f\"Rejected {len(rejected)} invalid rows\")\n    print(f\"Deduplicated {sum(len(v) for v in assets_by_id.values()) - len(final_assets)} duplicate entries\")\n\nif __name__ == '__main__':\n    main()\nEOF\n"]
