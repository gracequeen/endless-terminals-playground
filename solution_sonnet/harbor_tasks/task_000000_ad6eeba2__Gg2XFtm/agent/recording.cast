[34.894712, "o", "\u001b[?2004h> "]
[34.894797, "o", "        if not purchase_date:\r\n\u001b[?2004l\r"]
[34.894826, "o", "\u001b[?2004h> "]
[34.895033, "o", "            return None, f\"Invalid date format: {purchase_date_raw}\"\r\n\u001b[?2004l\r"]
[34.895065, "o", "\u001b[?2004h> "]
[34.895095, "o", "        \r\n\u001b[?2004l\r"]
[34.895123, "o", "\u001b[?2004h> "]
[34.895186, "o", "        # Parse price\r\n\u001b[?2004l\r"]
[34.895215, "o", "\u001b[?2004h> "]
[34.89534, "o", "        price_cents = parse_price(price_raw)\r\n\u001b[?2004l\r"]
[34.895368, "o", "\u001b[?2004h> "]
[34.895459, "o", "        if price_cents is None:\r\n\u001b[?2004l\r"]
[34.895487, "o", "\u001b[?2004h> "]
[34.895655, "o", "            return None, f\"Invalid price: {price_raw}\"\r\n\u001b[?2004l\r"]
[34.895684, "o", "\u001b[?2004h> "]
[34.895712, "o", "        \r\n\u001b[?2004l\r"]
[34.895742, "o", "\u001b[?2004h> "]
[34.895793, "o", "        return {\r\n\u001b[?2004l\r"]
[34.895821, "o", "\u001b[?2004h> "]
[34.895916, "o", "            'id': asset_id,\r\n\u001b[?2004l\r"]
[34.895946, "o", "\u001b[?2004h> "]
[34.896019, "o", "            'name': name,\r\n\u001b[?2004l\r"]
[34.896046, "o", "\u001b[?2004h> "]
[34.896132, "o", "            'serial': serial,\r\n\u001b[?2004l\r"]
[34.896161, "o", "\u001b[?2004h> "]
[34.896282, "o", "            'purchase_date': purchase_date,\r\n\u001b[?2004l\r"]
[34.89631, "o", "\u001b[?2004h> "]
[34.896423, "o", "            'price_cents': price_cents,\r\n\u001b[?2004l\r"]
[34.896459, "o", "\u001b[?2004h> "]
[34.896543, "o", "            'location': location\r\n\u001b[?2004l\r"]
[34.896571, "o", "\u001b[?2004h> "]
[34.89662, "o", "        }, None\r\n\u001b[?2004l\r"]
[34.896656, "o", "\u001b[?2004h> "]
[34.896687, "o", "        \r\n\u001b[?2004l\r"]
[34.896721, "o", "\u001b[?2004h> "]
[34.896779, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[34.896807, "o", "\u001b[?2004h> "]
[34.896967, "o", "        return None, f\"Processing error: {str(e)}\"\r\n\u001b[?2004l\r"]
[34.896998, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[34.897027, "o", "\u001b[?2004h"]
[34.897055, "o", "> "]
[34.897084, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.897119, "o", "> "]
[34.897202, "o", "    assets_by_id = defaultdict(list)\r\n\u001b[?2004l\r"]
[34.89723, "o", "\u001b[?2004h> "]
[34.897285, "o", "    rejected = []\r\n\u001b[?2004l\r"]
[34.897314, "o", "\u001b[?2004h> "]
[34.897349, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[34.897378, "o", "> "]
[34.897436, "o", "    # Read and process CSV\r\n\u001b[?2004l\r"]
[34.897464, "o", "\u001b[?2004h> "]
[34.89763, "o", "    with open('/home/user/inventory/assets.csv', 'r') as f:\r\n\u001b[?2004l\r"]
[34.897667, "o", "\u001b[?2004h> "]
[34.897756, "o", "        reader = csv.DictReader(f)\r\n\u001b[?2004l\r"]
[34.897784, "o", "\u001b[?2004h> "]
[34.898023, "o", "        for idx, row in enumerate(reader, start=2):  # start=2 because of header\r\n\u001b[?2004l\r"]
[34.898058, "o", "\u001b[?2004h> "]
[34.898183, "o", "            processed, error = process_row(row)\r\n\u001b[?2004l\r"]
[34.898212, "o", "\u001b[?2004h> "]
[34.898253, "o", "            \r\n\u001b[?2004l\r"]
[34.898287, "o", "\u001b[?2004h> "]
[34.898347, "o", "            if error:\r\n\u001b[?2004l\r"]
[34.898376, "o", "\u001b[?2004h> "]
[34.898467, "o", "                rejected.append({\r\n\u001b[?2004l\r"]
[34.898496, "o", "\u001b[?2004h> "]
[34.898626, "o", "                    'original_row': dict(row),\r\n\u001b[?2004l\r"]
[34.898657, "o", "\u001b[?2004h> "]
[34.89876, "o", "                    'reason': error,\r\n\u001b[?2004l\r"]
[34.898789, "o", "\u001b[?2004h> "]
[34.898914, "o", "                    'line_number': idx\r\n\u001b[?2004l\r"]
[34.898945, "o", "\u001b[?2004h> "]
[34.898998, "o", "                })\r\n\u001b[?2004l\r"]
[34.899024, "o", "\u001b[?2004h> "]
[34.899075, "o", "            else:\r\n\u001b[?2004l\r"]
[34.899103, "o", "\u001b[?2004h> "]
[34.89928, "o", "                assets_by_id[processed['id']].append(processed)\r\n\u001b[?2004l\r"]
[34.899308, "o", "\u001b[?2004h> "]
[34.899343, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[34.899378, "o", "> "]
[34.899518, "o", "    # Deduplicate - keep the one with latest purchase_date\r\n\u001b[?2004l\r"]
[34.899554, "o", "\u001b[?2004h> "]
[34.89961, "o", "    final_assets = []\r\n\u001b[?2004l\r"]
[34.89965, "o", "\u001b[?2004h> "]
[34.899795, "o", "    for asset_id, asset_list in assets_by_id.items():\r\n\u001b[?2004l\r"]
[34.899832, "o", "\u001b[?2004h> "]
[34.899936, "o", "        if len(asset_list) == 1:\r\n\u001b[?2004l\r"]
[34.899966, "o", "\u001b[?2004h> "]
[34.900096, "o", "            final_assets.append(asset_list[0])\r\n\u001b[?2004l\r"]
[34.900125, "o", "\u001b[?2004h> "]
[34.900168, "o", "        else:\r\n\u001b[?2004l\r"]
[34.900201, "o", "\u001b[?2004h> "]
[34.90035, "o", "            # Sort by purchase_date and take the latest\r\n\u001b[?2004l\r"]
[34.900379, "o", "\u001b[?2004h> "]
[34.900574, "o", "            latest = max(asset_list, key=lambda x: x['purchase_date'])\r\n\u001b[?2004l\r"]
[34.900612, "o", "\u001b[?2004h> "]
[34.900717, "o", "            final_assets.append(latest)\r\n\u001b[?2004l\r"]
[34.900744, "o", "\u001b[?2004h"]
[34.900771, "o", ">     \r\n\u001b[?2004l\r"]
[34.9008, "o", "\u001b[?2004h> "]
[34.900923, "o", "    # Sort by ID for consistent output\r\n\u001b[?2004l\r"]
[34.900966, "o", "\u001b[?2004h> "]
[34.901077, "o", "    final_assets.sort(key=lambda x: x['id'])\r\n\u001b[?2004l\r"]
[34.901101, "o", "\u001b[?2004h> "]
[34.90113, "o", "    \r\n\u001b[?2004l\r"]
[34.90115, "o", "\u001b[?2004h> "]
[34.901208, "o", "    # Write outputs\r\n\u001b[?2004l\r"]
[34.901235, "o", "\u001b[?2004h> "]
[34.901407, "o", "    with open('/home/user/inventory/assets.json', 'w') as f:\r\n\u001b[?2004l\r"]
[34.901438, "o", "\u001b[?2004h> "]
[34.901561, "o", "        json.dump(final_assets, f, indent=2)\r\n\u001b[?2004l\r"]
[34.901594, "o", "\u001b[?2004h> "]
[34.901625, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[34.901654, "o", "> "]
[34.90181, "o", "    with open('/home/user/inventory/rejected.json', 'w') as f:\r\n\u001b[?2004l\r"]
[34.901846, "o", "\u001b[?2004h> "]
[34.90197, "o", "        json.dump(rejected, f, indent=2)\r\n\u001b[?2004l\r"]
[34.901999, "o", "\u001b[?2004h"]
[34.902029, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[34.902062, "o", "> "]
[34.9022, "o", "    print(f\"Processed {len(final_assets)} valid assets\")\r\n\u001b[?2004l\r"]
[34.90223, "o", "\u001b[?2004h> "]
[34.902374, "o", "    print(f\"Rejected {len(rejected)} invalid rows\")\r\n\u001b[?2004l\r"]
[34.902397, "o", "\u001b[?2004h"]
[34.902422, "o", "> "]
[34.902712, "o", "    print(f\"Deduplicated {sum(len(v) for v in assets_by_id.values()) - len(final_assets)} duplicate entries\")\r\n\u001b[?2004l\r"]
[34.902734, "o", "\u001b[?2004h"]
[34.902769, "o", "> \r\n\u001b[?2004l\r"]
[34.902795, "o", "\u001b[?2004h> "]
[34.902856, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[34.902904, "o", "\u001b[?2004h> "]
[34.902935, "o", "    main()\r\n\u001b[?2004l\r"]
[34.902958, "o", "\u001b[?2004h"]
[34.902987, "o", "> EOF\r\n\u001b[?2004l\r"]
