[28.045379, "i", "for host in /home/user/memstats/host*.txt; do\n  hostname=$(basename \"$host\" .txt)\n  memtotal=$(grep -E '^MemTotal:' \"$host\" 2>/dev/null | awk '{print $2}')\n  memavail=$(grep -E '^MemAvailable:' \"$host\" 2>/dev/null | awk '{print $2}')\n  \n  if [[ -n \"$memtotal\" && -n \"$memavail\" && \"$memtotal\" -gt 0 ]]; then\n    percent=$(awk \"BEGIN {printf \\\"%.2f\\\", ($memavail / $memtotal) * 100}\")\n    percent_int=$(awk \"BEGIN {print int($percent)}\")\n    if [[ \"$percent_int\" -lt 20 ]]; then\n      echo -e \"${hostname}\\t${percent}\"\n    fi\n  fi\ndone | sort -t$'\\t' -k2 -n > /home/user/low_memory_report.txt\n"]
[28.045574, "o", "for host in /home/user/memstats/host*.txt; do\r\n\u001b[?2004l\r"]
