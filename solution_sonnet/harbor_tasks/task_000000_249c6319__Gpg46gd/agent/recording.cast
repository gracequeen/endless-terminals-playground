[109.373267, "i", "python3 << 'EOF'\nimport json\nimport csv\n\n# Load and sum JSON amounts\nwith open('input/transactions.json', 'r') as f:\n    transactions = json.load(f)\n    \njson_usd_total = 0\njson_eur_total = 0\n\nfor txn in transactions:\n    amount_str = txn['amount'].replace('$', '').replace('€', '').replace(',', '')\n    amount = float(amount_str)\n    if txn['currency'] == 'USD':\n        json_usd_total += amount\n    elif txn['currency'] == 'EUR':\n        json_eur_total += amount\n\n# Load and sum CSV amounts\nwith open('output/transactions.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    csv_usd_total = 0\n    csv_eur_total = 0\n    \n    for row in reader:\n        amount = float(row['amount'])\n        if row['currency'] == 'USD':\n            csv_usd_total += amount\n        elif row['currency'] == 'EUR':\n            csv_eur_total += amount\n\nprint(f\"JSON Input:\")\nprint(f\"  USD Total: ${json_usd_total:,.2f}\")\nprint(f\"  EUR Total: €{json_eur_total:,.2f}\")\nprint(f\"  Grand Total (USD): ${json_usd_total:,.2f}\")\nprint(f\"\\nCSV Output:"]
[109.373416, "i", "\")\nprint(f\"  USD Total: ${csv_usd_total:,.2f}\")\nprint(f\"  EUR Total: €{csv_eur_total:,.2f}\")\nprint(f\"  Grand Total (USD): ${csv_usd_total:,.2f}\")\nprint(f\"\\nMatch: {json_usd_total == csv_usd_total and json_eur_total == csv_eur_total}\")\nEOF\n"]
