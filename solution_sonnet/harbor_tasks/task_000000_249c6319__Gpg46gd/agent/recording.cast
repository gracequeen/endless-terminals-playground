[54.863364, "i", "cat > lib/parsers.py << 'EOF'\n\"\"\"\nHelper functions for parsing transaction data.\n\"\"\"\nimport re\n\n\ndef parse_amount(s):\n    \"\"\"\n    Parse an amount string like \"$1,234.56\" or \"€1,234.56\" and return a float.\n    Strips currency symbols and thousand separators.\n    \"\"\"\n    # Remove dollar sign, euro sign, and commas\n    cleaned = re.sub(r'[\\$€,]', '', s)\n    return float(cleaned)\nEOF\n"]
[54.863506, "o", "cat > lib/parsers.py << 'EOF'\r\n"]
