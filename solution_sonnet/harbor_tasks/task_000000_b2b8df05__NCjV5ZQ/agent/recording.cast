[9.421948, "o", "cat clean.sql\r\n\u001b[?2004l\r"]
[9.422836, "o", "DROP TABLE IF EXISTS responses_clean;\r\nCREATE TABLE responses_clean AS\r\nSELECT r.*\r\nFROM responses r\r\nRUN sed -i \"s|archive.ubuntu.com|us-west-1.ec2.archive.ubuntu.com|g; s|security.ubuntu.com|us-west-1.ec2.archive.ubuntu.com|g\" /etc/apt/sources.list 2>/dev/null || true\r\nINNER JOIN (\r\n    SELECT email, MIN(submitted_at) as first_sub\r\n    FROM responses\r\n    GROUP BY email\r\n) earliest ON r.email = earliest.email AND r.submitted_at = earliest.first_sub;\r\n"]
[9.422966, "o", "\u001b[?2004h"]
[9.423009, "o", "root@d49bac7ca9df:/home/user/data# "]
[17.392854, "i", "sqlite3 survey.db \"SELECT COUNT(*) as total_rows, COUNT(DISTINCT email) as unique_emails FROM responses;\"\n"]
[17.393203, "o", "sqlite3 survey.db \"SELECT COUNT(*) as total_rows, COUNT(DISTINCT email) as unique_emails FROM responses;\"\r\n\u001b[?2004l\r"]
