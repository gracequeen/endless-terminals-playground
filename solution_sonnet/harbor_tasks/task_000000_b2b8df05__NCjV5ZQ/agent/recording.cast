[55.308462, "o", ") earliest ON r.email = earliest.email AND r.submitted_at = earliest.first_sub;\r\n\u001b[?2004l\r"]
[55.308499, "o", "\u001b[?2004h> "]
[55.308535, "o", "EOF\r\n\u001b[?2004l\r"]
