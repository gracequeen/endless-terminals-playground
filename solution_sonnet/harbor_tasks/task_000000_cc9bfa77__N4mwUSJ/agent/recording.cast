[130.925844, "o", "\u001b[?2004huser@9365762ea513:~/wal_recovery$ "]
[131.029306, "i", "python3 << 'XOREOF'\ndata = open('primary_wal/000000010000000000000003', 'rb').read(24)\nprint(f\"First 24 bytes: {data.hex()}\")\n# WAL page header magic is typically D097 or D093 (little-endian)\n# Let's see if XORing first 2 bytes gives us the magic\nfor magic in [0xD097, 0xD093, 0xD07E, 0xD081]:\n    key1 = data[0] ^ (magic & 0xFF)\n    key2 = data[1] ^ ((magic >> 8) & 0xFF)\n    if key1 == key2:\n        print(f\"Possible XOR key: 0x{key1:02x} for magic 0x{magic:04x}\")\n        xored = bytes([b ^ key1 for b in data[:24]])\n        print(f\"XORed result: {xored.hex()}\")\nXOREOF\n"]
[131.029411, "o", "python3 << 'XOREOF'\r\n"]
