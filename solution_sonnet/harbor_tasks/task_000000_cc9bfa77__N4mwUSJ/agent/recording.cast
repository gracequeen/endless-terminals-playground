[167.951014, "i", "python3 << 'EOF'\n# Let's try a 16-byte repeating XOR key\n# Key pattern from multiple offsets: d3 a2 ?? ?? 2b ?? ?? ?? ?? ?? ?? ef\n\ndata = open('primary_wal/000000010000000000000003', 'rb').read()\n\n# Try the key: d3a2????2b??????ef (let's guess the missing bytes)\n# Common pattern might be d3a2d3a22bd3d3ef or similar\n\n# Let's look at more known values to derive full key\n# Check second page (offset 8192) which should have pageaddr 0x3002000\npage2 = data[8192:8192+16]\nprint(f\"Page 2 (offset 8192) first 16 bytes: {page2.hex()}\")\nprint(f\"Expected pageaddr for page 2: {(0x3000000 + 8192).to_bytes(8, 'little').hex()}\")\n\n# Page address at offset 8 in each page\npage2_addr = page2[8:16]\nexpected_addr = (0x3000000 + 8192).to_bytes(8, 'little')\nprint(f\"\\nPage 2 address bytes: {page2_addr.hex()}\")\nprint(f\"Expected: {expected_addr.hex()}\")\nxor_derived = bytes([a ^ e for a, e in zip(page2_addr, expected_addr)])\nprint(f\"XOR key from page 2: {xor_derived.hex()}\")\nEOF\n"]
