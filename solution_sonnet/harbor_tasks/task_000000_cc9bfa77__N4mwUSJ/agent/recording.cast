[269.077378, "i", "python3 << 'EOF'\nimport struct\n\n# Check what we got after decryption\ndata = open('decrypted_wal/000000010000000000000003', 'rb').read(32)\nprint(f\"Decrypted segment 3, first 32 bytes: {data.hex()}\")\nprint()\n\n# Parse the header\nmagic = struct.unpack('<H', data[0:2])[0]\ninfo = struct.unpack('<H', data[2:4])[0]\ntli = struct.unpack('<I', data[4:8])[0]\npageaddr = struct.unpack('<Q', data[8:16])[0]\nsysid = struct.unpack('<Q', data[16:24])[0]\nsegsize = struct.unpack('<I', data[24:28])[0]\nblksize = struct.unpack('<I', data[28:32])[0]\n\nprint(f\"Magic: 0x{magic:04x} (expected 0xd097)\")\nprint(f\"Info: 0x{info:04x}\")\nprint(f\"Timeline: {tli} (expected 1)\")\nprint(f\"Page addr: 0x{pageaddr:016x} (expected 0x3000000)\")\nprint(f\"System ID: {sysid} (expected {7636305587799150611})\")\nprint(f\"Seg size: {segsize} (expected 16777216)\")\nprint(f\"Blk size: {blksize} (expected 8192)\")\nEOF\n"]
