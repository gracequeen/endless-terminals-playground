[235.372624, "i", "python3 << 'EOF'\nimport os\n\nxor_key = bytes.fromhex('8aaff67f29a1e9a413a2c8b2dd45d92d')\n\nprint(f\"XOR key: {xor_key.hex()}\")\nprint(f\"Key length: {len(xor_key)} bytes\")\n\n# Create decrypted directory\nos.makedirs('decrypted_wal', exist_ok=True)\n\n# Decrypt all primary WAL segments\nfor seg_file in ['000000010000000000000003', '000000010000000000000004', \n                 '000000010000000000000005', '000000010000000000000006']:\n    input_path = f'primary_wal/{seg_file}'\n    output_path = f'decrypted_wal/{seg_file}'\n    \n    if os.path.exists(input_path):\n        with open(input_path, 'rb') as f:\n            data = f.read()\n        \n        decrypted = bytearray()\n        for i, byte in enumerate(data):\n            decrypted.append(byte ^ xor_key[i % len(xor_key)])\n        \n        with open(output_path, 'wb') as f:\n            f.write(decrypted)\n        \n        print(f\"Decrypted {seg_file}: {len(data)} bytes -> {output_path}\")\n\nprint(\"\\nDecryption complete!\")\nEOF\n"]
