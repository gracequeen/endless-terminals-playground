[300.60797, "i", "python3 << 'EOF'\nimport struct\n\n# Read more data to understand the pattern\ndata_enc = open('primary_wal/000000010000000000000003', 'rb').read(64)\n\n# Build expected values for bytes 0-32\nexpected = bytearray(32)\nexpected[0:2] = struct.pack('<H', 0xd097)  # magic\nexpected[4:8] = struct.pack('<I', 1)  # timeline  \nexpected[8:16] = struct.pack('<Q', 0x3000000)  # pageaddr\nexpected[16:24] = struct.pack('<Q', 7636305587799150611)  # sysid\nexpected[24:28] = struct.pack('<I', 16777216)  # segsize\nexpected[28:32] = struct.pack('<I', 8192)  # blksize\n\nprint(\"Expected header (0-32):\")\nprint(expected.hex())\nprint(\"\\nActual encrypted (0-32):\")\nprint(data_enc[:32].hex())\n\n# Derive 32-byte XOR key\nxor_key_32 = bytearray(32)\nfor i in range(32):\n    if i not in [2, 3]:  # skip unknown info field\n        xor_key_32[i] = data_enc[i] ^ expected[i]\n\nprint(\"\\nDerived 32-byte XOR key:\")\nprint(xor_key_32.hex())\n\n# Check if it repeats at 32 bytes\nprint(\"\\nChecking next 32 bytes (32-64):\")\nfor i in range(32, 64):\n    decrypted_byte = "]
[300.6081, "i", "data_enc[i] ^ xor_key_32[i % 32]\n    print(f\"{i:2d}: {data_enc[i]:02x} ^ {xor_key_32[i%32]:02x} = {decrypted_byte:02x}\", end=\"\")\n    if (i - 31) % 8 == 0:\n        print()\n    else:\n        print(\" \", end=\"\")\nEOF\n"]
