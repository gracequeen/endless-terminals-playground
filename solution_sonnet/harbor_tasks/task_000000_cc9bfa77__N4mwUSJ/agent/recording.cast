[143.307448, "i", "python3 << 'EOF'\nimport struct\n\ndata = open('primary_wal/000000010000000000000003', 'rb').read(48)\nprint(f\"First 48 bytes hex: {data.hex()}\")\n\n# PostgreSQL WAL long page header structure:\n# uint16 xlp_magic (0xD097 for PG 13+)\n# uint16 xlp_info\n# uint32 xlp_tli (timeline ID = 1)\n# uint64 xlp_pageaddr (should be 0x3000000 for segment 3)\n\n# Try to find XOR key from known pageaddr\nexpected_pageaddr = 0x0000000003000000  # LSN 0/3000000 in big-endian format\nactual_bytes = data[8:16]\nprint(f\"Bytes at offset 8-16: {actual_bytes.hex()}\")\n\n# Try different byte orders\nfor bo in ['little', 'big']:\n    expected = expected_pageaddr.to_bytes(8, bo)\n    print(f\"Expected pageaddr ({bo}-endian): {expected.hex()}\")\n    xor_key = bytes([a ^ e for a, e in zip(actual_bytes, expected)])\n    print(f\"Derived XOR key: {xor_key.hex()}\")\n    if len(set(xor_key)) == 1:\n        print(f\"  -> Constant key found: 0x{xor_key[0]:02x}\")\n        break\nEOF\n"]
