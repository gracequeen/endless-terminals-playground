[223.481883, "i", "python3 << 'EOF'\nimport struct\n\nsys_id_expected = 7636305587799150611\nseg_size_expected = 16777216\nblk_size_expected = 8192\n\nprint(\"Expected values:\")\nprint(f\"  System ID: {sys_id_expected} (0x{sys_id_expected:016x})\")\nprint(f\"  Seg size: {seg_size_expected} (0x{seg_size_expected:08x})\")\nprint(f\"  Block size: {blk_size_expected} (0x{blk_size_expected:08x})\")\nprint()\n\ndata = open('primary_wal/000000010000000000000003', 'rb').read(32)\nprint(f\"Segment 3 bytes 16-32: {data[16:32].hex()}\")\n\n# Extract actual values\nactual_sysid_bytes = data[16:24]\nactual_segsize_bytes = data[24:28]\nactual_blksize_bytes = data[28:32]\n\nprint(f\"\\nActual bytes:\")\nprint(f\"  Sys ID (16-24): {actual_sysid_bytes.hex()}\")\nprint(f\"  Seg size (24-28): {actual_segsize_bytes.hex()}\")\nprint(f\"  Blk size (28-32): {actual_blksize_bytes.hex()}\")\n\n# Derive XOR key from these known values\nexpected_bytes = sys_id_expected.to_bytes(8, 'little') + seg_size_expected.to_bytes(4, 'little') + blk_size_expected.to_bytes(4, 'little')\nactual_bytes = data[16:32"]
[223.481925, "i", "]\n\nprint(f\"\\nExpected bytes (16-32): {expected_bytes.hex()}\")\nxor_key = bytes([a ^ e for a, e in zip(actual_bytes, expected_bytes)])\nprint(f\"XOR key (16 bytes): {xor_key.hex()}\")\n\n# Check if it's a repeating pattern\nprint(f\"\\nChecking for repeating pattern:\")\nfor key_len in [1, 2, 4, 8, 16]:\n    if key_len <= 16:\n        key_pattern = xor_key[:key_len]\n        matches = all(xor_key[i] == key_pattern[i % key_len] for i in range(16))\n        print(f\"  {key_len}-byte pattern: {key_pattern.hex()} - {'MATCH' if matches else 'no match'}\")\nEOF\n"]
