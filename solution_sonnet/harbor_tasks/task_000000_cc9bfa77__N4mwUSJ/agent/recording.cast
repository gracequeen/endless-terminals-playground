[300.609956, "o", "> "]
[300.610063, "o", "expected[28:32] = struct.pack('<I', 8192)  # blksize\r\n\u001b[?2004l\r"]
[300.610096, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[300.610132, "o", "\u001b[?2004h> "]
[300.610222, "o", "print(\"Expected header (0-32):\")\r\n\u001b[?2004l\r"]
[300.610256, "o", "\u001b[?2004h> "]
[300.610318, "o", "print(expected.hex())\r\n\u001b[?2004l\r"]
[300.610348, "o", "\u001b[?2004h> "]
[300.61045, "o", "print(\"\\nActual encrypted (0-32):\")\r\n\u001b[?2004l\r"]
[300.610489, "o", "\u001b[?2004h> "]
[300.610568, "o", "print(data_enc[:32].hex())\r\n\u001b[?2004l\r"]
[300.61061, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[300.610643, "o", "\u001b[?2004h> "]
[300.610734, "o", "# Derive 32-byte XOR key\r\n\u001b[?2004l\r"]
[300.610769, "o", "\u001b[?2004h> "]
[300.610842, "o", "xor_key_32 = bytearray(32)\r\n\u001b[?2004l\r"]
[300.610875, "o", "\u001b[?2004h"]
[300.61091, "o", "> "]
[300.610944, "o", "for i in range(32):\r\n\u001b[?2004l\r"]
[300.610978, "o", "\u001b[?2004h> "]
[300.611103, "o", "    if i not in [2, 3]:  # skip unknown info field\r\n\u001b[?2004l\r"]
[300.611136, "o", "\u001b[?2004h"]
[300.611164, "o", "> "]
[300.611273, "o", "        xor_key_32[i] = data_enc[i] ^ expected[i]\r\n\u001b[?2004l\r"]
[300.611311, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[300.611347, "o", "\u001b[?2004h> "]
[300.611438, "o", "print(\"\\nDerived 32-byte XOR key:\")\r\n\u001b[?2004l\r"]
[300.611471, "o", "\u001b[?2004h> "]
[300.611537, "o", "print(xor_key_32.hex())\r\n\u001b[?2004l\r"]
[300.61157, "o", "\u001b[?2004h"]
[300.611605, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[300.611707, "o", "# Check if it repeats at 32 bytes\r\n\u001b[?2004l\r"]
[300.61174, "o", "\u001b[?2004h> "]
[300.611861, "o", "print(\"\\nChecking next 32 bytes (32-64):\")\r\n\u001b[?2004l\r"]
[300.611895, "o", "\u001b[?2004h> "]
[300.611959, "o", "for i in range(32, 64):\r\n\u001b[?2004l\r"]
[300.612003, "o", "\u001b[?2004h> "]
[300.612139, "o", "    decrypted_byte = data_enc[i] ^ xor_key_32[i % 32]\r\n\u001b[?2004l\r"]
[300.612171, "o", "\u001b[?2004h> "]
[300.612432, "o", "    print(f\"{i:2d}: {data_enc[i]:02x} ^ {xor_key_32[i%32]:02x} = {decrypted_byte:02x}\", end=\"\")\r\n\u001b[?2004l\r"]
[300.612468, "o", "\u001b[?2004h"]
[300.612504, "o", "> "]
[300.612549, "o", "    if (i - 31) % 8 == 0:\r\n\u001b[?2004l\r"]
[300.612585, "o", "\u001b[?2004h> "]
[300.612628, "o", "        print()\r\n\u001b[?2004l\r"]
[300.61266, "o", "\u001b[?2004h> "]
[300.612692, "o", "    else:\r\n\u001b[?2004l\r"]
[300.612737, "o", "\u001b[?2004h> "]
[300.61281, "o", "        print(\" \", end=\"\")\r\n\u001b[?2004l\r"]
[300.612841, "o", "\u001b[?2004h"]
[300.612873, "o", "> EOF\r\n\u001b[?2004l\r"]
[300.624155, "o", "Expected header (0-32):\r\n97d0000001000000000000030000000013501925799bf9690000000100200000\r\n\r\nActual encrypted (0-32):\r\n"]
[300.624251, "o", "4472c3072a4699225666a1ec3b14765d99ffef5a503a10cd13a2c8b3dd65d92d\r\n\r\nDerived 32-byte XOR key:\r\nd3a200002b4699225666a1ef3b14765d8aaff67f29a1e9a413a2c8b2dd45d92d\r\n\r\nChecking next 32 bytes (32-64):\r\n32: b7 ^ d3 = 64 33: 3a ^ a2 = 98 34: 3c ^ 00 = 3c 35: 5c ^ 00 = 5c 36: a4 ^ 2b = 8f 37: 7d ^ 46 = 3b 38: b5 ^ 99 = 2c 39: 2f ^ 22 = 0d\r\n40: 7f ^ 56 = 29 41: 67 ^ 66 = 01 42: 22 ^ a1 = 83 43: d3 ^ ef = 3c 44: 3b ^ 3b = 00 45: 8d ^ 14 = 99 46: 3e ^ 76 = 48 47: de ^ 5d = 83\r\n"]
[300.624289, "o", "48: c4 ^ 8a = 4e 49: 36 ^ af = 99 50: 08 ^ f6 = fe 51: 6b ^ 7f = 14 52: 66 ^ 29 = 4f 53: 52 ^ a1 = f3 54: 96 ^ e9 = 7f 55: 47 ^ a4 = e3\r\n"]
[300.624319, "o", "56: 4d ^ 13 = 5e 57: 76 ^ a2 = d4 58: b0 ^ c8 = 78 59: 3a ^ b2 = 88 60: a8 ^ dd = 75 61: fa ^ 45 = bf 62: 29 ^ d9 = f0 63: 3b ^ 2d = 16\r\n"]
[300.626429, "o", "\u001b[?2004h"]
