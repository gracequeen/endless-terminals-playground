[179.569643, "i", "python3 << 'EOF'\n# System identifier from pg_control: 7636305587799150611\n# Let's see if this is used as XOR key\n\nsys_id = 7636305587799150611\ndata = open('primary_wal/000000010000000000000003', 'rb').read(64)\n\nprint(f\"System ID: {sys_id}\")\nprint(f\"System ID hex: {sys_id:016x}\")\nprint(f\"System ID bytes (LE): {sys_id.to_bytes(8, 'little').hex()}\")\nprint(f\"System ID bytes (BE): {sys_id.to_bytes(8, 'big').hex()}\")\n\n# Try XOR with system ID as repeating 8-byte key\nkey = sys_id.to_bytes(8, 'little')\nprint(f\"\\nXOR key (8 bytes): {key.hex()}\")\n\ndecrypted = bytearray()\nfor i in range(64):\n    decrypted.append(data[i] ^ key[i % 8])\n\nprint(f\"\\nFirst 64 bytes decrypted: {decrypted.hex()}\")\nprint(f\"\\nFirst 2 bytes (should be magic 97d0): {decrypted[0]:02x}{decrypted[1]:02x}\")\nprint(f\"Timeline at offset 4 (should be 01000000): {decrypted[4:8].hex()}\")\nprint(f\"Pageaddr at offset 8 (should be 0000000300000000): {decrypted[8:16].hex()}\")\nEOF\n"]
