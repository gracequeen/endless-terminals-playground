[207.309888, "i", "python3 << 'EOF'\nimport struct\n\n# WAL page header is:\n# 0-2: magic (uint16)\n# 2-4: info (uint16) \n# 4-8: tli (uint32)\n# 8-16: pageaddr (uint64)\n# 16-20: xlp_rem_len (uint32)\n\n# But for LONG header (first page of segment):\n# After standard header, there's XLogLongPageHeaderData:\n# uint64 xlp_sysid\n# uint32 xlp_seg_size  <- This is what pg_waldump is reading!\n# uint32 xlp_xlog_blcksz\n\n# So xlp_seg_size should be at offset 24 (16 + 8)\n\nfor seg_name in ['000000010000000000000003', '000000010000000000000004', '000000010000000000000005', '000000010000000000000006']:\n    try:\n        data = open(f'primary_wal/{seg_name}', 'rb').read(32)\n        seg_size_bytes = data[24:28]\n        seg_size = struct.unpack('<I', seg_size_bytes)[0]\n        print(f\"{seg_name}: seg_size at offset 24 = {seg_size} (0x{seg_size:08x}) [{seg_size_bytes.hex()}]\")\n    except:\n        print(f\"{seg_name}: not found\")\n        \nprint(f\"\\nExpected seg_size: 16777216 (0x{16777216:08x})\")\nprint(f\"Expected bytes (LE): {struct.pack('<I', 16777216).hex("]
[207.310027, "i", ")}\")\nEOF\n"]
