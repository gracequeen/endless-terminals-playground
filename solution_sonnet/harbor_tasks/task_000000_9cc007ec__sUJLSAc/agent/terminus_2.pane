[?2004l#!/bin/bash
cd /home/user/builds

find . -name "*.dSYM" -type d -mtime +7 | while read -r dsym; do
    ipa="${dsym%.dSYM}.ipa"
    if [ ! -e "$ipa" ]; then
        echo "Deleting: $dsym (no matching .ipa found)"
        rm -rf "$dsym"
    else
        echo "Keeping: $dsym (matching .ipa exists)"
    fi
done
