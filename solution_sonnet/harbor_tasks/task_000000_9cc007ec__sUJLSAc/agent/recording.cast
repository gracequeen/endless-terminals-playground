[8.241653, "o", "#!/bin/bash\r\ncd /home/user/builds\r\n\r\nfind . -name \"*.dSYM\" -type d -mtime +7 | while read dsym; do\r\n    ipa=\"${dsym%.dSYM}.ipa\"\r\n    if [ ! -e \"$ipa\" ]; then\r\n        echo \"$dsym\"\r\n    fi\r\ndone | xargs rm -rf\r\n"]
