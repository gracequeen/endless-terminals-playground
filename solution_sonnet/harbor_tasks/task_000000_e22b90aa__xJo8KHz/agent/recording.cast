[89.932954, "i", "python3 << 'EOF'\nimport pandas as pd\ndf = pd.read_parquet('output/merged.parquet')\nprint(f'Total rows: {len(df)}')\nnat_count = df['recorded_at'].isna().sum()\nprint(f'NaT values in recorded_at: {nat_count}')\nif nat_count == 0:\n    print('\\n✓ SUCCESS: No NaT values found!')\n    print('\\nSample of sensor_c data (previously had NaT):')\n    print(df[df['sensor_id'].str.startswith('sensor_c')].head(10))\nelse:\n    print(f'\\n✗ FAILED: Still have {nat_count} NaT values')\n    print(df[df['recorded_at'].isna()].head())\nEOF\n"]
