[29.141882, "i", "for file in /home/user/memstats/host*.txt; do\n  hostname=$(basename \"$file\" .txt)\n  memtotal=$(grep '^MemTotal:' \"$file\" 2>/dev/null | awk '{print $2}')\n  memavail=$(grep '^MemAvailable:' \"$file\" 2>/dev/null | awk '{print $2}')\n  if [[ -n \"$memtotal\" && -n \"$memavail\" && \"$memtotal\" -gt 0 ]]; then\n    percent=$(awk \"BEGIN {printf \\\"%.2f\\\", ($memavail/$memtotal)*100}\")\n    echo \"$hostname $percent\"\n  fi\ndone | awk '$2 < 20 {print $1 \"\\t\" $2}' | sort -t$'\\t' -k2 -n > /home/user/low_memory_report.txt\n"]
