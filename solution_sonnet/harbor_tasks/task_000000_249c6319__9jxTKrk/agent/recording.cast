[84.995419, "o", "\u001b[?2004l\r"]
[84.99621, "o", "\"\"\"Helper functions for parsing transaction data.\r\n\"\"\"\r\nimport re\r\n\r\n\r\ndef parse_amount(s):\r\n    \"\"\"\r\n    Parse an amount string like \"$1,234.56\" or \"€1,234.56\" and return a float.\r\n    Strips currency symbols and thousand separators.\r\n    \"\"\"\r\n    # Remove dollar sign, euro sign (both regular and unicode), and commas\r\n    cleaned = re.sub(r'[\\$,€]', '', s)\r\n    return float(cleaned)\r\n"]
[84.996358, "o", "\u001b[?2004h"]
[84.996394, "o", "root@5a3313ad7080:/home/user/etl# "]
