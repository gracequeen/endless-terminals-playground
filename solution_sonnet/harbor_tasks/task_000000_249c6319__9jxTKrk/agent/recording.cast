[17.918142, "o", "\"\"\"\r\nHelper functions for parsing transaction data.\r\n\"\"\"\r\nimport re\r\n\r\n\r\ndef parse_amount(s):\r\n    \"\"\"\r\n    Parse an amount string like \"$1,234.56\" and return a float.\r\n    Strips currency symbols and thousand separators.\r\n    \"\"\"\r\n    # Remove dollar sign and commas\r\n    cleaned = re.sub(r'[\\$,]', '', s)\r\n    return float(cleaned)\r\n"]
[17.918315, "o", "\u001b[?2004h"]
