[76.452368, "i", "python3 << 'EOF'\nimport json\nimport csv\n\n# Calculate total from JSON\nwith open('input/transactions.json', 'r') as f:\n    transactions = json.load(f)\n    json_total = 0\n    for txn in transactions:\n        amount_str = txn['amount'].replace('$', '').replace('€', '').replace(',', '')\n        json_total += float(amount_str)\n\nprint(f\"Total from JSON: ${json_total:,.2f}\")\n\n# Calculate total from CSV\nwith open('output/transactions.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    csv_total = sum(float(row['amount']) for row in reader)\n\nprint(f\"Total from CSV:  ${csv_total:,.2f}\")\nprint(f\"Difference:      ${abs(json_total - csv_total):,.2f}\")\nprint(f\"Match: {abs(json_total - csv_total) < 0.01}\")\nEOF\n"]
