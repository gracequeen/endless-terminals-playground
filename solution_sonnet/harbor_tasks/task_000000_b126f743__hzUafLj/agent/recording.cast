[116.171315, "i", "cat > scripts/restore.sh << 'EOF'\n#!/bin/bash\nset -e\nCHUNKS_DIR=\"$1\"\nOUTPUT_DIR=\"$2\"\nmkdir -p \"$OUTPUT_DIR\"\nfind \"$CHUNKS_DIR\" -name 'chunk_*' -type f | sort | xargs cat | gunzip | tar xf - -C \"$OUTPUT_DIR\"\nEOF\n"]
