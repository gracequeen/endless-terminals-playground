[50.442802, "o", "> "]
[50.442879, "o", "            errors_found += 1\r\n"]
[50.442909, "o", "\u001b[?2004l\r\u001b[?2004h"]
[50.442934, "o", "> \r\n\u001b[?2004l\r"]
[50.442963, "o", "\u001b[?2004h> "]
[50.44304, "o", "    end_time = time.time()\r\n\u001b[?2004l\r"]
[50.443074, "o", "\u001b[?2004h"]
[50.443097, "o", "> "]
