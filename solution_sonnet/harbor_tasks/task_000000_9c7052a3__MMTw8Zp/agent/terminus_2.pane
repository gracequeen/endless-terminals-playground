[?2004l# Makefile for building markdown docs to HTML

# Source and build directories
SRC_DIR = src
BUILD_DIR = build

# Find all markdown files in src/
MD_FILES = $(wildcard $(SRC_DIR)/*.md)

# Convert src/%.md to build/%.html
HTML_FILES = $(patsubst $(SRC_DIR)/%.md,$(BUILD_DIR)/%.html,$(MD_FILES))

# Default target
.PHONY: html
html: $(HTML_FILES)

# Rule to convert .md to .html
$(BUILD_DIR)/%.html: $(SRC_DIR)/%.md
@mkdir -p $(BUILD_DIR)
pandoc $< -o $@

