[25.051166, "i", "cat > Makefile << 'EOF'\n# Makefile for building markdown docs to HTML\n\n# Source and build directories\nSRC_DIR = src\nBUILD_DIR = build\n\n# Find all markdown files in src/\nMD_FILES = $(wildcard $(SRC_DIR)/*.md)\n\n# Convert src/%.md to build/%.html\nHTML_FILES = $(patsubst $(SRC_DIR)/%.md,$(BUILD_DIR)/%.html,$(MD_FILES))\n\n# Default target\n.PHONY: html\nhtml: $(HTML_FILES)\n\n# Rule to convert .md to .html\n$(BUILD_DIR)/%.html: $(SRC_DIR)/%.md\n\t@mkdir -p $(BUILD_DIR)\n\tpandoc $< -o $@\n\nEOF\n"]
