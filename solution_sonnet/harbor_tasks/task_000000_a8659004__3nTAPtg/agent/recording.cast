[9.635122, "o", "#!/bin/bash\r\nLOG_DIR=\"/var/log/nginx\"\r\nOUTPUT=\"/var/log/reports/top_paths.txt\"\r\nYESTERDAY=$(date -d \"yesterday\" +%Y%m%d)\r\n\r\ncat $LOG_DIR/access.$YESTERDAY.log | \\\r\n    awk '{print $7}' | \\\r\n    sort | \\\r\n    uniq -c | \\\r\n    sort -rn | \\\r\n    head -10 > $OUTPUT\r\n"]
