[184.447918, "i", "python3 << 'EOF'\nimport sqlite3\nconn = sqlite3.connect('output/summary.db')\nresult = conn.execute('SELECT SUM(count) FROM summary').fetchone()\nprint(f\"\\n=== FINAL RESULTS ===\")\nprint(f\"Total records in DB: {result[0]}\")\nprint(f\"Expected: 50000\")\nprint(f\"Status: {'SUCCESS - Resume working correctly!' if result[0] == 50000 else 'FAILED - Data mismatch'}\")\nprint(f\"\\nCheckpoint: {open('.checkpoint').read()}\")\nprint(\"\\nCategory breakdown:\")\nfor row in conn.execute('SELECT category, count FROM summary ORDER BY category'):\n    print(f\"  {row[0]}: {row[1]} records\")\nconn.close()\nEOF\n"]
