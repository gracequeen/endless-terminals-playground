[25.944252, "o", "# Scheduler crontab - runs at the top of every hour\r\n0 * * * * cd /home/user/scheduler && python3 app.py >> /home/user/scheduler/output.log 2>&1\r\n"]
[25.944421, "o", "\u001b[?2004huser@dacdc6047aaa:~/scheduler$ "]
[26.04259, "i", "cat meetings.json\n"]
[26.042727, "o", "cat meetings.json\r\n\u001b[?2004l\r"]
[26.043612, "o", "[\r\n    {\r\n        \"title\": \"Daily Standup\",\r\n        \"utc_time\": \"2024-03-31T08:00:00\"\r\n    },\r\n    {\r\n        \"title\": \"Maintenance Window Prep\",\r\n        \"utc_time\": \"2024-03-31T01:30:00\"\r\n    },\r\n    {\r\n        \"title\": \"Weekly Review\",\r\n        \"utc_time\": \"2024-04-01T14:00:00\"\r\n    },\r\n    {\r\n        \"title\": \"Client Call\",\r\n        \"utc_time\": \"2024-03-30T15:30:00\"\r\n    },\r\n    {\r\n        \"title\": \"Team Lunch\",\r\n        \"utc_time\": \"2024-03-29T11:00:00\"\r\n    }\r\n]\r\n"]
[26.043774, "o", "\u001b[?2004h"]
