[61.619331, "i", "cat > verify_fix.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nVerify the timezone conversion fix.\nCompares old buggy method vs new correct method.\n\"\"\"\n\nimport pytz\nfrom datetime import datetime\n\nBERLIN_TZ = pytz.timezone('Europe/Berlin')\nUTC_TZ = pytz.utc\n\ndef old_buggy_convert(utc_time_str):\n    \"\"\"Old buggy conversion - treats UTC time as Berlin time.\"\"\"\n    utc_dt = datetime.strptime(utc_time_str, '%Y-%m-%dT%H:%M:%S')\n    berlin_dt = BERLIN_TZ.localize(utc_dt)\n    return berlin_dt\n\ndef new_correct_convert(utc_time_str):\n    \"\"\"New correct conversion - properly converts UTC to Berlin.\"\"\"\n    utc_dt = datetime.strptime(utc_time_str, '%Y-%m-%dT%H:%M:%S')\n    utc_dt_aware = UTC_TZ.localize(utc_dt)\n    berlin_dt = utc_dt_aware.astimezone(BERLIN_TZ)\n    return berlin_dt\n\nprint(\"Testing timezone conversion fix\")\nprint(\"=\" * 60)\n\n# Test cases including DST transition times\ntest_cases = [\n    ('2024-03-31T01:30:00', 'Maintenance Window (DST transition day)'),\n    ('2024-03-31T08:00:00', 'Daily Standup (DST transition day"]
[61.619485, "i", ")'),\n    ('2024-01-15T01:30:00', 'Winter time (CET, UTC+1)'),\n    ('2024-07-15T01:30:00', 'Summer time (CEST, UTC+2)'),\n]\n\nfor utc_time, description in test_cases:\n    print(f\"\\nTest: {description}\")\n    print(f\"UTC Time: {utc_time}\")\n    \n    old_result = old_buggy_convert(utc_time)\n    new_result = new_correct_convert(utc_time)\n    \n    print(f\"  OLD (buggy):  {old_result.strftime('%Y-%m-%d %H:%M:%S %Z%z')}\")\n    print(f\"  NEW (fixed):  {new_result.strftime('%Y-%m-%d %H:%M:%S %Z%z')}\")\n    \n    if old_result != new_result:\n        diff_hours = (new_result - old_result).total_seconds() / 3600\n        print(f\"  DIFFERENCE: {diff_hours:+.1f} hours\")\n    else:\n        print(f\"  SAME (no difference)\")\n\nprint(\"\\n\" + \"=\" * 60)\nprint(\"Fix verified: UTC times are now correctly converted to Berlin timezone.\")\nEOF\n"]
