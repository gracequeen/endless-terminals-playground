[69.793321, "i", "cat > /home/user/scripts/cleanup.sh << 'EOF'\n#!/bin/bash\n# Fixed: Handle filenames with spaces using null-terminated strings (-print0)\n# Fixed: Process deletions in loop instead of piping to xargs (preserves logic)\n# Fixed: Proper variable quoting throughout\n\ncd /home/user/builds\n\nfind . -name \"*.dSYM\" -type d -mtime +7 -print0 | while IFS= read -r -d '' dsym; do\n    ipa=\"${dsym%.dSYM}.ipa\"\n    if [ ! -e \"$ipa\" ]; then\n        echo \"Deleting: $dsym (no matching .ipa found)\"\n        rm -rf \"$dsym\"\n    else\n        echo \"Keeping: $dsym (matching .ipa exists)\"\n    fi\ndone\nEOF\n"]
