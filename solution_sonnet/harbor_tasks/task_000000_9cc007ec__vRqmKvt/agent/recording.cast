[39.212475, "i", "cat > /home/user/scripts/cleanup.sh << 'EOF'\n#!/bin/bash\ncd /home/user/builds\n\n# Use null-terminated strings to handle filenames with spaces\nfind . -name \"*.dSYM\" -type d -mtime +7 -print0 | while IFS= read -r -d '' dsym; do\n    ipa=\"${dsym%.dSYM}.ipa\"\n    if [ ! -e \"$ipa\" ]; then\n        echo \"Deleting: $dsym (no matching .ipa found)\"\n        rm -rf \"$dsym\"\n    else\n        echo \"Keeping: $dsym (matching .ipa exists)\"\n    fi\ndone\nEOF\n"]
