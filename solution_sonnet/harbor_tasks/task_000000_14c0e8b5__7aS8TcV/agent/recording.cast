[91.441622, "i", "cat > check.py << 'EOF'\n#!/usr/bin/env python3\nimport json\nimport csv\nimport ipaddress\nimport sys\n\ndef parse_port_spec(port_spec):\n    \"\"\"Parse a port specification (single port or range) into a set of allowed ports.\"\"\"\n    port_spec = str(port_spec).strip()\n    if '-' in port_spec:\n        start, end = port_spec.split('-')\n        return (int(start), int(end))\n    else:\n        port = int(port_spec)\n        return (port, port)\n\ndef port_in_range(port, port_range):\n    \"\"\"Check if a port is within a port range tuple.\"\"\"\n    start, end = port_range\n    return start <= port <= end\n\ndef load_firewall_rules(json_path):\n    \"\"\"Load and parse firewall rules, sorted by CIDR specificity (most specific first).\"\"\"\n    with open(json_path, 'r') as f:\n        data = json.load(f)\n    \n    rules = []\n    for rule in data['rules']:\n        network = ipaddress.ip_network(rule['source_cidr'])\n        port_range = parse_port_spec(rule['dest_port'])\n        rules.append({\n            'network': network,\n            'port_range'"]
[91.441752, "i", ": port_range,\n            'action': rule['action'],\n            'source_cidr': rule['source_cidr'],\n            'dest_port': rule['dest_port']\n        })\n    \n    # Sort by prefix length (descending) - more specific rules first\n    rules.sort(key=lambda r: r['network'].prefixlen, reverse=True)\n    \n    return rules, data.get('default_action', 'deny')\n\ndef check_connection(src_ip, dest_port, rules, default_action):\n    \"\"\"Check if a connection is allowed by firewall rules.\n    Returns (allowed, matching_rule) tuple.\n    \"\"\"\n    ip_obj = ipaddress.ip_address(src_ip)\n    \n    # Check rules in order (most specific first)\n    for rule in rules:\n        if ip_obj in rule['network']:\n            # IP matches this CIDR, check port\n            if port_in_range(dest_port, rule['port_range']):\n                # This rule applies\n                return (rule['action'] == 'allow', rule)\n    \n    # No matching rule, use default action\n    return (default_action == 'allow', None)\n\ndef main():\n    rules, default_action = loa"]
[91.441787, "o", "cat > check.py << 'EOF'\r\n\u001b[?2004l\r"]
[91.44188, "i", "d_firewall_rules('/home/user/audit/firewall_rules.json')\n    \n    with open('/home/user/audit/connections.csv', 'r') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            src_ip = row['src_ip']\n            dest_port = int(row['dest_port'])\n            \n            allowed, matching_rule = check_connection(src_ip, dest_port, rules, default_action)\n            \n            if not allowed:\n                if matching_rule:\n                    print(f\"BLOCKED: {src_ip}:{dest_port} not allowed from {matching_rule['source_cidr']}\")\n                else:\n                    print(f\"BLOCKED: {src_ip}:{dest_port} not allowed from any rule (default deny)\")\n\nif __name__ == '__main__':\n    main()\nEOF\n"]
