    # Sort by prefix length (descending) - more specific rules first
    rules.sort(key=lambda r: r['network'].prefixlen, reverse=True)
    
    return rules, data.get('default_action', 'deny')

def check_connection(src_ip, dest_port, rules, default_action):
    """Check if a connection is allowed by firewall rules.
    Returns (allowed, matching_rule) tuple.
    """
    ip_obj = ipaddress.ip_address(src_ip)
    
    # Check rules in order (most specific first)
    for rule in rules:
        if ip_obj in rule['network']:
            # IP matches this CIDR, check port
            if port_in_range(dest_port, rule['port_range']):
                # This rule applies
                return (rule['action'] == 'allow', rule)
    
    # No matching rule, use default action
    return (default_action == 'allow', None)

def main():
    rules, default_action = load_firewall_rules('/home/user/audit/firewall_rules.json')
    
    with open('/home/user/audit/connections.csv', 'r') as f:
        reader = csv.DictReader(f)
        for row in reader:
            src_ip = row['src_ip']
            dest_port = int(row['dest_port'])
            
            allowed, matching_rule = check_connection(src_ip, dest_port, rules, default_action)
            
            if not allowed:
                if matching_rule:
                    print(f"BLOCKED: {src_ip}:{dest_port} not allowed from {matching_rule['source_cidr']}")
                else:
                    print(f"BLOCKED: {src_ip}:{dest_port} not allowed from any rule (default deny)")

if __name__ == '__main__':
    main()
