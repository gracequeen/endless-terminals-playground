[84.533987, "i", "cat > filter_logs.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nFilter access logs for slow requests (>500ms response time).\nReads from /var/log/gateway/access.log\nWrites matching lines to /home/user/perf/slow.txt\n\"\"\"\n\nimport re\n\ndef filter_slow_requests():\n    input_file = \"/var/log/gateway/access.log\"\n    output_file = \"/home/user/perf/slow.txt\"\n\n    # Pattern to match response time - handle both formats:\n    # response_time=XXXms and response_time_ms=XXX\n    # Use negative lookbehind to exclude upstream_response_time\n    pattern1 = r'(?<!upstream_)response_time=(\\d+)ms'\n    pattern2 = r'(?<!upstream_)response_time_ms=(\\d+)'\n\n    slow_requests = []\n\n    with open(input_file, 'r') as f:\n        for line in f:\n            response_time = None\n            \n            # Try first pattern (response_time=XXXms)\n            match = re.search(pattern1, line)\n            if match:\n                response_time = int(match.group(1))\n            else:\n                # Try second pattern (response_time_ms=XXX)\n             "]
[84.534038, "i", "   match = re.search(pattern2, line)\n                if match:\n                    response_time = int(match.group(1))\n            \n            if response_time and response_time > 500:\n                slow_requests.append(line)\n\n    with open(output_file, 'w') as f:\n        f.writelines(slow_requests)\n\n    print(f\"Found {len(slow_requests)} slow requests (>500ms)\")\n\nif __name__ == \"__main__\":\n    filter_slow_requests()\nEOF\n"]
[84.534194, "o", "cat > filter_logs.py << 'EOF'\r\n"]
