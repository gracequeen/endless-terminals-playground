[7.941824, "o", "user@b4fe65dde394:~$ "]
[21.461011, "i", "cat > /home/user/bin/env-merge.sh << 'EOF'\n#!/bin/bash\n\n# Check arguments\nif [ $# -ne 2 ]; then\n    echo \"Usage: $0 <env-file-1> <env-file-2>\" >&2\n    echo \"Merges two .env files, with the second file taking precedence on conflicts\" >&2\n    exit 1\nfi\n\nFILE1=\"$1\"\nFILE2=\"$2\"\n\n# Check if files exist\nif [ ! -f \"$FILE1\" ]; then\n    echo \"Error: File '$FILE1' not found\" >&2\n    exit 1\nfi\n\nif [ ! -f \"$FILE2\" ]; then\n    echo \"Error: File '$FILE2' not found\" >&2\n    exit 1\nfi\n\n# Declare associative array for storing key-value pairs\ndeclare -A env_vars\ndeclare -a key_order\n\n# Function to parse env file\nparse_env_file() {\n    local file=\"$1\"\n    while IFS= read -r line || [ -n \"$line\" ]; do\n        # Skip empty lines and comments\n        if [[ -z \"$line\" ]] || [[ \"$line\" =~ ^[[:space:]]*# ]]; then\n            continue\n        fi\n        \n        # Extract key=value (handle lines with = in them)\n        if [[ \"$line\" =~ ^([^=]+)=(.*)$ ]]; then\n            key=\"${BASH_REMATCH[1]}\"\n            value=\"${BASH_REMATCH[2]}\"\n "]
[21.461154, "i", "           \n            # Store in associative array\n            if [ -z \"${env_vars[$key]+x}\" ]; then\n                # Key doesn't exist yet, add to order array\n                key_order+=(\"$key\")\n            fi\n            env_vars[\"$key\"]=\"$value\"\n        fi\n    done < \"$file\"\n}\n\n# Parse both files\nparse_env_file \"$FILE1\"\nparse_env_file \"$FILE2\"\n\n# Output merged result in order\nfor key in \"${key_order[@]}\"; do\n    echo \"${key}=${env_vars[$key]}\"\ndone\nEOF\n"]
[21.4612, "o", "cat > /home/user/bin/env-merge.sh << 'EOF'\r\n"]
