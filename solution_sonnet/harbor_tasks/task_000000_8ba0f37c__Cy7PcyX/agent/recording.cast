[57.705965, "o", "\u001b[?2004h> "]
[57.706016, "o", "ADDITIONAL ISSUES:\r\n\u001b[?2004l\r"]
[57.706046, "o", "\u001b[?2004h> "]
[57.706436, "o", "1. String matching on packet payloads in iptables is unreliable - it only inspects the first packet and can miss data in subsequent packets\r\n\u001b[?2004l\r"]
