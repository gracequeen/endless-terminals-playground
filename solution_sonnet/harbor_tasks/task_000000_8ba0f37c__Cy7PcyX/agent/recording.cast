[7.121421, "o", "total 12\r\n"]
[7.121455, "o", "drwxrwxrwx 1 user user 4096 May  5 05:03 .\r\ndrwxrwxrwx 1 user user 4096 May  5 05:04 ..\r\n-rw-r--r-- 1 user user  468 May  5 05:03 target_iptables.txt\r\n"]
