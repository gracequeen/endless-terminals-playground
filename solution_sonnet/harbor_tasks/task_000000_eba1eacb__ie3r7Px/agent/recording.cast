[34.491225, "i", "cat > Makefile << 'EOF'\n.PHONY: report clean\n\n# Check if hosts.conf exists before doing anything\ncheck-config:\n\t@test -f hosts.conf || (echo \"Error: hosts.conf not found\" && exit 1)\n\n# Main target to generate the report\nreport: check-config results/status.json\n\t@echo \"Monitoring report complete!\"\n\n# Create results directory\nresults:\n\tmkdir -p results\n\n# Run ping checks\nresults/ping.txt: check-config results\n\t./scripts/check_ping.sh\n\n# Run port checks\nresults/ports.txt: check-config results\n\t./scripts/check_ports.sh\n\n# Aggregate results into JSON\nresults/status.json: results/ping.txt results/ports.txt\n\t./aggregate.py\n\n# Clean up generated files\nclean:\n\trm -rf results\nEOF\n"]
