[148.309147, "o", ".PHONY: report clean\r\n\r\ncheck-config:\r\n\t@test -f hosts.conf || (echo \"Error: hosts.conf not found\" && exit 1)\r\n\r\nreport: check-config results/status.json\r\n\t@echo \"Monitoring report complete!\"\r\n\r\nresults:\r\n\tmkdir -p results\r\n\r\nresults/ping.txt: check-config results\r\n\t./scripts/check_ping.sh\r\n\r\nresults/ports.txt: check-config results\r\n\t./scripts/check_ports.sh\r\n\r\nresults/status.json: results/ping.txt results/ports.txt\r\n\t./aggregate.py\r\n\r\nclean:\r\n\trm -rf results\r\n"]
