[120.507313, "i", "python3 << 'PYEOF'\nwith open('changelog.py', 'r') as f:\n    lines = f.readlines()\n\n# Find and modify the line that adds section headers\nfor i, line in enumerate(lines):\n    if 'entry_lines.append(f\"\\\\n### {section_name}\\\\n\")' in line:\n        lines[i] = '            entry_lines.append(f\"\\\\n### {section_name.title()}\\\\n\")\\n'\n        break\n\nwith open('changelog.py', 'w') as f:\n    f.writelines(lines)\n\nprint('Fixed section header capitalization')\nPYEOF\n"]
