[126.371079, "i", "cat rules/alerts.yml\n"]
[126.371215, "o", "cat rules/alerts.yml\r\n\u001b[?2004l\r"]
[126.372041, "o", "groups:\r\n  - name: example-alerts\r\n    rules:\r\n      - alert: HighErrorRate\r\n        expr: job:request_errors:rate5m > 0.5\r\n        for: 10m\r\n        labels:\r\n          severity: critical\r\n        annotations:\r\n          summary: \"High error rate detected\"\r\n          description: \"Error rate is {{ $value }} for {{ $labels.job }}\"\r\n\r\n      - alert: HighLatency\r\n        expr: job:request_latency_seconds:mean5m > 1\r\n        for: 5m\r\n        labels:\r\n          severity: warning\r\n        annotations:\r\n          summary: \"High latency detected\"\r\n          description: \"Latency is {{ $value }}s for {{ $labels.job }}\"\r\n\r\n      - alert: ServiceDown\r\n        expr: up == 0\r\n        for: 1m\r\n        labels:\r\n          severity: critical\r\n        annotations:\r\n          summary: \"Service {{ $labels.job }} is down\"\r\n          description: \"{{ $labels.instance }} of job {{ $labels.job }} has been down for more than 1 minute.\"\r\n"]
[126.372195, "o", "\u001b[?2004h"]
[126.372236, "o", "root@b6b6275cc19d:/home/user/monitoring# "]
[126.472934, "i", "cat rules/database.yml\n"]
[126.473044, "o", "cat rules/database.yml\r\n"]
[126.473077, "o", "\u001b[?2004l\r"]
[126.473901, "o", "groups:\r\n  - name: database-alerts\r\n    rules:\r\n      - alert: DatabaseConnectionsHigh\r\n        expr: pg_stat_activity_count > 100\r\n        for: 5m\r\n        labels:\r\n          severity: warning\r\n          service: database\r\n        annotations:\r\n          summary: \"High number of database connections\"\r\n          description: \"Database has {{ $value }} active connections\"\r\n\r\n      - alert: DatabaseReplicationLag\r\n        expr: pg_replication_lag > 300\r\n        for: 10m\r\n        labels:\r\n          severity: critical\r\n          service: database\r\n        annotations:\r\n          summary: \"Database replication lag is high\"\r\n          description: \"Replication lag is {{ $value }} seconds\"\r\n"]
[126.474047, "o", "\u001b[?2004h"]
[126.474093, "o", "root@b6b6275cc19d:/home/user/monitoring# "]
