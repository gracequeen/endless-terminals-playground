[65.46152, "i", "python3 << 'EOF'\nimport sqlite3\n\n# Load breach hashes WITH newlines (buggy way)\nwith open('breach_hashes.txt', 'r') as f:\n    breach_with_newlines = set(f.readlines())\n\n# Load breach hashes WITHOUT newlines (correct way)\nwith open('breach_hashes.txt', 'r') as f:\n    breach_without_newlines = set(line.strip() for line in f)\n\n# Get database hashes\nconn = sqlite3.connect('users.db')\ncur = conn.cursor()\ncur.execute(\"SELECT password_hash FROM accounts\")\ndb_hashes = [row[0] for row in cur.fetchall()]\nconn.close()\n\n# Check for matches\nmatches_with_newlines = [h for h in db_hashes if h in breach_with_newlines]\nmatches_without_newlines = [h for h in db_hashes if h in breach_without_newlines]\n\nprint(f\"Matches with newlines (buggy): {len(matches_with_newlines)}\")\nprint(f\"Matches without newlines (correct): {len(matches_without_newlines)}\")\n\nif matches_without_newlines:\n    print(f\"\\nFirst few matches: {matches_without_newlines[:3]}\")\nEOF\n"]
