[38.426447, "o", "json.dump(report, f, indent=2)\r\n\r\n    return report\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    r"]
[38.426477, "o", "eport = generate_report()\r\n    print(json.dumps(report, indent=2))\r\nEOF\r\n\u001b[?2004h"]
