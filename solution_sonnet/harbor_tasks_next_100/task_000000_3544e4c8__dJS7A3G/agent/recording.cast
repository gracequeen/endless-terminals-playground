[8.839357, "o", "drwxrwxrwx 1 user user 4096 May  5 07:04 .\r\ndrwxrwxrwx 1 user user 4096 May  5 07:04 ..\r\n-rwxrwxrwx 1 user user  125 May  5 07:04 changelog.txt\r\ndrwxrwxrwx 1 user user 4096 May  5 07:04 rules.d\r\n-rwxrwxrwx 1 user user  858 May  5 07:04 rules.sh\r\n"]
