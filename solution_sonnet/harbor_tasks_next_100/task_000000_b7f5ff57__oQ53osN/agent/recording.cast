[105.840406, "o", "\u001b[?2004l\r"]
[105.841856, "o", "\u001b[?2004h"]
[105.841903, "o", "root@adead4b2841a:/home/user/loadtest# "]
[105.948485, "i", "cat > report.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nReads stats.json and prints a human-readable latency report.\n\"\"\"\nimport json\nimport sys\n\ndef print_report(stats_file=\"stats.json\"):\n    \"\"\"Print the latency report to stdout.\"\"\"\n    with open(stats_file, 'r') as f:\n        stats = json.load(f)\n\n    print(\"=\" * 50)\n    print(\"         LATENCY REPORT\")\n    print(\"=\" * 50)\n    print(f\"Total requests: {stats['count']}\")\n    print(f\"Min latency:    {stats['min']:.2f} ms\")\n    print(f\"Max latency:    {stats['max']:.2f} ms\")\n    print(\"-\" * 50)\n    # FIX: Corrected labels to match the actual values\n    print(f\"p50 (median):   {stats['p50']:.2f} ms\")\n    print(f\"p99:            {stats['p99']:.2f} ms\")\n    print(\"=\" * 50)\n\nif __name__ == '__main__':\n    print_report()\nEOF\n"]
[105.948626, "o", "cat > report.py << 'EOF'\r\n"]
[105.94867, "o", "\u001b[?2004l\r\u001b[?2004h"]
[105.948707, "o", "> "]
