[53.826844, "i", "cat > aggregate.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nReads raw_timings.csv and computes percentile statistics.\nWrites results to stats.json.\n\"\"\"\nimport csv\nimport json\nimport sys\n\ndef compute_percentile(sorted_data, percentile):\n    \"\"\"Compute the given percentile from sorted data.\"\"\"\n    if not sorted_data:\n        return 0\n    k = (len(sorted_data) - 1) * (percentile / 100)\n    f = int(k)\n    c = f + 1 if f + 1 < len(sorted_data) else f\n    return sorted_data[f] + (k - f) * (sorted_data[c] - sorted_data[f])\n\ndef aggregate(input_file=\"raw_timings.csv\", output_file=\"stats.json\"):\n    \"\"\"Read latencies and compute statistics.\"\"\"\n    latencies = []\n\n    with open(input_file, 'r') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            latencies.append(float(row['latency_ms']))\n\n    if not latencies:\n        print(\"No data to aggregate\", file=sys.stderr)\n        sys.exit(1)\n\n    # FIX: Convert to float BEFORE sorting\n    sorted_latencies = sorted(latencies)\n\n    stats = {\n        'count"]
[53.826974, "i", "': len(latencies),\n        'min': min(sorted_latencies),\n        'max': max(sorted_latencies),\n        'p50': compute_percentile(sorted_latencies, 50),\n        'p99': compute_percentile(sorted_latencies, 99)\n    }\n\n    with open(output_file, 'w') as f:\n        json.dump(stats, f, indent=2)\n\n    print(f\"Aggregated {stats['count']} samples to {output_file}\")\n\nif __name__ == '__main__':\n    aggregate()\nEOF\n"]
[53.827012, "o", "cat > aggregate.py << 'EOF'\r\n\u001b[?2004l\r"]
[53.827049, "o", "': len(latencies),\r\n        'min': min(sorted_latencies),\r\n        'max': max(sorted_latencies),\r\n        'p50': compute_percentile(sorted_latencies, 50),\r\n        'p99': compute_percentile(sorted_latencies, 99)\r\n    }\r\n\r\n    with open(output_file, "]
[53.8271, "o", "'w') as f:\r\n        json.dump(stats, f, indent=2)\r\n\r\n    print(f\"Aggregated {stats['count']} samples to {output_file}\")\r\n\r\nif __name__ == '__main__':\r\n    aggregate()\r\nEOF\r\n"]
