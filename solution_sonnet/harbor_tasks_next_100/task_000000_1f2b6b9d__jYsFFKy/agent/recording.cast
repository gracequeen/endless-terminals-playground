[62.959009, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[62.959039, "o", "> "]
[62.959111, "o", "if [ ! -f \"$INPUT_FILE\" ]; then\r\n\u001b[?2004l\r"]
[62.959143, "o", "\u001b[?2004h> "]
[62.959269, "o", "    echo \"Error: File not found: $INPUT_FILE\"\r\n\u001b[?2004l\r"]
[62.959297, "o", "\u001b[?2004h> "]
[62.959334, "o", "    exit 1\r\n\u001b[?2004l\r"]
[62.959368, "o", "\u001b[?2004h> fi\r\n\u001b[?2004l\r"]
[62.959398, "o", "\u001b[?2004h> "]
[62.959434, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.959544, "o", "FILENAME=$(basename \"$INPUT_FILE\")\r\n\u001b[?2004l\r"]
[62.959577, "o", "\u001b[?2004h> "]
[62.959653, "o", "TIMESTAMP=$(date -Iseconds)\r\n\u001b[?2004l\r"]
[62.959682, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[62.959712, "o", "\u001b[?2004h> "]
[62.959768, "o", "# Detect mime type\r\n\u001b[?2004l\r"]
[62.959797, "o", "\u001b[?2004h> "]
[62.959957, "o", "MIME_TYPE=$(file --mime-type -b \"$INPUT_FILE\")\r\n\u001b[?2004l\r"]
[62.960012, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[62.96004, "o", "\u001b[?2004h> "]
[62.960155, "o", "# Extract based on detected type\r\n\u001b[?2004l\r"]
[62.960202, "o", "\u001b[?2004h"]
[62.960252, "o", "> "]
[62.960296, "o", "case \"$MIME_TYPE\" in\r\n\u001b[?2004l\r"]
[62.96034, "o", "\u001b[?2004h> "]
[62.960413, "o", "    application/zip)\r\n\u001b[?2004l\r"]
[62.960478, "o", "\u001b[?2004h> "]
[62.960613, "o", "        unzip -o \"$INPUT_FILE\" -d \"$OUTPUT_DIR\"\r\n\u001b[?2004l\r"]
[62.960657, "o", "\u001b[?2004h> "]
[62.960875, "o", "        echo \"$TIMESTAMP $FILENAME $MIME_TYPE - extracted\" >> \"$LOG_FILE\"\r\n\u001b[?2004l\r"]
[62.960921, "o", "\u001b[?2004h> "]
[62.960961, "o", "        ;;\r\n"]
[62.961004, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[62.961082, "o", "    application/x-tar)\r\n\u001b[?2004l\r"]
[62.961126, "o", "\u001b[?2004h> "]
[62.961277, "o", "        tar -xf \"$INPUT_FILE\" -C \"$OUTPUT_DIR\"\r\n\u001b[?2004l\r"]
[62.961323, "o", "\u001b[?2004h> "]
[62.96155, "o", "        echo \"$TIMESTAMP $FILENAME $MIME_TYPE - extracted\" >> \"$LOG_FILE\"\r\n\u001b[?2004l\r"]
[62.961596, "o", "\u001b[?2004h> "]
[62.961637, "o", "        ;;\r\n\u001b[?2004l\r"]
[62.961682, "o", "\u001b[?2004h> "]
[62.961804, "o", "    application/gzip|application/x-gzip)\r\n\u001b[?2004l\r"]
[62.961844, "o", "\u001b[?2004h"]
[62.961886, "o", "> "]
[62.961956, "o", "        # Assume it's a tar.gz\r\n\u001b[?2004l\r"]
[62.961999, "o", "\u001b[?2004h> "]
[62.962142, "o", "        tar -xzf \"$INPUT_FILE\" -C \"$OUTPUT_DIR\"\r\n\u001b[?2004l\r"]
[62.962185, "o", "\u001b[?2004h> "]
[62.962409, "o", "        echo \"$TIMESTAMP $FILENAME $MIME_TYPE - extracted\" >> \"$LOG_FILE\"\r\n\u001b[?2004l\r"]
[62.962455, "o", "\u001b[?2004h> "]
[62.962508, "o", "        ;;\r\n\u001b[?2004l\r"]
[62.962549, "o", "\u001b[?2004h> "]
[62.962634, "o", "    application/x-bzip2)\r\n\u001b[?2004l\r"]
[62.962676, "o", "\u001b[?2004h> "]
[62.962827, "o", "        tar -xjf \"$INPUT_FILE\" -C \"$OUTPUT_DIR\"\r\n\u001b[?2004l\r"]
[62.962873, "o", "\u001b[?2004h> "]
[62.963091, "o", "        echo \"$TIMESTAMP $FILENAME $MIME_TYPE - extracted\" >> \"$LOG_FILE\"\r\n\u001b[?2004l\r"]
[62.963141, "o", "\u001b[?2004h> "]
[62.963179, "o", "        ;;\r\n\u001b[?2004l\r"]
[62.963206, "o", "\u001b[?2004h> "]
[62.963294, "o", "    application/x-xz)\r\n\u001b[?2004l\r"]
[62.963333, "o", "\u001b[?2004h"]
[62.963376, "o", "> "]
[62.963509, "o", "        tar -xJf \"$INPUT_FILE\" -C \"$OUTPUT_DIR\"\r\n\u001b[?2004l\r"]
[62.963554, "o", "\u001b[?2004h> "]
[62.963766, "o", "        echo \"$TIMESTAMP $FILENAME $MIME_TYPE - extracted\" >> \"$LOG_FILE\"\r\n"]
[62.963809, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[62.96385, "o", "        ;;\r\n\u001b[?2004l\r"]
[62.963894, "o", "\u001b[?2004h> "]
[62.963996, "o", "    application/x-7z-compressed)\r\n\u001b[?2004l\r"]
[62.964036, "o", "\u001b[?2004h> "]
[62.964178, "o", "        7z x \"$INPUT_FILE\" -o\"$OUTPUT_DIR\" -y\r\n\u001b[?2004l\r"]
[62.964221, "o", "\u001b[?2004h> "]
[62.964435, "o", "        echo \"$TIMESTAMP $FILENAME $MIME_TYPE - extracted\" >> \"$LOG_FILE\"\r\n\u001b[?2004l\r"]
[62.964495, "o", "\u001b[?2004h> "]
[62.964533, "o", "        ;;\r\n\u001b[?2004l\r"]
[62.964578, "o", "\u001b[?2004h> "]
[62.964617, "o", "    *)\r\n\u001b[?2004l\r"]
[62.96466, "o", "\u001b[?2004h> "]
[62.964872, "o", "        echo \"$TIMESTAMP $FILENAME unknown format - skipped\" >> \"$LOG_FILE\"\r\n\u001b[?2004l\r"]
[62.964914, "o", "\u001b[?2004h> "]
[62.965047, "o", "        echo \"Unknown format: $MIME_TYPE\"\r\n\u001b[?2004l\r"]
[62.965091, "o", "\u001b[?2004h> "]
[62.965146, "o", "        exit 1\r\n\u001b[?2004l\r"]
[62.965184, "o", "\u001b[?2004h"]
[62.965239, "o", "> "]
[62.965282, "o", "        ;;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.965322, "o", "esac\r\n\u001b[?2004l\r"]
[62.965363, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[62.965404, "o", "\u001b[?2004h> "]
[62.965542, "o", "echo \"Extraction complete for $FILENAME\"\r\n\u001b[?2004l\r"]
[62.965585, "o", "\u001b[?2004h> "]
[62.965629, "o", "EOF\r\n\u001b[?2004l\r"]
[62.96677, "o", "\u001b[?2004h"]
