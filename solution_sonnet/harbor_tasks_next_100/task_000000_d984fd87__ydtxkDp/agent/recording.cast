[37.193075, "o", "RETENTION_DAYS = 30\r\n\u001b[?2004l\r"]
[37.193107, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[37.193137, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[37.193169, "o", "\u001b[?2004h> "]
[37.193263, "o", "def get_run_created_at(run_path):\r\n\u001b[?2004l\r"]
[37.193314, "o", "\u001b[?2004h> "]
[37.193478, "o", "    \"\"\"Read the created_at timestamp from metadata.json.\"\"\"\r\n\u001b[?2004l\r"]
[37.193507, "o", "\u001b[?2004h> "]
[37.193647, "o", "    metadata_path = run_path / \"metadata.json\"\r\n\u001b[?2004l\r"]
[37.193679, "o", "\u001b[?2004h> "]
[37.19379, "o", "    if not metadata_path.exists():\r\n\u001b[?2004l\r"]
[37.193822, "o", "\u001b[?2004h> "]
[37.193889, "o", "        return None\r\n"]
[37.193921, "o", "\u001b[?2004l\r\u001b[?2004h"]
[37.193949, "o", "> \r\n\u001b[?2004l\r"]
[37.193983, "o", "\u001b[?2004h> "]
[37.194012, "o", "    try:\r\n"]
[37.194041, "o", "\u001b[?2004l\r\u001b[?2004h"]
[37.194075, "o", "> "]
[37.194205, "o", "        with open(metadata_path) as f:\r\n"]
[37.194239, "o", "\u001b[?2004l\r\u001b[?2004h"]
[37.194268, "o", "> "]
[37.194399, "o", "            data = json.load(f)\r\n\u001b[?2004l\r"]
[37.194432, "o", "\u001b[?2004h"]
[37.194461, "o", "> "]
[37.194616, "o", "        created_at_str = data.get(\"created_at\")\r\n\u001b[?2004l\r"]
[37.194645, "o", "\u001b[?2004h"]
[37.194681, "o", "> "]
[37.194776, "o", "        if not created_at_str:\r\n\u001b[?2004l\r"]
[37.194809, "o", "\u001b[?2004h"]
[37.194839, "o", "> "]
[37.194915, "o", "            return None\r\n\u001b[?2004l\r"]
[37.19495, "o", "\u001b[?2004h> "]
[37.195068, "o", "        # Parse ISO format timestamp\r\n\u001b[?2004l\r"]
[37.1951, "o", "\u001b[?2004h"]
[37.195134, "o", "> "]
[37.195328, "o", "        return datetime.fromisoformat(created_at_str)\r\n\u001b[?2004l\r"]
[37.195363, "o", "\u001b[?2004h> "]
[37.195455, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[37.195484, "o", "\u001b[?2004h"]
[37.195514, "o", "> "]
[37.195768, "o", "        logging.debug(f\"Could not parse metadata for {run_path}: {e}\")\r\n\u001b[?2004l\r"]
[37.195802, "o", "\u001b[?2004h"]
[37.195829, "o", "> "]
[37.195895, "o", "        return None\r\n\u001b[?2004l\r"]
[37.195932, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[37.195962, "o", "\u001b[?2004h> "]
[37.195992, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.196093, "o", "def should_delete_run(run_path):\r\n\u001b[?2004l\r"]
[37.196126, "o", "\u001b[?2004h> "]
[37.196362, "o", "    \"\"\"Determine if a run should be deleted based on age.\"\"\"\r\n\u001b[?2004l\r"]
[37.196397, "o", "\u001b[?2004h"]
[37.196428, "o", "> "]
[37.196547, "o", "    created_at = get_run_created_at(run_path)\r\n\u001b[?2004l\r"]
[37.196579, "o", "\u001b[?2004h> "]
[37.196688, "o", "    if created_at is None:\r\n\u001b[?2004l\r"]
[37.196718, "o", "\u001b[?2004h"]
[37.196747, "o", "> "]
[37.196812, "o", "        return False\r\n"]
[37.19684, "o", "\u001b[?2004l\r\u001b[?2004h"]
[37.196873, "o", "> \r\n\u001b[?2004l\r"]
[37.196905, "o", "\u001b[?2004h> "]
[37.196939, "o", "    try:\r\n\u001b[?2004l\r"]
[37.196972, "o", "\u001b[?2004h"]
[37.197001, "o", "> "]
[37.197247, "o", "        cutoff = datetime.now() - timedelta(days=RETENTION_DAYS)\r\n\u001b[?2004l\r"]
[37.19728, "o", "\u001b[?2004h"]
[37.197321, "o", "> "]
[37.197447, "o", "        return created_at < cutoff\r\n"]
[37.197483, "o", "\u001b[?2004l\r\u001b[?2004h"]
[37.197512, "o", "> "]
[37.197596, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[37.197626, "o", "\u001b[?2004h"]
[37.197655, "o", "> "]
[37.197908, "o", "        logging.debug(f\"Could not compare dates for {run_path}: {e}\")\r\n\u001b[?2004l\r"]
[37.197937, "o", "\u001b[?2004h"]
[37.197976, "o", "> "]
[37.198036, "o", "        return False\r\n\u001b[?2004l\r"]
[37.198065, "o", "\u001b[?2004h"]
[37.198094, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[37.198123, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[37.198153, "o", "> "]
[37.198214, "o", "def delete_run(run_path):\r\n\u001b[?2004l\r"]
[37.198242, "o", "\u001b[?2004h> "]
[37.198359, "o", "    \"\"\"Delete a run directory.\"\"\"\r\n\u001b[?2004l\r"]
[37.198393, "o", "\u001b[?2004h> "]
[37.198423, "o", "    try:\r\n\u001b[?2004l\r"]
[37.198452, "o", "\u001b[?2004h> "]
[37.198548, "o", "        shutil.rmtree(run_path)\r\n\u001b[?2004l\r"]
[37.198577, "o", "\u001b[?2004h> "]
[37.19871, "o", "        logging.info(f\"Deleted: {run_path}\")\r\n\u001b[?2004l\r"]
[37.198736, "o", "\u001b[?2004h> "]
[37.198815, "o", "        return True\r\n\u001b[?2004l\r"]
[37.198847, "o", "\u001b[?2004h"]
[37.198877, "o", "> "]
[37.198961, "o", "    except Exception as e:\r\n"]
[37.198989, "o", "\u001b[?2004l\r\u001b[?2004h"]
[37.199018, "o", "> "]
[37.199151, "o", "        logging.info(f\"skipped: {run_path}\")\r\n\u001b[?2004l\r"]
[37.199181, "o", "\u001b[?2004h> "]
[37.199244, "o", "        return False\r\n\u001b[?2004l\r"]
[37.199278, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[37.199319, "o", "\u001b[?2004h> "]
[37.199349, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[37.199378, "o", "> "]
[37.199408, "o", "def main():\r\n\u001b[?2004l\r"]
[37.199437, "o", "\u001b[?2004h> "]
[37.199577, "o", "    \"\"\"Main entry point for the purge script.\"\"\"\r\n"]
[37.199605, "o", "\u001b[?2004l\r\u001b[?2004h"]
[37.199634, "o", "> "]
[37.199805, "o", "    logging.info(\"Starting purge of old experiment runs\")\r\n"]
[37.199835, "o", "\u001b[?2004l\r\u001b[?2004h"]
[37.19987, "o", "> \r\n\u001b[?2004l\r"]
[37.199898, "o", "\u001b[?2004h> "]
[37.199982, "o", "    deleted_count = 0\r\n\u001b[?2004l\r"]
[37.200015, "o", "\u001b[?2004h"]
[37.200044, "o", "> "]
[37.200117, "o", "    processed_count = 0\r\n"]
[37.20015, "o", "\u001b[?2004l\r\u001b[?2004h"]
[37.20018, "o", "> \r\n\u001b[?2004l\r"]
[37.200209, "o", "\u001b[?2004h> "]
[37.200396, "o", "    for project_dir in EXPERIMENTS_DIR.iterdir():\r\n\u001b[?2004l\r"]
[37.20043, "o", "\u001b[?2004h> "]
[37.20057, "o", "        if not project_dir.is_dir():\r\n\u001b[?2004l\r"]
[37.200599, "o", "\u001b[?2004h"]
[37.200628, "o", "> "]
[37.200694, "o", "            continue\r\n"]
[37.200727, "o", "\u001b[?2004l\r\u001b[?2004h"]
[37.200757, "o", "> \r\n\u001b[?2004l\r"]
[37.200786, "o", "\u001b[?2004h> "]
[37.200939, "o", "        for run_dir in project_dir.iterdir():\r\n\u001b[?2004l\r"]
[37.200969, "o", "\u001b[?2004h"]
[37.200997, "o", "> "]
[37.201267, "o", "            if not run_dir.is_dir() or not run_dir.name.startswith(\"run_\"):\r\n\u001b[?2004l\r"]
[37.201311, "o", "\u001b[?2004h"]
[37.201345, "o", "> "]
[37.201425, "o", "                continue\r\n\u001b[?2004l\r"]
[37.201458, "o", "\u001b[?2004h"]
[37.201487, "o", "> \r\n\u001b[?2004l\r"]
[37.201517, "o", "\u001b[?2004h> "]
[37.201613, "o", "            processed_count += 1\r\n\u001b[?2004l\r"]
[37.201646, "o", "\u001b[?2004h> "]
[37.201841, "o", "            logging.info(f\"Processing {run_dir}\")\r\n"]
[37.20187, "o", "\u001b[?2004l\r\u001b[?2004h"]
[37.201901, "o", "> \r\n\u001b[?2004l\r"]
[37.201931, "o", "\u001b[?2004h> "]
[37.20206, "o", "            if should_delete_run(run_dir):\r\n\u001b[?2004l\r"]
[37.202089, "o", "\u001b[?2004h"]
[37.202118, "o", "> "]
[37.202255, "o", "                if delete_run(run_dir):\r\n"]
[37.202285, "o", "\u001b[?2004l\r\u001b[?2004h"]
[37.202331, "o", "> "]
[37.202439, "o", "                    deleted_count += 1\r\n\u001b[?2004l\r"]
[37.202469, "o", "\u001b[?2004h"]
[37.2025, "o", "> \r\n\u001b[?2004l\r"]
[37.202528, "o", "\u001b[?2004h> "]
[37.202879, "o", "    logging.info(f\"Purge complete. Processed: {processed_count}, Deleted: {deleted_count}\")\r\n"]
[37.202909, "o", "\u001b[?2004l\r\u001b[?2004h"]
[37.202936, "o", "> "]
[37.202983, "o", "    return 0\r\n\u001b[?2004l\r"]
[37.203011, "o", "\u001b[?2004h"]
[37.203049, "o", "> \r\n\u001b[?2004l\r"]
[37.203082, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[37.203115, "o", "\u001b[?2004h> "]
[37.20322, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[37.203249, "o", "\u001b[?2004h"]
[37.203279, "o", "> "]
[37.203336, "o", "    exit(main())\r\n\u001b[?2004l\r"]
[37.203366, "o", "\u001b[?2004h> "]
