[?2004l[?2004h> RETENTION_DAYS = 30
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def get_run_created_at(run_path):
[?2004l[?2004h>     """Read the created_at timestamp from metadata.json."""
[?2004l[?2004h>     metadata_path = run_path / "metadata.json"
[?2004l[?2004h>     if not metadata_path.exists():
[?2004l[?2004h>         return None
[?2004l[?2004h> 
[?2004l[?2004h>     try:
[?2004l[?2004h>         with open(metadata_path) as f:
[?2004l[?2004h>             data = json.load(f)
[?2004l[?2004h>         created_at_str = data.get("created_at")
[?2004l[?2004h>         if not created_at_str:
[?2004l[?2004h>             return None
[?2004l[?2004h>         # Parse ISO format timestamp, handle 'Z' suffix for UTC
[?2004l[?2004h>         created_at_str = created_at_str.replace('Z', '+00:00')
[?2004l[?2004h>         return datetime.fromisoformat(created_at_str)
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         logging.debug(f"Could not parse metadata for {run_path}: {e}")
[?2004l[?2004h>         return None
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def should_delete_run(run_path):
[?2004l[?2004h>     """Determine if a run should be deleted based on age."""
[?2004l[?2004h>     created_at = get_run_created_at(run_path)
[?2004l[?2004h>     if created_at is None:
[?2004l[?2004h>         return False
[?2004l[?2004h> 
[?2004l[?2004h>     try:
[?2004l[?2004h>         cutoff = datetime.now(created_at.tzinfo) - timedelta(days=RETENTION_DAYS)
[?2004l[?2004h>         return created_at < cutoff
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         logging.debug(f"Could not compare dates for {run_path}: {e}")
[?2004l[?2004h>         return False
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def delete_run(run_path):
