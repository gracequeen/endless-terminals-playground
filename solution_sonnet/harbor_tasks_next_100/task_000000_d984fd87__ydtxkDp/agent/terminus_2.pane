[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         logging.info(f"skipped: {run_path}")
[?2004l[?2004h>         return False
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def main():
