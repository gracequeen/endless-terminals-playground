[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> import json
[?2004l[?2004h> import sys
[?2004l[?2004h> 
[?2004l[?2004h> # Read the ignore patterns from .semgrepignore
[?2004l[?2004h> ignore_patterns = []
[?2004l[?2004h> with open('.semgrepignore', 'r') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line = line.strip()
[?2004l[?2004h>         if line and not line.startswith('#'):
[?2004l[?2004h>             # Format: path:rule_id
[?2004l[?2004h>             if ':' in line:
[?2004l[?2004h>                 path, rule_id = line.split(':', 1)
[?2004l[?2004h>                 ignore_patterns.append({'path': path, 'rule_id': rule_id})
[?2004l[?2004h> 
[?2004l[?2004h> # Read the scan results
[?2004l[?2004h> with open('reports/scan-results.json', 'r') as f:
[?2004l[?2004h>     data = json.load(f)
[?2004l[?2004h> 
[?2004l[?2004h> # Filter out suppressed findings
[?2004l[?2004h> filtered_results = []
[?2004l[?2004h> for result in data.get('results', []):
[?2004l[?2004h>     should_ignore = False
[?2004l[?2004h>     for pattern in ignore_patterns:
[?2004l[?2004h>         if result['path'] == pattern['path'] and result['check_id'] == pattern['rule_id']:
[?2004l[?2004h>             should_ignore = True
[?2004l[?2004h>             break
[?2004l[?2004h>     if not should_ignore:
[?2004l[?2004h>         filtered_results.append(result)
[?2004l[?2004h> 
[?2004l[?2004h> # Update the results
[?2004l[?2004h> data['results'] = filtered_results
[?2004l[?2004h> 
[?2004l[?2004h> # Write back
[?2004l[?2004h> with open('reports/scan-results.json', 'w') as f:
[?2004l[?2004h>     json.dump(data, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Filtered {len(data.get('results', [])) - len(filtered_results)} suppressed findings")
