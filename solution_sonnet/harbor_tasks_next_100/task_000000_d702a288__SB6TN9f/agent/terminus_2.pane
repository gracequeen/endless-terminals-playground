[?2004l[?2004h> #!/bin/bash
[?2004l[?2004h> # SAST scan wrapper script
[?2004l[?2004h> # Runs semgrep with our security configuration
[?2004l[?2004h> 
[?2004l[?2004h> set -e
[?2004l[?2004h> 
[?2004l[?2004h> SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
[?2004l[?2004h> cd "$SCRIPT_DIR"
[?2004l[?2004h> 
[?2004l[?2004h> CONFIG_FILE=".security/scanner-config.yaml"
[?2004l[?2004h> REPORT_FILE="reports/scan-results.json"
[?2004l[?2004h> 
[?2004l[?2004h> # Parse config file for settings
[?2004l[?2004h> IGNORE_FILE=$(grep -E "^ignore_file:" "$CONFIG_FILE" | awk '{print $2}' | tr -d '"' | tr -d "'")
[?2004l[?2004h> SEVERITY=$(grep -E "^severity_threshold:" "$CONFIG_FILE" | awk '{print $2}' | tr -d '"' | tr -d "'")
[?2004l[?2004h> 
[?2004l[?2004h> echo "Running SAST scan..."
[?2004l[?2004h> echo "Config: $CONFIG_FILE"
[?2004l[?2004h> echo "Ignore file: $IGNORE_FILE"
[?2004l[?2004h> echo "Severity threshold: $SEVERITY"
[?2004l[?2004h> 
[?2004l[?2004h> # Build semgrep command
[?2004l[?2004h> SEMGREP_CMD="semgrep --config p/python --json -o $REPORT_FILE --no-git-ignore"
[?2004l[?2004h> 
[?2004l[?2004h> # Add severity threshold
[?2004l[?2004h> if [ -n "$SEVERITY" ]; then
[?2004l[?2004h>     SEMGREP_CMD="$SEMGREP_CMD --severity $SEVERITY"
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> # Add source directory
[?2004l[?2004h> SEMGREP_CMD="$SEMGREP_CMD src/"
[?2004l[?2004h> 
[?2004l[?2004h> echo "Executing: $SEMGREP_CMD"
[?2004l[?2004h> $SEMGREP_CMD || true  # Don't exit on semgrep errors
[?2004l[?2004h> 
[?2004l[?2004h> # Apply suppressions from .semgrepignore if it exists
[?2004l[?2004h> if [ -f ".semgrepignore" ]; then
[?2004l[?2004h>     echo "Applying suppressions from .semgrepignore..."
[?2004l[?2004h>     python3 /tmp/filter_results.py
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> # Check results
[?2004l[?2004h> FINDING_COUNT=$(jq '.results | length' "$REPORT_FILE")
[?2004l[?2004h> echo "Scan complete. Found $FINDING_COUNT findings."
[?2004l[?2004h> 
[?2004l[?2004h> # Exit nonzero if there are WARNING or ERROR severity findings
[?2004l[?2004h> WARNING_COUNT=$(jq '[.results[] | select(.extra.severity == "WARNING" or .extra.severity == "ERROR")] | length' "$REPORT_FILE")
[?2004l[?2004h> if [ "$WARNING_COUNT" -gt 0 ]; then
[?2004l[?2004h>     echo "ERROR: $WARNING_COUNT findings at WARNING level or above. Failing scan."
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> echo "Scan passed."
[?2004l[?2004h> exit 0
[?2004l[?2004h> SHEOF
