[188.864833, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[34;1m\"check_id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"python.lang.security.audit.sqli-injection-psycopg2\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[34;1m\"path\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"src/db/queries.py\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[34;1m\"severity\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"WARNING\"\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\r\n  \u001b[0m\u001b[34;1m\"check_id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"python.lang.security.audit.logging-sensitive-data\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[34;1m\"path\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"src/utils/logging.py\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[34;1m\"severity\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"INFO\"\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\r\n  \u001b[0m\u001b[34;1m\"check_id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"python.lang.best-practice.missing-type-hints\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[34;1m\"path\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"src/utils/helpers.py\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[34;1m\"severity\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"INFO\"\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
