[227.012416, "o", "\u001b[?2004h> "]
[227.012511, "o", "if [ \"$WARNING_COUNT\" -gt 0 ]; then\r\n\u001b[?2004l\r"]
[227.012538, "o", "\u001b[?2004h> "]
[227.012773, "o", "    echo \"ERROR: $WARNING_COUNT findings at WARNING level or above. Failing scan.\"\r\n\u001b[?2004l\r"]
[227.012815, "o", "\u001b[?2004h> "]
[227.012846, "o", "    exit 1\r\n\u001b[?2004l\r"]
[227.012877, "o", "\u001b[?2004h> "]
[227.012907, "o", "fi\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.012938, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[227.012968, "o", "> "]
[227.013005, "o", "echo \"Scan passed.\"\r\n\u001b[?2004l\r"]
[227.013037, "o", "\u001b[?2004h> "]
[227.013066, "o", "exit 0\r\n\u001b[?2004l\r"]
[227.013098, "o", "\u001b[?2004h> "]
[227.013129, "o", "SHEOF\r\n\u001b[?2004l\r"]
[227.014254, "o", "\u001b[?2004h"]
