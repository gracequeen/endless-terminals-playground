[206.663118, "o", "cat .semgrepignore\r\n\u001b[?2004l\r"]
[206.664086, "o", "# Semgrep ignore patterns\r\n# These patterns suppress known false positives\r\n\r\n# False positive: hardcoded password in defaults.py is just a placeholder/example\r\nsrc/config/defaults.py:python.lang.security.audit.hardcoded-password-default\r\n\r\n# False positive: queries.py uses parameterized queries, not string concatenation\r\nsrc/db/queries.py:python.lang.security.audit.sqli-injection-psycopg2\r\n"]
[206.664293, "o", "\u001b[?2004h"]
[206.664337, "o", "root@4e542c269e92:/home/user/project# "]
[206.773204, "i", "cat > /tmp/filter_results.py << 'PYEOF'\n#!/usr/bin/env python3\nimport json\nimport sys\n\n# Read the ignore patterns from .semgrepignore\nignore_patterns = []\nwith open('.semgrepignore', 'r') as f:\n    for line in f:\n        line = line.strip()\n        if line and not line.startswith('#'):\n            # Format: path:rule_id\n            if ':' in line:\n                path, rule_id = line.split(':', 1)\n                ignore_patterns.append({'path': path, 'rule_id': rule_id})\n\n# Read the scan results\nwith open('reports/scan-results.json', 'r') as f:\n    data = json.load(f)\n\n# Filter out suppressed findings\nfiltered_results = []\nfor result in data.get('results', []):\n    should_ignore = False\n    for pattern in ignore_patterns:\n        if result['path'] == pattern['path'] and result['check_id'] == pattern['rule_id']:\n            should_ignore = True\n            break\n    if not should_ignore:\n        filtered_results.append(result)\n\n# Update the results\ndata['results'] = filtered_results\n\n# Write back\nwith open('re"]
[206.773338, "i", "ports/scan-results.json', 'w') as f:\n    json.dump(data, f, indent=2)\n\nprint(f\"Filtered {len(data.get('results', [])) - len(filtered_results)} suppressed findings\")\nPYEOF\n"]
