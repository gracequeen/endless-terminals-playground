[32.414871, "o", "import asyncio\r\nfrom aiohttp import web\r\nimport aiomqtt\r\n\r\nmqtt_client = None\r\n\r\nasync def health_handler(request):\r\n    if mqtt_client and mqtt_client._client.is_connected():\r\n        return web.json_response({\"status\": \"healthy\", \"mqtt\": \"connected\"})\r\n    return web.json_response({\"status\": \"degraded\", \"mqtt\": \"disconnected\"}, status=503)\r\n\r\nasync def sensor_handler(request):\r\n    data = await request.json()\r\n    if mqtt_client:\r\n        await mqtt_client.publish(\"sensors/data\", str(data))\r\n    return web.json_response({\"accepted\": True})\r\n\r\ndef create_app():\r\n    app = web.Application()\r\n    app.router.add_get('/health', health_handler)\r\n    app.router.add_post('/sensor', sensor_handler)\r\n    return app\r\n\r\nasync def mqtt_loop():\r\n    global mqtt_client\r\n    async with aiomqtt.Client(\"localhost\", 1883) as client:\r\n        mqtt_client = client\r\n        # Subscribe to a topic to keep connection alive\r\n        await client.subscribe(\"sensors/#\")\r\n        async for message in client.messages:\r\n            prin"]
[32.414984, "o", "t(f\"Received: {message.payload}\")\r\n\r\nasync def start_mqtt(app):\r\n    \"\"\"Start MQTT client as background task\"\"\"\r\n    app['mqtt_task'] = asyncio.create_task(mqtt_loop())\r\n\r\nasync def cleanup_mqtt(app):\r\n    \"\"\"Cleanup MQTT client on shutdown\"\"\"\r\n    if 'mqtt_task' in app:\r\n        app['mqtt_task'].cancel()\r\n        try:\r\n            await app['mqtt_task']\r\n        except asyncio.CancelledError:\r\n            pass\r\n\r\ndef main():\r\n    app = create_app()\r\n    app.on_startup.append(start_mqtt)\r\n    app.on_cleanup.append(cleanup_mqtt)\r\n    \r\n    # Run HTTP server properly with logging\r\n    with open('/home/user/edge-gateway/logs/gateway.log', 'a') as log:\r\n        log.write('Starting gateway server on port 8080\\n')\r\n    \r\n    web.run_app(app, host='0.0.0.0', port=8080, print=lambda x: open('/home/user/edge-gateway/logs/gateway.log', 'a').write(x + '\\n'))\r\n\r\nif __name__ == '__main__':\r\n    main()\r\n"]
