[81.963785, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[81.963816, "o", "\u001b[?2004h> "]
[81.963928, "o", "            chunks_processed += 1\r\n\u001b[?2004l\r"]
[81.963954, "o", "\u001b[?2004h"]
[81.963986, "o", "> "]
[81.964226, "o", "            print(f\"Worker {worker_id}: Processed chunk {chunk_id} (total: {chunks_processed})\")\r\n\u001b[?2004l\r"]
[81.964262, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[81.964302, "o", "\u001b[?2004h> "]
[81.964376, "o", "        except Exception as e:\r\n\u001b[?2004l\r"]
[81.964413, "o", "\u001b[?2004h> "]
[81.964549, "o", "            print(f\"Worker {worker_id}: Error: {e}\")\r\n\u001b[?2004l\r"]
[81.964579, "o", "\u001b[?2004h> "]
[81.964659, "o", "            import traceback\r\n\u001b[?2004l\r"]
[81.964691, "o", "\u001b[?2004h> "]
[81.964787, "o", "            traceback.print_exc()\r\n\u001b[?2004l\r"]
[81.964847, "o", "\u001b[?2004h> "]
[81.964885, "o", "            break\r\n\u001b[?2004l\r"]
[81.964921, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[81.964952, "o", "\u001b[?2004h> "]
[81.965197, "o", "    print(f\"Worker {worker_id}: Shutting down after processing {chunks_processed} chunks\")\r\n\u001b[?2004l\r"]
[81.965225, "o", "\u001b[?2004h> "]
[81.96529, "o", "    receiver.close()\r\n\u001b[?2004l\r"]
[81.965318, "o", "\u001b[?2004h> "]
[81.965377, "o", "    sender.close()\r\n\u001b[?2004l\r"]
[81.965405, "o", "\u001b[?2004h> "]
[81.965462, "o", "    context.term()\r\n\u001b[?2004l\r"]
[81.96549, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[81.965522, "o", "\u001b[?2004h> "]
[81.96561, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[81.965639, "o", "\u001b[?2004h> "]
[81.965678, "o", "    main()\r\n\u001b[?2004l\r"]
