[35.649056, "o", "cat worker.py\r\n\u001b[?2004l\r"]
[35.649907, "o", "#!/usr/bin/env python3\r\n\"\"\"\r\nWorker for distributed tf-idf feature extraction.\r\nReceives chunks from coordinator, computes tf-idf, sends results back.\r\n\"\"\"\r\nimport pickle\r\nimport sys\r\nimport zmq\r\nimport pandas as pd\r\nfrom sklearn.feature_extraction.text import TfidfVectorizer\r\n\r\ndef main():\r\n    worker_id = sys.argv[1] if len(sys.argv) > 1 else \"0\"\r\n\r\n    context = zmq.Context()\r\n\r\n    # Socket to receive work from coordinator\r\n    receiver = context.socket(zmq.PULL)\r\n    receiver.connect(\"tcp://127.0.0.1:5557\")\r\n\r\n    # Socket to send results to coordinator\r\n    sender = context.socket(zmq.PUSH)\r\n    sender.connect(\"tcp://127.0.0.1:5558\")\r\n\r\n    print(f\"Worker {worker_id}: Started and connected\")\r\n\r\n    chunks_processed = 0\r\n\r\n    # BUG: Each worker creates its own vectorizer with its own vocabulary\r\n    vectorizer = TfidfVectorizer(max_features=100)\r\n\r\n    while True:"]
[35.649951, "o", "\r\n        try:\r\n            msg = receiver.recv()\r\n            chunk_id, chunk_df = pickle.loads(msg)\r\n\r\n            print(f\"Worker {worker_id}: Processing chunk {chunk_id}\")\r\n\r\n            # Compute tf-idf (BUG: fitting on each chunk independently)\r\n            texts = chunk_df[\"text\"].tolist()\r\n            tfidf_matrix = vectorizer.fit_transform(texts)\r\n\r\n            # Convert to DataFrame with feature names as columns\r\n            feature_names = vectorizer.get_feature_names_out()\r\n            result_df = pd.DataFrame(\r\n                tfidf_matrix.toarray(),\r\n                columns=feature_names\r\n            )\r\n\r\n            # Send result back\r\n            result_msg = pickle.dumps((chunk_id, result_df))\r\n            sender.send(result_msg)\r\n\r\n            chunks_processed += 1\r\n            print(f\"Worker {worker_id}: Processed chunk {chunk_id} (total: {chunks_processed})\")\r\n\r\n        except Exception as e:\r\n            print(f\"Worker {worker_id}: Error: {e}\")\r\n            break\r\n\r\n    receiver.close()\r\n "]
[35.649983, "o", "   sender.close()\r\n    context.term()\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[35.650146, "o", "\u001b[?2004h"]
[35.65018, "o", "I have no name!@199a2e4cfacc:~/pipeline$ "]
[43.902277, "i", "cat run.sh\n"]
[43.902395, "o", "cat run.sh\r\n\u001b[?2004l\r"]
[43.903179, "o", "#!/bin/bash\r\n# Run the distributed feature extraction pipeline\r\n\r\ncd /home/user/pipeline\r\n\r\n# Start coordinator in background\r\npython3 coordinator.py &\r\nCOORD_PID=$!\r\n\r\n# Start 3 workers\r\npython3 worker.py 1 &\r\nWORKER1_PID=$!\r\npython3 worker.py 2 &\r\nWORKER2_PID=$!\r\npython3 worker.py 3 &\r\nWORKER3_PID=$!\r\n\r\n# Wait for coordinator to finish\r\nwait $COORD_PID\r\nCOORD_EXIT=$?\r\n\r\n# Kill workers (they spin forever waiting for more work)\r\nkill $WORKER1_PID $WORKER2_PID $WORKER3_PID 2>/dev/null\r\n\r\nexit $COORD_EXIT\r\n"]
[43.903356, "o", "\u001b[?2004hI have no name!@199a2e4cfacc:~/pipeline$ "]
[50.510432, "i", "cp coordinator.py coordinator.py.bak\n"]
[50.510579, "o", "cp coordinator.py coordinator.py.bak\r\n\u001b[?2004l\r"]
[50.515283, "o", "\u001b[?2004hI have no name!@199a2e4cfacc:~/pipeline$ "]
[50.617156, "i", "cp worker.py worker.py.bak\n"]
