[67.053965, "o", "    # Send all chunks\r\n\u001b[?2004l\r"]
[67.053992, "o", "\u001b[?2004h> "]
[67.054175, "o", "    print(f\"Coordinator: Sending {num_chunks} chunks to workers\")\r\n\u001b[?2004l\r"]
[67.054201, "o", "\u001b[?2004h> "]
[67.054331, "o", "    for chunk_id, chunk in enumerate(chunks):\r\n\u001b[?2004l\r"]
[67.054357, "o", "\u001b[?2004h> "]
[67.054518, "o", "        msg = pickle.dumps((\"CHUNK\", chunk_id, chunk))\r\n\u001b[?2004l\r"]
[67.054549, "o", "\u001b[?2004h> "]
[67.054611, "o", "        sender.send(msg)\r\n\u001b[?2004l\r"]
[67.054643, "o", "\u001b[?2004h> "]
[67.054791, "o", "        print(f\"Coordinator: Sent chunk {chunk_id}\")\r\n\u001b[?2004l\r"]
[67.054844, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[67.054877, "o", "> "]
[67.054994, "o", "    # Send termination signals (one per worker)\r\n\u001b[?2004l\r"]
[67.055018, "o", "\u001b[?2004h> "]
[67.055182, "o", "    print(\"Coordinator: Sending termination signals...\")\r\n\u001b[?2004l\r"]
[67.055223, "o", "\u001b[?2004h> "]
[67.055276, "o", "    for i in range(3):\r\n\u001b[?2004l\r"]
[67.055303, "o", "\u001b[?2004h> "]
[67.055459, "o", "        sender.send(pickle.dumps((\"DONE\", None, None)))\r\n\u001b[?2004l\r"]
[67.055486, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.055522, "o", "\u001b[?2004h> "]
[67.055683, "o", "    # FIX: Collect results using dict to track by chunk_id\r\n\u001b[?2004l\r"]
[67.05571, "o", "\u001b[?2004h> "]
[67.055761, "o", "    results = {}\r\n\u001b[?2004l\r"]
[67.055786, "o", "\u001b[?2004h"]
[67.055814, "o", "> "]
[67.055984, "o", "    receiver.setsockopt(zmq.RCVTIMEO, 10000)  # 10 second timeout\r\n\u001b[?2004l\r"]
[67.056012, "o", "\u001b[?2004h> "]
[67.056039, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.056067, "o", "> "]
[67.056224, "o", "    print(f\"Coordinator: Waiting for {num_chunks} results...\")\r\n\u001b[?2004l\r"]
[67.05625, "o", "\u001b[?2004h> "]
[67.056354, "o", "    while len(results) < num_chunks:\r\n\u001b[?2004l\r"]
[67.056382, "o", "\u001b[?2004h> "]
[67.056422, "o", "        try:\r\n\u001b[?2004l\r"]
[67.056448, "o", "\u001b[?2004h> "]
[67.056544, "o", "            msg = receiver.recv()\r\n\u001b[?2004l\r"]
[67.05657, "o", "\u001b[?2004h> "]
[67.05672, "o", "            chunk_id, result_df = pickle.loads(msg)\r\n\u001b[?2004l\r"]
[67.056753, "o", "\u001b[?2004h> "]
[67.056877, "o", "            results[chunk_id] = result_df\r\n\u001b[?2004l\r"]
[67.056907, "o", "\u001b[?2004h> "]
[67.057181, "o", "            print(f\"Coordinator: Received result for chunk {chunk_id} ({len(results)}/{num_chunks})\")\r\n\u001b[?2004l\r"]
[67.057205, "o", "\u001b[?2004h> "]
[67.057282, "o", "        except zmq.Again:\r\n\u001b[?2004l\r"]
[67.057312, "o", "\u001b[?2004h> "]
[67.057557, "o", "            print(f\"Coordinator: Timeout - received {len(results)}/{num_chunks} chunks\")\r\n\u001b[?2004l\r"]
[67.057591, "o", "\u001b[?2004h> "]
[67.057649, "o", "            break\r\n\u001b[?2004l\r"]
[67.057675, "o", "\u001b[?2004h> "]
[67.057702, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.05773, "o", "> "]
[67.057807, "o", "    # Check if we got all results\r\n\u001b[?2004l\r"]
[67.057847, "o", "\u001b[?2004h> "]
[67.057947, "o", "    if len(results) < num_chunks:\r\n\u001b[?2004l\r"]
[67.057974, "o", "\u001b[?2004h> "]
[67.058193, "o", "        print(f\"WARNING: Only received {len(results)} of {num_chunks} chunks!\")\r\n\u001b[?2004l\r"]
[67.05822, "o", "\u001b[?2004h> "]
[67.058398, "o", "        missing = set(range(num_chunks)) - set(results.keys())\r\n\u001b[?2004l\r"]
[67.058422, "o", "\u001b[?2004h"]
[67.058457, "o", "> "]
[67.058571, "o", "        print(f\"Missing chunks: {sorted(missing)}\")\r\n\u001b[?2004l\r"]
[67.058599, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[67.058628, "o", "\u001b[?2004h> "]
[67.058758, "o", "    # FIX: Aggregate results in correct order\r\n\u001b[?2004l\r"]
[67.058786, "o", "\u001b[?2004h> "]
[67.058847, "o", "    if results:\r\n\u001b[?2004l\r"]
[67.058878, "o", "\u001b[?2004h> "]
[67.059069, "o", "        ordered_results = [results[i] for i in sorted(results.keys())]\r\n\u001b[?2004l\r"]
[67.059095, "o", "\u001b[?2004h> "]
[67.059276, "o", "        final_df = pd.concat(ordered_results, ignore_index=True)\r\n\u001b[?2004l\r"]
[67.059302, "o", "\u001b[?2004h"]
[67.05933, "o", "> "]
[67.059485, "o", "        final_df.to_parquet(\"/home/user/data/features.parquet\")\r\n\u001b[?2004l\r"]
[67.059511, "o", "\u001b[?2004h> "]
[67.059725, "o", "        print(f\"Coordinator: Saved {len(final_df)} rows to features.parquet\")\r\n\u001b[?2004l\r"]
[67.059752, "o", "\u001b[?2004h"]
[67.05978, "o", ">         \r\n"]
[67.059808, "o", "\u001b[?2004l\r\u001b[?2004h"]
[67.059848, "o", "> "]
[67.059893, "o", "        # Verify values\r\n\u001b[?2004l\r"]
[67.05992, "o", "\u001b[?2004h> "]
[67.060035, "o", "        max_val = final_df.values.max()\r\n\u001b[?2004l\r"]
[67.060061, "o", "\u001b[?2004h"]
[67.060088, "o", "> "]
[67.060177, "o", "        min_val = final_df.values.min()\r\n\u001b[?2004l\r"]
[67.060204, "o", "\u001b[?2004h> "]
[67.06039, "o", "        print(f\"Coordinator: Value range: [{min_val}, {max_val}]\")\r\n\u001b[?2004l\r"]
[67.060417, "o", "\u001b[?2004h> "]
[67.060453, "o", "    else:\r\n\u001b[?2004l\r"]
[67.060482, "o", "\u001b[?2004h> "]
[67.060627, "o", "        print(\"Coordinator: No results received!\")\r\n\u001b[?2004l\r"]
[67.060655, "o", "\u001b[?2004h> "]
[67.060682, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.060709, "o", "> "]
[67.060748, "o", "    sender.close()\r\n\u001b[?2004l\r"]
[67.060775, "o", "\u001b[?2004h> "]
[67.060852, "o", "    receiver.close()\r\n\u001b[?2004l\r"]
[67.060882, "o", "\u001b[?2004h> "]
[67.060936, "o", "    context.term()\r\n\u001b[?2004l\r"]
[67.060963, "o", "\u001b[?2004h> "]
[67.060992, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.061019, "o", "> "]
[67.061075, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[67.061101, "o", "\u001b[?2004h"]
[67.061129, "o", "> "]
[67.061158, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.061185, "o", "> EOF\r\n\u001b[?2004l\r"]
[67.06348, "o", "\u001b[?2004h"]
[67.063514, "o", "I have no name!@199a2e4cfacc:~/pipeline$ "]
[81.955374, "i", "cat > worker.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nWorker for distributed tf-idf feature extraction.\nReceives chunks from coordinator, computes tf-idf, sends results back.\n\"\"\"\nimport pickle\nimport sys\nimport zmq\nimport pandas as pd\n\ndef main():\n    worker_id = sys.argv[1] if len(sys.argv) > 1 else \"0\"\n\n    context = zmq.Context()\n\n    # Socket to receive work from coordinator\n    receiver = context.socket(zmq.PULL)\n    receiver.connect(\"tcp://127.0.0.1:5557\")\n\n    # Socket to send results to coordinator\n    sender = context.socket(zmq.PUSH)\n    sender.connect(\"tcp://127.0.0.1:5558\")\n\n    print(f\"Worker {worker_id}: Started and connected\")\n\n    # FIX: Wait for fitted vectorizer from coordinator\n    print(f\"Worker {worker_id}: Waiting for vectorizer...\")\n    msg = receiver.recv()\n    msg_type, vectorizer = pickle.loads(msg)\n    \n    if msg_type != \"VECTORIZER\":\n        print(f\"Worker {worker_id}: ERROR - Expected VECTORIZER, got {msg_type}\")\n        return\n    \n    print(f\"Worker {worker_id}: Received fitted v"]
[81.955492, "i", "ectorizer with {len(vectorizer.vocabulary_)} terms\")\n\n    chunks_processed = 0\n\n    # Process chunks until DONE signal\n    while True:\n        try:\n            msg = receiver.recv()\n            msg_type, chunk_id, chunk_df = pickle.loads(msg)\n\n            if msg_type == \"DONE\":\n                print(f\"Worker {worker_id}: Received termination signal, exiting\")\n                break\n\n            if msg_type != \"CHUNK\":\n                print(f\"Worker {worker_id}: Unknown message type: {msg_type}\")\n                continue\n\n            print(f\"Worker {worker_id}: Processing chunk {chunk_id}\")\n\n            # FIX: Use transform() only, not fit_transform()\n            texts = chunk_df[\"text\"].tolist()\n            tfidf_matrix = vectorizer.transform(texts)\n\n            # Convert to DataFrame with feature names as columns\n            feature_names = vectorizer.get_feature_names_out()\n            result_df = pd.DataFrame(\n                tfidf_matrix.toarray(),\n                columns=feature_names\n            )\n\n     "]
[81.955534, "o", "cat > worker.py << 'EOF'\r\n\u001b[?2004l\r"]
[81.955576, "i", "       # Send result back\n            result_msg = pickle.dumps((chunk_id, result_df))\n            sender.send(result_msg)\n\n            chunks_processed += 1\n            print(f\"Worker {worker_id}: Processed chunk {chunk_id} (total: {chunks_processed})\")\n\n        except Exception as e:\n            print(f\"Worker {worker_id}: Error: {e}\")\n            import traceback\n            traceback.print_exc()\n            break\n\n    print(f\"Worker {worker_id}: Shutting down after processing {chunks_processed} chunks\")\n    receiver.close()\n    sender.close()\n    context.term()\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
[81.955593, "o", "\u001b[?2004h> "]
