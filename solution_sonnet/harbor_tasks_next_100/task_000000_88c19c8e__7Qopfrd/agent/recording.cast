[50.618691, "o", "\u001b[?2004hI have no name!@199a2e4cfacc:~/pipeline$ "]
[67.047367, "i", "cat > coordinator.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nCoordinator for distributed tf-idf feature extraction.\nPushes chunks to workers via ZeroMQ, collects results, aggregates.\n\"\"\"\nimport pickle\nimport time\nimport zmq\nimport pandas as pd\nfrom sklearn.feature_extraction.text import TfidfVectorizer\n\ndef main():\n    context = zmq.Context()\n\n    # Socket to send work to workers\n    sender = context.socket(zmq.PUSH)\n    sender.bind(\"tcp://127.0.0.1:5557\")\n\n    # Socket to receive results from workers\n    receiver = context.socket(zmq.PULL)\n    receiver.bind(\"tcp://127.0.0.1:5558\")\n\n    # Load data\n    df = pd.read_parquet(\"/home/user/data/raw.parquet\")\n    print(f\"Coordinator: Loaded {len(df)} rows\")\n\n    # FIX: Fit vectorizer on ALL data to build unified vocabulary\n    print(\"Coordinator: Fitting vectorizer on all data...\")\n    vectorizer = TfidfVectorizer(max_features=100)\n    texts = df[\"text\"].tolist()\n    vectorizer.fit(texts)\n    print(f\"Coordinator: Vocabulary built with {len(vectorizer.vocabulary_)} term"]
[67.047487, "i", "s\")\n\n    # Split into chunks of 1000 rows\n    chunk_size = 1000\n    chunks = [df.iloc[i:i+chunk_size] for i in range(0, len(df), chunk_size)]\n    num_chunks = len(chunks)\n\n    print(f\"Coordinator: Prepared {num_chunks} chunks\")\n\n    # FIX: Wait for workers to connect\n    print(\"Coordinator: Waiting 2 seconds for workers to connect...\")\n    time.sleep(2)\n\n    # FIX: Send fitted vectorizer to each worker (send 3 times for 3 workers)\n    print(\"Coordinator: Sending fitted vectorizer to workers...\")\n    vectorizer_msg = pickle.dumps((\"VECTORIZER\", vectorizer))\n    for i in range(3):\n        sender.send(vectorizer_msg)\n    time.sleep(0.5)  # Let workers receive and process\n\n    # Send all chunks\n    print(f\"Coordinator: Sending {num_chunks} chunks to workers\")\n    for chunk_id, chunk in enumerate(chunks):\n        msg = pickle.dumps((\"CHUNK\", chunk_id, chunk))\n        sender.send(msg)\n        print(f\"Coordinator: Sent chunk {chunk_id}\")\n\n    # Send termination signals (one per worker)\n    print(\"Coordinator: Sendin"]
[67.047532, "o", "cat > coordinator.py << 'EOF'\r\n\u001b[?2004l\r"]
[67.047571, "i", "g termination signals...\")\n    for i in range(3):\n        sender.send(pickle.dumps((\"DONE\", None, None)))\n\n    # FIX: Collect results using dict to track by chunk_id\n    results = {}\n    receiver.setsockopt(zmq.RCVTIMEO, 10000)  # 10 second timeout\n\n    print(f\"Coordinator: Waiting for {num_chunks} results...\")\n    while len(results) < num_chunks:\n        try:\n            msg = receiver.recv()\n            chunk_id, result_df = pickle.loads(msg)\n            results[chunk_id] = result_df\n            print(f\"Coordinator: Received result for chunk {chunk_id} ({len(results)}/{num_chunks})\")\n        except zmq.Again:\n            print(f\"Coordinator: Timeout - received {len(results)}/{num_chunks} chunks\")\n            break\n\n    # Check if we got all results\n    if len(results) < num_chunks:\n        print(f\"WARNING: Only received {len(results)} of {num_chunks} chunks!\")\n        missing = set(range(num_chunks)) - set(results.keys())\n        print(f\"Missing chunks: {sorted(missing)}\")\n\n    # FIX: Aggregate results in c"]
[67.047589, "o", "\u001b[?2004h> "]
[67.047637, "i", "orrect order\n    if results:\n        ordered_results = [results[i] for i in sorted(results.keys())]\n        final_df = pd.concat(ordered_results, ignore_index=True)\n        final_df.to_parquet(\"/home/user/data/features.parquet\")\n        print(f\"Coordinator: Saved {len(final_df)} rows to features.parquet\")\n        \n        # Verify values\n        max_val = final_df.values.max()\n        min_val = final_df.values.min()\n        print(f\"Coordinator: Value range: [{min_val}, {max_val}]\")\n    else:\n        print(\"Coordinator: No results received!\")\n\n    sender.close()\n    receiver.close()\n    context.term()\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
