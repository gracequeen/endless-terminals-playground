[130.552715, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Load the distributed output\ndf = pd.read_parquet('features.parquet')\n\nprint(f\"Row count: {len(df)}\")\nprint(f\"Column count: {len(df.columns)}\")\nprint(f\"Columns: {list(df.columns)[:10]}...\")  # Show first 10 feature names\n\n# Check value ranges\nmin_val = df.values.min()\nmax_val = df.values.max()\nprint(f\"\\nValue range: [{min_val}, {max_val}]\")\n\n# Verify all values are valid\nif min_val < 0:\n    print(\"ERROR: Found negative tf-idf values!\")\nelse:\n    print(\"✓ All values >= 0\")\n\nif max_val > 1.0:\n    print(\"ERROR: Found tf-idf values > 1!\")\nelse:\n    print(\"✓ All values <= 1\")\n\n# Check for NaN values\nnan_count = df.isna().sum().sum()\nprint(f\"\\nNaN count: {nan_count}\")\n\n# Show sample statistics\nprint(f\"\\nSample statistics:\")\nprint(f\"Mean: {df.values.mean():.6f}\")\nprint(f\"Std: {df.values.std():.6f}\")\nprint(f\"Non-zero values: {np.count_nonzero(df.values)} / {df.size} ({100*np.count_nonzero(df.values)/df.size:.2f}%)\")\n\nprint(\"\\n✓ Distributed pipeline outpu"]
[130.552879, "i", "t looks correct!\")\nEOF\n"]
[130.552924, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.552981, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[130.553013, "o", "\u001b[?2004h> "]
[130.553064, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[130.553098, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[130.553127, "o", "\u001b[?2004h> "]
[130.553216, "o", "# Load the distributed output\r\n\u001b[?2004l\r"]
[130.553243, "o", "\u001b[?2004h> "]
[130.553355, "o", "df = pd.read_parquet('features.parquet')\r\n\u001b[?2004l\r"]
