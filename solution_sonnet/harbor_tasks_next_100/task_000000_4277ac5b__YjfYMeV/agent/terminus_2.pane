[?2004huser@6fceb5742f3f:~/webhooks$ cat validator.py
[?2004l#!/usr/bin/env python3
import json
import sys
import jsonschema
from jsonschema import validate, ValidationError

def main():
    if len(sys.argv) != 2:
        print("Usage: validator.py <json_file>", file=sys.stderr)
        sys.exit(1)

    json_file = sys.argv[1]
    schema_file = "/home/user/webhooks/schema.json"

    try:
        with open(schema_file, 'r') as f:
            schema = json.load(f)
    except Exception as e:
        print(f"Error loading schema: {e}", file=sys.stderr)
        sys.exit(1)

    try:
        with open(json_file, 'r') as f:
            data = json.load(f)
    except Exception as e:
        print(f"Error loading JSON file: {e}", file=sys.stderr)
        sys.exit(1)

    try:
        validate(instance=data, schema=schema)
        print("Validation successful")
        sys.exit(0)
    except ValidationError as e:
        print(f"Validation failed: {e.message}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
