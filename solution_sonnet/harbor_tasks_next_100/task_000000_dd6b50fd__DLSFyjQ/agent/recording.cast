[99.702767, "i", "python3 << 'PYEOF'\nwith open('templates/report.md.j2', 'r') as f:\n    lines = f.readlines()\n\n# Find and fix the split line (lines 13 and 14, 0-indexed)\nif len(lines) > 14:\n    # Join line 13 and 14, removing the newline\n    lines[13] = lines[13].rstrip('\\n') + ' ' + lines[14].lstrip()\n    # Remove the now-duplicate line 14\n    del lines[14]\n\nwith open('templates/report.md.j2', 'w') as f:\n    f.writelines(lines)\n\nprint('Template fixed')\nPYEOF\n"]
