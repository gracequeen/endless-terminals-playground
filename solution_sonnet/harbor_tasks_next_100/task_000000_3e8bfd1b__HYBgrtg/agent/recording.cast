[23.725056, "o", "# Makefile for data pipeline automation\r\n\r\n# Directories\r\nRAW_DIR := raw\r\nCLEANED_DIR := cleaned\r\nFINAL_DIR := final\r\n\r\n# Find all CSV files in raw/\r\nRAW_CSVS := $(wildcard $(RAW_DIR)/*.csv)\r\n\r\n# Generate cleaned file names\r\nCLEANED_CSVS := $(patsubst $(RAW_DIR)/%.csv,$(CLEANED_DIR)/%.csv,$(RAW_CSVS))\r\n\r\n# Final output\r\nSUMMARY := $(FINAL_DIR)/summary.csv\r\n\r\n# Default target\r\n.PHONY: all\r\nall: $(SUMMARY)\r\n\r\n# Rule to create summary by aggregating all cleaned CSVs\r\n$(SUMMARY): $(CLEANED_CSVS) aggregate.py\r\n@echo \"Aggregating cleaned files...\"\r\npython3 aggregate.py"]
[23.725143, "o", "\r\n\r\n# Pattern rule to clean individual CSV files\r\n$(CLEANED_DIR)/%.csv: $(RAW_DIR)/%.csv clean.py\r\n@echo \"Cleaning $<...\"\r\npython3 clean.py $< $@\r\n\r\n# Clean up generated files\r\n.PHONY: clean\r\nclean:\r\n@echo \"Removing generated files...\"\r\nrm -f $(CLEANED_DIR)/*.csv\r\nrm -f $(SUMMARY)\r\n\r\n"]
