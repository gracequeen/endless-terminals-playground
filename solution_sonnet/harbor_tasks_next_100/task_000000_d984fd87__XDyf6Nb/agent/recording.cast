[165.103109, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[165.103144, "o", "> "]
[165.103242, "o", "EXPERIMENTS_DIR = Path(\"/data/experiments\")\r\n\u001b[?2004l\r"]
[165.103275, "o", "\u001b[?2004h> "]
[165.103331, "o", "RETENTION_DAYS = 30\r\n\u001b[?2004l\r"]
[165.103413, "o", "\u001b[?2004h"]
[165.103453, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.103521, "o", "def get_run_created_at(run_path):\r\n\u001b[?2004l\r"]
[165.103554, "o", "\u001b[?2004h> "]
[165.103732, "o", "    \"\"\"Read the created_at timestamp from metadata.json.\"\"\"\r\n\u001b[?2004l\r"]
[165.103763, "o", "\u001b[?2004h> "]
[165.103893, "o", "    metadata_path = run_path / \"metadata.json\"\r\n\u001b[?2004l\r"]
[165.103925, "o", "\u001b[?2004h> "]
[165.104037, "o", "    if not metadata_path.exists():\r\n\u001b[?2004l\r"]
[165.104072, "o", "\u001b[?2004h> "]
[165.104125, "o", "        return None\r\n\u001b[?2004l\r"]
[165.104156, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[165.104198, "o", "\u001b[?2004h> "]
[165.104232, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.104262, "o", "> "]
[165.104354, "o", "        with open(metadata_path) as f:\r\n\u001b[?2004l\r"]
[165.104385, "o", "\u001b[?2004h> "]
[165.104474, "o", "            data = json.load(f)\r\n\u001b[?2004l\r"]
[165.10451, "o", "\u001b[?2004h> "]
[165.104639, "o", "        created_at_str = data.get(\"created_at\")\r\n\u001b[?2004l\r"]
[165.104672, "o", "\u001b[?2004h> "]
[165.104756, "o", "        if not created_at_str:\r\n\u001b[?2004l\r"]
[165.104793, "o", "\u001b[?2004h> "]
[165.104852, "o", "            return None\r\n\u001b[?2004l\r"]
[165.10488, "o", "\u001b[?2004h> "]
[165.105077, "o", "        # Parse ISO format timestamp, handle 'Z' suffix for UTC\r\n\u001b[?2004l\r"]
[165.105108, "o", "\u001b[?2004h> "]
[165.105282, "o", "        created_at_str = created_at_str.replace('Z', '+00:00')\r\n\u001b[?2004l\r"]
[165.105311, "o", "\u001b[?2004h> "]
[165.105458, "o", "        dt = datetime.fromisoformat(created_at_str)\r\n\u001b[?2004l\r"]
[165.105488, "o", "\u001b[?2004h> "]
[165.105684, "o", "        # Strip timezone info for comparison with naive datetime.now()\r\n\u001b[?2004l\r"]
[165.105714, "o", "\u001b[?2004h> "]
[165.105824, "o", "        return dt.replace(tzinfo=None)\r\n\u001b[?2004l\r"]
[165.10586, "o", "\u001b[?2004h> "]
[165.105934, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[165.105983, "o", "\u001b[?2004h> "]
[165.106196, "o", "        logging.debug(f\"Could not parse metadata for {run_path}: {e}\")\r\n\u001b[?2004l\r"]
[165.106227, "o", "\u001b[?2004h> "]
[165.106287, "o", "        return None\r\n\u001b[?2004l\r"]
[165.106317, "o", "\u001b[?2004h> "]
[165.106348, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.106377, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.106407, "o", "> "]
[165.106476, "o", "def should_delete_run(run_path):\r\n\u001b[?2004l\r"]
[165.106503, "o", "\u001b[?2004h> "]
[165.106677, "o", "    \"\"\"Determine if a run should be deleted based on age.\"\"\"\r\n\u001b[?2004l\r"]
[165.106709, "o", "\u001b[?2004h> "]
[165.106838, "o", "    created_at = get_run_created_at(run_path)\r\n\u001b[?2004l\r"]
[165.106869, "o", "\u001b[?2004h> "]
[165.106946, "o", "    if created_at is None:\r\n\u001b[?2004l\r"]
[165.106992, "o", "\u001b[?2004h> "]
[165.107051, "o", "        return False\r\n\u001b[?2004l\r"]
[165.107082, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[165.107111, "o", "\u001b[?2004h> "]
[165.107142, "o", "    try:\r\n\u001b[?2004l\r"]
[165.107171, "o", "\u001b[?2004h> "]
[165.107353, "o", "        cutoff = datetime.now() - timedelta(days=RETENTION_DAYS)\r\n\u001b[?2004l\r"]
[165.107382, "o", "\u001b[?2004h> "]
[165.107483, "o", "        return created_at < cutoff\r\n\u001b[?2004l\r"]
[165.107516, "o", "\u001b[?2004h> "]
[165.107589, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[165.10762, "o", "\u001b[?2004h> "]
[165.107821, "o", "        logging.debug(f\"Could not compare dates for {run_path}: {e}\")\r\n\u001b[?2004l\r"]
[165.107855, "o", "\u001b[?2004h> "]
[165.107914, "o", "        return False\r\n\u001b[?2004l\r"]
[165.107947, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[165.107992, "o", "\u001b[?2004h> "]
[165.108023, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.108099, "o", "def delete_run(run_path):\r\n\u001b[?2004l\r"]
[165.108129, "o", "\u001b[?2004h> "]
[165.108228, "o", "    \"\"\"Delete a run directory.\"\"\"\r\n\u001b[?2004l\r"]
[165.10826, "o", "\u001b[?2004h> "]
[165.108288, "o", "    try:\r\n\u001b[?2004l\r"]
[165.108314, "o", "\u001b[?2004h"]
[165.108345, "o", "> "]
[165.108411, "o", "        shutil.rmtree(run_path)\r\n\u001b[?2004l\r"]
[165.108441, "o", "\u001b[?2004h> "]
[165.108569, "o", "        logging.info(f\"Deleted: {run_path}\")\r\n\u001b[?2004l\r"]
[165.108602, "o", "\u001b[?2004h> "]
[165.108658, "o", "        return True\r\n\u001b[?2004l\r"]
[165.108686, "o", "\u001b[?2004h> "]
[165.108766, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[165.108794, "o", "\u001b[?2004h> "]
[165.108979, "o", "        logging.error(f\"Failed to delete {run_path}: {e}\")\r\n\u001b[?2004l\r"]
[165.109013, "o", "\u001b[?2004h> "]
[165.109073, "o", "        return False\r\n\u001b[?2004l\r"]
[165.109107, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[165.109139, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[165.109172, "o", "\u001b[?2004h> "]
[165.109203, "o", "def main():\r\n"]
[165.109237, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[165.109375, "o", "    \"\"\"Main entry point for the purge script.\"\"\"\r\n\u001b[?2004l\r"]
[165.109408, "o", "\u001b[?2004h> "]
[165.109568, "o", "    logging.info(\"Starting purge of old experiment runs\")\r\n\u001b[?2004l\r"]
[165.109601, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[165.109632, "o", "\u001b[?2004h> "]
[165.109696, "o", "    deleted_count = 0\r\n\u001b[?2004l\r"]
[165.109727, "o", "\u001b[?2004h> "]
[165.109793, "o", "    processed_count = 0\r\n\u001b[?2004l\r"]
[165.109824, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[165.109854, "o", "\u001b[?2004h> "]
[165.110013, "o", "    for project_dir in EXPERIMENTS_DIR.iterdir():\r\n\u001b[?2004l\r"]
[165.110048, "o", "\u001b[?2004h> "]
[165.110146, "o", "        if not project_dir.is_dir():\r\n\u001b[?2004l\r"]
[165.110178, "o", "\u001b[?2004h> "]
[165.11024, "o", "            continue\r\n\u001b[?2004l\r"]
[165.110272, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[165.110301, "o", "\u001b[?2004h> "]
[165.11043, "o", "        for run_dir in project_dir.iterdir():\r\n\u001b[?2004l\r"]
[165.110459, "o", "\u001b[?2004h> "]
[165.11067, "o", "            if not run_dir.is_dir() or not run_dir.name.startswith(\"run_\"):\r\n\u001b[?2004l\r"]
[165.110703, "o", "\u001b[?2004h> "]
[165.110771, "o", "                continue\r\n\u001b[?2004l\r"]
[165.1108, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[165.110831, "o", "\u001b[?2004h> "]
[165.110925, "o", "            processed_count += 1\r\n\u001b[?2004l\r"]
[165.110966, "o", "\u001b[?2004h> "]
[165.111108, "o", "            logging.info(f\"Processing {run_dir}\")\r\n\u001b[?2004l\r"]
[165.111136, "o", "\u001b[?2004h> "]
[165.111169, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.111292, "o", "            if should_delete_run(run_dir):\r\n\u001b[?2004l\r"]
[165.111325, "o", "\u001b[?2004h> "]
[165.111433, "o", "                if delete_run(run_dir):\r\n\u001b[?2004l\r"]
[165.111466, "o", "\u001b[?2004h> "]
[165.111572, "o", "                    deleted_count += 1\r\n\u001b[?2004l\r"]
[165.111604, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[165.111631, "o", "\u001b[?2004h> "]
[165.111904, "o", "    logging.info(f\"Purge complete. Processed: {processed_count}, Deleted: {deleted_count}\")\r\n\u001b[?2004l\r"]
[165.11194, "o", "\u001b[?2004h> "]
[165.111993, "o", "    return 0\r\n\u001b[?2004l\r"]
[165.112021, "o", "\u001b[?2004h"]
[165.112054, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.112081, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.112112, "o", "> "]
[165.112168, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[165.112194, "o", "\u001b[?2004h> "]
[165.112248, "o", "    exit(main())\r\n\u001b[?2004l\r"]
[165.112281, "o", "\u001b[?2004h> "]
[165.112309, "o", "EOF\r\n\u001b[?2004l\r"]
[165.115067, "o", "\u001b[?2004h"]
