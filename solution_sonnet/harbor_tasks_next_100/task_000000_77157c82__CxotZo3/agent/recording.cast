[84.882501, "o", "import re\r\n\u001b[?2004l\r"]
[84.882543, "o", "\u001b[?2004h> "]
[84.882594, "o", "import os\r\n\u001b[?2004l\r"]
[84.882636, "o", "\u001b[?2004h> "]
[84.882683, "o", "import yaml\r\n\u001b[?2004l\r"]
[84.882717, "o", "\u001b[?2004h"]
[84.882749, "o", "> "]
[84.882852, "o", "from configparser import ConfigParser\r\n\u001b[?2004l\r"]
[84.882886, "o", "\u001b[?2004h"]
[84.882924, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[84.882956, "o", "> "]
[84.883113, "o", "SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))\r\n\u001b[?2004l\r"]
[84.883154, "o", "\u001b[?2004h> "]
[84.883296, "o", "RAW_LOG = os.path.join(SCRIPT_DIR, 'raw.log')\r\n\u001b[?2004l\r"]
[84.88333, "o", "\u001b[?2004h> "]
[84.883532, "o", "PATTERNS_CONF = os.path.join(SCRIPT_DIR, 'patterns.conf')\r\n\u001b[?2004l\r"]
[84.883572, "o", "\u001b[?2004h> "]
[84.88374, "o", "ROUTING_YAML = os.path.join(SCRIPT_DIR, 'routing.yaml')\r\n\u001b[?2004l\r"]
[84.883783, "o", "\u001b[?2004h> "]
[84.883932, "o", "OUTPUT_DIR = os.path.join(SCRIPT_DIR, 'output')\r\n\u001b[?2004l\r"]
[84.883967, "o", "\u001b[?2004h> "]
[84.884003, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.884051, "o", "> \r\n\u001b[?2004l\r"]
[84.884093, "o", "\u001b[?2004h> "]
[84.884173, "o", "def load_patterns(conf_path):\r\n\u001b[?2004l\r"]
[84.884206, "o", "\u001b[?2004h"]
[84.884238, "o", "> "]
[84.884372, "o", "    \"\"\"Load regex patterns from patterns.conf\"\"\"\r\n\u001b[?2004l\r"]
[84.884406, "o", "\u001b[?2004h"]
[84.884441, "o", "> "]
[84.884528, "o", "    config = ConfigParser()\r\n\u001b[?2004l\r"]
[84.884562, "o", "\u001b[?2004h"]
[84.884594, "o", "> "]
[84.884669, "o", "    config.read(conf_path)\r\n\u001b[?2004l\r"]
[84.884702, "o", "\u001b[?2004h> "]
[84.884773, "o", "    patterns = {}\r\n\u001b[?2004l\r"]
[84.884806, "o", "\u001b[?2004h"]
[84.884845, "o", "> "]
[84.884946, "o", "    for section in config.sections():\r\n\u001b[?2004l\r"]
[84.884981, "o", "\u001b[?2004h> "]
[84.885085, "o", "        patterns[section] = {}\r\n\u001b[?2004l\r"]
[84.885118, "o", "\u001b[?2004h"]
[84.88515, "o", "> "]
[84.885295, "o", "        for key, value in config.items(section):\r\n\u001b[?2004l\r"]
[84.885329, "o", "\u001b[?2004h"]
[84.885362, "o", "> "]
[84.885517, "o", "            patterns[section][key.upper()] = value\r\n\u001b[?2004l\r"]
[84.885554, "o", "\u001b[?2004h> "]
[84.885627, "o", "    return patterns\r\n\u001b[?2004l\r"]
[84.885661, "o", "\u001b[?2004h"]
[84.885695, "o", "> \r\n\u001b[?2004l\r"]
[84.885728, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[84.885761, "o", "\u001b[?2004h> "]
[84.885861, "o", "def load_routing(yaml_path):\r\n\u001b[?2004l\r"]
[84.885895, "o", "\u001b[?2004h"]
[84.885928, "o", "> "]
[84.886055, "o", "    \"\"\"Load routing rules from routing.yaml\"\"\"\r\n\u001b[?2004l\r"]
[84.886089, "o", "\u001b[?2004h"]
[84.886122, "o", "> "]
[84.88622, "o", "    with open(yaml_path, 'r') as f:\r\n\u001b[?2004l\r"]
[84.886253, "o", "\u001b[?2004h> "]
[84.886364, "o", "        return yaml.safe_load(f)\r\n\u001b[?2004l\r"]
[84.886401, "o", "\u001b[?2004h> "]
[84.886436, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.886487, "o", "> \r\n\u001b[?2004l\r"]
[84.886521, "o", "\u001b[?2004h> "]
[84.88663, "o", "def get_severity(line, patterns):\r\n\u001b[?2004l\r"]
[84.886665, "o", "\u001b[?2004h"]
[84.886698, "o", "> "]
[84.886901, "o", "    \"\"\"Extract severity level from log line using regex patterns.\"\"\"\r\n\u001b[?2004l\r"]
[84.886934, "o", "\u001b[?2004h"]
[84.886966, "o", "> "]
[84.88711, "o", "    severity_patterns = patterns.get('severity', {})\r\n\u001b[?2004l\r"]
[84.887144, "o", "\u001b[?2004h"]
[84.887176, "o", "> "]
[84.887323, "o", "    for level, pattern in severity_patterns.items():\r\n\u001b[?2004l\r"]
[84.887355, "o", "\u001b[?2004h"]
[84.887388, "o", "> "]
[84.887504, "o", "        if re.match(pattern, line):\r\n\u001b[?2004l\r"]
[84.887558, "o", "\u001b[?2004h> "]
[84.887636, "o", "            return level\r\n\u001b[?2004l\r"]
[84.88767, "o", "\u001b[?2004h"]
[84.887702, "o", "> "]
[84.887746, "o", "    return None\r\n\u001b[?2004l\r"]
[84.887779, "o", "\u001b[?2004h"]
[84.887812, "o", "> \r\n\u001b[?2004l\r"]
[84.887845, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[84.887877, "o", "\u001b[?2004h> "]
[84.887992, "o", "def get_service(line, patterns):\r\n\u001b[?2004l\r"]
[84.888024, "o", "\u001b[?2004h"]
[84.888057, "o", "> "]
[84.888188, "o", "    \"\"\"Extract service name from log line.\"\"\"\r\n\u001b[?2004l\r"]
[84.888222, "o", "\u001b[?2004h"]
[84.888255, "o", "> "]
[84.888392, "o", "    service_patterns = patterns.get('service', {})\r\n\u001b[?2004l\r"]
[84.888426, "o", "\u001b[?2004h"]
[84.88847, "o", "> "]
[84.888631, "o", "    for service_name, pattern in service_patterns.items():\r\n\u001b[?2004l\r"]
[84.888666, "o", "\u001b[?2004h"]
[84.888703, "o", "> "]
[84.888803, "o", "        if re.search(pattern, line):\r\n\u001b[?2004l\r"]
[84.888839, "o", "\u001b[?2004h> "]
[84.888947, "o", "            return service_name\r\n\u001b[?2004l\r"]
[84.888983, "o", "\u001b[?2004h> "]
[84.88906, "o", "    return 'unknown'\r\n\u001b[?2004l\r"]
[84.889096, "o", "\u001b[?2004h> "]
[84.889131, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.889164, "o", "> \r\n\u001b[?2004l\r"]
[84.889198, "o", "\u001b[?2004h> "]
[84.889291, "o", "def classify_line(line):\r\n\u001b[?2004l\r"]
[84.889324, "o", "\u001b[?2004h> "]
[84.889366, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[84.889399, "o", "\u001b[?2004h"]
[84.889431, "o", "> "]
[84.88962, "o", "    Classify a log line as structured (JSON-like) or plaintext.\r\n\u001b[?2004l\r"]
[84.889655, "o", "\u001b[?2004h"]
[84.889687, "o", "> "]
[84.889804, "o", "    Returns 'structured' or 'plaintext'.\r\n\u001b[?2004l\r"]
[84.889837, "o", "\u001b[?2004h"]
[84.889869, "o", "> "]
[84.889901, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[84.889935, "o", "\u001b[?2004h> "]
[84.890034, "o", "    # Check for actual JSON only\r\n\u001b[?2004l\r"]
[84.890067, "o", "\u001b[?2004h"]
[84.8901, "o", "> "]
[84.890175, "o", "    stripped = line.strip()\r\n\u001b[?2004l\r"]
[84.890207, "o", "\u001b[?2004h"]
[84.890239, "o", "> "]
[84.890401, "o", "    if stripped.startswith('{') and stripped.endswith('}'):\r\n\u001b[?2004l\r"]
[84.890434, "o", "\u001b[?2004h"]
[84.890478, "o", "> "]
[84.890554, "o", "        return 'structured'\r\n\u001b[?2004l\r"]
[84.890587, "o", "\u001b[?2004h"]
[84.89062, "o", "> "]
[84.890682, "o", "    return 'plaintext'\r\n\u001b[?2004l\r"]
[84.890715, "o", "\u001b[?2004h"]
[84.890746, "o", "> \r\n\u001b[?2004l\r"]
[84.890782, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[84.890814, "o", "\u001b[?2004h> "]
[84.890904, "o", "def normalize_line(line):\r\n\u001b[?2004l\r"]
[84.890937, "o", "\u001b[?2004h"]
[84.890969, "o", "> "]
[84.891142, "o", "    \"\"\"Normalize a log line by stripping control characters.\"\"\"\r\n\u001b[?2004l\r"]
[84.891175, "o", "\u001b[?2004h"]
[84.891208, "o", "> "]
[84.89133, "o", "    # Remove leading non-printable characters\r\n\u001b[?2004l\r"]
[84.891363, "o", "\u001b[?2004h"]
[84.891394, "o", "> "]
[84.891434, "o", "    result = []\r\n\u001b[?2004l\r"]
[84.891481, "o", "\u001b[?2004h"]
[84.891514, "o", "> "]
[84.891566, "o", "    started = False\r\n\u001b[?2004l\r"]
[84.891598, "o", "\u001b[?2004h"]
[84.891631, "o", "> "]
[84.891692, "o", "    for char in line:\r\n\u001b[?2004l\r"]
[84.891725, "o", "\u001b[?2004h"]
[84.891757, "o", "> "]
[84.891918, "o", "        if started or char.isprintable() or char in '\\t\\n':\r\n\u001b[?2004l\r"]
[84.891952, "o", "\u001b[?2004h"]
[84.891984, "o", "> "]
[84.89207, "o", "            result.append(char)\r\n\u001b[?2004l\r"]
[84.892103, "o", "\u001b[?2004h"]
[84.892135, "o", "> "]
[84.892209, "o", "            started = True\r\n\u001b[?2004l\r"]
[84.892241, "o", "\u001b[?2004h"]
[84.892274, "o", "> "]
[84.892346, "o", "    return ''.join(result)\r\n\u001b[?2004l\r"]
[84.892379, "o", "\u001b[?2004h"]
[84.892411, "o", "> \r\n\u001b[?2004l\r"]
[84.892469, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[84.892505, "o", "\u001b[?2004h> "]
[84.892673, "o", "def route_line(line, severity, service, routing_config):\r\n\u001b[?2004l\r"]
[84.892706, "o", "\u001b[?2004h"]
[84.892751, "o", "> "]
[84.892941, "o", "    \"\"\"Determine output file for a log line based on routing rules.\"\"\"\r\n\u001b[?2004l\r"]
[84.89298, "o", "\u001b[?2004h> "]
[84.89313, "o", "    rules = routing_config.get('rules', [])\r\n\u001b[?2004l\r"]
[84.893163, "o", "\u001b[?2004h"]
[84.893199, "o", "> "]
[84.893271, "o", "    for rule in rules:\r\n\u001b[?2004l\r"]
[84.893306, "o", "\u001b[?2004h> "]
[84.893449, "o", "        if rule.get('severity') == severity:\r\n\u001b[?2004l\r"]
[84.893498, "o", "\u001b[?2004h> "]
[84.893661, "o", "            return rule.get('output', 'default.log')\r\n\u001b[?2004l\r"]
[84.893696, "o", "\u001b[?2004h> "]
[84.893841, "o", "        if rule.get('service') == service:\r\n\u001b[?2004l\r"]
[84.893875, "o", "\u001b[?2004h> "]
[84.894039, "o", "            return rule.get('output', 'default.log')\r\n\u001b[?2004l\r"]
[84.894075, "o", "\u001b[?2004h"]
[84.894109, "o", "> "]
[84.894278, "o", "    return routing_config.get('default_output', 'default.log')\r\n\u001b[?2004l\r"]
[84.894313, "o", "\u001b[?2004h> "]
[84.894351, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.894385, "o", "> \r\n\u001b[?2004l\r"]
[84.89442, "o", "\u001b[?2004h> "]
[84.8945, "o", "def process_logs():\r\n\u001b[?2004l\r"]
[84.894537, "o", "\u001b[?2004h> "]
[84.89466, "o", "    \"\"\"Main processing function.\"\"\"\r\n\u001b[?2004l\r"]
[84.894693, "o", "\u001b[?2004h"]
[84.894726, "o", "> "]
[84.894847, "o", "    patterns = load_patterns(PATTERNS_CONF)\r\n\u001b[?2004l\r"]
[84.894881, "o", "\u001b[?2004h"]
[84.894915, "o", "> "]
[84.895023, "o", "    routing = load_routing(ROUTING_YAML)\r\n\u001b[?2004l\r"]
[84.895058, "o", "\u001b[?2004h> "]
[84.89509, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.895124, "o", "> "]
[84.895236, "o", "    # Ensure output directory exists\r\n\u001b[?2004l\r"]
[84.895271, "o", "\u001b[?2004h"]
[84.895303, "o", "> "]
[84.895418, "o", "    os.makedirs(OUTPUT_DIR, exist_ok=True)\r\n\u001b[?2004l\r"]
[84.895453, "o", "\u001b[?2004h> "]
[84.895503, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.895537, "o", "> "]
[84.895628, "o", "    # Open output file handles\r\n\u001b[?2004l\r"]
[84.895664, "o", "\u001b[?2004h> "]
[84.895744, "o", "    output_files = {}\r\n\u001b[?2004l\r"]
[84.89578, "o", "\u001b[?2004h> "]
[84.89582, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.895851, "o", "> "]
[84.89595, "o", "    with open(RAW_LOG, 'r') as f:\r\n\u001b[?2004l\r"]
[84.895983, "o", "\u001b[?2004h"]
[84.896017, "o", "> "]
[84.89608, "o", "        for line in f:\r\n\u001b[?2004l\r"]
[84.896113, "o", "\u001b[?2004h"]
[84.896147, "o", "> "]
[84.896245, "o", "            line = line.rstrip('\\n')\r\n\u001b[?2004l\r"]
[84.896279, "o", "\u001b[?2004h"]
[84.896314, "o", "> "]
[84.896383, "o", "            if not line:\r\n\u001b[?2004l\r"]
[84.896415, "o", "\u001b[?2004h"]
[84.896449, "o", "> "]
[84.89653, "o", "                continue\r\n\u001b[?2004l\r"]
[84.896565, "o", "\u001b[?2004h> "]
[84.896597, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.89663, "o", "> "]
[84.896729, "o", "            # Normalize the line\r\n\u001b[?2004l\r"]
[84.896761, "o", "\u001b[?2004h"]
[84.896796, "o", "> "]
[84.896918, "o", "            normalized = normalize_line(line)\r\n\u001b[?2004l\r"]
[84.896952, "o", "\u001b[?2004h"]
[84.896985, "o", "> \r\n\u001b[?2004l\r"]
[84.89702, "o", "\u001b[?2004h> "]
[84.897122, "o", "            # Classify line type\r\n\u001b[?2004l\r"]
[84.897155, "o", "\u001b[?2004h"]
[84.89719, "o", "> "]
[84.897343, "o", "            line_type = classify_line(normalized)\r\n\u001b[?2004l\r"]
[84.897376, "o", "\u001b[?2004h"]
[84.897411, "o", "> \r\n\u001b[?2004l\r"]
[84.897454, "o", "\u001b[?2004h> "]
[84.897587, "o", "            if line_type == 'structured':\r\n\u001b[?2004l\r"]
[84.89762, "o", "\u001b[?2004h"]
[84.897652, "o", "> "]
[84.897776, "o", "                # Route to structured.log\r\n\u001b[?2004l\r"]
[84.897808, "o", "\u001b[?2004h"]
[84.89784, "o", "> "]
[84.898037, "o", "                output_path = os.path.join(OUTPUT_DIR, 'structured.log')\r\n\u001b[?2004l\r"]
[84.898071, "o", "\u001b[?2004h"]
[84.898103, "o", "> "]
[84.898244, "o", "                if output_path not in output_files:\r\n\u001b[?2004l\r"]
[84.898277, "o", "\u001b[?2004h"]
[84.898308, "o", "> "]
[84.898528, "o", "                    output_files[output_path] = open(output_path, 'w')\r\n\u001b[?2004l\r"]
[84.898564, "o", "\u001b[?2004h> "]
[84.898749, "o", "                output_files[output_path].write(line + '\\n')\r\n\u001b[?2004l\r"]
[84.898784, "o", "\u001b[?2004h> "]
[84.898873, "o", "                continue\r\n\u001b[?2004l\r"]
[84.898908, "o", "\u001b[?2004h"]
[84.898942, "o", "> \r\n\u001b[?2004l\r"]
[84.898975, "o", "\u001b[?2004h> "]
[84.89909, "o", "            # Get severity and service\r\n\u001b[?2004l\r"]
[84.899123, "o", "\u001b[?2004h"]
[84.899156, "o", "> "]
[84.899325, "o", "            severity = get_severity(normalized, patterns)\r\n\u001b[?2004l\r"]
[84.899358, "o", "\u001b[?2004h"]
[84.899391, "o", "> "]
[84.899563, "o", "            service = get_service(normalized, patterns)\r\n\u001b[?2004l\r"]
[84.899598, "o", "\u001b[?2004h> "]
[84.899632, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.899666, "o", "> "]
[84.899772, "o", "            # Route based on rules\r\n\u001b[?2004l\r"]
[84.899806, "o", "\u001b[?2004h"]
[84.899837, "o", "> "]
[84.900066, "o", "            output_file = route_line(normalized, severity, service, routing)\r\n\u001b[?2004l\r"]
[84.900099, "o", "\u001b[?2004h"]
[84.900131, "o", "> "]
[84.900307, "o", "            output_path = os.path.join(OUTPUT_DIR, output_file)\r\n\u001b[?2004l\r"]
[84.900339, "o", "\u001b[?2004h"]
[84.900373, "o", "> \r\n\u001b[?2004l\r"]
[84.900409, "o", "\u001b[?2004h> "]
[84.90057, "o", "            if output_path not in output_files:\r\n\u001b[?2004l\r"]
[84.900604, "o", "\u001b[?2004h> "]
[84.900807, "o", "                output_files[output_path] = open(output_path, 'w')\r\n\u001b[?2004l\r"]
[84.900841, "o", "\u001b[?2004h"]
[84.900874, "o", "> \r\n\u001b[?2004l\r"]
[84.90091, "o", "\u001b[?2004h> "]
[84.901076, "o", "            output_files[output_path].write(line + '\\n')\r\n\u001b[?2004l\r"]
[84.901109, "o", "\u001b[?2004h> "]
[84.901141, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.901175, "o", "> "]
[84.901276, "o", "    # Close all output files\r\n\u001b[?2004l\r"]
[84.90131, "o", "\u001b[?2004h"]
[84.901342, "o", "> "]
[84.901442, "o", "    for f in output_files.values():\r\n\u001b[?2004l\r"]
[84.90149, "o", "\u001b[?2004h> "]
[84.901561, "o", "        f.close()\r\n\u001b[?2004l\r"]
[84.901594, "o", "\u001b[?2004h"]
