[140.054164, "o", "\u001b[?2004h> "]
[140.054257, "o", "    # Check for actual JSON only\r\n\u001b[?2004l\r"]
[140.054292, "o", "\u001b[?2004h> "]
[140.054365, "o", "    stripped = line.strip()\r\n\u001b[?2004l\r"]
