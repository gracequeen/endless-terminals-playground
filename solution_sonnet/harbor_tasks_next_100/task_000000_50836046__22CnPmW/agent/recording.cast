[32.14219, "o", "cp rules.conf rules.conf.bak\r\n\u001b[?2004l\r"]
[32.147444, "o", "\u001b[?2004hroot@ac85990d3a01:/home/user/firewall# "]
[32.242432, "i", "cat > rules.conf << 'EOF'\n# Default policies\ndefault_input: drop\ndefault_output: accept\n\n# Allow established connections\nallow in state established,related\n\n# SSH access\nallow in tcp 22 from any\n\n# Monitoring access - MUST come before broader deny rule\nallow in tcp 9100 from 10.80.4.0/24\n\n# Block known bad subnet\ndeny in from 10.80.0.0/16\n\n# Web traffic\nallow in tcp 80 from any\nallow in tcp 443 from any\nEOF\n"]
[32.242568, "o", "cat > rules.conf << 'EOF'\r\n"]
