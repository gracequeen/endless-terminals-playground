# Find all CSV files in raw/ directory
RAW_CSVS := $(wildcard raw/*.csv)
# Generate corresponding cleaned file names
CLEANED_CSVS := $(patsubst raw/%.csv,cleaned/%.csv,$(RAW_CSVS))

# Default target: build the final summary
.PHONY: all
all: final/summary.csv

# Rule to create final summary from all cleaned CSVs
final/summary.csv: $(CLEANED_CSVS)
@mkdir -p final
python3 aggregate.py

