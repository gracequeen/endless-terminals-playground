[96.386492, "o", "PATTERNS_CONF = os.path.join(SCRIPT_DIR, 'patterns.conf')\r\n\u001b[?2004l\r"]
[96.386527, "o", "\u001b[?2004h> "]
[96.386686, "o", "ROUTING_YAML = os.path.join(SCRIPT_DIR, 'routing.yaml')\r\n\u001b[?2004l\r"]
[96.386736, "o", "\u001b[?2004h"]
[96.386753, "o", "> "]
[96.386878, "o", "OUTPUT_DIR = os.path.join(SCRIPT_DIR, 'output')\r\n\u001b[?2004l\r"]
[96.386912, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.386942, "o", "\u001b[?2004h> "]
[96.386976, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.387053, "o", "def load_patterns(conf_path):\r\n\u001b[?2004l\r"]
[96.387084, "o", "\u001b[?2004h> "]
[96.387225, "o", "    \"\"\"Load regex patterns from patterns.conf\"\"\"\r\n\u001b[?2004l\r"]
[96.387259, "o", "\u001b[?2004h> "]
[96.38733, "o", "    config = ConfigParser()\r\n\u001b[?2004l\r"]
[96.387362, "o", "\u001b[?2004h> "]
[96.387437, "o", "    config.read(conf_path)\r\n\u001b[?2004l\r"]
[96.387469, "o", "\u001b[?2004h> "]
[96.387521, "o", "    patterns = {}\r\n\u001b[?2004l\r"]
[96.387552, "o", "\u001b[?2004h> "]
[96.387679, "o", "    for section in config.sections():\r\n\u001b[?2004l\r"]
[96.387713, "o", "\u001b[?2004h> "]
[96.387797, "o", "        patterns[section] = {}\r\n\u001b[?2004l\r"]
[96.387835, "o", "\u001b[?2004h"]
[96.387866, "o", "> "]
[96.387961, "o", "        for key, value in config.items(section):\r\n\u001b[?2004l\r"]
[96.387992, "o", "\u001b[?2004h> "]
[96.388134, "o", "            patterns[section][key.upper()] = value\r\n\u001b[?2004l\r"]
[96.38816, "o", "\u001b[?2004h> "]
[96.38822, "o", "    return patterns\r\n\u001b[?2004l\r"]
[96.38825, "o", "\u001b[?2004h"]
[96.388283, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.388314, "o", "\u001b[?2004h> "]
[96.388395, "o", "def load_routing(yaml_path):\r\n\u001b[?2004l\r"]
[96.388422, "o", "\u001b[?2004h> "]
[96.388555, "o", "    \"\"\"Load routing rules from routing.yaml\"\"\"\r\n\u001b[?2004l\r"]
[96.388586, "o", "\u001b[?2004h> "]
[96.388702, "o", "    with open(yaml_path, 'r') as f:\r\n\u001b[?2004l\r"]
[96.388738, "o", "\u001b[?2004h> "]
[96.388824, "o", "        return yaml.safe_load(f)\r\n\u001b[?2004l\r"]
[96.388849, "o", "\u001b[?2004h"]
[96.388875, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[96.388928, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.389012, "o", "def get_severity(line, patterns):\r\n\u001b[?2004l\r"]
[96.389042, "o", "\u001b[?2004h> "]
[96.389234, "o", "    \"\"\"Extract severity level from log line using regex patterns.\"\"\"\r\n\u001b[?2004l\r"]
[96.389268, "o", "\u001b[?2004h> "]
[96.38942, "o", "    severity_patterns = patterns.get('severity', {})\r\n\u001b[?2004l\r"]
[96.389444, "o", "\u001b[?2004h> "]
[96.389596, "o", "    for level, pattern in severity_patterns.items():\r\n\u001b[?2004l\r"]
[96.389633, "o", "\u001b[?2004h> "]
[96.38974, "o", "        if re.match(pattern, line):\r\n\u001b[?2004l\r"]
[96.389769, "o", "\u001b[?2004h> "]
[96.389843, "o", "            return level\r\n\u001b[?2004l\r"]
[96.389874, "o", "\u001b[?2004h> "]
[96.389915, "o", "    return None\r\n\u001b[?2004l\r"]
[96.389947, "o", "\u001b[?2004h> "]
[96.389978, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.39001, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.390103, "o", "def get_service(line, patterns):\r\n\u001b[?2004l\r"]
[96.390135, "o", "\u001b[?2004h> "]
[96.390261, "o", "    \"\"\"Extract service name from log line.\"\"\"\r\n\u001b[?2004l\r"]
[96.390292, "o", "\u001b[?2004h> "]
[96.390442, "o", "    service_patterns = patterns.get('service', {})\r\n\u001b[?2004l\r"]
[96.390475, "o", "\u001b[?2004h> "]
[96.390633, "o", "    for service_name, pattern in service_patterns.items():\r\n\u001b[?2004l\r"]
[96.390679, "o", "\u001b[?2004h> "]
[96.390782, "o", "        if re.search(pattern, line):\r\n\u001b[?2004l\r"]
[96.390812, "o", "\u001b[?2004h> "]
[96.390903, "o", "            return service_name\r\n\u001b[?2004l\r"]
[96.390933, "o", "\u001b[?2004h> "]
[96.390995, "o", "    return 'unknown'\r\n\u001b[?2004l\r"]
[96.391027, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.391057, "o", "\u001b[?2004h> "]
[96.391088, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.391161, "o", "def classify_line(line):\r\n\u001b[?2004l\r"]
[96.391192, "o", "\u001b[?2004h> "]
[96.391224, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[96.391255, "o", "\u001b[?2004h> "]
[96.391422, "o", "    Classify a log line as structured (JSON-like) or plaintext.\r\n\u001b[?2004l\r"]
[96.391454, "o", "\u001b[?2004h> "]
[96.391567, "o", "    Returns 'structured' or 'plaintext'.\r\n\u001b[?2004l\r"]
[96.391599, "o", "\u001b[?2004h> "]
[96.391631, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[96.391673, "o", "\u001b[?2004h> "]
[96.391747, "o", "    # Check for actual JSON\r\n\u001b[?2004l\r"]
[96.391778, "o", "\u001b[?2004h> "]
[96.391857, "o", "    stripped = line.strip()\r\n\u001b[?2004l\r"]
[96.391889, "o", "\u001b[?2004h> "]
[96.392053, "o", "    if stripped.startswith('{') and stripped.endswith('}'):\r\n\u001b[?2004l\r"]
[96.392084, "o", "\u001b[?2004h> "]
[96.392163, "o", "        return 'structured'\r\n\u001b[?2004l\r"]
[96.392195, "o", "\u001b[?2004h> "]
[96.392397, "o", "    # All other logs should be processed as plaintext for severity routing\r\n\u001b[?2004l\r"]
[96.392428, "o", "\u001b[?2004h> "]
[96.392492, "o", "    return 'plaintext'\r\n\u001b[?2004l\r"]
[96.392522, "o", "\u001b[?2004h> "]
[96.392553, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.392585, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.392675, "o", "def normalize_line(line):\r\n\u001b[?2004l\r"]
[96.392709, "o", "\u001b[?2004h> "]
[96.392882, "o", "    \"\"\"Normalize a log line by stripping control characters.\"\"\"\r\n\u001b[?2004l\r"]
[96.392912, "o", "\u001b[?2004h> "]
[96.393041, "o", "    # Remove leading non-printable characters\r\n\u001b[?2004l\r"]
[96.39307, "o", "\u001b[?2004h> "]
[96.393116, "o", "    result = []\r\n\u001b[?2004l\r"]
[96.393149, "o", "\u001b[?2004h> "]
[96.393202, "o", "    started = False\r\n\u001b[?2004l\r"]
[96.393234, "o", "\u001b[?2004h> "]
[96.393293, "o", "    for char in line:\r\n\u001b[?2004l\r"]
[96.393325, "o", "\u001b[?2004h> "]
[96.393489, "o", "        if started or char.isprintable() or char in '\\t\\n':\r\n\u001b[?2004l\r"]
[96.393521, "o", "\u001b[?2004h> "]
[96.39361, "o", "            result.append(char)\r\n\u001b[?2004l\r"]
[96.393641, "o", "\u001b[?2004h> "]
[96.393729, "o", "            started = True\r\n\u001b[?2004l\r"]
[96.393762, "o", "\u001b[?2004h> "]
[96.393837, "o", "    return ''.join(result)\r\n\u001b[?2004l\r"]
[96.393867, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.393899, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.39393, "o", "\u001b[?2004h> "]
[96.394087, "o", "def route_line(line, severity, service, routing_config):\r\n\u001b[?2004l\r"]
[96.39412, "o", "\u001b[?2004h> "]
[96.394313, "o", "    \"\"\"Determine output file for a log line based on routing rules.\"\"\"\r\n\u001b[?2004l\r"]
[96.394345, "o", "\u001b[?2004h> "]
[96.394473, "o", "    rules = routing_config.get('rules', [])\r\n\u001b[?2004l\r"]
[96.394506, "o", "\u001b[?2004h> "]
[96.394571, "o", "    for rule in rules:\r\n\u001b[?2004l\r"]
[96.394601, "o", "\u001b[?2004h> "]
[96.394747, "o", "        if rule.get('severity') == severity:\r\n\u001b[?2004l\r"]
[96.394778, "o", "\u001b[?2004h"]
[96.394812, "o", "> "]
[96.394928, "o", "            return rule.get('output', 'default.log')\r\n\u001b[?2004l\r"]
[96.394957, "o", "\u001b[?2004h> "]
[96.395077, "o", "        if rule.get('service') == service:\r\n\u001b[?2004l\r"]
[96.395106, "o", "\u001b[?2004h> "]
[96.395252, "o", "            return rule.get('output', 'default.log')\r\n\u001b[?2004l\r"]
[96.395286, "o", "\u001b[?2004h> "]
[96.395453, "o", "    return routing_config.get('default_output', 'default.log')\r\n\u001b[?2004l\r"]
[96.395483, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.395515, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.395546, "o", "\u001b[?2004h> "]
[96.395603, "o", "def process_logs():\r\n\u001b[?2004l\r"]
[96.395631, "o", "\u001b[?2004h> "]
[96.395744, "o", "    \"\"\"Main processing function.\"\"\"\r\n\u001b[?2004l\r"]
[96.395775, "o", "\u001b[?2004h> "]
[96.395896, "o", "    patterns = load_patterns(PATTERNS_CONF)\r\n\u001b[?2004l\r"]
[96.395925, "o", "\u001b[?2004h> "]
[96.396043, "o", "    routing = load_routing(ROUTING_YAML)\r\n\u001b[?2004l\r"]
[96.396075, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.396102, "o", "\u001b[?2004h> "]
[96.396209, "o", "    # Ensure output directory exists\r\n\u001b[?2004l\r"]
[96.396238, "o", "\u001b[?2004h> "]
[96.396356, "o", "    os.makedirs(OUTPUT_DIR, exist_ok=True)\r\n\u001b[?2004l\r"]
[96.396389, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.39642, "o", "\u001b[?2004h> "]
[96.396504, "o", "    # Open output file handles\r\n\u001b[?2004l\r"]
[96.396536, "o", "\u001b[?2004h> "]
[96.396598, "o", "    output_files = {}\r\n\u001b[?2004l\r"]
[96.396631, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.396673, "o", "\u001b[?2004h> "]
[96.396767, "o", "    with open(RAW_LOG, 'r') as f:\r\n\u001b[?2004l\r"]
[96.396795, "o", "\u001b[?2004h> "]
[96.396863, "o", "        for line in f:\r\n\u001b[?2004l\r"]
[96.396894, "o", "\u001b[?2004h> "]
[96.397, "o", "            line = line.rstrip('\\n')\r\n\u001b[?2004l\r"]
[96.397029, "o", "\u001b[?2004h> "]
[96.397101, "o", "            if not line:\r\n\u001b[?2004l\r"]
[96.397128, "o", "\u001b[?2004h"]
[96.397157, "o", "> "]
[96.397206, "o", "                continue\r\n\u001b[?2004l\r"]
[96.397237, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.397269, "o", "\u001b[?2004h> "]
[96.397361, "o", "            # Normalize the line\r\n\u001b[?2004l\r"]
[96.397393, "o", "\u001b[?2004h> "]
[96.397517, "o", "            normalized = normalize_line(line)\r\n\u001b[?2004l\r"]
[96.397548, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.39758, "o", "\u001b[?2004h> "]
[96.397685, "o", "            # Classify line type\r\n\u001b[?2004l\r"]
[96.39772, "o", "\u001b[?2004h> "]
[96.397854, "o", "            line_type = classify_line(normalized)\r\n\u001b[?2004l\r"]
[96.397884, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.397915, "o", "\u001b[?2004h> "]
[96.398032, "o", "            if line_type == 'structured':\r\n\u001b[?2004l\r"]
[96.398063, "o", "\u001b[?2004h> "]
[96.398177, "o", "                # Route to structured.log\r\n\u001b[?2004l\r"]
[96.398209, "o", "\u001b[?2004h> "]
[96.398414, "o", "                output_path = os.path.join(OUTPUT_DIR, 'structured.log')\r\n\u001b[?2004l\r"]
[96.398445, "o", "\u001b[?2004h> "]
[96.398589, "o", "                if output_path not in output_files:\r\n\u001b[?2004l\r"]
[96.398621, "o", "\u001b[?2004h> "]
[96.398832, "o", "                    output_files[output_path] = open(output_path, 'w')\r\n\u001b[?2004l\r"]
[96.398864, "o", "\u001b[?2004h"]
[96.398897, "o", "> "]
[96.399032, "o", "                output_files[output_path].write(line + '\\n')\r\n\u001b[?2004l\r"]
[96.399057, "o", "\u001b[?2004h"]
[96.399087, "o", "> "]
[96.39913, "o", "                continue\r\n\u001b[?2004l\r"]
[96.399159, "o", "\u001b[?2004h> "]
[96.399191, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.399303, "o", "            # Get severity and service\r\n\u001b[?2004l\r"]
[96.399334, "o", "\u001b[?2004h> "]
[96.399498, "o", "            severity = get_severity(normalized, patterns)\r\n\u001b[?2004l\r"]
[96.399531, "o", "\u001b[?2004h> "]
[96.399703, "o", "            service = get_service(normalized, patterns)\r\n\u001b[?2004l\r"]
[96.399736, "o", "\u001b[?2004h> "]
[96.399763, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.399791, "o", "> "]
[96.399871, "o", "            # Route based on rules\r\n\u001b[?2004l\r"]
[96.399889, "o", "\u001b[?2004h"]
[96.399996, "o", "> "]
[96.400113, "o", "            output_file = route_line(normalized, severity, service, routing)\r\n\u001b[?2004l\r"]
[96.400143, "o", "\u001b[?2004h> "]
[96.400336, "o", "            output_path = os.path.join(OUTPUT_DIR, output_file)\r\n\u001b[?2004l\r"]
[96.400405, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[96.400477, "o", "> "]
[96.400702, "o", "            if output_path not in output_files:\r\n\u001b[?2004l\r"]
[96.400826, "o", "\u001b[?2004h> "]
[96.401002, "o", "                output_files[output_path] = open(output_path, 'w')\r\n\u001b[?2004l\r"]
[96.401045, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.401087, "o", "\u001b[?2004h> "]
[96.401293, "o", "            output_files[output_path].write(line + '\\n')\r\n\u001b[?2004l\r"]
[96.401325, "o", "\u001b[?2004h"]
[96.401358, "o", "> \r\n\u001b[?2004l\r"]
[96.401402, "o", "\u001b[?2004h> "]
[96.401492, "o", "    # Close all output files\r\n\u001b[?2004l\r"]
[96.401524, "o", "\u001b[?2004h"]
[96.401564, "o", "> "]
[96.401688, "o", "    for f in output_files.values():\r\n\u001b[?2004l\r"]
[96.401726, "o", "\u001b[?2004h"]
[96.401764, "o", "> "]
[96.401801, "o", "        f.close()\r\n\u001b[?2004l\r"]
[96.401828, "o", "\u001b[?2004h"]
[96.401869, "o", "> \r\n\u001b[?2004l\r"]
[96.401905, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.401942, "o", "\u001b[?2004h> "]
[96.402035, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[96.402069, "o", "\u001b[?2004h"]
[96.40211, "o", "> "]
[96.402149, "o", "    process_logs()\r\n\u001b[?2004l\r"]
[96.402184, "o", "\u001b[?2004h> "]
[96.402225, "o", "EOF\r\n\u001b[?2004l\r"]
[96.404456, "o", "\u001b[?2004h"]
[96.404498, "o", "root@1a47e7718deb:/home/user/logpipe# "]
[110.612543, "i", "rm -rf output/*\n"]
[110.612674, "o", "rm -rf output/*\r\n\u001b[?2004l\r"]
[110.63068, "o", "\u001b[?2004hroot@1a47e7718deb:/home/user/logpipe# "]
[110.711351, "i", "python3 filter.py\n"]
[110.711466, "o", "python3 filter.py\r\n\u001b[?2004l\r"]
[110.762483, "o", "\u001b[?2004hroot@1a47e7718deb:/home/user/logpipe# "]
[116.355102, "i", "ls -la output/\n"]
[116.35522, "o", "ls -la output/\r\n"]
[116.355274, "o", "\u001b[?2004l\r"]
[116.356519, "o", "total 72\r\n"]
[116.356601, "o", "drwxrwxrwx 1 root root  4096 May  5 23:45 \u001b[0m\u001b[34;42m.\u001b[0m\r\ndrwxrwxrwx 1 root root  4096 May  5 23:44 \u001b[34;42m..\u001b[0m\r\n-rw-r--r-- 1 root root 14830 May  5 23:45 debug.log\r\n-rw-r--r-- 1 root root 12108 May  5 23:45 errors.log\r\n-rw-r--r-- 1 root root 18141 May  5 23:45 info.log\r\n-rw-r--r-- 1 root root   635 May  5 23:45 structured.log\r\n-rw-r--r-- 1 root root  6566 May  5 23:45 warnings.log\r\n"]
[116.356789, "o", "\u001b[?2004h"]
