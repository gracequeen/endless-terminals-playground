[13.057296, "o", "#!/bin/bash\r\ncd /home/user/edge-gateway\r\n\r\n# Start mosquitto in background\r\nmosquitto -d\r\n\r\n# Wait for mosquitto to be ready\r\nsleep 1\r\n\r\n# Run the gateway\r\npython3 gateway.py\r\n"]
