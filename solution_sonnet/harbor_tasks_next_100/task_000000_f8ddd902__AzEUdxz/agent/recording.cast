[31.239714, "i", "cat > gateway.py << 'EOF'\nimport asyncio\nfrom aiohttp import web\nimport aiomqtt\n\nmqtt_client = None\n\nasync def health_handler(request):\n    if mqtt_client and mqtt_client._client.is_connected():\n        return web.json_response({\"status\": \"healthy\", \"mqtt\": \"connected\"})\n    return web.json_response({\"status\": \"degraded\", \"mqtt\": \"disconnected\"}, status=503)\n\nasync def sensor_handler(request):\n    data = await request.json()\n    if mqtt_client:\n        await mqtt_client.publish(\"sensors/data\", str(data))\n    return web.json_response({\"accepted\": True})\n\ndef create_app():\n    app = web.Application()\n    app.router.add_get('/health', health_handler)\n    app.router.add_post('/sensor', sensor_handler)\n    return app\n\nasync def mqtt_loop():\n    global mqtt_client\n    async with aiomqtt.Client(\"localhost\", 1883) as client:\n        mqtt_client = client\n        # Subscribe to a topic to keep the connection alive\n        await client.subscribe(\"sensors/#\")\n        async for message in client.messages:\n            prin"]
[31.239855, "i", "t(f\"Received: {message.payload}\")\n\nasync def run_http_server(app):\n    runner = web.AppRunner(app)\n    await runner.setup()\n    site = web.TCPSite(runner, '0.0.0.0', 8080)\n    await site.start()\n    print(\"HTTP server started on port 8080\")\n    # Keep running forever\n    await asyncio.Event().wait()\n\nasync def main_async():\n    app = create_app()\n    # Run both HTTP server and MQTT loop concurrently\n    await asyncio.gather(\n        run_http_server(app),\n        mqtt_loop()\n    )\n\ndef main():\n    asyncio.run(main_async())\n\nif __name__ == '__main__':\n    main()\nEOF\n"]
