[22.746134, "o", "# Data pipeline Makefile\r\n# Cleans CSV files from raw/ and aggregates them into final/summary.csv\r\n\r\n# Source CSV files in raw/\r\nRAW_CSVS := $(wildcard raw/*.csv)\r\n\r\n# Target cleaned CSV files in cleaned/\r\nCLEANED_CSVS := $(patsubst raw/%.csv,cleaned/%.csv,$(RAW_CSVS))\r\n\r\n# Default target\r\nall: final/summary.csv\r\n\r\n# Rule to clean individual CSV files\r\ncleaned/%.csv: raw/%.csv clean.py\r\n@mkdir -p cleaned\r\npython3 clean.py $< $@\r\n@echo \"Cleaned $< -> $@\"\r\n\r\n# Rule to aggregate all cleaned files\r\nfinal/summary.csv: $(CLEANED_CSVS) aggregate.py\r\n@mkdir -p final\r\npython3 aggregate.py\r\n\r\n# Clean up generated files\r\nclean:\r\nrm -f cleaned/*.csv final/summary.csv\r\n@echo \"Cleaned up generated files\"\r\n\r\n.PHONY: all clean\r\n"]
