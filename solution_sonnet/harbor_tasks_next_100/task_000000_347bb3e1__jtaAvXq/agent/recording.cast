[13.505947, "o", "#!/bin/bash\r\nset -e\r\nSRCDIR=\"${1:-/home/user/backup/testdata}\"\r\nOUTFILE=\"${2:-/home/user/backup/output.tar.gz}\"\r\ntar -cf - \"$SRCDIR\" | gzip -9 --rsyncable > \"$OUTFILE\"\r\necho \"Compressed to $OUTFILE\"\r\n"]
