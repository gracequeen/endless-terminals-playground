[27.723495, "o", "cat routing.yaml\r\n\u001b[?2004l\r"]
[27.724351, "o", "# Log routing configuration\r\nversion: 1\r\n\r\nrules:\r\n  - severity: ERROR\r\n    output: errors.log\r\n    description: \"Route all ERROR level logs to errors.log\"\r\n\r\n  - severity: WARN\r\n    output: warnings.log\r\n    description: \"Route all WARN level logs to warnings.log\"\r\n\r\n  - severity: INFO\r\n    output: info.log\r\n    description: \"Route INFO level logs\"\r\n\r\n  - severity: DEBUG\r\n    output: debug.log\r\n    description: \"Route DEBUG level logs\"\r\n\r\ndefault_output: other.log\r\n\r\nservice_subdirs:\r\n  enabled: false\r\n\r\nretention:\r\n  max_size_mb: 100\r\n  max_age_days: 7\r\n"]
[27.724499, "o", "\u001b[?2004h"]
