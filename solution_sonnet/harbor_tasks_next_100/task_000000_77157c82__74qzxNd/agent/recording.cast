[54.5665, "o", "\u001b[?2004h> \r\n"]
[54.566531, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[54.566569, "o", "import re\r\n\u001b[?2004l\r"]
[54.566607, "o", "\u001b[?2004h> "]
[54.566644, "o", "import os\r\n\u001b[?2004l\r"]
[54.566692, "o", "\u001b[?2004h> "]
[54.566737, "o", "import yaml\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.566839, "o", "from configparser import ConfigParser\r\n\u001b[?2004l\r"]
[54.566877, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.566906, "o", "\u001b[?2004h> "]
[54.56707, "o", "SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))\r\n\u001b[?2004l\r"]
[54.567106, "o", "\u001b[?2004h> "]
[54.56723, "o", "RAW_LOG = os.path.join(SCRIPT_DIR, 'raw.log')\r\n\u001b[?2004l\r"]
[54.567263, "o", "\u001b[?2004h> "]
[54.567416, "o", "PATTERNS_CONF = os.path.join(SCRIPT_DIR, 'patterns.conf')\r\n\u001b[?2004l\r"]
[54.567454, "o", "\u001b[?2004h> "]
[54.567592, "o", "ROUTING_YAML = os.path.join(SCRIPT_DIR, 'routing.yaml')\r\n\u001b[?2004l\r"]
[54.567623, "o", "\u001b[?2004h> "]
[54.567755, "o", "OUTPUT_DIR = os.path.join(SCRIPT_DIR, 'output')\r\n\u001b[?2004l\r"]
[54.567787, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.567817, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.567847, "o", "\u001b[?2004h> "]
[54.567932, "o", "def load_patterns(conf_path):\r\n\u001b[?2004l\r"]
[54.567975, "o", "\u001b[?2004h> "]
[54.568112, "o", "    \"\"\"Load regex patterns from patterns.conf\"\"\"\r\n\u001b[?2004l\r"]
[54.568143, "o", "\u001b[?2004h> "]
[54.56822, "o", "    config = ConfigParser()\r\n\u001b[?2004l\r"]
[54.568252, "o", "\u001b[?2004h> "]
[54.568331, "o", "    config.read(conf_path)\r\n\u001b[?2004l\r"]
[54.568362, "o", "\u001b[?2004h> "]
[54.568413, "o", "    patterns = {}\r\n\u001b[?2004l\r"]
[54.56844, "o", "\u001b[?2004h"]
[54.568466, "o", "> "]
[54.568552, "o", "    for section in config.sections():\r\n\u001b[?2004l\r"]
[54.568582, "o", "\u001b[?2004h> "]
[54.568667, "o", "        patterns[section] = {}\r\n\u001b[?2004l\r"]
[54.568696, "o", "\u001b[?2004h> "]
[54.56883, "o", "        for key, value in config.items(section):\r\n\u001b[?2004l\r"]
[54.568858, "o", "\u001b[?2004h> "]
[54.56902, "o", "            patterns[section][key.upper()] = value\r\n\u001b[?2004l\r"]
[54.569049, "o", "\u001b[?2004h> "]
[54.569108, "o", "    return patterns\r\n\u001b[?2004l\r"]
[54.569144, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.569171, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.569202, "o", "\u001b[?2004h> "]
[54.569282, "o", "def load_routing(yaml_path):\r\n\u001b[?2004l\r"]
[54.569309, "o", "\u001b[?2004h> "]
[54.569441, "o", "    \"\"\"Load routing rules from routing.yaml\"\"\"\r\n\u001b[?2004l\r"]
[54.569471, "o", "\u001b[?2004h> "]
[54.569572, "o", "    with open(yaml_path, 'r') as f:\r\n\u001b[?2004l\r"]
[54.569602, "o", "\u001b[?2004h> "]
[54.569692, "o", "        return yaml.safe_load(f)\r\n\u001b[?2004l\r"]
[54.569727, "o", "\u001b[?2004h> "]
[54.569759, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.569789, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[54.56982, "o", "> "]
[54.56989, "o", "def get_severity(line, patterns):\r\n\u001b[?2004l\r"]
[54.56992, "o", "\u001b[?2004h> "]
[54.570127, "o", "    \"\"\"Extract severity level from log line using regex patterns.\"\"\"\r\n\u001b[?2004l\r"]
[54.570162, "o", "\u001b[?2004h> "]
[54.570304, "o", "    severity_patterns = patterns.get('severity', {})\r\n\u001b[?2004l\r"]
[54.570334, "o", "\u001b[?2004h> "]
[54.570481, "o", "    for level, pattern in severity_patterns.items():\r\n\u001b[?2004l\r"]
[54.570512, "o", "\u001b[?2004h> "]
[54.57061, "o", "        if re.match(pattern, line):\r\n\u001b[?2004l\r"]
[54.57064, "o", "\u001b[?2004h> "]
[54.570712, "o", "            return level\r\n\u001b[?2004l\r"]
[54.570742, "o", "\u001b[?2004h> "]
[54.570788, "o", "    return None\r\n\u001b[?2004l\r"]
[54.570819, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.570848, "o", "\u001b[?2004h> "]
[54.570878, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.570988, "o", "def get_service(line, patterns):\r\n\u001b[?2004l\r"]
[54.571022, "o", "\u001b[?2004h> "]
[54.571145, "o", "    \"\"\"Extract service name from log line.\"\"\"\r\n\u001b[?2004l\r"]
[54.571174, "o", "\u001b[?2004h"]
[54.571205, "o", "> "]
[54.571325, "o", "    service_patterns = patterns.get('service', {})\r\n\u001b[?2004l\r"]
[54.571354, "o", "\u001b[?2004h> "]
[54.571517, "o", "    for service_name, pattern in service_patterns.items():\r\n\u001b[?2004l\r"]
[54.571547, "o", "\u001b[?2004h> "]
[54.571648, "o", "        if re.search(pattern, line):\r\n\u001b[?2004l\r"]
[54.57168, "o", "\u001b[?2004h> "]
[54.571768, "o", "            return service_name\r\n\u001b[?2004l\r"]
[54.571799, "o", "\u001b[?2004h> "]
[54.571857, "o", "    return 'unknown'\r\n\u001b[?2004l\r"]
[54.571888, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.571918, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.57196, "o", "\u001b[?2004h> "]
[54.572034, "o", "def classify_line(line):\r\n\u001b[?2004l\r"]
[54.572063, "o", "\u001b[?2004h> "]
[54.572092, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[54.572121, "o", "\u001b[?2004h> "]
[54.572297, "o", "    Classify a log line as structured (JSON-like) or plaintext.\r\n\u001b[?2004l\r"]
[54.572328, "o", "\u001b[?2004h> "]
[54.572441, "o", "    Returns 'structured' or 'plaintext'.\r\n\u001b[?2004l\r"]
[54.572469, "o", "\u001b[?2004h> "]
[54.572499, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[54.57253, "o", "\u001b[?2004h> "]
[54.572603, "o", "    # Check for actual JSON\r\n\u001b[?2004l\r"]
[54.572634, "o", "\u001b[?2004h> "]
[54.572711, "o", "    stripped = line.strip()\r\n\u001b[?2004l\r"]
[54.572742, "o", "\u001b[?2004h> "]
[54.572905, "o", "    if stripped.startswith('{') and stripped.endswith('}'):\r\n\u001b[?2004l\r"]
[54.57294, "o", "\u001b[?2004h> "]
[54.573036, "o", "        return 'structured'\r\n\u001b[?2004l\r"]
[54.573066, "o", "\u001b[?2004h> "]
[54.573133, "o", "    return 'plaintext'\r\n\u001b[?2004l\r"]
[54.573164, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.573196, "o", "\u001b[?2004h> "]
[54.573227, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.573302, "o", "def normalize_line(line):\r\n\u001b[?2004l\r"]
[54.573332, "o", "\u001b[?2004h> "]
[54.573508, "o", "    \"\"\"Normalize a log line by stripping control characters.\"\"\"\r\n\u001b[?2004l\r"]
[54.573539, "o", "\u001b[?2004h> "]
[54.573666, "o", "    # Remove leading non-printable characters\r\n\u001b[?2004l\r"]
[54.573697, "o", "\u001b[?2004h> "]
[54.573751, "o", "    result = []\r\n\u001b[?2004l\r"]
[54.573782, "o", "\u001b[?2004h> "]
[54.573839, "o", "    started = False\r\n\u001b[?2004l\r"]
[54.57387, "o", "\u001b[?2004h> "]
[54.57393, "o", "    for char in line:\r\n\u001b[?2004l\r"]
[54.573968, "o", "\u001b[?2004h"]
[54.574, "o", "> "]
[54.574139, "o", "        if started or char.isprintable() or char in '\\t\\n':\r\n\u001b[?2004l\r"]
[54.57417, "o", "\u001b[?2004h> "]
[54.574259, "o", "            result.append(char)\r\n\u001b[?2004l\r"]
[54.574289, "o", "\u001b[?2004h> "]
[54.574363, "o", "            started = True\r\n\u001b[?2004l\r"]
[54.574394, "o", "\u001b[?2004h> "]
[54.574469, "o", "    return ''.join(result)\r\n\u001b[?2004l\r"]
[54.5745, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.574531, "o", "\u001b[?2004h> "]
[54.574562, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.57472, "o", "def route_line(line, severity, service, routing_config):\r\n\u001b[?2004l\r"]
[54.574749, "o", "\u001b[?2004h> "]
[54.574943, "o", "    \"\"\"Determine output file for a log line based on routing rules.\"\"\"\r\n\u001b[?2004l\r"]
[54.574986, "o", "\u001b[?2004h> "]
[54.575113, "o", "    rules = routing_config.get('rules', [])\r\n\u001b[?2004l\r"]
[54.575144, "o", "\u001b[?2004h> "]
[54.575208, "o", "    for rule in rules:\r\n\u001b[?2004l\r"]
[54.575243, "o", "\u001b[?2004h"]
[54.575274, "o", "> "]
[54.575361, "o", "        if rule.get('severity') == severity:\r\n\u001b[?2004l\r"]
[54.575392, "o", "\u001b[?2004h> "]
[54.575536, "o", "            return rule.get('output', 'default.log')\r\n\u001b[?2004l\r"]
[54.575567, "o", "\u001b[?2004h> "]
[54.575686, "o", "        if rule.get('service') == service:\r\n\u001b[?2004l\r"]
[54.575714, "o", "\u001b[?2004h> "]
[54.57586, "o", "            return rule.get('output', 'default.log')\r\n\u001b[?2004l\r"]
[54.575891, "o", "\u001b[?2004h> "]
[54.576078, "o", "    return routing_config.get('default_output', 'default.log')\r\n\u001b[?2004l\r"]
[54.576106, "o", "\u001b[?2004h> "]
[54.576137, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.576168, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.576229, "o", "def process_logs():\r\n\u001b[?2004l\r"]
[54.576258, "o", "\u001b[?2004h> "]
[54.576358, "o", "    \"\"\"Main processing function.\"\"\"\r\n\u001b[?2004l\r"]
[54.576386, "o", "\u001b[?2004h> "]
[54.57651, "o", "    patterns = load_patterns(PATTERNS_CONF)\r\n\u001b[?2004l\r"]
[54.576541, "o", "\u001b[?2004h> "]
[54.576652, "o", "    routing = load_routing(ROUTING_YAML)\r\n\u001b[?2004l\r"]
[54.576683, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.576714, "o", "\u001b[?2004h> "]
[54.576816, "o", "    # Ensure output directory exists\r\n\u001b[?2004l\r"]
[54.576846, "o", "\u001b[?2004h> "]
[54.576981, "o", "    os.makedirs(OUTPUT_DIR, exist_ok=True)\r\n\u001b[?2004l\r"]
[54.577015, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.577044, "o", "\u001b[?2004h> "]
[54.57713, "o", "    # Open output file handles\r\n\u001b[?2004l\r"]
[54.57716, "o", "\u001b[?2004h> "]
[54.577224, "o", "    output_files = {}\r\n\u001b[?2004l\r"]
[54.577255, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.577286, "o", "\u001b[?2004h> "]
[54.577382, "o", "    with open(RAW_LOG, 'r') as f:\r\n\u001b[?2004l\r"]
[54.577412, "o", "\u001b[?2004h> "]
[54.577476, "o", "        for line in f:\r\n\u001b[?2004l\r"]
[54.577508, "o", "\u001b[?2004h> "]
[54.577607, "o", "            line = line.rstrip('\\n')\r\n\u001b[?2004l\r"]
[54.577635, "o", "\u001b[?2004h> "]
[54.577716, "o", "            if not line:\r\n\u001b[?2004l\r"]
[54.577749, "o", "\u001b[?2004h> "]
[54.577819, "o", "                continue\r\n\u001b[?2004l\r"]
[54.577849, "o", "\u001b[?2004h> "]
[54.577879, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.578004, "o", "            # Normalize the line\r\n\u001b[?2004l\r"]
[54.578038, "o", "\u001b[?2004h> "]
[54.578165, "o", "            normalized = normalize_line(line)\r\n\u001b[?2004l\r"]
[54.578196, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.578227, "o", "\u001b[?2004h> "]
[54.578322, "o", "            # Classify line type\r\n\u001b[?2004l\r"]
[54.578353, "o", "\u001b[?2004h> "]
[54.578494, "o", "            line_type = classify_line(normalized)\r\n\u001b[?2004l\r"]
[54.578525, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.578556, "o", "\u001b[?2004h> "]
[54.578676, "o", "            if line_type == 'structured':\r\n\u001b[?2004l\r"]
[54.578706, "o", "\u001b[?2004h> "]
[54.578822, "o", "                # Route to structured.log\r\n\u001b[?2004l\r"]
[54.578854, "o", "\u001b[?2004h> "]
[54.579069, "o", "                output_path = os.path.join(OUTPUT_DIR, 'structured.log')\r\n\u001b[?2004l\r"]
[54.579103, "o", "\u001b[?2004h> "]
[54.579243, "o", "                if output_path not in output_files:\r\n\u001b[?2004l\r"]
[54.579273, "o", "\u001b[?2004h> "]
[54.579468, "o", "                    output_files[output_path] = open(output_path, 'w')\r\n\u001b[?2004l\r"]
[54.5795, "o", "\u001b[?2004h> "]
[54.57967, "o", "                output_files[output_path].write(line + '\\n')\r\n\u001b[?2004l\r"]
[54.5797, "o", "\u001b[?2004h> "]
[54.579771, "o", "                continue\r\n\u001b[?2004l\r"]
[54.579803, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.57983, "o", "\u001b[?2004h"]
[54.579857, "o", "> "]
[54.579944, "o", "            # Get severity and service\r\n\u001b[?2004l\r"]
[54.579984, "o", "\u001b[?2004h> "]
[54.580146, "o", "            severity = get_severity(normalized, patterns)\r\n\u001b[?2004l\r"]
[54.580173, "o", "\u001b[?2004h> "]
[54.580329, "o", "            service = get_service(normalized, patterns)\r\n\u001b[?2004l\r"]
[54.580359, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.580389, "o", "\u001b[?2004h> "]
[54.580487, "o", "            # Route based on rules\r\n\u001b[?2004l\r"]
[54.580516, "o", "\u001b[?2004h> "]
[54.580727, "o", "            output_file = route_line(normalized, severity, service, routing)\r\n\u001b[?2004l\r"]
[54.580754, "o", "\u001b[?2004h> "]
[54.580934, "o", "            output_path = os.path.join(OUTPUT_DIR, output_file)\r\n\u001b[?2004l\r"]
[54.580974, "o", "\u001b[?2004h"]
[54.581, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[54.581032, "o", "> "]
[54.581142, "o", "            if output_path not in output_files:\r\n\u001b[?2004l\r"]
[54.581173, "o", "\u001b[?2004h> "]
[54.581353, "o", "                output_files[output_path] = open(output_path, 'w')\r\n\u001b[?2004l\r"]
[54.581385, "o", "\u001b[?2004h> "]
[54.581415, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.581442, "o", "> "]
[54.581581, "o", "            output_files[output_path].write(line + '\\n')\r\n\u001b[?2004l\r"]
[54.581609, "o", "\u001b[?2004h> \r\n"]
[54.581641, "o", "\u001b[?2004l\r\u001b[?2004h"]
[54.581668, "o", "> "]
[54.581737, "o", "    # Close all output files\r\n\u001b[?2004l\r"]
[54.581765, "o", "\u001b[?2004h> "]
[54.58187, "o", "    for f in output_files.values():\r\n\u001b[?2004l\r"]
[54.581901, "o", "\u001b[?2004h> "]
[54.581966, "o", "        f.close()\r\n\u001b[?2004l\r"]
[54.582, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.582027, "o", "\u001b[?2004h> "]
[54.582058, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.582089, "o", "> "]
[54.582142, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[54.582172, "o", "\u001b[?2004h> "]
[54.582229, "o", "    process_logs()\r\n\u001b[?2004l\r"]
[54.58226, "o", "\u001b[?2004h> "]
[54.582288, "o", "EOF\r\n\u001b[?2004l\r"]
[54.584582, "o", "\u001b[?2004h"]
[54.584616, "o", "root@609cf789e441:/home/user/logpipe# "]
[60.247627, "i", "rm -rf output/*\n"]
[60.247753, "o", "rm -rf output/*\r\n\u001b[?2004l\r"]
[60.251806, "o", "\u001b[?2004hroot@609cf789e441:/home/user/logpipe# "]
[60.357738, "i", "python3 filter.py\n"]
[60.357846, "o", "python3 filter.py\r\n\u001b[?2004l\r"]
[60.409247, "o", "\u001b[?2004hroot@609cf789e441:/home/user/logpipe# "]
[66.451612, "i", "grep 'payment-svc' output/errors.log | grep ERROR | head -5\n"]
[66.45183, "o", "grep 'payment-svc' output/errors.log | grep ERROR | head -5\r\n"]
[66.451896, "o", "\u001b[?2004l\r"]
[66.453457, "o", "2024-01-15T08:48:40+00:00 [ERROR] service=payment-svc msg=\"processing error\" txn_id=9006 error_code=442\r\n2024-01-15T08:42:40+00:00 [ERROR] service=payment-svc msg=\"insufficient funds\" txn_id=6432\r\n2024-01-15T08:45:20+00:00 [ERROR] service=payment-svc msg=\"payment declined\" txn_id=9019 error_code=535\r\n2024-01-15T08:50:40+00:00 [ERROR] service=payment-svc msg=\"transaction failed\" txn_id=8193 error_code=430\r\n2024-01-15T08:32:55+00:00 [ERROR] service=payment-svc msg=\"card validation failed\" txn_id=4814\r\n"]
