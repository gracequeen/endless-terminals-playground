version: 1

rules:
  - severity: ERROR
    output: errors.log
    description: "Route all ERROR level logs to errors.log"

  - severity: WARN
    output: warnings.log
    description: "Route all WARN level logs to warnings.log"

  - severity: INFO
    output: info.log
    description: "Route INFO level logs"

  - severity: DEBUG
    output: debug.log
    description: "Route DEBUG level logs"

default_output: other.log

service_subdirs:
  enabled: false

retention:
  max_size_mb: 100
  max_age_days: 7
