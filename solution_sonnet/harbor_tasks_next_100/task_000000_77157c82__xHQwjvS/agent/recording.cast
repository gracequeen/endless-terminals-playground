[90.390046, "o", "grep 'payment-svc.*ERROR' output/errors.log | head -10\r\n\u001b[?2004l\r"]
[90.391761, "o", "\u001b[?2004h"]
[90.391777, "o", "root@cc0d12aebac5:/home/user/logpipe# "]
