[73.226915, "o", "> "]
[73.227046, "o", "OUTPUT_DIR = os.path.join(SCRIPT_DIR, 'output')\r\n\u001b[?2004l\r"]
[73.227079, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[73.227103, "o", "\u001b[?2004h> \r\n"]
[73.227133, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[73.227221, "o", "def load_patterns(conf_path):\r\n\u001b[?2004l\r"]
[73.227249, "o", "\u001b[?2004h> "]
[73.227393, "o", "    \"\"\"Load regex patterns from patterns.conf\"\"\"\r\n\u001b[?2004l\r"]
[73.22742, "o", "\u001b[?2004h"]
[73.22745, "o", "> "]
[73.227509, "o", "    config = ConfigParser()\r\n\u001b[?2004l\r"]
[73.227533, "o", "\u001b[?2004h"]
[73.227565, "o", "> "]
[73.227617, "o", "    config.read(conf_path)\r\n\u001b[?2004l\r"]
[73.227647, "o", "\u001b[?2004h> "]
[73.227698, "o", "    patterns = {}\r\n\u001b[?2004l\r"]
[73.227734, "o", "\u001b[?2004h"]
[73.227766, "o", "> "]
[73.227849, "o", "    for section in config.sections():\r\n\u001b[?2004l\r"]
[73.227878, "o", "\u001b[?2004h> "]
[73.227985, "o", "        patterns[section] = {}\r\n\u001b[?2004l\r"]
[73.228009, "o", "\u001b[?2004h"]
[73.228035, "o", "> "]
[73.228152, "o", "        for key, value in config.items(section):\r\n\u001b[?2004l\r"]
[73.228184, "o", "\u001b[?2004h> "]
[73.228327, "o", "            patterns[section][key.upper()] = value\r\n\u001b[?2004l\r"]
[73.228357, "o", "\u001b[?2004h> "]
[73.228412, "o", "    return patterns\r\n\u001b[?2004l\r"]
[73.228441, "o", "\u001b[?2004h> "]
[73.228468, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[73.228498, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[73.228528, "o", "> "]
[73.228594, "o", "def load_routing(yaml_path):\r\n\u001b[?2004l\r"]
[73.228625, "o", "\u001b[?2004h> "]
[73.228756, "o", "    \"\"\"Load routing rules from routing.yaml\"\"\"\r\n\u001b[?2004l\r"]
[73.228788, "o", "\u001b[?2004h> "]
[73.228891, "o", "    with open(yaml_path, 'r') as f:\r\n\u001b[?2004l\r"]
[73.228917, "o", "\u001b[?2004h> "]
[73.229024, "o", "        return yaml.safe_load(f)\r\n\u001b[?2004l\r"]
[73.22905, "o", "\u001b[?2004h"]
[73.229079, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[73.22911, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[73.229141, "o", "> "]
[73.229215, "o", "def get_severity(line, patterns):\r\n\u001b[?2004l\r"]
[73.229246, "o", "\u001b[?2004h> "]
[73.229434, "o", "    \"\"\"Extract severity level from log line using regex patterns.\"\"\"\r\n\u001b[?2004l\r"]
[73.229466, "o", "\u001b[?2004h> "]
[73.229614, "o", "    severity_patterns = patterns.get('severity', {})\r\n\u001b[?2004l\r"]
[73.229648, "o", "\u001b[?2004h> "]
[73.229793, "o", "    for level, pattern in severity_patterns.items():\r\n\u001b[?2004l\r"]
[73.22983, "o", "\u001b[?2004h> "]
[73.229927, "o", "        if re.match(pattern, line):\r\n\u001b[?2004l\r"]
[73.22997, "o", "\u001b[?2004h> "]
[73.230037, "o", "            return level\r\n\u001b[?2004l\r"]
[73.23007, "o", "\u001b[?2004h> "]
[73.230113, "o", "    return None\r\n\u001b[?2004l\r"]
[73.230145, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[73.230178, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[73.230209, "o", "\u001b[?2004h> "]
[73.230303, "o", "def get_service(line, patterns):\r\n\u001b[?2004l\r"]
[73.230335, "o", "\u001b[?2004h> "]
[73.230461, "o", "    \"\"\"Extract service name from log line.\"\"\"\r\n\u001b[?2004l\r"]
[73.230494, "o", "\u001b[?2004h> "]
[73.230634, "o", "    service_patterns = patterns.get('service', {})\r\n\u001b[?2004l\r"]
[73.230667, "o", "\u001b[?2004h> "]
[73.23084, "o", "    for service_name, pattern in service_patterns.items():\r\n\u001b[?2004l\r"]
[73.230871, "o", "\u001b[?2004h> "]
[73.230988, "o", "        if re.search(pattern, line):\r\n\u001b[?2004l\r"]
[73.231021, "o", "\u001b[?2004h> "]
[73.231106, "o", "            return service_name\r\n\u001b[?2004l\r"]
[73.231137, "o", "\u001b[?2004h> "]
[73.231199, "o", "    return 'unknown'\r\n\u001b[?2004l\r"]
[73.231229, "o", "\u001b[?2004h> "]
[73.231255, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[73.231285, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[73.231322, "o", "> "]
[73.231366, "o", "def classify_line(line):\r\n\u001b[?2004l\r"]
[73.231397, "o", "\u001b[?2004h> "]
[73.231429, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[73.231459, "o", "\u001b[?2004h> "]
[73.231628, "o", "    Classify a log line as structured (JSON-like) or plaintext.\r\n\u001b[?2004l\r"]
[73.23166, "o", "\u001b[?2004h> "]
[73.231772, "o", "    Returns 'structured' or 'plaintext'.\r\n\u001b[?2004l\r"]
[73.231802, "o", "\u001b[?2004h> "]
[73.23183, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[73.23186, "o", "\u001b[?2004h> "]
[73.231936, "o", "    # Check for actual JSON\r\n\u001b[?2004l\r"]
[73.231976, "o", "\u001b[?2004h> "]
[73.232056, "o", "    stripped = line.strip()\r\n\u001b[?2004l\r"]
[73.232091, "o", "\u001b[?2004h> "]
[73.232253, "o", "    if stripped.startswith('{') and stripped.endswith('}'):\r\n\u001b[?2004l\r"]
[73.232284, "o", "\u001b[?2004h> "]
[73.232363, "o", "        return 'structured'\r\n\u001b[?2004l\r"]
[73.232394, "o", "\u001b[?2004h> "]
[73.232457, "o", "    return 'plaintext'\r\n\u001b[?2004l\r"]
[73.232488, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[73.232516, "o", "\u001b[?2004h> "]
[73.232543, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[73.232573, "o", "> "]
[73.232625, "o", "def normalize_line(line):\r\n\u001b[?2004l\r"]
[73.232652, "o", "\u001b[?2004h"]
[73.232683, "o", "> "]
[73.232834, "o", "    \"\"\"Normalize a log line by stripping control characters.\"\"\"\r\n\u001b[?2004l\r"]
[73.232865, "o", "\u001b[?2004h> "]
[73.233004, "o", "    # Remove leading non-printable characters\r\n\u001b[?2004l\r"]
[73.23304, "o", "\u001b[?2004h> "]
[73.233082, "o", "    result = []\r\n\u001b[?2004l\r"]
[73.233112, "o", "\u001b[?2004h> "]
[73.233171, "o", "    started = False\r\n\u001b[?2004l\r"]
[73.233203, "o", "\u001b[?2004h> "]
[73.233263, "o", "    for char in line:\r\n\u001b[?2004l\r"]
[73.233295, "o", "\u001b[?2004h> "]
[73.23346, "o", "        if started or char.isprintable() or char in '\\t\\n':\r\n\u001b[?2004l\r"]
[73.233495, "o", "\u001b[?2004h> "]
[73.23358, "o", "            result.append(char)\r\n\u001b[?2004l\r"]
[73.233608, "o", "\u001b[?2004h> "]
[73.233686, "o", "            started = True\r\n\u001b[?2004l\r"]
[73.233717, "o", "\u001b[?2004h> "]
[73.233795, "o", "    return ''.join(result)\r\n\u001b[?2004l\r"]
[73.233827, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[73.233854, "o", "\u001b[?2004h"]
[73.233885, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[73.233917, "o", "> "]
[73.234064, "o", "def route_line(line, severity, service, routing_config):\r\n\u001b[?2004l\r"]
[73.234099, "o", "\u001b[?2004h> "]
[73.234288, "o", "    \"\"\"Determine output file for a log line based on routing rules.\"\"\"\r\n\u001b[?2004l\r"]
[73.234319, "o", "\u001b[?2004h> "]
[73.234442, "o", "    rules = routing_config.get('rules', [])\r\n\u001b[?2004l\r"]
[73.234473, "o", "\u001b[?2004h> "]
[73.234539, "o", "    for rule in rules:\r\n\u001b[?2004l\r"]
[73.234568, "o", "\u001b[?2004h> "]
[73.234707, "o", "        if rule.get('severity') == severity:\r\n\u001b[?2004l\r"]
[73.23474, "o", "\u001b[?2004h> "]
[73.234886, "o", "            return rule.get('output', 'default.log')\r\n\u001b[?2004l\r"]
[73.234918, "o", "\u001b[?2004h> "]
[73.235049, "o", "        if rule.get('service') == service:\r\n\u001b[?2004l\r"]
[73.235081, "o", "\u001b[?2004h> "]
[73.235227, "o", "            return rule.get('output', 'default.log')\r\n\u001b[?2004l\r"]
[73.235259, "o", "\u001b[?2004h> "]
[73.235431, "o", "    return routing_config.get('default_output', 'default.log')\r\n\u001b[?2004l\r"]
[73.235463, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[73.235492, "o", "\u001b[?2004h> "]
[73.235524, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[73.235551, "o", "> "]
[73.23559, "o", "def process_logs():\r\n\u001b[?2004l\r"]
[73.23562, "o", "\u001b[?2004h> "]
[73.23572, "o", "    \"\"\"Main processing function.\"\"\"\r\n\u001b[?2004l\r"]
[73.235751, "o", "\u001b[?2004h> "]
[73.235875, "o", "    patterns = load_patterns(PATTERNS_CONF)\r\n\u001b[?2004l\r"]
[73.235902, "o", "\u001b[?2004h> "]
[73.236032, "o", "    routing = load_routing(ROUTING_YAML)\r\n\u001b[?2004l\r"]
[73.236066, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[73.236097, "o", "\u001b[?2004h> "]
[73.236193, "o", "    # Ensure output directory exists\r\n\u001b[?2004l\r"]
[73.236224, "o", "\u001b[?2004h> "]
[73.236343, "o", "    os.makedirs(OUTPUT_DIR, exist_ok=True)\r\n\u001b[?2004l\r"]
[73.236373, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[73.236405, "o", "\u001b[?2004h> "]
[73.236493, "o", "    # Open output file handles\r\n\u001b[?2004l\r"]
[73.236523, "o", "\u001b[?2004h> "]
[73.236584, "o", "    output_files = {}\r\n\u001b[?2004l\r"]
[73.236612, "o", "\u001b[?2004h> "]
[73.236643, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.236742, "o", "    with open(RAW_LOG, 'r') as f:\r\n\u001b[?2004l\r"]
[73.236773, "o", "\u001b[?2004h> "]
[73.236837, "o", "        for line in f:\r\n\u001b[?2004l\r"]
[73.236868, "o", "\u001b[?2004h> "]
[73.236982, "o", "            line = line.rstrip('\\n')\r\n\u001b[?2004l\r"]
[73.237018, "o", "\u001b[?2004h> "]
[73.237082, "o", "            if not line:\r\n\u001b[?2004l\r"]
[73.237113, "o", "\u001b[?2004h> "]
[73.237184, "o", "                continue\r\n\u001b[?2004l\r"]
[73.237215, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[73.237243, "o", "\u001b[?2004h> "]
[73.237339, "o", "            # Normalize the line\r\n\u001b[?2004l\r"]
[73.237367, "o", "\u001b[?2004h"]
[73.237399, "o", "> "]
[73.2375, "o", "            normalized = normalize_line(line)\r\n\u001b[?2004l\r"]
[73.237532, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[73.23756, "o", "\u001b[?2004h"]
[73.237591, "o", "> "]
[73.237657, "o", "            # Classify line type\r\n\u001b[?2004l\r"]
[73.237688, "o", "\u001b[?2004h> "]
[73.237828, "o", "            line_type = classify_line(normalized)\r\n\u001b[?2004l\r"]
[73.23786, "o", "\u001b[?2004h> "]
[73.237892, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.238023, "o", "            if line_type == 'structured':\r\n\u001b[?2004l\r"]
[73.238057, "o", "\u001b[?2004h> "]
[73.238169, "o", "                # Route to structured.log\r\n\u001b[?2004l\r"]
[73.238199, "o", "\u001b[?2004h> "]
[73.2384, "o", "                output_path = os.path.join(OUTPUT_DIR, 'structured.log')\r\n\u001b[?2004l\r"]
[73.238432, "o", "\u001b[?2004h> "]
[73.238579, "o", "                if output_path not in output_files:\r\n\u001b[?2004l\r"]
[73.238608, "o", "\u001b[?2004h> "]
[73.238816, "o", "                    output_files[output_path] = open(output_path, 'w')\r\n\u001b[?2004l\r"]
[73.238847, "o", "\u001b[?2004h> "]
[73.239028, "o", "                output_files[output_path].write(line + '\\n')\r\n\u001b[?2004l\r"]
[73.239062, "o", "\u001b[?2004h> "]
[73.239128, "o", "                continue\r\n\u001b[?2004l\r"]
[73.239153, "o", "\u001b[?2004h> "]
[73.239181, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[73.239212, "o", "> "]
[73.239295, "o", "            # Get severity and service\r\n\u001b[?2004l\r"]
[73.239322, "o", "\u001b[?2004h"]
[73.239353, "o", "> "]
[73.239488, "o", "            severity = get_severity(normalized, patterns)\r\n\u001b[?2004l\r"]
[73.239515, "o", "\u001b[?2004h> "]
[73.239672, "o", "            service = get_service(normalized, patterns)\r\n\u001b[?2004l\r"]
[73.239701, "o", "\u001b[?2004h> "]
[73.239734, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.239836, "o", "            # Route based on rules\r\n\u001b[?2004l\r"]
[73.23986, "o", "\u001b[?2004h"]
[73.239886, "o", "> "]
[73.240094, "o", "            output_file = route_line(normalized, severity, service, routing)\r\n\u001b[?2004l\r"]
[73.240125, "o", "\u001b[?2004h> "]
[73.2403, "o", "            output_path = os.path.join(OUTPUT_DIR, output_file)\r\n\u001b[?2004l\r"]
[73.240332, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[73.240359, "o", "\u001b[?2004h> "]
[73.240497, "o", "            if output_path not in output_files:\r\n\u001b[?2004l\r"]
[73.240528, "o", "\u001b[?2004h> "]
[73.240713, "o", "                output_files[output_path] = open(output_path, 'w')\r\n\u001b[?2004l\r"]
[73.240745, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[73.240772, "o", "\u001b[?2004h> "]
[73.240932, "o", "            output_files[output_path].write(line + '\\n')\r\n\u001b[?2004l\r"]
[73.240974, "o", "\u001b[?2004h> "]
[73.241008, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.241089, "o", "    # Close all output files\r\n\u001b[?2004l\r"]
[73.24112, "o", "\u001b[?2004h> "]
[73.241221, "o", "    for f in output_files.values():\r\n\u001b[?2004l\r"]
[73.241252, "o", "\u001b[?2004h> "]
[73.241303, "o", "        f.close()\r\n\u001b[?2004l\r"]
[73.241334, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[73.241366, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[73.241397, "o", "\u001b[?2004h> "]
[73.241477, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[73.241508, "o", "\u001b[?2004h> "]
[73.241562, "o", "    process_logs()\r\n\u001b[?2004l\r"]
[73.241592, "o", "\u001b[?2004h> "]
[73.241623, "o", "EOF\r\n\u001b[?2004l\r"]
[73.268064, "o", "\u001b[?2004hroot@cc0d12aebac5:/home/user/logpipe# "]
[78.504468, "i", "rm -rf output/*\n"]
[78.504593, "o", "rm -rf output/*\r\n\u001b[?2004l\r"]
[78.507463, "o", "\u001b[?2004hroot@cc0d12aebac5:/home/user/logpipe# "]
[78.607981, "i", "python3 filter.py\n"]
[78.608097, "o", "python3 filter.py\r\n\u001b[?2004l\r"]
[78.66014, "o", "\u001b[?2004hroot@cc0d12aebac5:/home/user/logpipe# "]
