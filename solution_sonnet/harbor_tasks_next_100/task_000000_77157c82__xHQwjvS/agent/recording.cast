[84.137122, "o", "drwxrwxrwx 1 root root  4096 May  5 05:06 \u001b[0m\u001b[34;42m.\u001b[0m\r\ndrwxrwxrwx 1 root root  4096 May  5 05:06 \u001b[34;42m..\u001b[0m\r\n-rw-r--r-- 1 root root 14830 May  5 05:06 debug.log\r\n-rw-r--r-- 1 root root 12108 May  5 05:06 errors.log\r\n"]
[84.137156, "o", "-rw-r--r-- 1 root root 18141 May  5 05:06 info.log\r\n-rw-r--r-- 1 root root   635 May  5 05:06 structured.log\r\n-rw-r--r-- 1 root root  6566 May  5 05:06 warnings.log\r\n"]
[84.137352, "o", "\u001b[?2004h"]
[84.137384, "o", "root@cc0d12aebac5:/home/user/logpipe# "]
