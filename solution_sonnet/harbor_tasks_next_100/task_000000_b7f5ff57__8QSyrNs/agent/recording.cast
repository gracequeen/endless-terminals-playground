[18.468646, "o", "#!/bin/bash\r\nset -e\r\n\r\ncd /home/user/loadtest\r\n\r\necho \"Starting benchmark run...\"\r\n\r\n# Run the client to make requests\r\npython3 client.py 200\r\n\r\n# Aggregate the results\r\npython3 aggregate.py\r\n\r\n# Print the report\r\npython3 report.py\r\n\r\necho \"Benchmark complete.\"\r\n"]
