[18.3531, "o", "#!/bin/bash\r\npython3 /home/user/webhooks/validator.py \"$1\"\r\nexit $?\r\n"]
[18.35325, "o", "\u001b[?2004h"]
[18.353291, "o", "user@1336df948b94:~/webhooks$ "]
