[39.068443, "i", "while read f; do echo \"Processing $f...\"; cp \"$f\" \"$f.corrupt\"; gunzip -c \"$f\" 2>/dev/null > \"${f%.gz}\".recovered || true; if [ -s \"${f%.gz}\".recovered ]; then gzip -c \"${f%.gz}\".recovered > \"$f.new\" && mv \"$f.new\" \"$f\" && rm \"${f%.gz}\".recovered && echo \"  Recovered: $f\"; else echo \"  FAILED: $f (no data recovered)\"; rm -f \"${f%.gz}\".recovered; fi; done < /tmp/corrupt_files.txt\n"]
