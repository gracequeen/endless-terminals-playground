[14.045933, "o", "drwxrwxrwx 1 root root 4096 May  5 05:36 \u001b[0m\u001b[34;42m.\u001b[0m\r\ndrwxrwxrwx 1 root root 4096 May  5 05:36 \u001b[34;42m..\u001b[0m\r\n-rw-rw-rw- 1 root root  876 May  5 05:36 auth.py\r\n-rw-rw-rw- 1 root root  596 May  5 05:36 backend.py\r\n-rw-rw-rw- 1 root root  872 May  5 05:36 gateway.py\r\n-rw-rw-rw- 1 root root   15 May  5 05:36 requirements.txt\r\n-rwxr-xr-x 1 root root  538 May  5 05:36 \u001b[01;32mstart_mesh.sh\u001b[0m\r\n"]
