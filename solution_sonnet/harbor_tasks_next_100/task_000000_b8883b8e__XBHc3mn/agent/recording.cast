[30.747811, "o", "cat app/config.py\r\n\u001b[?2004l\r"]
[30.74869, "o", "# Application Configuration\r\n\r\nDATABASE_PATH = \"/home/user/pentest/inventory.db\"\r\nSECRET_KEY = \"super-secret-key-change-in-production\"\r\n\r\n# Authentication settings\r\nSESSION_TIMEOUT = 3600\r\nMAX_LOGIN_ATTEMPTS = 5\r\n\r\n# Legacy authentication table\r\n# TODO: migrate users off PIN auth\r\nLEGACY_AUTH_TABLE = \"_legacy_auth\"\r\n\r\n# API settings\r\nAPI_KEY_LENGTH = 32\r\n"]
[30.748887, "o", "\u001b[?2004huser@2fb2e930080b:~/pentest$ "]
[30.860829, "i", "cat app/auth.py\n"]
[30.860972, "o", "cat app/auth.py\r\n\u001b[?2004l\r"]
[30.861762, "o", "\"\"\"Authentication module for the inventory application.\"\"\"\r\n\r\nimport sqlite3\r\nimport hashlib\r\nfrom config import DATABASE_PATH, LEGACY_AUTH_TABLE\r\n\r\n\r\ndef get_db_connection():\r\n    \"\"\"Get a database connection.\"\"\"\r\n    return sqlite3.connect(DATABASE_PATH)\r\n\r\n\r\ndef check_password(username, password_hash_input):\r\n    \"\"\"Check bcrypt password hash against stored hash.\"\"\"\r\n    conn = get_db_connection()\r\n    cursor = conn.cursor()\r\n    cursor.execute(\r\n        \"SELECT password_hash FROM users WHERE username = ?\",\r\n        (username,)\r\n    )\r\n    result = cursor.fetchone()\r\n    conn.close()\r\n\r\n    if result:\r\n        # In production, use bcrypt.checkpw()\r\n        return result[0] == password_hash_input\r\n    return False\r\n\r\n\r\ndef check_legacy_pin(username, pin):\r\n    \"\"\"\r\n    Check legacy 4-digit PIN for quick login.\r\n    This is the old authentication method - should be deprecated.\r\n    \"\"\"\r\n    conn = get_db_connection()\r\n    cursor = conn.cursor()\r\n    # Query the legacy auth table directly\r\n    query = f\"SELEC"]
[30.861858, "o", "T pin FROM {LEGACY_AUTH_TABLE} WHERE username = ?\"\r\n    cursor.execute(query, (username,))\r\n    result = cursor.fetchone()\r\n    conn.close()\r\n\r\n    if result:\r\n        return result[0] == pin\r\n    return False\r\n\r\n\r\ndef validate_api_key(key):\r\n    \"\"\"Validate an API key by checking its SHA256 hash.\"\"\"\r\n    conn = get_db_connection()\r\n    cursor = conn.cursor()\r\n    key_hash = hashlib.sha256(key.encode()).hexdigest()\r\n    cursor.execute(\r\n        \"SELECT user_id FROM api_keys WHERE key_hash = ?\",\r\n        (key_hash,)\r\n    )\r\n    result = cursor.fetchone()\r\n    conn.close()\r\n    return result is not None\r\n"]
[30.861974, "o", "\u001b[?2004h"]
[30.862018, "o", "user@2fb2e930080b:~/pentest$ "]
[30.967485, "i", "cat app/routes.py\n"]
[30.967613, "o", "cat app/routes.py\r\n"]
[30.967653, "o", "\u001b[?2004l\r"]
[30.968588, "o", "\"\"\"Flask routes for the inventory application.\"\"\"\r\n\r\nfrom flask import Flask, request, jsonify\r\nfrom auth import check_password, check_legacy_pin, validate_api_key\r\n\r\napp = Flask(__name__)\r\n\r\n\r\n@app.route('/api/login', methods=['POST'])\r\ndef login():\r\n    \"\"\"Standard login endpoint using username and password.\"\"\"\r\n    data = request.get_json()\r\n    username = data.get('username')\r\n    password = data.get('password')\r\n\r\n    if check_password(username, password):\r\n        return jsonify({\"status\": \"success\", \"message\": \"Logged in\"})\r\n    return jsonify({\"status\": \"error\", \"message\": \"Invalid credentials\"}), 401\r\n\r\n\r\n@app.route('/api/quick-login', methods=['POST'])\r\ndef quick_login():\r\n    \"\"\"\r\n    Quick login endpoint using 4-digit PIN.\r\n    Legacy feature for mobile app compatibility.\r\n    Accepts username and 4-digit PIN."]
[30.968652, "o", "\r\n    \"\"\"\r\n    data = request.get_json()\r\n    username = data.get('username')\r\n    pin = data.get('pin')\r\n\r\n    if not pin or len(pin) != 4 or not pin.isdigit():\r\n        return jsonify({\"status\": \"error\", \"message\": \"PIN must be 4 digits\"}), 400\r\n\r\n    if check_legacy_pin(username, pin):\r\n        return jsonify({\"status\": \"success\", \"message\": \"Quick login successful\"})\r\n    return jsonify({\"status\": \"error\", \"message\": \"Invalid PIN\"}), 401\r\n\r\n\r\n@app.route('/api/inventory', methods=['GET'])\r\ndef get_inventory():\r\n    \"\"\"Get inventory items. Requires API key.\"\"\"\r\n    api_key = request.headers.get('X-API-Key')\r\n    if not api_key or not validate_api_key(api_key):\r\n        return jsonify({\"status\": \"error\", \"message\": \"Invalid API key\"}), 401\r\n\r\n    # Return inventory data\r\n    return jsonify({\"status\": \"success\", \"items\": []})\r\n\r\n\r\nif __name__ == '__main__':\r\n    app.run(debug=True)\r\n"]
[30.968858, "o", "\u001b[?2004h"]
[30.96892, "o", "user@2fb2e930080b:~/pentest$ "]
[31.077821, "i", "cat app/models.py\n"]
[31.07794, "o", "cat app/models.py\r\n\u001b[?2004l\r"]
[31.078835, "o", "\"\"\"ORM models for the inventory application.\"\"\"\r\n\r\n# Note: Using raw SQL for some legacy tables that don't fit the ORM pattern\r\n\r\nclass User:\r\n    \"\"\"User model - maps to 'users' table.\"\"\"\r\n\r\n    def __init__(self, id, username, password_hash):\r\n        self.id = id\r\n        self.username = username\r\n        self.password_hash = password_hash\r\n\r\n    @staticmethod\r\n    def table_name():\r\n        return 'users'\r\n\r\n\r\nclass Session:\r\n    \"\"\"Session model - maps to 'sessions' table.\"\"\"\r\n\r\n"]
[31.078895, "o", "    def __init__(self, id, user_id, session_token, created_at):\r\n        self.id = id\r\n        self.user_id = user_id\r\n        self.session_token = session_token\r\n        self.created_at = created_at\r\n\r\n    @staticmethod\r\n    def table_name():\r\n        return 'sessions'\r\n\r\n\r\nclass ApiKey:\r\n    \"\"\"API Key model - maps to 'api_keys' table.\"\"\"\r\n\r\n    def __init__(self, id, user_id, key_hash):\r\n        self.id = id\r\n        self.user_id = user_id\r\n        self.key_hash = key_hash\r\n\r\n    @staticmethod\r\n    def table_name():\r\n        return 'api_keys'\r\n\r\n\r\nclass AuditLog:\r\n    \"\"\"Audit log model - maps to 'audit_log' table.\"\"\"\r\n\r\n    def __init__(self, id, user_id, action, details, timestamp):\r\n        self.id = id\r\n        self.user_id = user_id\r\n        self.action = action\r\n        self.details = details\r\n        self.timestamp = timestamp\r\n\r\n    @staticmethod\r\n    def table_name():\r\n        return 'audit_log'\r\n\r\n\r\n# Note: _legacy_auth table is not represented here as it's being phased out\r\n# and uses raw SQL qu"]
[31.078933, "o", "eries in auth.py for backward compatibility\r\n"]
