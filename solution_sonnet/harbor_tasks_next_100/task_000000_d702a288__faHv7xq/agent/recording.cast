[138.670734, "o", "\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KSEVERITY=$(grep -E \"^\u001b[01;31m\u001b[Kseverity\u001b[m\u001b[K_threshold:\" \"$CONFIG_FILE\" | awk '{print $2}' | tr -d '\"' | tr -d \"'\")\r\n\u001b[32m\u001b[K26\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# Add \u001b[01;31m\u001b[Kseverity\u001b[m\u001b[K threshold\r\n\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    SEMGREP_CMD=\"$SEMGREP_CMD --\u001b[01;31m\u001b[Kseverity\u001b[m\u001b[K $SEVERITY\"\r\n"]
[138.670814, "o", "\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K# Exit nonzero if there are WARNING or ERROR \u001b[01;31m\u001b[Kseverity\u001b[m\u001b[K findings\r\n\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KWARNING_COUNT=$(jq '[.results[] | select(.extra.\u001b[01;31m\u001b[Kseverity\u001b[m\u001b[K == \"WARNING\" or .extra.\u001b[01;31m\u001b[Kseverity\u001b[m\u001b[K == \"ERROR\")] | length' \"$REPORT_FILE\")\r\n"]
[138.670969, "o", "\u001b[?2004h"]
