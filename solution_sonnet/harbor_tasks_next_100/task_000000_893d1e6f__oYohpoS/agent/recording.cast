[61.513155, "i", "cat > /tmp/verify_all.sh << 'EOF'\n#!/bin/bash\n\nREPO_DIR=\"/var/repo/maven\"\nmismatch_count=0\nverified_count=0\n\nfind \"$REPO_DIR\" -name '*.jar' | while read -r jar_file; do\n    sha1_file=\"${jar_file}.sha1\"\n    \n    if [ ! -f \"$sha1_file\" ]; then\n        echo \"ERROR: Missing SHA1 file for $jar_file\"\n        mismatch_count=$((mismatch_count + 1))\n        continue\n    fi\n    \n    expected_sha1=$(cat \"$sha1_file\" | tr -d '[:space:]')\n    actual_sha1=$(sha1sum \"$jar_file\" | cut -d' ' -f1)\n    \n    if [ \"$expected_sha1\" = \"$actual_sha1\" ]; then\n        verified_count=$((verified_count + 1))\n    else\n        echo \"MISMATCH: $jar_file\"\n        echo \"  Expected: $expected_sha1\"\n        echo \"  Actual:   $actual_sha1\"\n        mismatch_count=$((mismatch_count + 1))\n    fi\ndone\n\necho \"Verification complete.\"\nEOF\n"]
