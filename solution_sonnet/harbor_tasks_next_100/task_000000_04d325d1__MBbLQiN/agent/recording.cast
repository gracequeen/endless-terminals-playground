[17.784724, "o", "cat config.yaml\r\n\u001b[?2004l\r"]
[17.785616, "o", "port: 8080\r\nstartup_timeout: 5s\r\ncache_warmup: true\r\nwarmup_endpoint: \"http://localhost:9999/warmup\"\r\ndb_pool_size: 10\r\nservice_name: \"profilesvc\"\r\n"]
