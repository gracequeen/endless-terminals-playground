[24.914336, "o", "root@eb0cd99bce13:/home/user/profilesvc# "]
[25.018493, "i", "cat internal/cache/cache.go\n"]
[25.018618, "o", "cat internal/cache/cache.go\r\n"]
[25.018658, "o", "\u001b[?2004l\r"]
[25.01948, "o", "package cache\r\n\r\nimport (\r\n\t\"context\"\r\n\t\"fmt\"\r\n\t\"net/http\"\r\n\t\"sync\"\r\n\t\"time\"\r\n)\r\n\r\nvar (\r\n\tinitialized bool\r\n\tinitError   error\r\n\tmu          sync.RWMutex\r\n)\r\n\r\ntype Config interface {"]
[25.019519, "o", "\r\n\tGetCacheWarmup() bool\r\n\tGetWarmupEndpoint() string\r\n\tGetStartupTimeout() time.Duration\r\n}\r\n\r\nfunc Init(cfg Config) error {\r\n\tmu.Lock()\r\n\tdefer mu.Unlock()\r\n\r\n\tif !cfg.GetCacheWarmup() {\r\n\t\tinitialized = true\r\n\t\tinitError = nil\r\n\t\treturn nil\r\n\t}\r\n\r\n\tendpoint := cfg.GetWarmupEndpoint()\r\n\t// BUG: ignores the startup_timeout from config and uses hardcoded 30s\r\n\t// The context with cfg.GetStartupTimeout() is created but not used properly\r\n\t_ = cfg.GetStartupTimeout() // pretend we use it\r\n\r\n\tctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)\r\n\tdefer cancel()\r\n\r\n\t"]
[25.019564, "o", "req, err := http.NewRequestWithContext(ctx, \"GET\", endpoint, nil)\r\n\tif err != nil {\r\n\t\tinitError = fmt.Errorf(\"failed to create warmup request: %w\", err)\r\n\t\tinitialized = false\r\n\t\treturn initError\r\n\t}\r\n\r\n\tclient := &http.Client{Timeout: 30 * time.Second}\r\n\tresp, err := client.Do(req)\r\n\tif err != nil {\r\n\t\tinitError = fmt.Errorf(\"cache warmup failed: %w\", err)\r\n\t\tinitialized = false\r\n\t\treturn initError\r\n\t}\r\n\tdefer resp.Body.Close()\r\n\r\n\tif resp.StatusCode != http.StatusOK {\r\n\t\tinitError = fmt.Errorf(\"cache warmup returned status %d\", resp.StatusCode)\r\n\t\tinitialized = false\r\n\t\treturn initError\r\n\t}\r\n\r\n\tinitialized = true\r\n\tinitError = nil\r\n\treturn nil\r\n}\r\n\r\nfunc MustBeReady() {\r\n\tmu.RLock()\r\n\tdefer mu.RUnlock()\r\n\r\n\tif !initialized || initError != nil {\r\n\t\tpanic(fmt.Sprintf(\"cache not properly initialized: %v\", initError))\r\n\t}\r\n}\r\n\r\nfunc IsReady() bool {\r\n\tmu.RLock()\r\n\tdefer mu.RUnlock()\r\n\treturn initialized && initError == nil\r\n}\r\n"]
[25.019737, "o", "\u001b[?2004h"]
[25.01977, "o", "root@eb0cd99bce13:/home/user/profilesvc# "]
[35.052287, "i", "cat internal/db/db.go\n"]
[35.052413, "o", "cat internal/db/db.go\r\n\u001b[?2004l\r"]
[35.053317, "o", "package db\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\r\n\t\"profilesvc/internal/cache\"\r\n)\r\n\r\ntype Config interface {\r\n\tGetDBPoolSize() int\r\n}\r\n\r\n"]
[35.053358, "o", "var poolSize int\r\n\r\nfunc Init(cfg Config) (err error) {\r\n\t// Added after \"cleanup\" - require cache to be ready before DB init\r\n\t// This was added to ensure proper initialization order\r\n\tdefer func() {\r\n\t\tif r := recover(); r != nil {\r\n\t\t\tfmt.Fprintf(os.Stderr, \"db init panic: %v\\n\", r)\r\n\t\t\tos.Exit(1)\r\n\t\t}\r\n\t}()\r\n\r\n\t// This will panic if cache init failed\r\n\tcache.MustBeReady()\r\n\r\n\tpoolSize = cfg.GetDBPoolSize()\r\n\tif poolSize <= 0 {\r\n\t\tpoolSize = 5\r\n\t}\r\n\r\n\t// Mock DB initialization - no real database needed\r\n\tfmt.Printf(\"db pool initialized with size %d\\n\", poolSize)\r\n\treturn nil\r\n}\r\n\r\nfunc GetPoolSize() int {\r\n\treturn poolSize\r\n}\r\n"]
