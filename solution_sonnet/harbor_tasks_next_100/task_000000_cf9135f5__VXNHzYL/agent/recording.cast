[7.080501, "o", "{\r\n  \"name\": \"pg-backup-tool\",\r\n  \"version\": \"2.3.1\",\r\n  \"description\": \"A PostgreSQL backup utility with support for full and differential backups\",\r\n  \"main\": \"index.js\",\r\n  \"scripts\": {\r\n    \"start\": \"node index.js\",\r\n    \"test\": \"jest\",\r\n    \"lint\": \"eslint .\"\r\n  },\r\n  \"keywords\": [\r\n    \"postgresql\",\r\n    \"backup\","]
