[50.280438, "o", "#!/bin/bash\r\n\r\n# Firewall rule applier script\r\n# Reads rules.conf and generates iptables commands\r\n# Applies iptables rules and logs them to applied.log\r\n\r\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\r\nRULES_FILE=\"$SCRIPT_DIR/rules.conf\"\r\nOUTPUT_LOG=\"$SCRIPT_DIR/applied.log\"\r\n\r\nif [[ ! -f \"$RULES_FILE\" ]]; then\r\n    echo \"Error: rules.conf not found\"\r\n    exit 1\r\nfi\r\n\r\n# Clear output log\r\n> \"$OUTPUT_LOG\"\r\n\r\necho \"# Firewall rules applied at $(date)\" >> \"$OUTPUT_LOG\"\r\necho \"# Rules being executed\" >> \"$OUTPUT_LOG\"\r\necho \"\" >> \"$OUTPUT_LOG\"\r\n\r\nwhile IFS= read -r line || [[ -n \"$line\" ]]; do\r\n    # Skip comments and empty lines\r\n    [[ \"$line\" =~ ^[[:space:]]*# ]] && continue\r\n    [[ -z \"${line// }\" ]] && continue\r\n\r\n    # Parse default policies\r\n"]
[50.280492, "o", "    if [[ \"$line\" =~ ^default_input:[[:space:]]*(.+)$ ]]; then\r\n        policy=\"${BASH_REMATCH[1]}\"\r\n        policy_upper=$(echo \"$policy\" | tr '[:lower:]' '[:upper:]')\r\n        cmd=\"iptables -P INPUT $policy_upper\"; echo \"$cmd\" >> \"$OUTPUT_LOG\"; eval \"$cmd\"\r\n        continue\r\n    fi\r\n\r\n    if [[ \"$line\" =~ ^default_output:[[:space:]]*(.+)$ ]]; then\r\n        policy=\"${BASH_REMATCH[1]}\"\r\n        policy_upper=$(echo \"$policy\" | tr '[:lower:]' '[:upper:]')\r\n        cmd=\"iptables -P OUTPUT $policy_upper\"; echo \"$cmd\" >> \"$OUTPUT_LOG\"; eval \"$cmd\"\r\n        continue\r\n    fi\r\n\r\n    # Parse allow in state established,related\r\n    if [[ \"$line\" =~ ^allow[[:space:]]+in[[:space:]]+state[[:space:]]+(.+)$ ]]; then\r\n        states=\"${BASH_REMATCH[1]}\"\r\n        states_upper=$(echo \"$states\" | tr '[:lower:]' '[:upper:]')\r\n        cmd=\"iptables -A INPUT -m state --state $states_upper -j ACCEPT\"; echo \"$cmd\" >> \"$OUTPUT_LOG\"; eval \"$cmd\"\r\n        continue\r\n    fi\r\n\r\n    # Parse allow in tcp PORT from CIDR/any\r\n    if [[ \"$line"]
[50.280536, "o", "\" =~ ^allow[[:space:]]+in[[:space:]]+tcp[[:space:]]+([0-9]+)[[:space:]]+from[[:space:]]+(.+)$ ]]; then\r\n        port=\"${BASH_REMATCH[1]}\"\r\n        source=\"${BASH_REMATCH[2]}\"\r\n        if [[ \"$source\" == \"any\" ]]; then\r\n            cmd=\"iptables -A INPUT -p tcp --dport $port -j ACCEPT\"; echo \"$cmd\" >> \"$OUTPUT_LOG\"; eval \"$cmd\"\r\n        else\r\n            cmd=\"iptables -A INPUT -p tcp --dport $port -s $source -j ACCEPT\"; echo \"$cmd\" >> \"$OUTPUT_LOG\"; eval \"$cmd\"\r\n        fi\r\n        continue\r\n    fi\r\n\r\n    # Parse deny in from CIDR\r\n    if [[ \"$line\" =~ ^deny[[:space:]]+in[[:space:]]+from[[:space:]]+(.+)$ ]]; then\r\n        source=\"${BASH_REMATCH[1]}\"\r\n        cmd=\"iptables -A INPUT -s $source -j DROP\"; echo \"$cmd\" >> \"$OUTPUT_LOG\"; eval \"$cmd\"\r\n        continue\r\n    fi\r\n\r\ndone < \"$RULES_FILE\"\r\n\r\necho \"\" >> \"$OUTPUT_LOG\"\r\necho \"# End of rules\" >> \"$OUTPUT_LOG\"\r\n\r\necho \"Rules applied successfully\"\r\nexit 0\r\n"]
