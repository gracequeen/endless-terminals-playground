[14.200014, "o", "     1\tglobal:\r\n     2\t  resolve_timeout: 5m\r\n     3\t  slack_api_url: 'https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXX'\r\n     4\t\r\n     5\ttemplates:\r\n     6\t  - 'templates/*.tmpl'\r\n     7\t\r\n     8\troute:\r\n     9\t  receiver: 'default-receiver'\r\n    10\t  group_by: ['alertname', 'cluster']\r\n    11\t  group_wait: 30s\r\n    12\t  group_interval: 5m\r\n    13\t  repeat_interval: 4h\r\n    14\t  routes:\r\n    15\t    - match:\r\n    16\t        severity: critical\r\n    17\t      receiver: 'pagerduty-critical'\r\n    18\t    - match:\r\n    19\t        severity: warning\r\n    20\t      receiver: 'slack-warnings'\r\n    21\t"]
[14.200105, "o", "    - match_re:\r\n    22\t        service: ^(foo|bar)$\r\n    23\t      receiver: 'team-backend'\r\n    24\t\r\n    25\treceivers:\r\n    26\t  - name: 'default-receiver'\r\n    27\t    slack_configs:\r\n    28\t      - channel: '#alerts-general'\r\n    29\t        send_resolved: true\r\n    30\t\r\n    31\t  - name: 'pagerduty-critical'\r\n    32\t    pagerduty_configs:\r\n    33\t      - service_key: 'fake-pagerduty-key-12345'\r\n    34\t        severity: critical\r\n    35\t\r\n    36\t  - name: 'slack-warnings'\r\n    37\t    slack_configs:\r\n    38\t      - channel: '#alerts-warnings'\r\n    39\t        send_resolved: true\r\n    40\t\r\n    41\t  - name: 'team-backend'\r\n    42\t"]
