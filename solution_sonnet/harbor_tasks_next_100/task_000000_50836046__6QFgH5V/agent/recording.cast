[60.085963, "o", "        continue\r\n\u001b[?2004l\r"]
[60.085996, "o", "\u001b[?2004h> "]
[60.086023, "o", "    fi\r\n\u001b[?2004l\r"]
[60.086054, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[60.086085, "o", "\u001b[?2004h> "]
[60.086276, "o", "    if [[ \"$line\" =~ ^default_output:[[:space:]]*(.+)$ ]]; then\r\n\u001b[?2004l\r"]
[60.086309, "o", "\u001b[?2004h> "]
[60.086409, "o", "        policy=\"${BASH_REMATCH[1]}\"\r\n\u001b[?2004l\r"]
[60.086441, "o", "\u001b[?2004h> "]
[60.086629, "o", "        policy_upper=$(echo \"$policy\" | tr '[:lower:]' '[:upper:]')\r\n\u001b[?2004l\r"]
[60.086662, "o", "\u001b[?2004h> "]
[60.08682, "o", "        exec_iptables \"iptables -P OUTPUT $policy_upper\"\r\n\u001b[?2004l\r"]
[60.086863, "o", "\u001b[?2004h> "]
[60.08691, "o", "        continue\r\n\u001b[?2004l\r"]
[60.086941, "o", "\u001b[?2004h> "]
[60.086972, "o", "    fi\r\n\u001b[?2004l\r"]
[60.087003, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[60.087035, "o", "\u001b[?2004h> "]
[60.087171, "o", "    # Parse allow in state established,related\r\n\u001b[?2004l\r"]
[60.087207, "o", "\u001b[?2004h> "]
[60.087435, "o", "    if [[ \"$line\" =~ ^allow[[:space:]]+in[[:space:]]+state[[:space:]]+(.+)$ ]]; then\r\n\u001b[?2004l\r"]
[60.087473, "o", "\u001b[?2004h> "]
[60.087569, "o", "        states=\"${BASH_REMATCH[1]}\"\r\n\u001b[?2004l\r"]
[60.087611, "o", "\u001b[?2004h> "]
[60.087789, "o", "        states_upper=$(echo \"$states\" | tr '[:lower:]' '[:upper:]')\r\n\u001b[?2004l\r"]
[60.087821, "o", "\u001b[?2004h> "]
[60.08805, "o", "        exec_iptables \"iptables -A INPUT -m state --state $states_upper -j ACCEPT\"\r\n\u001b[?2004l\r"]
[60.088081, "o", "\u001b[?2004h> "]
[60.088141, "o", "        continue\r\n\u001b[?2004l\r"]
[60.088174, "o", "\u001b[?2004h> "]
[60.088201, "o", "    fi\r\n\u001b[?2004l\r"]
[60.088232, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[60.088259, "o", "\u001b[?2004h> "]
[60.08838, "o", "    # Parse allow in tcp PORT from CIDR/any\r\n\u001b[?2004l\r"]
[60.088413, "o", "\u001b[?2004h> "]
[60.088744, "o", "    if [[ \"$line\" =~ ^allow[[:space:]]+in[[:space:]]+tcp[[:space:]]+([0-9]+)[[:space:]]+from[[:space:]]+(.+)$ ]]; then\r\n\u001b[?2004l\r"]
[60.088784, "o", "\u001b[?2004h> "]
[60.088864, "o", "        port=\"${BASH_REMATCH[1]}\"\r\n\u001b[?2004l\r"]
[60.088896, "o", "\u001b[?2004h> "]
[60.088996, "o", "        source=\"${BASH_REMATCH[2]}\"\r\n\u001b[?2004l\r"]
[60.089033, "o", "\u001b[?2004h> "]
[60.089156, "o", "        if [[ \"$source\" == \"any\" ]]; then\r\n\u001b[?2004l\r"]
[60.089197, "o", "\u001b[?2004h> "]
[60.089402, "o", "            exec_iptables \"iptables -A INPUT -p tcp --dport $port -j ACCEPT\"\r\n\u001b[?2004l\r"]
[60.089439, "o", "\u001b[?2004h> "]
[60.089478, "o", "        else\r\n\u001b[?2004l\r"]
[60.089514, "o", "\u001b[?2004h> "]
[60.089743, "o", "            exec_iptables \"iptables -A INPUT -p tcp --dport $port -s $source -j ACCEPT\"\r\n\u001b[?2004l\r"]
[60.08978, "o", "\u001b[?2004h> "]
[60.089812, "o", "        fi\r\n"]
[60.089842, "o", "\u001b[?2004l\r\u001b[?2004h"]
[60.089872, "o", "> "]
[60.089902, "o", "        continue\r\n\u001b[?2004l\r"]
[60.089943, "o", "\u001b[?2004h> "]
[60.089977, "o", "    fi\r\n\u001b[?2004l\r"]
[60.090012, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[60.090049, "o", "\u001b[?2004h> "]
[60.090178, "o", "    # Parse deny in from CIDR\r\n\u001b[?2004l\r"]
[60.090214, "o", "\u001b[?2004h"]
[60.090254, "o", "> "]
[60.090477, "o", "    if [[ \"$line\" =~ ^deny[[:space:]]+in[[:space:]]+from[[:space:]]+(.+)$ ]]; then\r\n\u001b[?2004l\r"]
[60.09052, "o", "\u001b[?2004h> "]
[60.090617, "o", "        source=\"${BASH_REMATCH[1]}\"\r\n\u001b[?2004l\r"]
[60.090654, "o", "\u001b[?2004h> "]
[60.090822, "o", "        exec_iptables \"iptables -A INPUT -s $source -j DROP\"\r\n\u001b[?2004l\r"]
[60.090865, "o", "\u001b[?2004h> "]
[60.090914, "o", "        continue\r\n\u001b[?2004l\r"]
[60.090947, "o", "\u001b[?2004h> "]
[60.090978, "o", "    fi\r\n\u001b[?2004l\r"]
[60.091011, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[60.091042, "o", "\u001b[?2004h> "]
[60.091107, "o", "done < \"$RULES_FILE\"\r\n\u001b[?2004l\r"]
[60.091139, "o", "\u001b[?2004h> "]
[60.091167, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.091198, "o", "> "]
[60.091244, "o", "echo \"\" >> \"$OUTPUT_LOG\"\r\n\u001b[?2004l\r"]
[60.091278, "o", "\u001b[?2004h> "]
[60.091384, "o", "echo \"# End of rules\" >> \"$OUTPUT_LOG\"\r\n\u001b[?2004l\r"]
[60.091445, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[60.091485, "o", "> "]
[60.091566, "o", "echo \"Rules applied successfully\"\r\n\u001b[?2004l\r"]
[60.091608, "o", "\u001b[?2004h> "]
[60.091649, "o", "exit 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.091687, "o", "> "]
[60.091726, "o", "EOFSCRIPT\r\n\u001b[?2004l\r"]
[60.094014, "o", "\u001b[?2004h"]
[60.094076, "o", "root@b51c0756dbfa:/home/user/firewall# "]
