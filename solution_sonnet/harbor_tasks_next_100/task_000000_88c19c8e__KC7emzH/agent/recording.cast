[139.201803, "o", "\u001b[?2004h> "]
[139.201876, "o", "                continue\r\n\u001b[?2004l\r"]
[139.201906, "o", "\u001b[?2004h> "]
[139.202011, "o", "            elif data[0] == \"CHUNK\":\r\n\u001b[?2004l\r"]
[139.202039, "o", "\u001b[?2004h> "]
[139.202139, "o", "                chunk_id = data[1]\r\n\u001b[?2004l\r"]
[139.202164, "o", "\u001b[?2004h"]
[139.202192, "o", "> "]
[139.202267, "o", "                chunk_df = data[2]\r\n\u001b[?2004l\r"]
[139.202294, "o", "\u001b[?2004h> "]
[139.202346, "o", "                \r\n\u001b[?2004l\r"]
[139.20237, "o", "\u001b[?2004h"]
[139.202412, "o", "> "]
[139.202594, "o", "                print(f\"Worker {worker_id}: Processing chunk {chunk_id}\")\r\n\u001b[?2004l\r"]
[139.202623, "o", "\u001b[?2004h> "]
[139.202649, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.202677, "o", "> "]
[139.202918, "o", "                # FIX: Use transform() with the shared fitted vectorizer, not fit_transform()\r\n\u001b[?2004l\r"]
[139.202947, "o", "\u001b[?2004h> "]
[139.203091, "o", "                texts = chunk_df[\"text\"].tolist()\r\n\u001b[?2004l\r"]
[139.20312, "o", "\u001b[?2004h> "]
[139.203294, "o", "                tfidf_matrix = vectorizer.transform(texts)\r\n\u001b[?2004l\r"]
[139.203321, "o", "\u001b[?2004h> "]
[139.203349, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.203375, "o", "> "]
[139.203562, "o", "                # Convert to DataFrame with feature names as columns\r\n\u001b[?2004l\r"]
[139.203597, "o", "\u001b[?2004h> "]
[139.20378, "o", "                feature_names = vectorizer.get_feature_names_out()\r\n\u001b[?2004l\r"]
[139.203809, "o", "\u001b[?2004h> "]
[139.203925, "o", "                result_df = pd.DataFrame(\r\n\u001b[?2004l\r"]
[139.203954, "o", "\u001b[?2004h> "]
[139.20408, "o", "                    tfidf_matrix.toarray(),\r\n\u001b[?2004l\r"]
[139.204108, "o", "\u001b[?2004h> "]
[139.204229, "o", "                    columns=feature_names\r\n\u001b[?2004l\r"]
[139.204256, "o", "\u001b[?2004h> "]
[139.204312, "o", "                )\r\n\u001b[?2004l\r"]
[139.204341, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[139.20437, "o", "\u001b[?2004h> "]
[139.204487, "o", "                # Send result back\r\n\u001b[?2004l\r"]
[139.20451, "o", "\u001b[?2004h"]
[139.204529, "o", "> "]
[139.204698, "o", "                result_msg = pickle.dumps((chunk_id, result_df))\r\n\u001b[?2004l\r"]
[139.204733, "o", "\u001b[?2004h"]
[139.20476, "o", "> "]
[139.204838, "o", "                sender.send(result_msg)\r\n\u001b[?2004l\r"]
[139.204865, "o", "\u001b[?2004h> "]
[139.204893, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[139.204922, "o", "> "]
[139.205007, "o", "                chunks_processed += 1\r\n\u001b[?2004l\r"]
[139.205037, "o", "\u001b[?2004h> "]
[139.205316, "o", "                print(f\"Worker {worker_id}: Completed chunk {chunk_id} (total: {chunks_processed})\")\r\n\u001b[?2004l\r"]
[139.205344, "o", "\u001b[?2004h"]
[139.205371, "o", "> "]
[139.205413, "o", "            else:\r\n"]
[139.205443, "o", "\u001b[?2004l\r\u001b[?2004h"]
[139.205472, "o", "> "]
[139.205666, "o", "                print(f\"Worker {worker_id}: Unknown message type: {data[0]}\")\r\n\u001b[?2004l\r"]
[139.205696, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[139.205724, "o", "\u001b[?2004h> "]
[139.205815, "o", "        except Exception as e:\r\n\u001b[?2004l\r"]
[139.205842, "o", "\u001b[?2004h> "]
[139.205993, "o", "            print(f\"Worker {worker_id}: Error: {e}\")\r\n\u001b[?2004l\r"]
[139.206023, "o", "\u001b[?2004h"]
[139.206047, "o", "> "]
[139.206076, "o", "            break\r\n\u001b[?2004l\r"]
[139.206101, "o", "\u001b[?2004h"]
[139.20613, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[139.206158, "o", "> "]
[139.206409, "o", "    print(f\"Worker {worker_id}: Shutting down after processing {chunks_processed} chunks\")\r\n\u001b[?2004l\r"]
[139.206447, "o", "\u001b[?2004h> "]
[139.2065, "o", "    receiver.close()\r\n\u001b[?2004l\r"]
[139.206537, "o", "\u001b[?2004h> "]
[139.206589, "o", "    sender.close()\r\n\u001b[?2004l\r"]
[139.206618, "o", "\u001b[?2004h> "]
[139.206676, "o", "    context.term()\r\n\u001b[?2004l\r"]
[139.206709, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[139.206738, "o", "\u001b[?2004h> "]
[139.206817, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[139.206846, "o", "\u001b[?2004h> "]
[139.20688, "o", "    main()\r\n\u001b[?2004l\r"]
[139.206909, "o", "\u001b[?2004h> "]
[139.206936, "o", "EOF\r\n\u001b[?2004l\r"]
