[126.051517, "o", "\u001b[?2004h> "]
[126.051669, "o", "        # Sort by chunk_id to maintain original order\r\n\u001b[?2004l\r"]
[126.051698, "o", "\u001b[?2004h> "]
[126.051893, "o", "        sorted_results = [results[i] for i in sorted(results.keys())]\r\n\u001b[?2004l\r"]
[126.051922, "o", "\u001b[?2004h> "]
