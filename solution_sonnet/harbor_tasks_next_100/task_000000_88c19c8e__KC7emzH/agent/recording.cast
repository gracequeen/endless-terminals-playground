[126.040043, "i", "cat > pipeline/coordinator.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nCoordinator for distributed tf-idf feature extraction.\nPushes chunks to workers via ZeroMQ, collects results, aggregates.\n\"\"\"\nimport pickle\nimport time\nimport zmq\nimport pandas as pd\nfrom sklearn.feature_extraction.text import TfidfVectorizer\n\ndef main():\n    context = zmq.Context()\n\n    # Socket to send work to workers\n    sender = context.socket(zmq.PUSH)\n    sender.bind(\"tcp://127.0.0.1:5557\")\n\n    # Socket to receive results from workers\n    receiver = context.socket(zmq.PULL)\n    receiver.bind(\"tcp://127.0.0.1:5558\")\n\n    # Load data\n    df = pd.read_parquet(\"/home/user/data/raw.parquet\")\n    print(f\"Coordinator: Loaded {len(df)} rows\")\n\n    # FIX: Fit vocabulary on ALL data first\n    print(\"Coordinator: Fitting vocabulary on full dataset...\")\n    vectorizer = TfidfVectorizer(max_features=100)\n    texts = df[\"text\"].tolist()\n    vectorizer.fit(texts)\n    print(f\"Coordinator: Vocabulary fitted with {len(vectorizer.get_feature_names_out())} "]
[126.040166, "i", "features\")\n\n    # Split into chunks of 1000 rows\n    chunk_size = 1000\n    chunks = [df.iloc[i:i+chunk_size] for i in range(0, len(df), chunk_size)]\n    num_chunks = len(chunks)\n    print(f\"Coordinator: Split into {num_chunks} chunks\")\n\n    # FIX: Wait for workers to connect (give them time to start)\n    print(\"Coordinator: Waiting 2 seconds for workers to connect...\")\n    time.sleep(2)\n\n    # FIX: Send fitted vectorizer to workers first\n    print(\"Coordinator: Sending fitted vectorizer to workers...\")\n    for i in range(3):  # Send to 3 workers\n        vectorizer_msg = pickle.dumps((\"VECTORIZER\", vectorizer))\n        sender.send(vectorizer_msg)\n    print(\"Coordinator: Vectorizer sent to all workers\")\n\n    # Small delay to ensure workers receive vectorizer\n    time.sleep(0.5)\n\n    # Send all chunks\n    print(f\"Coordinator: Sending {num_chunks} chunks to workers\")\n    for chunk_id, chunk in enumerate(chunks):\n        msg = pickle.dumps((\"CHUNK\", chunk_id, chunk))\n        sender.send(msg)\n        print(f\"Coordi"]
[126.040208, "i", "nator: Sent chunk {chunk_id}\")\n\n    # FIX: Collect results using dict to track by chunk_id\n    results = {}\n    print(f\"Coordinator: Waiting for {num_chunks} results...\")\n\n    while len(results) < num_chunks:\n        try:\n            msg = receiver.recv()\n            chunk_id, result_df = pickle.loads(msg)\n            if chunk_id not in results:\n                results[chunk_id] = result_df\n                print(f\"Coordinator: Received result for chunk {chunk_id} ({len(results)}/{num_chunks})\")\n            else:\n                print(f\"Coordinator: Duplicate result for chunk {chunk_id}, ignoring\")\n        except Exception as e:\n            print(f\"Coordinator: Error receiving: {e}\")\n            break\n\n    # FIX: Aggregate results in correct order\n    if len(results) == num_chunks:\n        print(\"Coordinator: All chunks received, aggregating...\")\n        # Sort by chunk_id to maintain original order\n        sorted_results = [results[i] for i in sorted(results.keys())]\n        final_df = pd.concat(sorted_result"]
