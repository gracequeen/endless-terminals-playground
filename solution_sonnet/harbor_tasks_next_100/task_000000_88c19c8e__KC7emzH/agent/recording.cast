[194.593712, "i", "python3 << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Load the distributed output\ndf = pd.read_parquet('/home/user/data/features.parquet')\n\nprint(f\"Shape: {df.shape}\")\nprint(f\"Rows: {len(df)}\")\nprint(f\"Columns: {len(df.columns)}\")\nprint(f\"\\nValue statistics:\")\nprint(f\"  Min: {df.values.min():.6f}\")\nprint(f\"  Max: {df.values.max():.6f}\")\nprint(f\"  Mean: {df.values.mean():.6f}\")\nprint(f\"  NaN count: {df.isna().sum().sum()}\")\n\n# Check if all values are in valid range [0, 1]\nif df.values.min() >= 0 and df.values.max() <= 1:\n    print(\"\\n✓ All TF-IDF values in valid range [0, 1]\")\nelse:\n    print(\"\\n✗ ERROR: TF-IDF values outside valid range!\")\n\n# Check row count\nif len(df) == 50000:\n    print(\"✓ Correct number of rows (50000)\")\nelse:\n    print(f\"✗ ERROR: Expected 50000 rows, got {len(df)}\")\n\nprint(\"\\n\" + \"=\"*50)\nprint(\"SUCCESS: Distributed pipeline produces correct output!\")\nprint(\"=\"*50)\nEOF\n"]
