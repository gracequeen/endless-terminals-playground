[126.047456, "o", "\u001b[?2004h> "]
[126.047514, "o", "    time.sleep(0.5)\r\n\u001b[?2004l\r"]
[126.04755, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[126.047581, "o", "\u001b[?2004h> "]
[126.047638, "o", "    # Send all chunks\r\n\u001b[?2004l\r"]
[126.047671, "o", "\u001b[?2004h> "]
[126.047851, "o", "    print(f\"Coordinator: Sending {num_chunks} chunks to workers\")\r\n\u001b[?2004l\r"]
[126.04788, "o", "\u001b[?2004h> "]
[126.048011, "o", "    for chunk_id, chunk in enumerate(chunks):\r\n\u001b[?2004l\r"]
[126.048043, "o", "\u001b[?2004h"]
[126.048068, "o", "> "]
[126.048212, "o", "        msg = pickle.dumps((\"CHUNK\", chunk_id, chunk))\r\n\u001b[?2004l\r"]
[126.048248, "o", "\u001b[?2004h> "]
