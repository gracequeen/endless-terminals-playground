[139.196002, "i", "cat > pipeline/worker.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nWorker for distributed tf-idf feature extraction.\nReceives chunks from coordinator, computes tf-idf, sends results back.\n\"\"\"\nimport pickle\nimport sys\nimport zmq\nimport pandas as pd\n\ndef main():\n    worker_id = sys.argv[1] if len(sys.argv) > 1 else \"0\"\n\n    context = zmq.Context()\n\n    # Socket to receive work from coordinator\n    receiver = context.socket(zmq.PULL)\n    receiver.connect(\"tcp://127.0.0.1:5557\")\n\n    # Socket to send results to coordinator\n    sender = context.socket(zmq.PUSH)\n    sender.connect(\"tcp://127.0.0.1:5558\")\n\n    print(f\"Worker {worker_id}: Started and connected\")\n\n    # FIX: Wait to receive the fitted vectorizer first\n    vectorizer = None\n    print(f\"Worker {worker_id}: Waiting for vectorizer...\")\n    \n    while vectorizer is None:\n        msg = receiver.recv()\n        data = pickle.loads(msg)\n        \n        if data[0] == \"VECTORIZER\":\n            vectorizer = data[1]\n            print(f\"Worker {worker_id}: Received fitt"]
[139.19612, "i", "ed vectorizer with {len(vectorizer.get_feature_names_out())} features\")\n            break\n\n    chunks_processed = 0\n\n    # Process chunks\n    while True:\n        try:\n            msg = receiver.recv()\n            data = pickle.loads(msg)\n            \n            if data[0] == \"VECTORIZER\":\n                # Ignore duplicate vectorizer messages\n                continue\n            elif data[0] == \"CHUNK\":\n                chunk_id = data[1]\n                chunk_df = data[2]\n                \n                print(f\"Worker {worker_id}: Processing chunk {chunk_id}\")\n\n                # FIX: Use transform() with the shared fitted vectorizer, not fit_transform()\n                texts = chunk_df[\"text\"].tolist()\n                tfidf_matrix = vectorizer.transform(texts)\n\n                # Convert to DataFrame with feature names as columns\n                feature_names = vectorizer.get_feature_names_out()\n                result_df = pd.DataFrame(\n                    tfidf_matrix.toarray(),\n                    columns="]
[139.196156, "i", "feature_names\n                )\n\n                # Send result back\n                result_msg = pickle.dumps((chunk_id, result_df))\n                sender.send(result_msg)\n\n                chunks_processed += 1\n                print(f\"Worker {worker_id}: Completed chunk {chunk_id} (total: {chunks_processed})\")\n            else:\n                print(f\"Worker {worker_id}: Unknown message type: {data[0]}\")\n\n        except Exception as e:\n            print(f\"Worker {worker_id}: Error: {e}\")\n            break\n\n    print(f\"Worker {worker_id}: Shutting down after processing {chunks_processed} chunks\")\n    receiver.close()\n    sender.close()\n    context.term()\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
[139.196193, "o", "cat > pipeline/worker.py << 'EOF'\r\n\u001b[?2004l\rfeature_names\r\n                )\r\n\r\n                # Send result back\r\n                result_msg"]
[139.196238, "o", " = pickle.dumps((chunk_id, result_df))\r\n                sender.send(result_msg)\r\n\r\n                chunks_processed += 1\r\n                "]
[139.196264, "o", "print(f\"Worker {worker_id}: Completed chunk {chunk_id} (total: {chunks_processed})\")\r\n            el"]
[139.196303, "o", "se:\r\n                print(f\"Worker {worker_id}: Unknown message type: {data[0]}\")\r\n\r\n        except Exception as e:\r\n            print(f\"Worker {worker_id}: Error: {e"]
[139.196335, "o", "}\")\r\n            break\r\n\r\n    print(f\"Worker {worker_id}: Shutting down after processing {chunks_processed} chunks\")\r\n    receiver.close()\r\n    sender.clo"]
[139.196377, "o", "se()\r\n    context.term()\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\nEOF\r\n\u001b[?2004h"]
