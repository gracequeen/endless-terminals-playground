[126.04497, "o", "\u001b[?2004h"]
[126.044995, "o", "> "]
[126.045196, "o", "    chunks = [df.iloc[i:i+chunk_size] for i in range(0, len(df), chunk_size)]\r\n\u001b[?2004l\r"]
[126.045224, "o", "\u001b[?2004h> "]
