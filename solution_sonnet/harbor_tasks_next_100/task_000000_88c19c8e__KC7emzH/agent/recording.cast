[126.045539, "o", "\u001b[?2004h"]
[126.045563, "o", "> \r\n\u001b[?2004l\r"]
[126.045594, "o", "\u001b[?2004h> "]
[126.045758, "o", "    # FIX: Wait for workers to connect (give them time to start)\r\n\u001b[?2004l\r"]
[126.045787, "o", "\u001b[?2004h> "]
[126.045983, "o", "    print(\"Coordinator: Waiting 2 seconds for workers to connect...\")\r\n\u001b[?2004l\r"]
[126.046019, "o", "\u001b[?2004h> "]
[126.046068, "o", "    time.sleep(2)\r\n\u001b[?2004l\r"]
[126.046095, "o", "\u001b[?2004h> "]
[126.046126, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[126.046155, "o", "> "]
