[219.052733, "o", "   - Workers called fit_transform() on individual chunks\r\n\u001b[?2004l\r"]
[219.052762, "o", "\u001b[?2004h> "]
[219.052921, "o", "   - This created different vocabularies for each chunk\r\n\u001b[?2004l\r"]
[219.052951, "o", "\u001b[?2004h> "]
[219.053129, "o", "   - When coordinator concatenated results, columns didn't align\r\n\u001b[?2004l\r"]
[219.053155, "o", "\u001b[?2004h> "]
[219.053344, "o", "   - Result: Data corruption, invalid scores, wrong feature counts\r\n\u001b[?2004l\r"]
[219.05337, "o", "\u001b[?2004h"]
[219.053407, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[219.053439, "o", "> "]
[219.053509, "o", "2. RACE CONDITION (Data Loss)\r\n\u001b[?2004l\r"]
[219.053534, "o", "\u001b[?2004h"]
[219.05356, "o", "> "]
[219.053715, "o", "   - Coordinator sent chunks immediately after binding sockets\r\n\u001b[?2004l\r"]
[219.053744, "o", "\u001b[?2004h> "]
[219.053902, "o", "   - Workers hadn't connected yet when chunks were sent\r\n\u001b[?2004l\r"]
[219.05393, "o", "\u001b[?2004h"]
[219.05396, "o", "> "]
[219.05405, "o", "   - Early chunks were dropped by ZeroMQ\r\n\u001b[?2004l\r"]
[219.05408, "o", "\u001b[?2004h> "]
[219.054236, "o", "   - Result: Missing data, only ~12k/50k rows processed\r\n\u001b[?2004l\r"]
[219.054267, "o", "\u001b[?2004h> "]
[219.054294, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.054319, "o", "> "]
[219.054439, "o", "3. NO CHUNK TRACKING (Potential Duplicates)\r\n\u001b[?2004l\r"]
[219.054469, "o", "\u001b[?2004h> "]
[219.054604, "o", "   - Coordinator used a list to collect results\r\n\u001b[?2004l\r"]
[219.054633, "o", "\u001b[?2004h> "]
[219.054775, "o", "   - No deduplication or verification of chunk IDs\r\n\u001b[?2004l\r"]
[219.054803, "o", "\u001b[?2004h> "]
[219.054953, "o", "   - Could process duplicates or miss chunks silently\r\n\u001b[?2004l\r"]
[219.054985, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[219.055012, "o", "\u001b[?2004h> "]
[219.055129, "o", "4. TIMEOUT-BASED COLLECTION (Unreliable)\r\n\u001b[?2004l\r"]
[219.055159, "o", "\u001b[?2004h"]
[219.055185, "o", "> "]
[219.05529, "o", "   - 5-second timeout for receiving results\r\n\u001b[?2004l\r"]
[219.055315, "o", "\u001b[?2004h"]
[219.055341, "o", "> "]
[219.055459, "o", "   - Could exit before all workers finished\r\n\u001b[?2004l\r"]
