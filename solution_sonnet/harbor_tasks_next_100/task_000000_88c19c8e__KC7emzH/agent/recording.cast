[101.920299, "o", "cat pipeline/run.sh\r\n\u001b[?2004l\r"]
[101.921164, "o", "#!/bin/bash\r\n# Run the distributed feature extraction pipeline\r\n\r\ncd /home/user/pipeline\r\n\r\n# Start coordinator in background\r\npython3 coordinator.py &\r\nCOORD_PID=$!\r\n\r\n# Start 3 workers\r\npython3 worker.py 1 &\r\nWORKER1_PID=$!\r\npython3 worker.py 2 &\r\nWORKER2_PID=$!\r\npython3 worker.py 3 &\r\nWORKER3_PID=$!\r\n\r\n# Wait for coordinator to finish\r\nwait $COORD_PID\r\nCOORD_EXIT=$?\r\n\r\n# Kill workers (they spin forever waiting for more work)\r\nkill $WORKER1_PID $WORKER2_PID $WORKER3_PID 2>/dev/null\r\n\r\nexit $COORD_EXIT\r\n"]
[101.921299, "o", "\u001b[?2004h"]
[101.92134, "o", "I have no name!@148def893cbc:~$ "]
