[126.046525, "o", "\u001b[?2004h> "]
[126.046649, "o", "    for i in range(3):  # Send to 3 workers\r\n\u001b[?2004l\r"]
[126.04668, "o", "\u001b[?2004h"]
[126.046709, "o", "> "]
