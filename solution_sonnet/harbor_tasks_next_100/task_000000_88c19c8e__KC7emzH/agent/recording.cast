[126.050989, "o", "\u001b[?2004h"]
[126.051018, "o", "> "]
[126.051123, "o", "    # FIX: Aggregate results in correct order\r\n\u001b[?2004l\r"]
[126.051154, "o", "\u001b[?2004h"]
[126.051179, "o", "> "]
