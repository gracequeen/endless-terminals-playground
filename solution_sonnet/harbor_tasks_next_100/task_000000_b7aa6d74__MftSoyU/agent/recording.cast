[49.137736, "i", "cat > collect.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nCompliance audit metrics collector.\nPulls metrics from auth, billing, and inventory services and produces a consolidated report.\n\"\"\"\n\nimport asyncio\nimport aiohttp\nimport json\nfrom datetime import datetime\n\nSERVICES = {\n    \"auth\": \"http://localhost:9001/metrics\",\n    \"billing\": \"http://localhost:9002/metrics\",\n    \"inventory\": \"http://localhost:9003/metrics\",\n}\n\nTIMEOUT_SECONDS = 5\n\n\nasync def fetch_service_metrics(session, service_name, url):\n    \"\"\"Fetch metrics from a single service.\"\"\"\n    try:\n        async with session.get(url, timeout=aiohttp.ClientTimeout(total=TIMEOUT_SECONDS)) as response:\n            if response.status == 200:\n                return service_name, await response.json()\n            else:\n                print(f\"Error: {service_name} returned status {response.status}\")\n                return service_name, None\n    except asyncio.TimeoutError:\n        print(f\"timeout\")\n        return service_name, None\n    except Exception as e:\n   "]
[49.137902, "i", "     print(f\"Error fetching {service_name}: {e}\")\n        return service_name, None\n\n\nasync def collect_metrics():\n    \"\"\"Collect metrics from all services concurrently.\"\"\"\n    async with aiohttp.ClientSession() as session:\n        # Fetch all services concurrently using gather\n        tasks = [fetch_service_metrics(session, name, url) for name, url in SERVICES.items()]\n        results = await asyncio.gather(*tasks)\n        return dict(results)\n\n\ndef generate_report():\n    \"\"\"Generate the compliance audit report.\"\"\"\n    try:\n        metrics = asyncio.run(collect_metrics())\n    except Exception as e:\n        print(f\"Collection failed: {e}\")\n        metrics = {\"auth\": None, \"billing\": None, \"inventory\": None}\n\n    report = {\n        \"timestamp\": datetime.utcnow().isoformat() + \"Z\",\n        \"auth\": metrics.get(\"auth\"),\n        \"billing\": metrics.get(\"billing\"),\n        \"inventory\": metrics.get(\"inventory\"),\n    }\n\n    with open(\"/home/user/audit/report.json\", \"w\") as f:\n        json.dump(report, f, indent=2)\n\n  "]
[49.137926, "o", "cat > collect.py << 'EOF'\r\n\u001b[?2004l\r     print(f\"Error fetching {service_name}: {e}\")\r\n        return service_name, None\r\n\r\n\r\nasync def c"]
[49.137992, "i", "  return report\n\n\nif __name__ == \"__main__\":\n    report = generate_report()\n    print(json.dumps(report, indent=2))\nEOF\n"]
[49.138027, "o", "ollect_metrics():\r\n    \"\"\"Collect metrics from all services concurrently.\"\"\"\r\n    async with aiohttp.ClientSession() as session:\r\n        # Fetch all services concurrently using gather\r\n        tasks = [fetch_service_metrics(session, name, url) for name, url in SERVICES.items()]"]
[49.138114, "o", "\r\n        results = await asyncio.gather(*tasks)\r\n        return dict(results)\r\n\r\n\r\ndef generate_report():\r\n    \"\"\"Generate the compliance audit report.\"\"\"\r\n    try:\r\n        metrics = asyncio.run(collect_metrics())\r\n  "]
[49.138184, "o", "  except Exception as e:\r\n        print(f\"Collection failed: {e}\")\r\n        metrics = {\"auth\": None, \"billing\": None, \"inventory\": None}\r\n\r\n    report = {\r\n        \"timestamp\": datetime.utcnow().isoformat() + \"Z\",\r\n        \"auth\": metrics.get(\"auth\"),\r\n        \"billing\": metrics.get(\"billing\"),\r\n        \"invento"]
[49.138239, "o", "ry\": metrics.get(\"inventory\"),\r\n    }\r\n\r\n    with open(\"/home/user/audit/report.json\", \"w\") as f:\r\n        json.dump(report, f, indent=2)\r\n\r\n    return report\r\n\r\n\r\nif __name__ == \"__main__\":\r\n   "]
[49.138323, "o", " report = generate_report()\r\n    print(json.dumps(report, indent=2))\r\nEOF\r\n\u001b[?2004h> "]
