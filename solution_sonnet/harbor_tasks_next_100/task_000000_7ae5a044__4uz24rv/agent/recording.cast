[70.579186, "o", "drwxrwxrwx 1 root root 4096 May  5 08:11 \u001b[0m\u001b[34;42m.\u001b[0m\r\ndrwxrwxrwx 1 root root 4096 May  5 08:11 \u001b[34;42m..\u001b[0m\r\n-rw-rw-rw- 1 root root  876 May  5 08:11 auth.py\r\n-rw-rw-rw- 1 root root  596 May  5 08:11 backend.py\r\n-rw-rw-rw- 1 root root  872 May  5 08:11 gateway.py\r\n-rw-rw-rw- 1 root root   15 May  5 08:11 requirements.txt\r\n"]
