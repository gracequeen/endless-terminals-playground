[7.925142, "o", "{\r\n  \"name\": \"pg-backup-tool\",\r\n  \"version\": \"2.3.1\",\r\n  \"description\": \"A PostgreSQL backup utility with support for full and differential backups\",\r\n  \"main\": \"index.js\",\r\n  \"scripts\": {\r\n    \"start\": \"node index.js\",\r\n    \"test\": \"jest\",\r\n    \"lint\": \"eslint .\"\r\n  },\r\n  \"keywords\": [\r\n    \"postgresql\",\r\n    \"backup\",\r\n    \"database\",\r\n    \"utility\"\r\n  ],\r\n  \"author\": \"DevOps Team\",\r\n  \"license\": \"MIT\",\r\n  \"dependencies\": {\r\n    \"pg\": \"^8.11.0\",\r\n    \"commander\": \"^11.0.0\",\r\n    \"winston\": \"^3.10.0\",\r\n    \"dotenv\": \"^16.3.1\"\r\n  },\r\n  \"devDependencies\": {\r\n    \"jest\": \"^29.6.0\",\r\n    \"eslint\": \"^8.45.0\"\r\n  },\r\n  \"repository\": {\r\n    \"type\": \"git\",\r\n    \"url\": \"https://github.com/example/pg-backup-tool.git\"\r\n  }\r\n}\r\n"]
