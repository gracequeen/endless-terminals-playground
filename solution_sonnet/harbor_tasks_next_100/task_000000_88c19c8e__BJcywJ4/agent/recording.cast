[61.27464, "o", "cat /home/user/pipeline/run.sh\r\n\u001b[?2004l\r"]
[61.275549, "o", "#!/bin/bash\r\n# Run the distributed feature extraction pipeline\r\n\r\ncd /home/user/pipeline\r\n\r\n# Start coordinator in background\r\npython3 coordinator.py &\r\nCOORD_PID=$!\r\n\r\n# Start 3 workers\r\npython3 worker.py 1 &\r\nWORKER1_PID=$!\r\npython3 worker.py 2 &\r\nWORKER2_PID=$!\r\npython3 worker.py 3 &\r\nWORKER3_PID=$!\r\n\r\n# Wait for coordinator to finish\r\nwait $COORD_PID\r\nCOORD_EXIT=$?\r\n\r\n# Kill workers (they spin forever waiting for more work)\r\nkill $WORKER1_PID $WORKER2_PID $WORKER3_PID 2>/dev/null\r\n\r\nexit $COORD_EXIT\r\n"]
[61.27571, "o", "\u001b[?2004h"]
[61.275758, "o", "I have no name!@8d9b8d08258a:~$ "]
[80.60094, "i", "cat > /home/user/pipeline/coordinator_fixed.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nFixed coordinator for distributed tf-idf feature extraction.\nTwo-phase: 1) Build global vocabulary, 2) Distribute fitted vectorizer + chunks\n\"\"\"\nimport pickle\nimport time\nimport zmq\nimport pandas as pd\nfrom sklearn.feature_extraction.text import TfidfVectorizer\n\ndef main():\n    context = zmq.Context()\n    \n    # Socket for worker registration\n    sync = context.socket(zmq.REP)\n    sync.bind(\"tcp://127.0.0.1:5559\")\n    \n    # Socket to send work to workers\n    sender = context.socket(zmq.PUSH)\n    sender.bind(\"tcp://127.0.0.1:5557\")\n    \n    # Socket to receive results from workers\n    receiver = context.socket(zmq.PULL)\n    receiver.bind(\"tcp://127.0.0.1:5558\")\n    \n    # Wait for 3 workers to register\n    num_workers = 3\n    print(f\"Coordinator: Waiting for {num_workers} workers to register...\")\n    for i in range(num_workers):\n        msg = sync.recv()\n        worker_id = msg.decode('utf-8')\n        print(f\"Coordinator: Worke"]
[80.601074, "i", "r {worker_id} registered\")\n        sync.send(b\"OK\")\n    \n    print(\"Coordinator: All workers registered, starting processing\")\n    time.sleep(0.5)  # Give workers time to connect to PUSH/PULL sockets\n    \n    # Load data\n    df = pd.read_parquet(\"/home/user/data/raw.parquet\")\n    print(f\"Coordinator: Loaded {len(df)} rows\")\n    \n    # PHASE 1: Build global vocabulary on all data\n    print(\"Coordinator: Building global vocabulary...\")\n    vectorizer = TfidfVectorizer(max_features=100)\n    all_texts = df[\"text\"].tolist()\n    vectorizer.fit(all_texts)\n    print(f\"Coordinator: Vocabulary built with {len(vectorizer.vocabulary_)} terms\")\n    \n    # PHASE 2: Distribute chunks with fitted vectorizer\n    chunk_size = 1000\n    chunks = [df.iloc[i:i+chunk_size] for i in range(0, len(df), chunk_size)]\n    num_chunks = len(chunks)\n    \n    print(f\"Coordinator: Sending {num_chunks} chunks to workers\")\n    \n    for chunk_id, chunk in enumerate(chunks):\n        msg = pickle.dumps((chunk_id, chunk, vectorizer))\n        sender"]
[80.601118, "i", ".send(msg)\n        print(f\"Coordinator: Sent chunk {chunk_id}\")\n    \n    # Send termination signals (one per worker)\n    for _ in range(num_workers):\n        sender.send(pickle.dumps((None, None, None)))\n    \n    # Collect results - use dict to track by chunk_id\n    results = {}\n    expected_chunks = set(range(num_chunks))\n    \n    print(f\"Coordinator: Waiting for {num_chunks} results...\")\n    \n    while len(results) < num_chunks:\n        try:\n            msg = receiver.recv()\n            chunk_id, result_df = pickle.loads(msg)\n            \n            if chunk_id in results:\n                print(f\"Coordinator: WARNING - Duplicate chunk {chunk_id} received!\")\n            else:\n                results[chunk_id] = result_df\n                print(f\"Coordinator: Received result for chunk {chunk_id} ({len(results)}/{num_chunks})\")\n        except Exception as e:\n            print(f\"Coordinator: Error receiving: {e}\")\n            break\n    \n    # Check for missing chunks\n    received_chunks = set(results.keys())\n  "]
[80.601152, "i", "  missing = expected_chunks - received_chunks\n    if missing:\n        print(f\"Coordinator: ERROR - Missing chunks: {missing}\")\n    \n    # Aggregate results in correct order\n    if len(results) == num_chunks:\n        ordered_results = [results[i] for i in range(num_chunks)]\n        final_df = pd.concat(ordered_results, ignore_index=True)\n        final_df.to_parquet(\"/home/user/data/features.parquet\")\n        print(f\"Coordinator: Saved {len(final_df)} rows to features.parquet\")\n        \n        # Verify values\n        max_val = final_df.values.max()\n        min_val = final_df.values.min()\n        print(f\"Coordinator: Value range: [{min_val}, {max_val}]\")\n    else:\n        print(f\"Coordinator: ERROR - Only received {len(results)}/{num_chunks} chunks\")\n    \n    sender.close()\n    receiver.close()\n    sync.close()\n    context.term()\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
