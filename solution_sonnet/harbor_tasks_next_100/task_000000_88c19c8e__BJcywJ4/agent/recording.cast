[93.458424, "o", "            # Use transform only (not fit_transform) with the provided vectorizer\r\n\u001b[?2004l\r"]
[93.458447, "o", "\u001b[?2004h"]
[93.458472, "o", "> "]
[93.458586, "o", "            texts = chunk_df[\"text\"].tolist()\r\n\u001b[?2004l\r"]
[93.458611, "o", "\u001b[?2004h"]
[93.458636, "o", "> "]
[93.458772, "o", "            tfidf_matrix = vectorizer.transform(texts)\r\n\u001b[?2004l\r"]
[93.4588, "o", "\u001b[?2004h"]
[93.458826, "o", "> "]
[93.458853, "o", "            \r\n\u001b[?2004l\r"]
[93.458882, "o", "\u001b[?2004h> "]
[93.459118, "o", "            # Convert to DataFrame with feature names from the fitted vectorizer\r\n\u001b[?2004l\r"]
[93.459148, "o", "\u001b[?2004h> "]
[93.459325, "o", "            feature_names = vectorizer.get_feature_names_out()\r\n\u001b[?2004l\r"]
[93.459354, "o", "\u001b[?2004h> "]
[93.459463, "o", "            result_df = pd.DataFrame(\r\n\u001b[?2004l\r"]
[93.459489, "o", "\u001b[?2004h> "]
[93.459605, "o", "                tfidf_matrix.toarray(),\r\n\u001b[?2004l\r"]
[93.459635, "o", "\u001b[?2004h> "]
[93.459754, "o", "                columns=feature_names\r\n\u001b[?2004l\r"]
[93.459772, "o", "\u001b[?2004h"]
[93.45981, "o", "> "]
[93.459835, "o", "            )\r\n\u001b[?2004l\r"]
[93.459864, "o", "\u001b[?2004h> "]
[93.459889, "o", "            \r\n\u001b[?2004l\r"]
[93.459914, "o", "\u001b[?2004h"]
[93.459955, "o", "> "]
[93.460024, "o", "            # Send result back\r\n\u001b[?2004l\r"]
[93.46005, "o", "\u001b[?2004h"]
[93.460075, "o", "> "]
[93.460227, "o", "            result_msg = pickle.dumps((chunk_id, result_df))\r\n\u001b[?2004l\r"]
[93.460253, "o", "\u001b[?2004h"]
[93.460277, "o", "> "]
[93.460361, "o", "            sender.send(result_msg)\r\n\u001b[?2004l\r"]
[93.460386, "o", "\u001b[?2004h"]
[93.460411, "o", "> "]
[93.460435, "o", "            \r\n\u001b[?2004l\r"]
[93.46046, "o", "\u001b[?2004h> "]
[93.460557, "o", "            chunks_processed += 1\r\n\u001b[?2004l\r"]
[93.460579, "o", "\u001b[?2004h"]
[93.460608, "o", "> "]
[93.460856, "o", "            print(f\"Worker {worker_id}: Completed chunk {chunk_id} (total: {chunks_processed})\")\r\n\u001b[?2004l\r"]
[93.460885, "o", "\u001b[?2004h> "]
[93.460925, "o", "            \r\n\u001b[?2004l\r"]
[93.460968, "o", "\u001b[?2004h> "]
[93.461059, "o", "        except Exception as e:\r\n\u001b[?2004l\r"]
[93.461082, "o", "\u001b[?2004h"]
[93.461101, "o", "> "]
[93.461238, "o", "            print(f\"Worker {worker_id}: Error: {e}\")\r\n\u001b[?2004l\r"]
[93.461263, "o", "\u001b[?2004h"]
[93.461288, "o", "> "]
[93.461351, "o", "            import traceback\r\n\u001b[?2004l\r"]
[93.461375, "o", "\u001b[?2004h"]
[93.4614, "o", "> "]
[93.46148, "o", "            traceback.print_exc()\r\n\u001b[?2004l\r"]
[93.461505, "o", "\u001b[?2004h"]
[93.46153, "o", "> "]
[93.461564, "o", "            break\r\n\u001b[?2004l\r"]
[93.461598, "o", "\u001b[?2004h> "]
[93.461625, "o", "    \r\n\u001b[?2004l\r"]
[93.461649, "o", "\u001b[?2004h> "]
[93.461904, "o", "    print(f\"Worker {worker_id}: Processed {chunks_processed} chunks total, shutting down\")\r\n\u001b[?2004l\r"]
[93.461931, "o", "\u001b[?2004h"]
[93.461973, "o", "> "]
[93.462014, "o", "    receiver.close()\r\n\u001b[?2004l\r"]
[93.462039, "o", "\u001b[?2004h"]
[93.462067, "o", "> "]
[93.462104, "o", "    sender.close()\r\n\u001b[?2004l\r"]
[93.462133, "o", "\u001b[?2004h> "]
[93.462191, "o", "    context.term()\r\n\u001b[?2004l\r"]
[93.462216, "o", "\u001b[?2004h"]
[93.46224, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[93.462265, "o", "> "]
[93.462333, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[93.462358, "o", "\u001b[?2004h"]
[93.462383, "o", "> "]
[93.462407, "o", "    main()\r\n\u001b[?2004l\r"]
[93.462432, "o", "\u001b[?2004h> "]
[93.46246, "o", "EOF\r\n\u001b[?2004l\r"]
[93.463574, "o", "\u001b[?2004h"]
[93.463602, "o", "I have no name!@8d9b8d08258a:~$ "]
[103.985834, "i", "cat > /home/user/pipeline/run_fixed.sh << 'EOF'\n#!/bin/bash\n# Run the FIXED distributed feature extraction pipeline\n\ncd /home/user/pipeline\n\n# Start coordinator in background\npython3 coordinator_fixed.py &\nCOORD_PID=$!\n\n# Small delay to ensure coordinator binds sockets\nsleep 0.5\n\n# Start 3 workers\npython3 worker_fixed.py 1 &\nWORKER1_PID=$!\npython3 worker_fixed.py 2 &\nWORKER2_PID=$!\npython3 worker_fixed.py 3 &\nWORKER3_PID=$!\n\n# Wait for all processes to complete\nwait $COORD_PID\nCOORD_EXIT=$?\n\nwait $WORKER1_PID 2>/dev/null\nwait $WORKER2_PID 2>/dev/null\nwait $WORKER3_PID 2>/dev/null\n\necho \"Pipeline completed with exit code: $COORD_EXIT\"\nexit $COORD_EXIT\nEOF\n"]
