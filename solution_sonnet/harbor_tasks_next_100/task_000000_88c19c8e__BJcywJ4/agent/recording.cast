[80.607543, "o", "    vectorizer = TfidfVectorizer(max_features=100)\r\n\u001b[?2004l\r"]
[80.607572, "o", "\u001b[?2004h> "]
[80.607674, "o", "    all_texts = df[\"text\"].tolist()\r\n\u001b[?2004l\r"]
[80.607711, "o", "\u001b[?2004h"]
[80.607745, "o", "> "]
[80.607804, "o", "    vectorizer.fit(all_texts)\r\n\u001b[?2004l\r"]
[80.607834, "o", "\u001b[?2004h> "]
[80.608083, "o", "    print(f\"Coordinator: Vocabulary built with {len(vectorizer.vocabulary_)} terms\")\r\n\u001b[?2004l\r"]
[80.608119, "o", "\u001b[?2004h> "]
[80.608145, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[80.608171, "o", "> "]
[80.608314, "o", "    # PHASE 2: Distribute chunks with fitted vectorizer\r\n\u001b[?2004l\r"]
[80.608342, "o", "\u001b[?2004h> "]
[80.608409, "o", "    chunk_size = 1000\r\n\u001b[?2004l\r"]
[80.608433, "o", "\u001b[?2004h"]
[80.608463, "o", "> "]
[80.608655, "o", "    chunks = [df.iloc[i:i+chunk_size] for i in range(0, len(df), chunk_size)]\r\n\u001b[?2004l\r"]
[80.608682, "o", "\u001b[?2004h> "]
[80.608767, "o", "    num_chunks = len(chunks)\r\n\u001b[?2004l\r"]
[80.608796, "o", "\u001b[?2004h> "]
[80.608824, "o", "    \r\n\u001b[?2004l\r"]
[80.608853, "o", "\u001b[?2004h> "]
[80.609042, "o", "    print(f\"Coordinator: Sending {num_chunks} chunks to workers\")\r\n\u001b[?2004l\r"]
[80.609071, "o", "\u001b[?2004h> "]
[80.609101, "o", "    \r\n\u001b[?2004l\r"]
[80.609131, "o", "\u001b[?2004h> "]
[80.609249, "o", "    for chunk_id, chunk in enumerate(chunks):\r\n\u001b[?2004l\r"]
[80.60928, "o", "\u001b[?2004h> "]
[80.609444, "o", "        msg = pickle.dumps((chunk_id, chunk, vectorizer))\r\n\u001b[?2004l\r"]
[80.609472, "o", "\u001b[?2004h> "]
[80.609545, "o", "        sender.send(msg)\r\n\u001b[?2004l\r"]
[80.609575, "o", "\u001b[?2004h"]
[80.609603, "o", "> "]
[80.609722, "o", "        print(f\"Coordinator: Sent chunk {chunk_id}\")\r\n\u001b[?2004l\r"]
[80.609751, "o", "\u001b[?2004h> "]
[80.609778, "o", "    \r\n\u001b[?2004l\r"]
[80.609803, "o", "\u001b[?2004h> "]
[80.609933, "o", "    # Send termination signals (one per worker)\r\n\u001b[?2004l\r"]
[80.609977, "o", "\u001b[?2004h> "]
[80.610072, "o", "    for _ in range(num_workers):\r\n\u001b[?2004l\r"]
[80.610101, "o", "\u001b[?2004h> "]
[80.610251, "o", "        sender.send(pickle.dumps((None, None, None)))\r\n\u001b[?2004l\r"]
[80.610283, "o", "\u001b[?2004h> "]
[80.610309, "o", "    \r\n\u001b[?2004l\r"]
[80.610334, "o", "\u001b[?2004h> "]
[80.610475, "o", "    # Collect results - use dict to track by chunk_id\r\n\u001b[?2004l\r"]
[80.610504, "o", "\u001b[?2004h> "]
[80.610555, "o", "    results = {}\r\n\u001b[?2004l\r"]
[80.610578, "o", "\u001b[?2004h"]
[80.610603, "o", "> "]
[80.610711, "o", "    expected_chunks = set(range(num_chunks))\r\n\u001b[?2004l\r"]
[80.610738, "o", "\u001b[?2004h> "]
[80.610767, "o", "    \r\n\u001b[?2004l\r"]
[80.610793, "o", "\u001b[?2004h> "]
[80.610977, "o", "    print(f\"Coordinator: Waiting for {num_chunks} results...\")\r\n\u001b[?2004l\r"]
[80.611004, "o", "\u001b[?2004h> "]
[80.61103, "o", "    \r\n\u001b[?2004l\r"]
[80.611054, "o", "\u001b[?2004h> "]
[80.611158, "o", "    while len(results) < num_chunks:\r\n\u001b[?2004l\r"]
[80.611183, "o", "\u001b[?2004h"]
[80.611207, "o", "> "]
[80.611233, "o", "        try:\r\n\u001b[?2004l\r"]
[80.611258, "o", "\u001b[?2004h> "]
[80.61135, "o", "            msg = receiver.recv()\r\n\u001b[?2004l\r"]
[80.611384, "o", "\u001b[?2004h> "]
[80.611523, "o", "            chunk_id, result_df = pickle.loads(msg)\r\n\u001b[?2004l\r"]
[80.611545, "o", "\u001b[?2004h"]
[80.61157, "o", "> "]
[80.611594, "o", "            \r\n\u001b[?2004l\r"]
[80.611623, "o", "\u001b[?2004h> "]
[80.611737, "o", "            if chunk_id in results:\r\n\u001b[?2004l\r"]
[80.611773, "o", "\u001b[?2004h> "]
[80.612024, "o", "                print(f\"Coordinator: WARNING - Duplicate chunk {chunk_id} received!\")\r\n\u001b[?2004l\r"]
[80.61206, "o", "\u001b[?2004h> "]
[80.612108, "o", "            else:\r\n\u001b[?2004l\r"]
[80.612132, "o", "\u001b[?2004h"]
[80.612157, "o", "> "]
[80.612267, "o", "                results[chunk_id] = result_df\r\n\u001b[?2004l\r"]
[80.612289, "o", "\u001b[?2004h"]
[80.612319, "o", "> "]
[80.612588, "o", "                print(f\"Coordinator: Received result for chunk {chunk_id} ({len(results)}/{num_chunks})\")\r\n\u001b[?2004l\r"]
[80.612617, "o", "\u001b[?2004h"]
[80.612642, "o", "> "]
[80.61271, "o", "        except Exception as e:\r\n\u001b[?2004l\r"]
[80.612739, "o", "\u001b[?2004h> "]
[80.612895, "o", "            print(f\"Coordinator: Error receiving: {e}\")\r\n\u001b[?2004l\r"]
[80.612924, "o", "\u001b[?2004h> "]
[80.612992, "o", "            break\r\n\u001b[?2004l\r"]
[80.613021, "o", "\u001b[?2004h> "]
[80.613058, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[80.613087, "o", "> "]
[80.613156, "o", "    # Check for missing chunks\r\n\u001b[?2004l\r"]
[80.613189, "o", "\u001b[?2004h> "]
[80.613302, "o", "    received_chunks = set(results.keys())\r\n\u001b[?2004l\r"]
[80.61333, "o", "\u001b[?2004h> "]
[80.613464, "o", "    missing = expected_chunks - received_chunks\r\n\u001b[?2004l\r"]
[80.613491, "o", "\u001b[?2004h> "]
[80.613539, "o", "    if missing:\r\n\u001b[?2004l\r"]
[80.613563, "o", "\u001b[?2004h"]
[80.613591, "o", "> "]
[80.613748, "o", "        print(f\"Coordinator: ERROR - Missing chunks: {missing}\")\r\n\u001b[?2004l\r"]
[80.613781, "o", "\u001b[?2004h> "]
[80.613808, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[80.613834, "o", "> "]
[80.613937, "o", "    # Aggregate results in correct order\r\n\u001b[?2004l\r"]
[80.613978, "o", "\u001b[?2004h> "]
[80.61408, "o", "    if len(results) == num_chunks:\r\n\u001b[?2004l\r"]
[80.614109, "o", "\u001b[?2004h> "]
[80.614293, "o", "        ordered_results = [results[i] for i in range(num_chunks)]\r\n\u001b[?2004l\r"]
[80.614322, "o", "\u001b[?2004h"]
[80.61435, "o", "> "]
[80.614507, "o", "        final_df = pd.concat(ordered_results, ignore_index=True)\r\n\u001b[?2004l\r"]
[80.614528, "o", "\u001b[?2004h"]
[80.614559, "o", "> "]
[80.614713, "o", "        final_df.to_parquet(\"/home/user/data/features.parquet\")\r\n\u001b[?2004l\r"]
[80.614741, "o", "\u001b[?2004h> "]
[80.614974, "o", "        print(f\"Coordinator: Saved {len(final_df)} rows to features.parquet\")\r\n\u001b[?2004l\r"]
[80.615005, "o", "\u001b[?2004h> "]
[80.615031, "o", "        \r\n\u001b[?2004l\r"]
[80.615057, "o", "\u001b[?2004h> "]
[80.615128, "o", "        # Verify values\r\n\u001b[?2004l\r"]
[80.615156, "o", "\u001b[?2004h> "]
[80.61527, "o", "        max_val = final_df.values.max()\r\n\u001b[?2004l\r"]
[80.615298, "o", "\u001b[?2004h> "]
[80.615414, "o", "        min_val = final_df.values.min()\r\n\u001b[?2004l\r"]
[80.615439, "o", "\u001b[?2004h"]
[80.615469, "o", "> "]
[80.61563, "o", "        print(f\"Coordinator: Value range: [{min_val}, {max_val}]\")\r\n\u001b[?2004l\r"]
[80.615659, "o", "\u001b[?2004h> "]
[80.615692, "o", "    else:\r\n\u001b[?2004l\r"]
[80.615721, "o", "\u001b[?2004h"]
[80.615751, "o", "> "]
[80.61599, "o", "        print(f\"Coordinator: ERROR - Only received {len(results)}/{num_chunks} chunks\")\r\n\u001b[?2004l\r"]
[80.616021, "o", "\u001b[?2004h> "]
[80.616052, "o", "    \r\n\u001b[?2004l\r"]
[80.616081, "o", "\u001b[?2004h> "]
[80.616128, "o", "    sender.close()\r\n\u001b[?2004l\r"]
[80.616153, "o", "\u001b[?2004h> "]
[80.616218, "o", "    receiver.close()\r\n\u001b[?2004l\r"]
[80.616251, "o", "\u001b[?2004h> "]
[80.616298, "o", "    sync.close()\r\n\u001b[?2004l\r"]
[80.616325, "o", "\u001b[?2004h> "]
[80.616382, "o", "    context.term()\r\n\u001b[?2004l\r"]
[80.616409, "o", "\u001b[?2004h> "]
[80.616435, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[80.61646, "o", "> "]
[80.616522, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[80.616547, "o", "\u001b[?2004h"]
[80.616576, "o", "> "]
[80.616605, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h"]
[80.616634, "o", "> EOF\r\n\u001b[?2004l\r"]
[80.622107, "o", "\u001b[?2004h"]
[80.622146, "o", "I have no name!@8d9b8d08258a:~$ "]
[93.452396, "i", "cat > /home/user/pipeline/worker_fixed.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nFixed worker for distributed tf-idf feature extraction.\nRegisters with coordinator, receives fitted vectorizer, transforms only.\n\"\"\"\nimport pickle\nimport sys\nimport zmq\nimport pandas as pd\n\ndef main():\n    worker_id = sys.argv[1] if len(sys.argv) > 1 else \"0\"\n    \n    context = zmq.Context()\n    \n    # Register with coordinator\n    sync = context.socket(zmq.REQ)\n    sync.connect(\"tcp://127.0.0.1:5559\")\n    sync.send(worker_id.encode('utf-8'))\n    response = sync.recv()\n    print(f\"Worker {worker_id}: Registered with coordinator\")\n    sync.close()\n    \n    # Socket to receive work from coordinator\n    receiver = context.socket(zmq.PULL)\n    receiver.connect(\"tcp://127.0.0.1:5557\")\n    \n    # Socket to send results to coordinator\n    sender = context.socket(zmq.PUSH)\n    sender.connect(\"tcp://127.0.0.1:5558\")\n    \n    print(f\"Worker {worker_id}: Ready to process chunks\")\n    \n    chunks_processed = 0\n    \n    while True:\n        try:\n"]
[93.452452, "i", "            msg = receiver.recv()\n            chunk_id, chunk_df, vectorizer = pickle.loads(msg)\n            \n            # Check for termination signal\n            if chunk_id is None:\n                print(f\"Worker {worker_id}: Received termination signal, exiting\")\n                break\n            \n            print(f\"Worker {worker_id}: Processing chunk {chunk_id}\")\n            \n            # Use transform only (not fit_transform) with the provided vectorizer\n            texts = chunk_df[\"text\"].tolist()\n            tfidf_matrix = vectorizer.transform(texts)\n            \n            # Convert to DataFrame with feature names from the fitted vectorizer\n            feature_names = vectorizer.get_feature_names_out()\n            result_df = pd.DataFrame(\n                tfidf_matrix.toarray(),\n                columns=feature_names\n            )\n            \n            # Send result back\n            result_msg = pickle.dumps((chunk_id, result_df))\n            sender.send(result_msg)\n            \n            c"]
[93.452555, "i", "hunks_processed += 1\n            print(f\"Worker {worker_id}: Completed chunk {chunk_id} (total: {chunks_processed})\")\n            \n        except Exception as e:\n            print(f\"Worker {worker_id}: Error: {e}\")\n            import traceback\n            traceback.print_exc()\n            break\n    \n    print(f\"Worker {worker_id}: Processed {chunks_processed} chunks total, shutting down\")\n    receiver.close()\n    sender.close()\n    context.term()\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
[93.452599, "o", "cat > /home/user/pipeline/worker_fixed.py << 'EOF'\r\n\u001b[?2004l\r"]
