[177.71484, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.714868, "o", "> "]
[177.715137, "o", "Each worker produces DataFrames with COMPLETELY DIFFERENT columns.\r\n\u001b[?2004l\r"]
[177.715173, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.715202, "o", "\u001b[?2004h> "]
[177.715257, "o", "**Impact:** \r\n\u001b[?2004l\r"]
[177.715285, "o", "\u001b[?2004h> "]
[177.715484, "o", "- When concatenated, pandas aligns by column name\r\n\u001b[?2004l\r"]
[177.715512, "o", "\u001b[?2004h> "]
[177.715714, "o", "- Mismatched columns create massive NaN padding\r\n\u001b[?2004l\r"]
[177.715744, "o", "\u001b[?2004h> "]
[177.716009, "o", "- IDF calculations are wrong (computed per chunk, not globally)\r\n\u001b[?2004l\r"]
[177.716042, "o", "\u001b[?2004h> "]
[177.716277, "o", "- tf-idf scores > 1.0 because IDF is artificially inflated\r\n\u001b[?2004l\r"]
[177.716305, "o", "\u001b[?2004h> "]
[177.716331, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.716366, "o", "> ---\r\n\u001b[?2004l\r"]
[177.716395, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.716438, "o", "\u001b[?2004h> "]
[177.716559, "o", "### 3. Timeout-Based Completion\r\n\u001b[?2004l\r"]
[177.716587, "o", "\u001b[?2004h> "]
[177.716765, "o", "**Location:** `coordinator.py` lines 34-45\r\n\u001b[?2004l\r"]
[177.716792, "o", "\u001b[?2004h> "]
[177.71682, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.716848, "o", "> "]
[177.716883, "o", "**Bug:**\r\n\u001b[?2004l\r"]
[177.716912, "o", "\u001b[?2004h> "]
[177.716961, "o", "```python\r\n\u001b[?2004l\r"]
[177.716993, "o", "\u001b[?2004h> "]
[177.717231, "o", "receiver.setsockopt(zmq.RCVTIMEO, 5000)  # 5 second timeout\r\n\u001b[?2004l\r"]
[177.717263, "o", "\u001b[?2004h> "]
[177.717292, "o", "try:\r\n\u001b[?2004l\r"]
[177.717319, "o", "\u001b[?2004h> "]
[177.717384, "o", "    while True:\r\n\u001b[?2004l\r"]
[177.717412, "o", "\u001b[?2004h> "]
[177.717475, "o", "        try:\r\n\u001b[?2004l\r"]
[177.717507, "o", "\u001b[?2004h> "]
[177.717652, "o", "            msg = receiver.recv()\r\n\u001b[?2004l\r"]
[177.71768, "o", "\u001b[?2004h> "]
[177.717763, "o", "            # ...\r\n\u001b[?2004l\r"]
[177.717791, "o", "\u001b[?2004h"]
[177.717826, "o", "> "]
[177.717906, "o", "        except zmq.Again:\r\n\u001b[?2004l\r"]
[177.717954, "o", "\u001b[?2004h> "]
[177.718127, "o", "            print(\"Timeout, finishing up\")\r\n\u001b[?2004l\r"]
[177.718155, "o", "\u001b[?2004h> "]
[177.718234, "o", "            break\r\n\u001b[?2004l\r"]
[177.718261, "o", "\u001b[?2004h"]
[177.718298, "o", "> ```\r\n\u001b[?2004l\r"]
[177.718328, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.718355, "o", "\u001b[?2004h> "]
[177.718755, "o", "**Problem:** Coordinator stops after 5 seconds of no activity, not when all chunks are received.\r\n\u001b[?2004l\r"]
[177.718782, "o", "\u001b[?2004h> "]
[177.71881, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.718838, "o", "> "]
[177.719101, "o", "**Impact:** If last few workers are slow, their results are lost.\r\n\u001b[?2004l\r"]
[177.719133, "o", "\u001b[?2004h> \r\n"]
[177.719162, "o", "\u001b[?2004l\r\u001b[?2004h"]
[177.719189, "o", "> ---\r\n\u001b[?2004l\r"]
[177.719219, "o", "\u001b[?2004h> "]
[177.719254, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.719419, "o", "### 4. Results Stored in List (Not Dict)\r\n\u001b[?2004l\r"]
[177.719446, "o", "\u001b[?2004h> "]
[177.719604, "o", "**Location:** `coordinator.py` line 33\r\n\u001b[?2004l\r"]
[177.719637, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.719666, "o", "\u001b[?2004h> "]
[177.719723, "o", "**Bug:**\r\n\u001b[?2004l\r"]
[177.719763, "o", "\u001b[?2004h> "]
[177.7198, "o", "```python\r\n\u001b[?2004l\r"]
[177.719829, "o", "\u001b[?2004h> "]
[177.720061, "o", "results = []  # No way to track which chunks received\r\n\u001b[?2004l\r"]
[177.720093, "o", "\u001b[?2004h> "]
[177.720322, "o", "results.append(result_df)  # Just append in arrival order\r\n\u001b[?2004l\r"]
[177.720358, "o", "\u001b[?2004h> "]
[177.720393, "o", "```\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.720422, "o", "> \r\n\u001b[?2004l\r"]
[177.720459, "o", "\u001b[?2004h> "]
[177.72055, "o", "**Problem:** Can't detect:\r\n\u001b[?2004l\r"]
[177.720578, "o", "\u001b[?2004h> "]
[177.72065, "o", "- Missing chunks\r\n\u001b[?2004l\r"]
[177.720677, "o", "\u001b[?2004h> "]
[177.720766, "o", "- Duplicate chunks\r\n\u001b[?2004l\r"]
[177.720793, "o", "\u001b[?2004h> "]
[177.720889, "o", "- Out-of-order chunks\r\n\u001b[?2004l\r"]
[177.720917, "o", "\u001b[?2004h> "]
[177.72096, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.72099, "o", "> "]
[177.721153, "o", "**Impact:** Silent data loss, no validation.\r\n\u001b[?2004l\r"]
[177.721186, "o", "\u001b[?2004h> \r\n"]
[177.721215, "o", "\u001b[?2004l\r\u001b[?2004h"]
[177.721243, "o", "> ---\r\n\u001b[?2004l\r"]
[177.721279, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.721308, "o", "\u001b[?2004h> "]
[177.721356, "o", "## The Fix\r\n\u001b[?2004l\r"]
[177.721389, "o", "\u001b[?2004h> \r\n"]
[177.721418, "o", "\u001b[?2004l\r\u001b[?2004h"]
[177.721446, "o", "> "]
[177.721626, "o", "### Solution 1: Worker Registration & Synchronization\r\n\u001b[?2004l\r"]
[177.721653, "o", "\u001b[?2004h> "]
[177.721781, "o", "**File:** `coordinator_fixed.py` lines 16-27\r\n\u001b[?2004l\r"]
[177.721814, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.721841, "o", "\u001b[?2004h"]
[177.721871, "o", "> "]
[177.7219, "o", "```python\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.721934, "o", "> "]
[177.722036, "o", "# REQ-REP socket for worker registration\r\n\u001b[?2004l\r"]
[177.722071, "o", "\u001b[?2004h> "]
[177.722154, "o", "sync = context.socket(zmq.REP)\r\n\u001b[?2004l\r"]
[177.722188, "o", "\u001b[?2004h> "]
[177.722277, "o", "sync.bind(\"tcp://127.0.0.1:5559\")\r\n\u001b[?2004l\r"]
[177.722306, "o", "\u001b[?2004h> \r\n"]
[177.722335, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[177.722494, "o", "# Wait for all workers to register BEFORE sending chunks\r\n\u001b[?2004l\r"]
[177.72253, "o", "\u001b[?2004h> "]
[177.722603, "o", "for i in range(num_workers):\r\n\u001b[?2004l\r"]
[177.722632, "o", "\u001b[?2004h> "]
[177.722696, "o", "    msg = sync.recv()\r\n\u001b[?2004l\r"]
[177.722726, "o", "\u001b[?2004h> "]
[177.722827, "o", "    worker_id = msg.decode('utf-8')\r\n\u001b[?2004l\r"]
[177.722855, "o", "\u001b[?2004h> "]
[177.722998, "o", "    print(f\"Worker {worker_id} registered\")\r\n\u001b[?2004l\r"]
[177.723034, "o", "\u001b[?2004h> "]
[177.723083, "o", "    sync.send(b\"OK\")\r\n\u001b[?2004l\r"]
[177.723107, "o", "\u001b[?2004h"]
[177.723135, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[177.723163, "o", "> "]
[177.72333, "o", "time.sleep(0.5)  # Give workers time to connect PUSH/PULL sockets\r\n\u001b[?2004l\r"]
[177.723358, "o", "\u001b[?2004h> "]
[177.723387, "o", "```\r\n\u001b[?2004l\r"]
[177.72341, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.723433, "o", "\u001b[?2004h"]
[177.723456, "o", "> "]
[177.723656, "o", "**Result:** All workers connected before any chunks sent. Zero chunks dropped.\r\n\u001b[?2004l\r"]
[177.723685, "o", "\u001b[?2004h> "]
[177.723719, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.723744, "o", "> ---\r\n\u001b[?2004l\r"]
[177.723772, "o", "\u001b[?2004h> "]
[177.7238, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.723827, "o", "> "]
[177.723975, "o", "### Solution 2: Global Vocabulary (Two-Phase Approach)\r\n\u001b[?2004l\r"]
[177.724001, "o", "\u001b[?2004h"]
[177.724025, "o", "> "]
[177.724131, "o", "**File:** `coordinator_fixed.py` lines 38-43\r\n\u001b[?2004l\r"]
[177.724161, "o", "\u001b[?2004h> "]
[177.724185, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.724209, "o", "> "]
[177.724237, "o", "```python\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.724262, "o", "> "]
[177.724364, "o", "# PHASE 1: Build vocabulary on ALL data\r\n\u001b[?2004l\r"]
[177.724394, "o", "\u001b[?2004h> "]
[177.724525, "o", "vectorizer = TfidfVectorizer(max_features=100)\r\n\u001b[?2004l\r"]
[177.724555, "o", "\u001b[?2004h> "]
[177.724646, "o", "all_texts = df[\"text\"].tolist()\r\n\u001b[?2004l\r"]
[177.724673, "o", "\u001b[?2004h> "]
[177.724836, "o", "vectorizer.fit(all_texts)  # Fit once on complete dataset\r\n\u001b[?2004l\r"]
[177.724872, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.724897, "o", "\u001b[?2004h> "]
[177.725053, "o", "# PHASE 2: Send fitted vectorizer WITH each chunk\r\n\u001b[?2004l\r"]
[177.725084, "o", "\u001b[?2004h> "]
[177.725199, "o", "for chunk_id, chunk in enumerate(chunks):\r\n\u001b[?2004l\r"]
[177.725224, "o", "\u001b[?2004h> "]
[177.725377, "o", "    msg = pickle.dumps((chunk_id, chunk, vectorizer))\r\n\u001b[?2004l\r"]
[177.725397, "o", "\u001b[?2004h"]
[177.725421, "o", "> "]
[177.725466, "o", "    sender.send(msg)\r\n\u001b[?2004l\r"]
[177.725504, "o", "\u001b[?2004h> ```\r\n"]
[177.725533, "o", "\u001b[?2004l\r\u001b[?2004h"]
[177.725557, "o", "> \r\n\u001b[?2004l\r"]
[177.725581, "o", "\u001b[?2004h> "]
[177.725684, "o", "**File:** `worker_fixed.py` lines 39-40\r\n\u001b[?2004l\r"]
[177.725712, "o", "\u001b[?2004h> "]
[177.725736, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.725764, "o", "> "]
[177.725793, "o", "```python\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.72582, "o", "> "]
[177.72599, "o", "# Workers receive fitted vectorizer and use transform() ONLY\r\n\u001b[?2004l\r"]
[177.726012, "o", "\u001b[?2004h"]
[177.726037, "o", "> "]
[177.726114, "o", "texts = chunk_df[\"text\"].tolist()\r\n\u001b[?2004l\r"]
[177.726137, "o", "\u001b[?2004h"]
[177.726166, "o", "> "]
[177.726324, "o", "tfidf_matrix = vectorizer.transform(texts)  # NOT fit_transform!\r\n\u001b[?2004l\r"]
[177.726353, "o", "\u001b[?2004h> "]
[177.726381, "o", "```\r\n\u001b[?2004l\r"]
[177.726401, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.726437, "o", "\u001b[?2004h> "]
[177.726471, "o", "**Result:** \r\n\u001b[?2004l\r"]
[177.726498, "o", "\u001b[?2004h> "]
[177.72661, "o", "- All workers use identical vocabulary\r\n\u001b[?2004l\r"]
[177.726638, "o", "\u001b[?2004h> "]
[177.726749, "o", "- All DataFrames have same 100 columns\r\n\u001b[?2004l\r"]
[177.726773, "o", "\u001b[?2004h"]
[177.726804, "o", "> "]
[177.726891, "o", "- IDF values computed globally (correct)\r\n\u001b[?2004l\r"]
[177.72692, "o", "\u001b[?2004h> "]
[177.727043, "o", "- tf-idf scores in valid range [0, 1]\r\n\u001b[?2004l\r"]
[177.727075, "o", "\u001b[?2004h"]
[177.727106, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.727129, "o", "---\r\n\u001b[?2004l\r"]
[177.727156, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.727183, "o", "\u001b[?2004h> "]
[177.727292, "o", "### Solution 3: Explicit Chunk Tracking\r\n\u001b[?2004l\r"]
[177.727315, "o", "\u001b[?2004h"]
[177.72734, "o", "> "]
[177.72745, "o", "**File:** `coordinator_fixed.py` lines 58-72\r\n\u001b[?2004l\r"]
[177.727479, "o", "\u001b[?2004h"]
[177.727501, "o", "> \r\n\u001b[?2004l\r"]
[177.727529, "o", "\u001b[?2004h"]
[177.727551, "o", "> "]
[177.727584, "o", "```python\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.727608, "o", "> "]
[177.727686, "o", "# Use dict to track chunks by ID\r\n\u001b[?2004l\r"]
[177.727718, "o", "\u001b[?2004h"]
[177.727746, "o", "> "]
[177.727774, "o", "results = {}\r\n\u001b[?2004l\r"]
[177.727803, "o", "\u001b[?2004h> "]
[177.727912, "o", "expected_chunks = set(range(num_chunks))\r\n\u001b[?2004l\r"]
[177.727956, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.727983, "o", "\u001b[?2004h"]
[177.728012, "o", "> "]
[177.728086, "o", "# Wait for EXACT number of chunks\r\n\u001b[?2004l\r"]
[177.728114, "o", "\u001b[?2004h> "]
[177.728209, "o", "while len(results) < num_chunks:\r\n\u001b[?2004l\r"]
[177.728233, "o", "\u001b[?2004h"]
[177.728261, "o", "> "]
[177.728315, "o", "    msg = receiver.recv()\r\n\u001b[?2004l\r"]
[177.728339, "o", "\u001b[?2004h"]
[177.728367, "o", "> "]
[177.72847, "o", "    chunk_id, result_df = pickle.loads(msg)\r\n\u001b[?2004l\r"]
[177.728494, "o", "\u001b[?2004h"]
[177.728519, "o", ">     \r\n\u001b[?2004l\r"]
[177.728544, "o", "\u001b[?2004h> "]
[177.728627, "o", "    if chunk_id in results:\r\n\u001b[?2004l\r"]
[177.728652, "o", "\u001b[?2004h> "]
[177.728811, "o", "        print(f\"WARNING - Duplicate chunk {chunk_id}!\")\r\n\u001b[?2004l\r"]
[177.728836, "o", "\u001b[?2004h"]
[177.72886, "o", "> "]
[177.728885, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.72891, "o", "> "]
[177.729025, "o", "        results[chunk_id] = result_df\r\n\u001b[?2004l\r"]
[177.729048, "o", "\u001b[?2004h"]
[177.729067, "o", "> \r\n\u001b[?2004l\r"]
[177.729095, "o", "\u001b[?2004h> "]
[177.729163, "o", "# Verify no missing chunks\r\n\u001b[?2004l\r"]
[177.72919, "o", "\u001b[?2004h> "]
[177.729325, "o", "missing = expected_chunks - set(results.keys())\r\n\u001b[?2004l\r"]
[177.729349, "o", "\u001b[?2004h"]
[177.729373, "o", "> "]
[177.729409, "o", "if missing:\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.729434, "o", "> "]
[177.729558, "o", "    print(f\"ERROR - Missing chunks: {missing}\")\r\n\u001b[?2004l\r"]
[177.729582, "o", "\u001b[?2004h> "]
[177.729608, "o", "```\r\n\u001b[?2004l\r"]
[177.729635, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.729667, "o", "\u001b[?2004h> "]
[177.729881, "o", "**Result:** Guaranteed all chunks received, no duplicates, no silent failures.\r\n\u001b[?2004l\r"]
[177.729906, "o", "\u001b[?2004h"]
[177.729934, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[177.729977, "o", "> ---\r\n\u001b[?2004l\r"]
[177.730004, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.730033, "o", "\u001b[?2004h> "]
[177.73014, "o", "### Solution 4: Graceful Termination\r\n\u001b[?2004l\r"]
[177.730169, "o", "\u001b[?2004h> "]
[177.730293, "o", "**File:** `coordinator_fixed.py` lines 53-55\r\n\u001b[?2004l\r"]
[177.730322, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.730351, "o", "\u001b[?2004h> "]
[177.730383, "o", "```python\r\n\u001b[?2004l\r"]
[177.73042, "o", "\u001b[?2004h> "]
[177.730536, "o", "# Send termination signals (one per worker)\r\n\u001b[?2004l\r"]
[177.730562, "o", "\u001b[?2004h"]
[177.730592, "o", "> "]
[177.73065, "o", "for _ in range(num_workers):\r\n\u001b[?2004l\r"]
[177.730678, "o", "\u001b[?2004h> "]
[177.730821, "o", "    sender.send(pickle.dumps((None, None, None)))\r\n\u001b[?2004l\r"]
[177.730848, "o", "\u001b[?2004h> "]
[177.730878, "o", "```\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.730906, "o", "> \r\n\u001b[?2004l\r"]
[177.730927, "o", "\u001b[?2004h> "]
[177.731055, "o", "**File:** `worker_fixed.py` lines 36-38\r\n\u001b[?2004l\r"]
[177.731078, "o", "\u001b[?2004h"]
[177.731108, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[177.731136, "o", "> "]
[177.731162, "o", "```python\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.731186, "o", "> "]
[177.731236, "o", "if chunk_id is None:\r\n\u001b[?2004l\r"]
[177.73126, "o", "\u001b[?2004h"]
[177.731288, "o", "> "]
