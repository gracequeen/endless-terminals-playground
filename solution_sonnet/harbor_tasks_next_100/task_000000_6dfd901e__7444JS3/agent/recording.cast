[63.051611, "i", "cat > ../recover.sh << 'EOF'\n#!/bin/bash\nfor gz_file in analytics.sql.gz categories.sql.gz configs.sql.gz discounts.sql.gz images.sql.gz inventory.sql.gz invoices.sql.gz messages.sql.gz payments.sql.gz products.sql.gz reviews.sql.gz roles.sql.gz scheduled_tasks.sql.gz settings.sql.gz subscriptions.sql.gz thumbnails.sql.gz; do\n    base=$(basename \"$gz_file\" .sql.gz)\n    echo \"Processing $gz_file...\"\n    gunzip -c \"$gz_file\" > \"${base}.sql\" 2>/dev/null || true\n    if [ -s \"${base}.sql\" ]; then\n        size=$(wc -c < \"${base}.sql\")\n        lines=$(wc -l < \"${base}.sql\")\n        echo \"  Extracted: $size bytes, $lines lines\"\n        gzip -c \"${base}.sql\" > \"${base}.sql.gz.new\"\n        mv \"${base}.sql.gz.new\" \"${base}.sql.gz\"\n        rm \"${base}.sql\"\n        echo \"  Recompressed successfully\"\n    else\n        echo \"  WARNING: No data extracted\"\n    fi\ndone\nEOF\n"]
[63.051752, "o", "cat > ../recover.sh << 'EOF'\r\n\u001b[?2004l\r"]
