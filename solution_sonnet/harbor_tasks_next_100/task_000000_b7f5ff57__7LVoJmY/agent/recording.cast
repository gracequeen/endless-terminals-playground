[38.262894, "o", "Starting benchmark run...\r\n"]
[58.100413, "o", "Completed 200 requests, results in raw_timings.csv\r\n"]
[58.138503, "o", "Aggregated 200 samples to stats.json\r\n"]
[58.159334, "o", "==================================================\r\n         LATENCY REPORT\r\n==================================================\r\nTotal requests: 200"]
[58.159388, "o", "\r\nMin latency:    51.80 ms\r\nMax latency:    150.56 ms\r\n--------------------------------------------------\r\np50 (median):   99.55 ms\r\np99:            52.47 ms\r\n==================================================\r\n"]
[58.162036, "o", "Benchmark complete.\r\n"]
