[85.761241, "o", "\u001b[?2004h"]
[85.761284, "o", "> "]
[85.761414, "o", "    print(f\"p50 (median):   {stats['p50']:.2f} ms\")\r\n\u001b[?2004l\r"]
[85.761455, "o", "\u001b[?2004h> "]
[85.761632, "o", "    print(f\"p99:            {stats['p99']:.2f} ms\")\r\n\u001b[?2004l\r"]
[85.761675, "o", "\u001b[?2004h> "]
[85.761743, "o", "    print(\"=\" * 50)\r\n\u001b[?2004l\r"]
[85.761771, "o", "\u001b[?2004h"]
[85.761809, "o", "> \r\n\u001b[?2004l\r"]
[85.76185, "o", "\u001b[?2004h> "]
[85.761927, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[85.761969, "o", "\u001b[?2004h> "]
