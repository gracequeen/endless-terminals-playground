[85.760293, "o", "> "]
[85.760324, "o", "    print(\"=\" * 50)\r\n\u001b[?2004l\r"]
[85.76038, "o", "\u001b[?2004h> "]
[85.760531, "o", "    print(f\"Total requests: {stats['count']}\")\r\n\u001b[?2004l\r"]
[85.760576, "o", "\u001b[?2004h> "]
[85.760729, "o", "    print(f\"Min latency:    {stats['min']:.2f} ms\")\r\n\u001b[?2004l\r"]
[85.760775, "o", "\u001b[?2004h> "]
[85.760923, "o", "    print(f\"Max latency:    {stats['max']:.2f} ms\")\r\n\u001b[?2004l\r"]
