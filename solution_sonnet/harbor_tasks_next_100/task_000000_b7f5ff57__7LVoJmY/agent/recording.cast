[85.758284, "i", "cat > report.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nReads stats.json and prints a human-readable latency report.\n\"\"\"\nimport json\nimport sys\n\ndef print_report(stats_file=\"stats.json\"):\n    \"\"\"Print the latency report to stdout.\"\"\"\n    with open(stats_file, 'r') as f:\n        stats = json.load(f)\n\n    print(\"=\" * 50)\n    print(\"         LATENCY REPORT\")\n    print(\"=\" * 50)\n    print(f\"Total requests: {stats['count']}\")\n    print(f\"Min latency:    {stats['min']:.2f} ms\")\n    print(f\"Max latency:    {stats['max']:.2f} ms\")\n    print(\"-\" * 50)\n    # FIX: Corrected the swapped labels\n    print(f\"p50 (median):   {stats['p50']:.2f} ms\")\n    print(f\"p99:            {stats['p99']:.2f} ms\")\n    print(\"=\" * 50)\n\nif __name__ == '__main__':\n    print_report()\nEOF\n"]
[85.758429, "o", "cat > report.py << 'EOF'\r\n"]
